#!/usr/bin/env python3
import argparse
import hashlib
import json
import os
import subprocess
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import Optional


DEFAULTS = {
    "threshold_lines": 200,
    "head_lines": 20,
    "tail_lines": 20,
    "always_offload": [],
    "index_path": ".offload/index.jsonl",
}

REQUIRED_INDEX_FIELDS = (
    "id",
    "command",
    "work_item_id",
    "agent_name",
    "timestamp",
    "size_bytes",
    "path",
)


def load_config(path: str) -> dict:
    if not os.path.exists(path):
        return dict(DEFAULTS)

    config = dict(DEFAULTS)
    current_list = None

    with open(path, "r", encoding="utf-8") as handle:
        for raw_line in handle:
            line = raw_line.strip()
            if not line or line.startswith("#"):
                continue

            if line.startswith("- "):
                if current_list is None:
                    raise ValueError("List item found without a list key.")
                config[current_list].append(line[2:].strip())
                continue

            current_list = None
            if ":" not in line:
                raise ValueError(f"Invalid config line: {raw_line.rstrip()}")

            key, value = line.split(":", 1)
            key = key.strip()
            value = value.strip()

            if value == "":
                if key not in config or not isinstance(config[key], list):
                    config[key] = []
                current_list = key
                continue

            if key in ("threshold_lines", "head_lines", "tail_lines"):
                config[key] = int(value)
            elif key == "always_offload":
                config[key] = [value]
            else:
                config[key] = value

    return config


def should_offload(cmdline: str, output_lines: int, config: dict) -> bool:
    for prefix in config.get("always_offload", []):
        if cmdline.startswith(prefix):
            return True
    return output_lines > int(config["threshold_lines"])


def resolve_index_path(config: dict, override: Optional[str] = None) -> Path:
    index_path = override or os.environ.get("PP_INDEX_PATH")
    if not index_path:
        index_path = config.get("index_path", ".offload/index.jsonl")
    return Path(index_path)


def now_utc() -> datetime:
    forced = os.environ.get("PP_NOW")
    if forced:
        return parse_timestamp(forced) or datetime.now(timezone.utc)
    return datetime.now(timezone.utc)


def parse_timestamp(value: Optional[str]) -> Optional[datetime]:
    if not value:
        return None
    cleaned = value.strip()
    if cleaned.endswith("Z"):
        cleaned = cleaned[:-1] + "+00:00"
    try:
        parsed = datetime.fromisoformat(cleaned)
    except ValueError:
        return None
    if parsed.tzinfo is None:
        return parsed.replace(tzinfo=timezone.utc)
    return parsed.astimezone(timezone.utc)


def index_entry_for(pointer_id: str, command: str, path: Path, size_bytes: int) -> dict:
    return {
        "id": pointer_id,
        "command": command,
        "work_item_id": os.environ.get("PP_WORK_ITEM_ID")
        or os.environ.get("PC_WORK_ITEM_ID")
        or "",
        "agent_name": os.environ.get("PP_AGENT_NAME")
        or os.environ.get("PC_AGENT_NAME")
        or "",
        "timestamp": now_utc().isoformat().replace("+00:00", "Z"),
        "size_bytes": size_bytes,
        "path": str(path),
    }


def append_index_entry(index_path: Path, entry: dict) -> None:
    index_path.parent.mkdir(parents=True, exist_ok=True)
    with open(index_path, "a", encoding="utf-8") as handle:
        handle.write(json.dumps(entry, sort_keys=True))
        handle.write("\n")


def offload_output(output: str, command: str, config: dict) -> str:
    digest = hashlib.sha256(output.encode("utf-8")).hexdigest()
    index_path = resolve_index_path(config)
    target_dir = index_path.parent
    target_dir.mkdir(parents=True, exist_ok=True)
    path = target_dir / f"{digest}.txt"
    with open(path, "w", encoding="utf-8") as handle:
        handle.write(output)
    size_bytes = path.stat().st_size
    entry = index_entry_for(digest, command, path, size_bytes)
    append_index_entry(index_path, entry)
    return digest


def enrich_entry(entry: dict, cwd: Path) -> dict:
    enriched = dict(entry)
    path = entry.get("path")
    if path:
        candidate = Path(path)
        if not candidate.is_absolute():
            candidate = cwd / candidate
        enriched["file_exists"] = candidate.exists()
    else:
        enriched["file_exists"] = False
    return enriched


def load_index_entries(index_path: Path) -> list[dict]:
    if not index_path.exists():
        return []
    entries: list[dict] = []
    with open(index_path, "r", encoding="utf-8") as handle:
        for raw_line in handle:
            line = raw_line.strip()
            if not line:
                continue
            try:
                entry = json.loads(line)
            except json.JSONDecodeError:
                print("pp: warning: skipping invalid index line", file=sys.stderr)
                continue
            if not isinstance(entry, dict):
                print("pp: warning: skipping non-object index line", file=sys.stderr)
                continue
            if "id" not in entry:
                print("pp: warning: skipping index line without id", file=sys.stderr)
                continue
            entries.append(entry)
    return entries


def sort_entries(entries: list[dict]) -> list[dict]:
    minimum = datetime.min.replace(tzinfo=timezone.utc)

    def key(entry: dict):
        timestamp = parse_timestamp(entry.get("timestamp")) or minimum
        return (timestamp, entry.get("id", ""))

    return sorted(entries, key=key, reverse=True)


def filter_entries(
    entries: list[dict],
    work_item_id: Optional[str],
    agent_name: Optional[str],
    command_contains: Optional[str],
    missing_only: bool,
    cwd: Path,
) -> list[dict]:
    filtered = []
    for entry in entries:
        if work_item_id and entry.get("work_item_id") != work_item_id:
            continue
        if agent_name and entry.get("agent_name") != agent_name:
            continue
        if command_contains and command_contains not in entry.get("command", ""):
            continue
        enriched = enrich_entry(entry, cwd)
        if missing_only and enriched.get("file_exists"):
            continue
        filtered.append(enriched)
    return filtered


def write_index(entries: list[dict], index_path: Path) -> None:
    index_path.parent.mkdir(parents=True, exist_ok=True)
    with open(index_path, "w", encoding="utf-8") as handle:
        for entry in entries:
            handle.write(json.dumps(entry, sort_keys=True))
            handle.write("\n")


def handle_list(args: argparse.Namespace, config: dict) -> int:
    index_path = resolve_index_path(config, args.index)
    entries = load_index_entries(index_path)
    filtered = filter_entries(
        entries,
        args.work_item_id,
        args.agent_name,
        args.command_contains,
        args.missing_only,
        Path.cwd(),
    )
    ordered = sort_entries(filtered)
    if args.limit is not None:
        ordered = ordered[: args.limit]
    for entry in ordered:
        print(json.dumps(entry, sort_keys=True))
    return 0


def handle_get(args: argparse.Namespace, config: dict) -> int:
    index_path = resolve_index_path(config, args.index)
    entries = load_index_entries(index_path)
    entry = next((item for item in entries if item.get("id") == args.pointer_id), None)
    if not entry:
        print(f"pp: id not found: {args.pointer_id}", file=sys.stderr)
        return 1
    enriched = enrich_entry(entry, Path.cwd())
    print(json.dumps(enriched, sort_keys=True))
    return 0


def determine_purge(
    entries: list[dict],
    now: datetime,
    max_age_days: Optional[int],
    max_count: Optional[int],
    protected_work_items: list[str],
) -> dict[str, list[str]]:
    protected_ids = {
        entry.get("id")
        for entry in entries
        if entry.get("work_item_id") in protected_work_items
    }
    purge_reasons: dict[str, list[str]] = {}

    if max_age_days is not None:
        cutoff = now - timedelta(days=max_age_days)
        for entry in entries:
            entry_id = entry.get("id")
            if not entry_id or entry_id in protected_ids:
                continue
            timestamp = parse_timestamp(entry.get("timestamp"))
            if not timestamp or timestamp < cutoff:
                purge_reasons.setdefault(entry_id, []).append("max_age_days")

    if max_count is not None:
        ordered = sort_entries(entries)
        protected_ids = {
            entry.get("id") for entry in ordered if entry.get("id") in protected_ids
        }
        candidates = [
            entry for entry in ordered if entry.get("id") not in protected_ids
        ]
        keep_ids = {
            entry.get("id") for entry in candidates[:max_count] if entry.get("id")
        }
        for entry in candidates[max_count:]:
            entry_id = entry.get("id")
            if not entry_id:
                continue
            purge_reasons.setdefault(entry_id, []).append("max_count")

    return purge_reasons


def handle_purge(args: argparse.Namespace, config: dict) -> int:
    if args.max_age_days is None and args.max_count is None:
        print("pp: purge requires --max-age-days and/or --max-count", file=sys.stderr)
        return 2

    index_path = resolve_index_path(config, args.index)
    entries = load_index_entries(index_path)
    now = now_utc()
    purge_reasons = determine_purge(
        entries, now, args.max_age_days, args.max_count, args.protect_work_item
    )

    kept_entries = []
    removed_count = 0
    ordered = sort_entries(entries)
    cwd = Path.cwd()

    for entry in ordered:
        entry_id = entry.get("id")
        reasons = purge_reasons.get(entry_id)
        if reasons:
            removed_count += 1
            enriched = enrich_entry(entry, cwd)
            if not args.dry_run:
                path = entry.get("path")
                if path:
                    target = Path(path)
                    if not target.is_absolute():
                        target = cwd / target
                    if target.exists():
                        target.unlink()
            print(
                json.dumps(
                    {
                        "action": "purge",
                        "id": entry_id,
                        "reasons": reasons,
                        "file_exists": enriched.get("file_exists"),
                    },
                    sort_keys=True,
                )
            )
            continue
        kept_entries.append(entry)
        print(
            json.dumps(
                {
                    "action": "keep",
                    "id": entry_id,
                    "file_exists": enrich_entry(entry, cwd).get("file_exists"),
                },
                sort_keys=True,
            )
        )

    if not args.dry_run:
        write_index(sort_entries(kept_entries), index_path)

    summary = {
        "removed": removed_count,
        "kept": len(kept_entries),
        "dry_run": args.dry_run,
    }
    print(json.dumps({"summary": summary}, sort_keys=True))
    return 0


def handle_index_command(args: list[str], config: dict) -> int:
    parser = argparse.ArgumentParser(prog="pp", add_help=True)
    subparsers = parser.add_subparsers(dest="command", required=True)

    list_parser = subparsers.add_parser("list", help="list offload index entries")
    list_parser.add_argument("--index", dest="index", default=None)
    list_parser.add_argument("--work-item", dest="work_item_id", default=None)
    list_parser.add_argument("--agent", dest="agent_name", default=None)
    list_parser.add_argument(
        "--command-contains", dest="command_contains", default=None
    )
    list_parser.add_argument("--missing-only", dest="missing_only", action="store_true")
    list_parser.add_argument("--limit", dest="limit", type=int, default=None)

    get_parser = subparsers.add_parser("get", help="fetch a single index entry")
    get_parser.add_argument("pointer_id")
    get_parser.add_argument("--index", dest="index", default=None)

    purge_parser = subparsers.add_parser(
        "purge", help="purge index entries by retention policy"
    )
    purge_parser.add_argument("--index", dest="index", default=None)
    purge_parser.add_argument(
        "--max-age-days", dest="max_age_days", type=int, default=None
    )
    purge_parser.add_argument("--max-count", dest="max_count", type=int, default=None)
    purge_parser.add_argument("--dry-run", dest="dry_run", action="store_true")
    purge_parser.add_argument(
        "--protect-work-item", dest="protect_work_item", action="append", default=[]
    )

    parsed = parser.parse_args(args)
    if parsed.command == "list":
        return handle_list(parsed, config)
    if parsed.command == "get":
        return handle_get(parsed, config)
    if parsed.command == "purge":
        return handle_purge(parsed, config)
    return 2


def print_head_tail(lines: list[str], head_lines: int, tail_lines: int) -> None:
    head = lines[:head_lines]
    tail = lines[-tail_lines:] if tail_lines > 0 else []

    if head:
        print("\n".join(head))
    if tail_lines > 0 and len(lines) > head_lines:
        print("...")
        print("\n".join(tail))


def main() -> int:
    if len(sys.argv) < 2:
        print("Usage: pp <command> [args...]", file=sys.stderr)
        return 2

    config_path = os.environ.get("PP_CONFIG", "pp.yml")
    try:
        config = load_config(config_path)
    except ValueError as exc:
        print(f"pp: invalid config: {exc}", file=sys.stderr)
        return 2

    if sys.argv[1] in ("list", "get", "purge"):
        return handle_index_command(sys.argv[1:], config)

    cmd = sys.argv[1:]
    cmdline = " ".join(cmd)

    completed = subprocess.run(
        cmd, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT
    )
    output = completed.stdout or ""
    lines = output.splitlines()

    if should_offload(cmdline, len(lines), config):
        pointer_id = offload_output(output, cmdline, config)
        print(f"[pp] offloaded output id: {pointer_id}")
        print_head_tail(lines, int(config["head_lines"]), int(config["tail_lines"]))
    else:
        print(output, end="" if output.endswith("\n") else "\n")

    return completed.returncode


if __name__ == "__main__":
    raise SystemExit(main())
