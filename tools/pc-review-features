TASK_MARKER_END = "<!-- review-backlog:end -->"

SEVERITY_HIGH = "High"
SEVERITY_MEDIUM = "Medium"
SEVERITY_LOW = "Low"
VALID_SEVERITIES = {SEVERITY_HIGH, SEVERITY_MEDIUM, SEVERITY_LOW}
OWNER_PATCHER = "patcher"
OWNER_HUMAN = "human"
