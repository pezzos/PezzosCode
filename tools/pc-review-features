def die(message: str) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(1)


def default_role_mode() -> str:
    raw = os.environ.get("REVIEW_ROLE_MODE", ROLE_MODE_DETERMINISTIC).strip().lower()
    if raw in {ROLE_MODE_CODEX, ROLE_MODE_DETERMINISTIC}:
        return raw
    return ROLE_MODE_DETERMINISTIC


def parse_args(argv: Optional[Sequence[str]] = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Review feature folders for security and product risks and inject "
            "actionable findings."
        )
    )
    parser.add_argument(
        "--root",
        default=str(ROOT),
        help="Repository root (defaults to detected root).",
    )
    parser.add_argument(
        "--feature",
        default="",
        help="Optional feature selector (e.g. '01' or '01-alpha-feature').",
    )
    parser.add_argument(
        "--role-mode",
        choices=(ROLE_MODE_CODEX, ROLE_MODE_DETERMINISTIC),
        default=default_role_mode(),
        help=(
            "Role execution mode for Security Expert/Product Manager review steps. "
            "'codex' runs prompt-driven role execution; "
            "'deterministic' uses local fallback heuristics."
        ),
    )
    parser.add_argument(
        "--include-completed",
        action="store_true",
        help="Include features already marked `Status: Done` in dev-tasks.md.",
    )
    parser.add_argument(
        "--skip-schema-check",
        action="store_true",
        help="Skip tools/pc-devtasks-schema-check after updates.",
    )
    return parser.parse_args(argv)


def feature_slug_from_dir_name(name: str) -> str:
    parts = name.split("-", 1)
    if len(parts) == 2:
        return parts[1]
    return name


def numeric_feature_dirs(features_root: Path) -> List[Path]:
    selected: List[Path] = []
    for entry in sorted(features_root.iterdir(), key=lambda item: item.name):
        if not entry.is_dir():
            continue
        if entry.name == "feature-template":
            continue
        if not re.match(r"^\d+-", entry.name):
            continue
        selected.append(entry)
    return selected


def ordered_feature_slugs(root: Path) -> List[str]:
    for rel_path in (FEATURE_ORDER_PLAN_PATH, PREPARE_FEATURES_STATE_PATH):
        path = root / rel_path
        if not path.exists():
            continue
        try:
            payload = json.loads(path.read_text(encoding="utf-8"))
        except json.JSONDecodeError:
            print(
                f"pc-review-features: warning: invalid JSON in {rel_path}; "
                "falling back to numeric feature folder scan"
            )
            continue
        raw_values = payload.get("ordered_feature_slugs")
        if not isinstance(raw_values, list):
            continue
        values: List[str] = []
        seen = set()
        for raw in raw_values:
            token = str(raw).strip()
            if not token or token in seen:
                continue
            seen.add(token)
            values.append(token)
        if values:
            return values
    return []


def feature_dirs(root: Path, selector: str) -> List[Path]:
    features_root = root / FEATURES_DIR
    if not features_root.exists():
        return []
    numeric_dirs = numeric_feature_dirs(features_root)
    normalized = selector.strip()
    if normalized:
        return [
            entry
            for entry in numeric_dirs
            if entry.name == normalized or entry.name.startswith(f"{normalized}-")
        ]

    slugs = ordered_feature_slugs(root)
    if not slugs:
        return numeric_dirs

    by_slug = {feature_slug_from_dir_name(entry.name): entry for entry in numeric_dirs}
    selected: List[Path] = []
    missing: List[str] = []
    for slug in slugs:
        entry = by_slug.get(slug)
        if entry is None:
            missing.append(slug)
            continue
        selected.append(entry)
    if missing:
        print(
            "pc-review-features: warning: ordered feature slug(s) missing folders: "
            + ", ".join(missing)
        )
    return selected


def read_text(path: Path) -> str:
    return path.read_text(encoding="utf-8") if path.exists() else ""


def strip_managed_block(content: str, start_marker: str, end_marker: str) -> str:
    pattern = re.compile(
        rf"{re.escape(start_marker)}.*?{re.escape(end_marker)}",
        re.DOTALL,
    )
    return pattern.sub("", content)


def contains_any(text: str, keywords: Iterable[str]) -> bool:
    lowered = text.lower()
    return any(keyword in lowered for keyword in keywords)


def count_functional_requirements(feature_spec: str) -> int:
    patterns = [
        r"\*\*Requirement\s+\d+",  # markdown bold style
        r"^- \[ \]\s+\*\*Requirement",  # checklist style
    ]
    total = 0
    for pattern in patterns:
        total += len(re.findall(pattern, feature_spec, re.MULTILINE | re.IGNORECASE))
    return total


def extract_json_payload(raw: str) -> str:
    start = raw.find("{")
    end = raw.rfind("}")
    if start == -1 or end == -1 or end < start:
        return raw
    return raw[start : end + 1]


def load_prompt_template(root: Path, prompt_rel_path: Path) -> str:
    prompt_path = root / prompt_rel_path
    if not prompt_path.exists():
        die(
            "pc-review-features: missing prompt template "
            f"{prompt_path}; restore prompts under {root / PROMPTS_DIR}"
        )
    return prompt_path.read_text(encoding="utf-8")


def render_prompt_template(template: str, values: Dict[str, str]) -> str:
    class StrictMap(dict):
        def __missing__(self, key):
            die(f"pc-review-features: prompt template missing value for '{key}'")
            return ""

    return template.format_map(StrictMap(values))


def truncate_for_error(raw: str, max_chars: int = 800) -> str:
    compact = re.sub(r"\s+", " ", raw.strip())
    if len(compact) <= max_chars:
        return compact
    return compact[:max_chars].rstrip() + "..."


def codex_exec_json(
    *,
    root: Path,
    prompt: str,
    profile: str,
    label: str,
) -> Dict[str, Any]:
    if shutil.which("codex") is None:
        raise RuntimeError("codex CLI not found in PATH")

    cmd = [
        "codex",
        "-C",
        str(root),
        "--profile",
        profile,
        "--sandbox",
        "read-only",
        "--ask-for-approval",
        "never",
        "exec",
        prompt,
    ]
    result = subprocess.run(
        cmd,
        cwd=str(root),
        check=False,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if result.returncode != 0:
        combined = "\n".join(part for part in [result.stdout, result.stderr] if part)
        raise RuntimeError(
            f"{label} role execution failed with exit {result.returncode}: "
            f"{truncate_for_error(combined)}"
        )
    payload = extract_json_payload(result.stdout or "")
    try:
        data = json.loads(payload)
    except json.JSONDecodeError as exc:
        raise RuntimeError(
            f"{label} role returned non-JSON output: {truncate_for_error(result.stdout or '')}"
        ) from exc
    if not isinstance(data, dict):
        raise RuntimeError(f"{label} role JSON payload must be an object")
    return data


def feature_status_from_dev_tasks(content: str) -> str:
    status, _ = parse_status_from_content(content)
    if not status:
        return ""
    return status.strip()


def has_measurable_acceptance(feature_spec_content: str) -> bool:
    match = re.search(
        r"^##\s+Acceptance Criteria\s*$",
        feature_spec_content,
        flags=re.MULTILINE | re.IGNORECASE,
    )
    if not match:
        return False
    section_start = match.end()
    next_heading = re.search(
        r"^##\s+", feature_spec_content[section_start:], re.MULTILINE
    )
    section_end = (
        section_start + next_heading.start()
        if next_heading
        else len(feature_spec_content)
    )
    section = feature_spec_content[section_start:section_end]
    if re.search(r"\b\d+\b", section):
        return True
    if "target" in section.lower() and "metric" in section.lower():
        return True
    return False


def feature_id_matches_folder(feature_id: str, feature_spec_content: str) -> bool:
    folder_match = re.match(r"^(\d+)-", feature_id.strip())
    if not folder_match:
        return True
    expected = int(folder_match.group(1))
    spec_match = re.search(
        r"\*\*Feature ID:\*\*\s*`F-(\d+)`",
        feature_spec_content,
        flags=re.IGNORECASE,
    )
    if not spec_match:
        return False
    actual = int(spec_match.group(1))
    return actual == expected


def has_template_leakage(*contents: str) -> bool:
    merged = "\n".join(contents)
    return any(marker in merged for marker in GENERIC_TEMPLATE_MARKERS)


def build_finding_from_template(
    *,
    feature_key: str,
    template: FindingTemplate,
    index: int,
    prefix: str,
) -> Finding:
    finding_id = f"{prefix}-{feature_key}-{index:03d}"
    return Finding(
        finding_id=finding_id,
        canonical_key=template.canonical_key,
        severity=template.severity,
        title=template.title,
        spec_guidance=template.spec_guidance,
        action=template.action,
        acceptance=template.acceptance,
        blocking=bool(template.blocking),
        target=template.target,
    )


def findings_from_keys(
    *,
    feature_key: str,
    selected_keys: Sequence[str],
    templates: Sequence[FindingTemplate],
    template_index: Dict[str, int],
    template_by_key: Dict[str, FindingTemplate],
    prefix: str,
) -> List[Finding]:
    selected_set = {item for item in selected_keys if item in template_by_key}
    findings: List[Finding] = []
    for template in templates:
        if template.canonical_key not in selected_set:
            continue
        findings.append(
            build_finding_from_template(
                feature_key=feature_key,
                template=template,
                index=template_index[template.canonical_key],
                prefix=prefix,
            )
        )
    return findings


def deterministic_security_keys(content: str) -> List[str]:
    selected: List[str] = []
    for template in SECURITY_TEMPLATES:
        if template.applies_when and not contains_any(content, template.applies_when):
            continue
        if template.satisfied_when and contains_any(content, template.satisfied_when):
            continue
        selected.append(template.canonical_key)
        if len(selected) >= MAX_SECURITY_FINDINGS:
            break
    return selected


def deterministic_product_keys(
    *,
    feature_id: str,
    feature_spec_content: str,
    dev_tasks_content: str,
) -> List[str]:
    selected: List[str] = []

    if not feature_id_matches_folder(feature_id, feature_spec_content):
        selected.append("PROD-FEATURE-ID-CORRECTNESS")

    if has_template_leakage(feature_spec_content, dev_tasks_content):
        selected.append("PROD-TEMPLATE-LEAKAGE")

    if count_functional_requirements(feature_spec_content) < 2:
        selected.append("PROD-FUNCTIONAL-SCOPE")

    if not contains_any(
        feature_spec_content, ("user flow", "detailed steps", "journey")
    ):
        selected.append("PROD-USER-JOURNEY")

    if not contains_any(feature_spec_content, ("workflow", "flow")):
        selected.append("PROD-WORKFLOW")

    if (
        "product owner" not in dev_tasks_content.lower()
        and "po test" not in dev_tasks_content.lower()
    ):
        selected.append("PROD-PO-VALIDATION-CHECKPOINT")

    if not has_measurable_acceptance(feature_spec_content):
        selected.append("PROD-MEASURABLE-ACCEPTANCE")

    ordered: List[str] = []
    for template in PRODUCT_TEMPLATES:
        if template.canonical_key not in selected:
            continue
        ordered.append(template.canonical_key)
        if len(ordered) >= MAX_PRODUCT_FINDINGS:
            break
    return ordered


def normalize_selected_keys(
    raw_keys: Any, templates: Sequence[FindingTemplate]
) -> Optional[List[str]]:
    if not isinstance(raw_keys, list):
        return None
    allowed = {item.canonical_key for item in templates}
    raw_normalized = []
    for item in raw_keys:
        token = str(item).strip().upper()
        if not token:
            continue
        if token in allowed and token not in raw_normalized:
            raw_normalized.append(token)

    ordered: List[str] = []
    for template in templates:
        if template.canonical_key in raw_normalized:
            ordered.append(template.canonical_key)
    return ordered


def filter_keys_by_evidence(
    *,
    selected_keys: Sequence[str],
    evidence_payload: Any,
    content: str,
) -> List[str]:
    if not isinstance(evidence_payload, dict):
        return []
    accepted: List[str] = []
    lowered_content = content.lower()
    for key in selected_keys:
        evidence = str(evidence_payload.get(key, "")).strip()
        if not evidence:
            continue
        if evidence.lower() in lowered_content:
            accepted.append(key)
    return accepted


def run_security_role(
    *,
    root: Path,
    role_mode: str,
    feature_id: str,
    feature_key: str,
    feature_title: str,
    feature_spec_content: str,
    dev_tasks_content: str,
    ux_content: str,
) -> List[Finding]:
    feature_text = f"{feature_spec_content}\n{dev_tasks_content}"
    fallback_keys = deterministic_security_keys(feature_text)
    fallback = findings_from_keys(
        feature_key=feature_key,
        selected_keys=fallback_keys,
        templates=SECURITY_TEMPLATES,
        template_index=SECURITY_TEMPLATE_INDEX,
        template_by_key=SECURITY_TEMPLATE_BY_KEY,
        prefix="SEC",
    )
    if role_mode == ROLE_MODE_DETERMINISTIC:
        return fallback

    template = load_prompt_template(root, SECURITY_PROMPT_PATH)
    prompt = render_prompt_template(
        template,
        {
            "feature_id": feature_id,
            "feature_key": feature_key,
            "feature_title": feature_title,
            "feature_spec_markdown": feature_spec_content,
            "dev_tasks_markdown": dev_tasks_content,
            "ux_blueprint_markdown": ux_content,
            "allowed_keys_json": json.dumps(
                [item.canonical_key for item in SECURITY_TEMPLATES],
                ensure_ascii=True,
                sort_keys=True,
            ),
        },
    )

    try:
        payload = codex_exec_json(
            root=root,
            prompt=prompt,
            profile=os.environ.get("REVIEW_SECURITY_PROFILE", "SecurityExpert"),
            label="security-expert",
        )
    except RuntimeError as exc:
        print(
            "pc-review-features: warning: Security Expert role failed for "
            f"{feature_id}; using deterministic findings ({exc})"
        )
        return fallback

    decision = str(payload.get("decision", "APPROVE")).strip().upper()
    if decision not in {"APPROVE", "BLOCK"}:
        print(
            "pc-review-features: warning: Security Expert returned invalid decision "
            f"for {feature_id}; using deterministic findings"
        )
        return fallback

    normalized_keys = normalize_selected_keys(
        payload.get("selected_keys"), SECURITY_TEMPLATES
    )
    if normalized_keys is None:
        print(
            "pc-review-features: warning: Security Expert selected_keys payload invalid "
            f"for {feature_id}; using deterministic findings"
        )
        return fallback

    evidence_keys = filter_keys_by_evidence(
        selected_keys=normalized_keys,
        evidence_payload=payload.get("evidence"),
        content=feature_text,
    )

    if decision == "BLOCK" and not evidence_keys:
        return fallback

    return findings_from_keys(
        feature_key=feature_key,
        selected_keys=evidence_keys,
        templates=SECURITY_TEMPLATES,
        template_index=SECURITY_TEMPLATE_INDEX,
        template_by_key=SECURITY_TEMPLATE_BY_KEY,
        prefix="SEC",
    )


def run_product_role(
    *,
    root: Path,
    role_mode: str,
    feature_id: str,
    feature_key: str,
    feature_title: str,
    feature_spec_content: str,
    dev_tasks_content: str,
    ux_content: str,
    security_findings: Sequence[Finding],
) -> List[Finding]:
    fallback_keys = deterministic_product_keys(
        feature_id=feature_id,
        feature_spec_content=feature_spec_content,
        dev_tasks_content=dev_tasks_content,
    )
    fallback = findings_from_keys(
        feature_key=feature_key,
        selected_keys=fallback_keys,
        templates=PRODUCT_TEMPLATES,
        template_index=PRODUCT_TEMPLATE_INDEX,
        template_by_key=PRODUCT_TEMPLATE_BY_KEY,
        prefix="PROD",
    )
    if role_mode == ROLE_MODE_DETERMINISTIC:
        return fallback

    template = load_prompt_template(root, PRODUCT_PROMPT_PATH)
    prompt = render_prompt_template(
        template,
        {
            "feature_id": feature_id,
            "feature_key": feature_key,
            "feature_title": feature_title,
            "feature_spec_markdown": feature_spec_content,
            "dev_tasks_markdown": dev_tasks_content,
            "ux_blueprint_markdown": ux_content,
            "security_findings_json": json.dumps(
                [finding_payload(item) for item in security_findings],
                ensure_ascii=True,
                indent=2,
                sort_keys=True,
            ),
            "allowed_keys_json": json.dumps(
                [item.canonical_key for item in PRODUCT_TEMPLATES],
                ensure_ascii=True,
                sort_keys=True,
            ),
        },
    )

    try:
        payload = codex_exec_json(
            root=root,
            prompt=prompt,
            profile=os.environ.get("REVIEW_PM_PROFILE", "ProductManager"),
            label="product-manager-review",
        )
    except RuntimeError as exc:
        print(
            "pc-review-features: warning: Product Manager role failed for "
            f"{feature_id}; using deterministic findings ({exc})"
        )
        return fallback

    decision = str(payload.get("decision", "APPROVE")).strip().upper()
    if decision not in {"APPROVE", "BLOCK"}:
        print(
            "pc-review-features: warning: Product Manager returned invalid decision "
            f"for {feature_id}; using deterministic findings"
        )
        return fallback

    normalized_keys = normalize_selected_keys(
        payload.get("selected_keys"), PRODUCT_TEMPLATES
    )
    if normalized_keys is None:
        print(
            "pc-review-features: warning: Product Manager selected_keys payload invalid "
            f"for {feature_id}; using deterministic findings"
        )
        return fallback

    evidence_keys = filter_keys_by_evidence(
        selected_keys=normalized_keys,
        evidence_payload=payload.get("evidence"),
        content=feature_spec_content + "\n" + dev_tasks_content,
    )

    if decision == "BLOCK" and not evidence_keys:
        return fallback

    return findings_from_keys(
        feature_key=feature_key,
        selected_keys=evidence_keys,
        templates=PRODUCT_TEMPLATES,
        template_index=PRODUCT_TEMPLATE_INDEX,
        template_by_key=PRODUCT_TEMPLATE_BY_KEY,
        prefix="PROD",
    )


def finding_payload(finding: Finding) -> Dict[str, Any]:
    return {
        "finding_id": finding.finding_id,
        "canonical_key": finding.canonical_key,
        "severity": finding.severity,
        "title": finding.title,
        "spec_guidance": finding.spec_guidance,
        "action": finding.action,
        "acceptance": finding.acceptance,
        "blocking": finding.blocking,
    }


def render_constraint_list(findings: Sequence[Finding], empty_label: str) -> List[str]:
    if not findings:
        return [f"- {empty_label}"]

    lines: List[str] = []
    for finding in findings:
        lines.append(f"- `{finding.finding_id}` {finding.title}")
        lines.append(f"  - Specification constraint: {finding.spec_guidance}")
        lines.append(f"  - Blocking: {'Yes' if finding.blocking else 'No'}")
    return lines


def render_feature_spec_block(
    security_findings: Sequence[Finding],
    product_findings: Sequence[Finding],
) -> str:
    lines: List[str] = [
        "## Automated Review Summary",
        "",
        SPEC_MARKER_START,
        "",
        "### Security Constraints",
        "",
        *render_constraint_list(
            security_findings, "No security constraints identified."
        ),
        "",
        "### Product Constraints",
        "",
        *render_constraint_list(product_findings, "No product constraints identified."),
        "",
        SPEC_MARKER_END,
        "",
    ]
    return "\n".join(lines)


def render_task_list(findings: Sequence[Finding], empty_label: str) -> List[str]:
    if not findings:
        return [f"- [ ] {empty_label}", ""]

    lines: List[str] = []
    for finding in findings:
        lines.append(f"- [ ] `{finding.finding_id}` {finding.title}")
        lines.append(f"  - Action: {finding.action}")
        lines.append(f"  - Acceptance: {finding.acceptance}")
    lines.append("")
    return lines


def render_dev_tasks_block(
    security_findings: Sequence[Finding],
    product_findings: Sequence[Finding],
) -> str:
    all_findings = [*security_findings, *product_findings]
    patcher_findings = [item for item in all_findings if item.target == TARGET_PATCHER]
    human_findings = [item for item in all_findings if item.target == TARGET_HUMAN]

    lines = [
        "## Review Findings Backlog",
        "",
        TASK_MARKER_START,
        "",
        "### Patcher Tasks",
        "",
        *render_task_list(patcher_findings, "No patcher-target findings."),
        "### Human Validation Requests (Product Owner / end-user)",
        "",
        *render_task_list(human_findings, "No human-validation requests."),
        TASK_MARKER_END,
        "",
    ]
    return "\n".join(lines)


def replace_or_insert_block(
    content: str,
    *,
    start_marker: str,
    end_marker: str,
    replacement_block: str,
    fallback_anchor: str,
) -> str:
    marker_pattern = re.compile(
        rf"{re.escape(start_marker)}.*?{re.escape(end_marker)}",
        re.DOTALL,
    )
    replacement_match = marker_pattern.search(replacement_block)
    replacement_marker_block = replacement_match.group(0) if replacement_match else ""
    if marker_pattern.search(content) and replacement_marker_block:
        return marker_pattern.sub(replacement_marker_block, content, count=1)

    anchor_pattern = re.compile(
        rf"^##\s+{re.escape(fallback_anchor)}\s*$", re.MULTILINE
    )
    match = anchor_pattern.search(content)
    insertion = replacement_block.rstrip() + "\n\n"
    if match:
        return content[: match.start()] + insertion + content[match.start() :]
    return content.rstrip() + "\n\n" + insertion


def upsert_feature_spec(content: str, block: str) -> str:
    return replace_or_insert_block(
        content,
        start_marker=SPEC_MARKER_START,
        end_marker=SPEC_MARKER_END,
        replacement_block=block,
        fallback_anchor="Change Log",
    )


def upsert_dev_tasks(content: str, block: str) -> str:
    return replace_or_insert_block(
        content,
        start_marker=TASK_MARKER_START,
        end_marker=TASK_MARKER_END,
        replacement_block=block,
        fallback_anchor="Task Breakdown",
    )


def write_text(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content.rstrip() + "\n", encoding="utf-8")


def run_schema_check(root: Path) -> None:
    cmd = [str(root / "tools" / "pc-devtasks-schema-check"), f"--root={root}"]
    result = subprocess.run(
        cmd,
        cwd=str(root),
        check=False,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if result.stdout:
        print(result.stdout, end="")
    if result.stderr:
        print(result.stderr, end="", file=sys.stderr)
    if result.returncode != 0:
        die("pc-review-features: schema validation failed after updates")


def feature_key_from_dir(feature_dir: Path) -> str:
    match = re.match(r"^(\d+)-", feature_dir.name)
    if match:
        return match.group(1).zfill(2)
    return "00"


def feature_title_from_spec(content: str, fallback_slug: str) -> str:
    for line in content.splitlines():
        if line.lower().startswith("# feature specification:"):
            return line.split(":", 1)[1].strip() or fallback_slug
    return fallback_slug


def run_review(args: argparse.Namespace) -> int:
    root = Path(args.root).resolve()
    selected = feature_dirs(root, args.feature)
    if not selected:
        die("pc-review-features: no matching feature folders found")

    ux_content = read_text(root / UX_PATH)
    if not ux_content.strip():
        print(
            "pc-review-features: warning: docs/01-product/ux-ui.md missing or empty; "
            "product alignment checks may emit findings"
        )

    updated = 0
    total_security = 0
    total_product = 0
    total_human_requests = 0
    total_blocking = 0
    features_with_findings = 0
    reviewed = 0
    skipped = 0
    skipped_completed = 0
    report_features: List[Dict[str, Any]] = []

    for feature_dir in selected:
        spec_path = feature_dir / "feature-spec.md"
        dev_tasks_path = feature_dir / "dev-tasks.md"
        if not spec_path.exists() or not dev_tasks_path.exists():
            print(
                f"pc-review-features: skipping {feature_dir.name} "
                "(missing feature-spec.md or dev-tasks.md)"
            )
            skipped += 1
            report_features.append(
                {
                    "feature_id": feature_dir.name,
                    "status": "skipped-missing-docs",
                    "security_findings": [],
                    "product_findings": [],
                    "human_validation_requests": [],
                }
            )
            continue

        spec_content = read_text(spec_path)
        dev_tasks_content = read_text(dev_tasks_path)
        feature_status = feature_status_from_dev_tasks(dev_tasks_content)
        if not args.include_completed and is_completed_status(feature_status):
            skipped += 1
            skipped_completed += 1
            print(
                f"pc-review-features: skipping {feature_dir.name} "
                f"(completed status: {feature_status or 'unknown'})"
            )
            report_features.append(
                {
                    "feature_id": feature_dir.name,
                    "status": "skipped-completed",
                    "feature_status": feature_status,
                    "security_findings": [],
                    "product_findings": [],
                    "human_validation_requests": [],
                }
            )
            continue

        analysis_spec = strip_managed_block(
            spec_content, SPEC_MARKER_START, SPEC_MARKER_END
        )
        analysis_tasks = strip_managed_block(
            dev_tasks_content, TASK_MARKER_START, TASK_MARKER_END
        )

        feature_key = feature_key_from_dir(feature_dir)
        fallback_slug = feature_dir.name.split("-", 1)[-1]
        feature_title = feature_title_from_spec(spec_content, fallback_slug)

        security_findings = run_security_role(
            root=root,
            role_mode=args.role_mode,
            feature_id=feature_dir.name,
            feature_key=feature_key,
            feature_title=feature_title,
            feature_spec_content=analysis_spec,
            dev_tasks_content=analysis_tasks,
            ux_content=ux_content,
        )
        product_findings = run_product_role(
            root=root,
            role_mode=args.role_mode,
            feature_id=feature_dir.name,
            feature_key=feature_key,
            feature_title=feature_title,
            feature_spec_content=analysis_spec,
            dev_tasks_content=analysis_tasks,
            ux_content=ux_content,
            security_findings=security_findings,
        )

        all_findings = [*security_findings, *product_findings]
        human_requests = [item for item in all_findings if item.target == TARGET_HUMAN]
        reviewed += 1
        total_security += len(security_findings)
        total_product += len(product_findings)
        total_human_requests += len(human_requests)
        total_blocking += len([item for item in all_findings if item.blocking])
        if all_findings:
            features_with_findings += 1

        spec_block = render_feature_spec_block(security_findings, product_findings)
        tasks_block = render_dev_tasks_block(security_findings, product_findings)

        next_spec = upsert_feature_spec(spec_content, spec_block)
        next_tasks = upsert_dev_tasks(dev_tasks_content, tasks_block)

        if next_spec != spec_content:
            write_text(spec_path, next_spec)
        if next_tasks != dev_tasks_content:
            write_text(dev_tasks_path, next_tasks)

        if next_spec != spec_content or next_tasks != dev_tasks_content:
            updated += 1

        report_features.append(
            {
                "feature_id": feature_dir.name,
                "status": "reviewed",
                "feature_status": feature_status,
                "feature_title": feature_title,
                "spec_path": str(spec_path.relative_to(root)),
                "dev_tasks_path": str(dev_tasks_path.relative_to(root)),
                "security_findings": [
                    finding_payload(item) for item in security_findings
                ],
                "product_findings": [
                    finding_payload(item) for item in product_findings
                ],
                "human_validation_requests": [
                    finding_payload(item) for item in human_requests
                ],
            }
        )

    report_payload = {
        "version": 3,
        "generated_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "selector": args.feature.strip() or "all",
        "role_mode": args.role_mode,
        "include_completed": bool(args.include_completed),
        "totals": {
            "features_selected": len(selected),
            "features_reviewed": reviewed,
            "features_updated": updated,
            "features_skipped": skipped,
            "features_skipped_completed": skipped_completed,
            "features_with_findings": features_with_findings,
            "security_findings": total_security,
            "product_findings": total_product,
            "human_validation_requests": total_human_requests,
            "blocking_findings": total_blocking,
        },
        "features": report_features,
        "notes": [
            "Machine-managed by tools/pc-review-features.",
            "Actionable tasks are canonical in dev-tasks.md Review Findings Backlog.",
            "feature-spec.md contains constraint summaries only (no duplicate actionable checklist).",
            "Features marked `Status: Done` are skipped by default unless --include-completed is set.",
        ],
    }
    write_text(
        root / REVIEW_REPORT_PATH,
        json.dumps(report_payload, ensure_ascii=True, indent=2, sort_keys=True),
    )
    print(f"pc-review-features: wrote report artifact -> {REVIEW_REPORT_PATH}")

    print(
        "pc-review-features: complete "
        f"(features_updated={updated}, security_findings={total_security}, "
        f"product_findings={total_product}, human_validation_requests={total_human_requests}, "
        f"skipped_completed={skipped_completed})"
    )

    if not args.skip_schema_check:
        run_schema_check(root)

    return 0


def main(argv: Optional[Sequence[str]] = None) -> int:
    args = parse_args(argv)
    return run_review(args)


if __name__ == "__main__":
    raise SystemExit(main())
