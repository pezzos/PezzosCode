@dataclass(frozen=True)
class Finding:
    finding_id: str
    severity: str
    title: str
    risk: str
    action: str
    owner: str
    phase: str
    blocking: bool
    reviewer: str


def die(message: str) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(1)


def default_role_mode() -> str:
    raw = os.environ.get("REVIEW_ROLE_MODE", ROLE_MODE_CODEX).strip().lower()
    if raw in {ROLE_MODE_CODEX, ROLE_MODE_DETERMINISTIC}:
        return raw
    return ROLE_MODE_CODEX


def parse_args(argv: Optional[Sequence[str]] = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Review feature folders for security and product risks and inject "
            "actionable findings."
        )
    )
    parser.add_argument(
        "--root",
        default=str(ROOT),
        help="Repository root (defaults to detected root).",
    )
    parser.add_argument(
        "--feature",
        default="",
        help="Optional feature selector (e.g. '01' or '01-alpha-feature').",
    )
    parser.add_argument(
        "--role-mode",
        choices=(ROLE_MODE_CODEX, ROLE_MODE_DETERMINISTIC),
        default=default_role_mode(),
        help=(
            "Role execution mode for Security Expert/Product Manager review steps. "
            "'codex' runs prompt-driven role execution; "
            "'deterministic' uses local fallback heuristics."
        ),
    )
    parser.add_argument(
        "--skip-schema-check",
        action="store_true",
        help="Skip tools/pc-devtasks-schema-check after updates.",
    )
    return parser.parse_args(argv)


def feature_dirs(root: Path, selector: str) -> List[Path]:
    features_root = root / FEATURES_DIR
    if not features_root.exists():
        return []
    selected: List[Path] = []
    normalized = selector.strip()
    for entry in sorted(features_root.iterdir(), key=lambda item: item.name):
        if not entry.is_dir():
            continue
        if entry.name == "feature-template":
            continue
        if not re.match(r"^\d+-", entry.name):
            continue
        if normalized:
            if entry.name == normalized or entry.name.startswith(f"{normalized}-"):
                selected.append(entry)
            continue
        selected.append(entry)
    return selected


def read_text(path: Path) -> str:
    return path.read_text(encoding="utf-8") if path.exists() else ""


def strip_managed_block(content: str, start_marker: str, end_marker: str) -> str:
    pattern = re.compile(
        rf"{re.escape(start_marker)}.*?{re.escape(end_marker)}",
        re.DOTALL,
    )
    return pattern.sub("", content)


def contains_any(text: str, keywords: Iterable[str]) -> bool:
    lowered = text.lower()
    return any(keyword in lowered for keyword in keywords)


def count_functional_requirements(feature_spec: str) -> int:
    patterns = [
        r"\*\*Requirement\s+\d+",  # markdown bold style
        r"^- \[ \]\s+\*\*Requirement",  # checklist style
    ]
    total = 0
    for pattern in patterns:
        total += len(re.findall(pattern, feature_spec, re.MULTILINE | re.IGNORECASE))
    return total


def normalize_severity(raw: Any, default: str = SEVERITY_MEDIUM) -> str:
    token = str(raw).strip().lower()
    if token in {"high", "sev1", "critical", "blocker"}:
        return SEVERITY_HIGH
    if token in {"low", "sev3"}:
        return SEVERITY_LOW
    if token in {"medium", "med", "sev2"}:
        return SEVERITY_MEDIUM
    return default


def normalize_owner(raw: Any, default: str = OWNER_PATCHER) -> str:
    token = str(raw).strip().lower()
    if token in {OWNER_HUMAN, "product-owner", "po", "manual", "end-user"}:
        return OWNER_HUMAN
    if token in {OWNER_PATCHER, "developer", "engineer", "codex"}:
        return OWNER_PATCHER
    return default


def normalize_phase(raw: Any, default: str = PHASE_PATCH) -> str:
    token = str(raw).strip().lower()
    if token in {PHASE_PATCH, "implementation", "develop", "development"}:
        return PHASE_PATCH
    if token in {
        PHASE_AUTOMATED_TEST,
        "automated",
        "tests",
        "test",
        "tester",
    }:
        return PHASE_AUTOMATED_TEST
    if token in {PHASE_HUMAN_VALIDATION, "human", "manual", "acceptance"}:
        return PHASE_HUMAN_VALIDATION
    return default


def normalize_blocking(raw: Any, default: bool = False) -> bool:
    if isinstance(raw, bool):
        return raw
    token = str(raw).strip().lower()
    if token in {"true", "yes", "y", "1", "block", "blocking"}:
        return True
    if token in {"false", "no", "n", "0", "non-blocking"}:
        return False
    return default


def extract_json_payload(raw: str) -> str:
    start = raw.find("{")
    end = raw.rfind("}")
    if start == -1 or end == -1 or end < start:
        return raw
    return raw[start : end + 1]


def load_prompt_template(root: Path, prompt_rel_path: Path) -> str:
    prompt_path = root / prompt_rel_path
    if not prompt_path.exists():
        die(
            "pc-review-features: missing prompt template "
            f"{prompt_path}; restore prompts under {root / PROMPTS_DIR}"
        )
    return prompt_path.read_text(encoding="utf-8")


def render_prompt_template(template: str, values: Dict[str, str]) -> str:
    class StrictMap(dict):
        def __missing__(self, key):
            die(f"pc-review-features: prompt template missing value for '{key}'")
            return ""

    return template.format_map(StrictMap(values))


def truncate_for_error(raw: str, max_chars: int = 800) -> str:
    compact = re.sub(r"\s+", " ", raw.strip())
    if len(compact) <= max_chars:
        return compact
    return compact[:max_chars].rstrip() + "..."


def codex_exec_json(
    *,
    root: Path,
    prompt: str,
    profile: str,
    label: str,
) -> Dict[str, Any]:
    if shutil.which("codex") is None:
        raise RuntimeError("codex CLI not found in PATH")

    cmd = ["codex", "-C", str(root), "--profile", profile, "exec", prompt]
    result = subprocess.run(
        cmd,
        cwd=str(root),
        check=False,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if result.returncode != 0:
        combined = "\n".join(part for part in [result.stdout, result.stderr] if part)
        raise RuntimeError(
            f"{label} role execution failed with exit {result.returncode}: "
            f"{truncate_for_error(combined)}"
        )
    payload = extract_json_payload(result.stdout or "")
    try:
        data = json.loads(payload)
    except json.JSONDecodeError as exc:
        raise RuntimeError(
            f"{label} role returned non-JSON output: {truncate_for_error(result.stdout or '')}"
        ) from exc
    if not isinstance(data, dict):
        raise RuntimeError(f"{label} role JSON payload must be an object")
    return data


def build_security_findings(feature_key: str, content: str) -> List[Finding]:
    checks = [
        (
            "001",
            SEVERITY_HIGH,
            "Input validation controls are not explicit",
            "Unvalidated input can trigger data corruption or unsafe behavior.",
            "Add explicit validation rules, error paths, and anti-bypass tests in feature-spec and dev-tasks.",
            ("input validation", "sanitize", "schema validation", "validated"),
            OWNER_PATCHER,
            PHASE_PATCH,
            True,
        ),
        (
            "002",
            SEVERITY_HIGH,
            "Authentication/authorization expectations are missing",
            "Access controls may be implemented inconsistently or omitted.",
            "Specify authN/authZ requirements, denied-path behavior, and least-privilege checks.",
            ("authentication", "authorization", "auth", "permission"),
            OWNER_PATCHER,
            PHASE_PATCH,
            True,
        ),
        (
            "003",
            SEVERITY_MEDIUM,
            "Secrets handling is not documented",
            "Credentials or tokens may leak into code, logs, or config.",
            "Document secret sources, redaction strategy, and prohibited storage locations.",
            ("secret", "credential", "token", "redact"),
            OWNER_PATCHER,
            PHASE_AUTOMATED_TEST,
            True,
        ),
        (
            "004",
            SEVERITY_HIGH,
            "Injection defenses are not explicit",
            "Missing injection controls can expose command, SQL, or script injection paths.",
            "Define escaping/parameterization requirements and add dedicated injection test scenarios.",
            ("injection", "xss", "sql", "escape", "parameterized"),
            OWNER_PATCHER,
            PHASE_PATCH,
            True,
        ),
        (
            "005",
            SEVERITY_MEDIUM,
            "Infrastructure misconfiguration guardrails are missing",
            "Unsafe defaults can bypass intended runtime protections.",
            "Capture required config defaults, permission boundaries, and misconfiguration failure behavior.",
            ("misconfiguration", "configuration", "fail-close", "least privilege"),
            OWNER_PATCHER,
            PHASE_PATCH,
            False,
        ),
    ]

    findings: List[Finding] = []
    for (
        suffix,
        severity,
        title,
        risk,
        action,
        keywords,
        owner,
        phase,
        blocking,
    ) in checks:
        if contains_any(content, keywords):
            continue
        findings.append(
            Finding(
                finding_id=f"SEC-{feature_key}-{suffix}",
                severity=severity,
                title=title,
                risk=risk,
                action=action,
                owner=owner,
                phase=phase,
                blocking=blocking,
                reviewer=REVIEWER_SECURITY,
            )
        )
    return findings


def build_product_findings(
    feature_key: str,
    feature_title: str,
    feature_spec_content: str,
    dev_tasks_content: str,
    ux_content: str,
) -> List[Finding]:
    findings: List[Finding] = []

    requirements_count = count_functional_requirements(feature_spec_content)
    if requirements_count < 2:
        findings.append(
            Finding(
                finding_id=f"PROD-{feature_key}-001",
                severity=SEVERITY_HIGH,
                title="Functional scope is under-specified",
                risk="Key product capabilities may be missed during implementation.",
                action="Expand functional requirements to cover primary and edge behaviors with acceptance criteria.",
                owner=OWNER_PATCHER,
                phase=PHASE_PATCH,
                blocking=True,
                reviewer=REVIEWER_PM,
            )
        )

    if not contains_any(
        feature_spec_content, ("user flow", "detailed steps", "journey")
    ):
        findings.append(
            Finding(
                finding_id=f"PROD-{feature_key}-002",
                severity=SEVERITY_MEDIUM,
                title="User journey details are missing in feature docs",
                risk="Implementation may diverge from intended user path and onboarding flow.",
                action="Add explicit user journey steps, entry points, and completion states.",
                owner=OWNER_PATCHER,
                phase=PHASE_PATCH,
                blocking=True,
                reviewer=REVIEWER_PM,
            )
        )

    if feature_title.lower() not in ux_content.lower():
        findings.append(
            Finding(
                finding_id=f"PROD-{feature_key}-003",
                severity=SEVERITY_MEDIUM,
                title="Global UX blueprint does not reference this feature",
                risk="Cross-feature workflow alignment may be inconsistent for end users.",
                action=f"Ask the Product Owner to validate and update `docs/01-product/ux-ui.md` with '{feature_title}' journey/workflow coverage before final sign-off.",
                owner=OWNER_HUMAN,
                phase=PHASE_HUMAN_VALIDATION,
                blocking=False,
                reviewer=REVIEWER_PM,
            )
        )

    if not contains_any(feature_spec_content, ("workflow", "flow")):
        findings.append(
            Finding(
                finding_id=f"PROD-{feature_key}-004",
                severity=SEVERITY_MEDIUM,
                title="Workflow definition is incomplete",
                risk="Execution order and handoff expectations may be unclear for delivery.",
                action="Define end-to-end workflow states, system responses, and handoff boundaries.",
                owner=OWNER_PATCHER,
                phase=PHASE_PATCH,
                blocking=True,
                reviewer=REVIEWER_PM,
            )
        )

    if (
        "product owner" not in dev_tasks_content.lower()
        and "po test" not in dev_tasks_content.lower()
    ):
        findings.append(
            Finding(
                finding_id=f"PROD-{feature_key}-005",
                severity=SEVERITY_LOW,
                title="PO validation checkpoint is missing",
                risk="End-user acceptance timing may be unclear before completion.",
                action="Add a Product Owner end-user validation checkpoint task in dev-tasks before completion.",
                owner=OWNER_HUMAN,
                phase=PHASE_HUMAN_VALIDATION,
                blocking=False,
                reviewer=REVIEWER_PM,
            )
        )

    return findings


def normalize_role_findings(
    *,
    raw_findings: Any,
    prefix: str,
    feature_key: str,
    reviewer: str,
    default_owner: str,
    default_phase: str,
) -> Optional[List[Finding]]:
    if not isinstance(raw_findings, list):
        return None

    normalized: List[Finding] = []
    for idx, item in enumerate(raw_findings, start=1):
        if not isinstance(item, dict):
            continue
        finding_id = str(item.get("finding_id", "")).strip()
        if not finding_id:
            finding_id = f"{prefix}-{feature_key}-{idx:03d}"
        severity = normalize_severity(item.get("severity"), default=SEVERITY_MEDIUM)
        title = str(item.get("title", "")).strip() or "Untitled finding"
        risk = str(item.get("risk", "")).strip() or "Risk not specified."
        action = str(item.get("action", "")).strip() or "Action not specified."
        owner = normalize_owner(item.get("owner"), default=default_owner)
        phase = normalize_phase(item.get("phase"), default=default_phase)
        blocking_default = severity == SEVERITY_HIGH
        blocking = normalize_blocking(item.get("blocking"), default=blocking_default)
        normalized.append(
            Finding(
                finding_id=finding_id,
                severity=severity,
                title=title,
                risk=risk,
                action=action,
                owner=owner,
                phase=phase,
                blocking=blocking,
                reviewer=reviewer,
            )
        )
    return normalized


def run_security_role(
    *,
    root: Path,
    role_mode: str,
    feature_id: str,
    feature_key: str,
    feature_title: str,
    feature_spec_content: str,
    dev_tasks_content: str,
    ux_content: str,
) -> List[Finding]:
    fallback = build_security_findings(
        feature_key,
        feature_spec_content + "\n" + dev_tasks_content,
    )
    if role_mode == ROLE_MODE_DETERMINISTIC:
        return fallback

    template = load_prompt_template(root, SECURITY_PROMPT_PATH)
    prompt = render_prompt_template(
        template,
        {
            "feature_id": feature_id,
            "feature_key": feature_key,
            "feature_title": feature_title,
            "feature_spec_markdown": feature_spec_content,
            "dev_tasks_markdown": dev_tasks_content,
            "ux_blueprint_markdown": ux_content,
        },
    )
    try:
        payload = codex_exec_json(
            root=root,
            prompt=prompt,
            profile=os.environ.get("REVIEW_SECURITY_PROFILE", "SecurityExpert"),
            label="security-expert",
        )
    except RuntimeError as exc:
        print(
            "pc-review-features: warning: Security Expert role failed for "
            f"{feature_id}; using deterministic findings ({exc})"
        )
        return fallback

    decision = str(payload.get("decision", "APPROVE")).strip().upper()
    if decision not in {"APPROVE", "BLOCK"}:
        print(
            "pc-review-features: warning: Security Expert returned invalid decision "
            f"for {feature_id}; using deterministic findings"
        )
        return fallback

    normalized = normalize_role_findings(
        raw_findings=payload.get("findings"),
        prefix="SEC",
        feature_key=feature_key,
        reviewer=REVIEWER_SECURITY,
        default_owner=OWNER_PATCHER,
        default_phase=PHASE_PATCH,
    )
    if normalized is None:
        print(
            "pc-review-features: warning: Security Expert findings payload invalid "
            f"for {feature_id}; using deterministic findings"
        )
        return fallback
    if decision == "BLOCK" and not normalized:
        print(
            "pc-review-features: warning: Security Expert returned BLOCK without "
            f"findings for {feature_id}; using deterministic findings"
        )
        return fallback
    return normalized


def run_product_role(
    *,
    root: Path,
    role_mode: str,
    feature_id: str,
    feature_key: str,
    feature_title: str,
    feature_spec_content: str,
    dev_tasks_content: str,
    ux_content: str,
    security_findings: Sequence[Finding],
) -> List[Finding]:
    fallback = build_product_findings(
        feature_key,
        feature_title,
        feature_spec_content,
        dev_tasks_content,
        ux_content,
    )
    if role_mode == ROLE_MODE_DETERMINISTIC:
        return fallback

    template = load_prompt_template(root, PRODUCT_PROMPT_PATH)
    prompt = render_prompt_template(
        template,
        {
            "feature_id": feature_id,
            "feature_key": feature_key,
            "feature_title": feature_title,
            "feature_spec_markdown": feature_spec_content,
            "dev_tasks_markdown": dev_tasks_content,
            "ux_blueprint_markdown": ux_content,
            "security_findings_json": json.dumps(
                [finding_payload(item) for item in security_findings],
                ensure_ascii=True,
                indent=2,
                sort_keys=True,
            ),
        },
    )
    try:
        payload = codex_exec_json(
            root=root,
            prompt=prompt,
            profile=os.environ.get("REVIEW_PM_PROFILE", "ProductManager"),
            label="product-manager-review",
        )
    except RuntimeError as exc:
        print(
            "pc-review-features: warning: Product Manager role failed for "
            f"{feature_id}; using deterministic findings ({exc})"
        )
        return fallback

    decision = str(payload.get("decision", "APPROVE")).strip().upper()
    if decision not in {"APPROVE", "BLOCK"}:
        print(
            "pc-review-features: warning: Product Manager returned invalid decision "
            f"for {feature_id}; using deterministic findings"
        )
        return fallback

    normalized = normalize_role_findings(
        raw_findings=payload.get("findings"),
        prefix="PROD",
        feature_key=feature_key,
        reviewer=REVIEWER_PM,
        default_owner=OWNER_PATCHER,
        default_phase=PHASE_PATCH,
    )
    if normalized is None:
        print(
            "pc-review-features: warning: Product Manager findings payload invalid "
            f"for {feature_id}; using deterministic findings"
        )
        return fallback
    if decision == "BLOCK" and not normalized:
        print(
            "pc-review-features: warning: Product Manager returned BLOCK without "
            f"findings for {feature_id}; using deterministic findings"
        )
        return fallback
    return normalized


def reviewer_label(reviewer: str) -> str:
    if reviewer == REVIEWER_SECURITY:
        return "Security Expert"
    if reviewer == REVIEWER_PM:
        return "Product Manager"
    return reviewer


def finding_payload(finding: Finding) -> Dict[str, Any]:
    return {
        "finding_id": finding.finding_id,
        "severity": finding.severity,
        "title": finding.title,
        "risk": finding.risk,
        "action": finding.action,
        "owner": finding.owner,
        "phase": finding.phase,
        "blocking": finding.blocking,
        "reviewer": finding.reviewer,
    }


def render_findings_table(findings: Sequence[Finding]) -> List[str]:
    if not findings:
        return ["- No findings."]
    rows = [
        "| ID | Severity | Owner | Phase | Blocking | Title | Risk | Action |",
        "| -- | -------- | ----- | ----- | -------- | ----- | ---- | ------ |",
    ]
    for finding in findings:
        blocking = "Yes" if finding.blocking else "No"
        rows.append(
            "| "
            + f"{finding.finding_id} | {finding.severity} | {finding.owner} | "
            + f"{finding.phase} | {blocking} | {finding.title} | "
            + f"{finding.risk} | {finding.action} |"
        )
    return rows


def render_feature_spec_block(
    security_findings: Sequence[Finding],
    product_findings: Sequence[Finding],
) -> str:
    lines: List[str] = [
        "## Automated Review Findings",
        "",
        SPEC_MARKER_START,
        "",
        "### Security Expert",
        "",
        *render_findings_table(security_findings),
        "",
        "### Product Manager (End-User Feedback)",
        "",
        *render_findings_table(product_findings),
        "",
        SPEC_MARKER_END,
        "",
    ]
    return "\n".join(lines)


def render_finding_checklist(
    findings: Sequence[Finding], empty_label: str, *, include_blocking: bool = True
) -> List[str]:
    if not findings:
        return [f"- [ ] {empty_label}", ""]

    lines: List[str] = []
    for finding in findings:
        lines.append(f"- [ ] `{finding.finding_id}` {finding.title}")
        lines.append(f"  - Reviewer: {reviewer_label(finding.reviewer)}")
        lines.append(f"  - Severity: {finding.severity}")
        lines.append(f"  - Phase: {finding.phase}")
        if include_blocking:
            lines.append(f"  - Blocking: {'Yes' if finding.blocking else 'No'}")
        lines.append(f"  - Action: {finding.action}")
    lines.append("")
    return lines


def render_dev_tasks_block(
    security_findings: Sequence[Finding],
    product_findings: Sequence[Finding],
) -> str:
    all_findings = list(security_findings) + list(product_findings)
    patcher_findings = [item for item in all_findings if item.owner == OWNER_PATCHER]
    human_findings = [item for item in all_findings if item.owner == OWNER_HUMAN]

    lines = [
        "## Review Findings Backlog",
        "",
        TASK_MARKER_START,
        "",
        "### Patcher Tasks (must be handled during patch/test steps)",
        "",
        *render_finding_checklist(
            patcher_findings,
            "No patcher-target findings.",
        ),
        "### Human Validation Requests (Product Owner / end-user)",
        "",
        *render_finding_checklist(
            human_findings,
            "No human-validation requests.",
            include_blocking=False,
        ),
        TASK_MARKER_END,
        "",
    ]
    return "\n".join(lines)


def replace_or_insert_block(
    content: str,
    *,
    start_marker: str,
    end_marker: str,
    replacement_block: str,
    fallback_anchor: str,
) -> str:
    marker_pattern = re.compile(
        rf"{re.escape(start_marker)}.*?{re.escape(end_marker)}",
        re.DOTALL,
    )
    replacement_match = marker_pattern.search(replacement_block)
    replacement_marker_block = replacement_match.group(0) if replacement_match else ""
    if marker_pattern.search(content) and replacement_marker_block:
        return marker_pattern.sub(replacement_marker_block, content, count=1)

    anchor_pattern = re.compile(
        rf"^##\s+{re.escape(fallback_anchor)}\s*$", re.MULTILINE
    )
    match = anchor_pattern.search(content)
    insertion = replacement_block.rstrip() + "\n\n"
    if match:
        return content[: match.start()] + insertion + content[match.start() :]
    return content.rstrip() + "\n\n" + insertion


def upsert_feature_spec(content: str, block: str) -> str:
    return replace_or_insert_block(
        content,
        start_marker=SPEC_MARKER_START,
        end_marker=SPEC_MARKER_END,
        replacement_block=block,
        fallback_anchor="Change Log",
    )


def upsert_dev_tasks(content: str, block: str) -> str:
    return replace_or_insert_block(
        content,
        start_marker=TASK_MARKER_START,
        end_marker=TASK_MARKER_END,
        replacement_block=block,
        fallback_anchor="Task Breakdown",
    )


def write_text(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content.rstrip() + "\n", encoding="utf-8")


def run_schema_check(root: Path) -> None:
    cmd = [str(root / "tools" / "pc-devtasks-schema-check"), f"--root={root}"]
    result = subprocess.run(
        cmd,
        cwd=str(root),
        check=False,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if result.stdout:
        print(result.stdout, end="")
    if result.stderr:
        print(result.stderr, end="", file=sys.stderr)
    if result.returncode != 0:
        die("pc-review-features: schema validation failed after updates")


def feature_key_from_dir(feature_dir: Path) -> str:
    match = re.match(r"^(\d+)-", feature_dir.name)
    if match:
        return match.group(1).zfill(2)
    return "00"


def feature_title_from_spec(content: str, fallback_slug: str) -> str:
    for line in content.splitlines():
        if line.lower().startswith("# feature specification:"):
            return line.split(":", 1)[1].strip() or fallback_slug
    return fallback_slug


def run_review(args: argparse.Namespace) -> int:
    root = Path(args.root).resolve()
    selected = feature_dirs(root, args.feature)
    if not selected:
        die("pc-review-features: no matching feature folders found")

    ux_content = read_text(root / UX_PATH)
    if not ux_content.strip():
        print(
            "pc-review-features: warning: docs/01-product/ux-ui.md missing or empty; "
            "product alignment checks will emit findings"
        )

    updated = 0
    total_security = 0
    total_product = 0
    total_patcher = 0
    total_human = 0
    features_with_findings = 0
    reviewed = 0
    skipped = 0
    report_features: List[Dict[str, Any]] = []

    for feature_dir in selected:
        spec_path = feature_dir / "feature-spec.md"
        dev_tasks_path = feature_dir / "dev-tasks.md"
        if not spec_path.exists() or not dev_tasks_path.exists():
            print(
                f"pc-review-features: skipping {feature_dir.name} "
                "(missing feature-spec.md or dev-tasks.md)"
            )
            skipped += 1
            report_features.append(
                {
                    "feature_id": feature_dir.name,
                    "status": "skipped-missing-docs",
                    "security_findings": [],
                    "product_findings": [],
                }
            )
            continue

        spec_content = read_text(spec_path)
        dev_tasks_content = read_text(dev_tasks_path)

        analysis_spec = strip_managed_block(
            spec_content, SPEC_MARKER_START, SPEC_MARKER_END
        )
        analysis_tasks = strip_managed_block(
            dev_tasks_content, TASK_MARKER_START, TASK_MARKER_END
        )

        feature_key = feature_key_from_dir(feature_dir)
        fallback_slug = feature_dir.name.split("-", 1)[-1]
        feature_title = feature_title_from_spec(spec_content, fallback_slug)

        security_findings = run_security_role(
            root=root,
            role_mode=args.role_mode,
            feature_id=feature_dir.name,
            feature_key=feature_key,
            feature_title=feature_title,
            feature_spec_content=analysis_spec,
            dev_tasks_content=analysis_tasks,
            ux_content=ux_content,
        )
        product_findings = run_product_role(
            root=root,
            role_mode=args.role_mode,
            feature_id=feature_dir.name,
            feature_key=feature_key,
            feature_title=feature_title,
            feature_spec_content=analysis_spec,
            dev_tasks_content=analysis_tasks,
            ux_content=ux_content,
            security_findings=security_findings,
        )

        all_findings = [*security_findings, *product_findings]
        reviewed += 1
        total_security += len(security_findings)
        total_product += len(product_findings)
        total_patcher += len(
            [item for item in all_findings if item.owner == OWNER_PATCHER]
        )
        total_human += len([item for item in all_findings if item.owner == OWNER_HUMAN])
        if all_findings:
            features_with_findings += 1

        spec_block = render_feature_spec_block(security_findings, product_findings)
        tasks_block = render_dev_tasks_block(security_findings, product_findings)

        next_spec = upsert_feature_spec(spec_content, spec_block)
        next_tasks = upsert_dev_tasks(dev_tasks_content, tasks_block)

        if next_spec != spec_content:
            write_text(spec_path, next_spec)
        if next_tasks != dev_tasks_content:
            write_text(dev_tasks_path, next_tasks)

        if next_spec != spec_content or next_tasks != dev_tasks_content:
            updated += 1

        report_features.append(
            {
                "feature_id": feature_dir.name,
                "status": "reviewed",
                "feature_title": feature_title,
                "spec_path": str(spec_path.relative_to(root)),
                "dev_tasks_path": str(dev_tasks_path.relative_to(root)),
                "security_findings": [
                    finding_payload(item) for item in security_findings
                ],
                "product_findings": [
                    finding_payload(item) for item in product_findings
                ],
            }
        )

    report_payload = {
        "version": 2,
        "generated_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "selector": args.feature.strip() or "all",
        "role_mode": args.role_mode,
        "totals": {
            "features_selected": len(selected),
            "features_reviewed": reviewed,
            "features_updated": updated,
            "features_skipped": skipped,
            "features_with_findings": features_with_findings,
            "security_findings": total_security,
            "product_findings": total_product,
            "patcher_findings": total_patcher,
            "human_findings": total_human,
        },
        "features": report_features,
        "notes": [
            "Machine-managed by tools/pc-review-features.",
            "Actionable findings are mirrored into feature-spec.md and dev-tasks.md.",
            "Review order is Security Expert first, then Product Manager.",
        ],
    }
    write_text(
        root / REVIEW_REPORT_PATH,
        json.dumps(report_payload, ensure_ascii=True, indent=2, sort_keys=True),
    )
    print(f"pc-review-features: wrote report artifact -> {REVIEW_REPORT_PATH}")

    print(
        "pc-review-features: complete "
        f"(features_updated={updated}, security_findings={total_security}, "
        f"product_findings={total_product}, patcher_findings={total_patcher}, "
        f"human_findings={total_human})"
    )

    if not args.skip_schema_check:
        run_schema_check(root)

    return 0


def main(argv: Optional[Sequence[str]] = None) -> int:
    args = parse_args(argv)
    return run_review(args)


if __name__ == "__main__":
    raise SystemExit(main())
