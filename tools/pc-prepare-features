def feature_semantic_tokens(feature: Feature) -> List[str]:
    raw = f"{feature.outcome} {feature.notes}".strip().lower()
    if not raw:
        return []
    candidates = re.findall(r"[a-z0-9]{4,}", raw)
    stop_tokens = {
        "feature",
        "features",
        "deliver",
        "workflow",
        "workflows",
        "project",
        "system",
        "process",
        "prepare",
        "review",
        "execute",
        "priority",
        "notes",
    }
    ordered: List[str] = []
    for token in candidates:
        if token in stop_tokens:
            continue
        if token in ordered:
            continue
        ordered.append(token)
        if len(ordered) >= 5:
            break
    return ordered


