def build_order_payload(
    *,
    ordered_slugs: Sequence[str],
    features: Sequence[Feature],
    graph: Dict[str, Set[str]],
    decisions: Sequence[Dict[str, Any]],
) -> Dict[str, object]:
    def ordered_unique(items: Sequence[str]) -> List[str]:
        seen: Set[str] = set()
        output: List[str] = []
        for item in items:
            token = str(item).strip()
            if not token or token in seen:
                continue
            seen.add(token)
            output.append(token)
        return output

    def parse_token_list(raw: Any) -> List[str]:
        if isinstance(raw, (list, tuple, set)):
            return ordered_unique([str(item) for item in raw])
        if isinstance(raw, str):
            token = raw.strip()
            if not token or token.lower() in {"none", "n/a", "na", "-", "[]"}:
                return []
            parsed: Optional[Any] = None
            if token.startswith("[") and token.endswith("]"):
                try:
                    parsed = json.loads(token)
                except json.JSONDecodeError:
                    try:
                        parsed = ast.literal_eval(token)
                    except (SyntaxError, ValueError):
                        parsed = None
            if isinstance(parsed, (list, tuple, set)):
                return ordered_unique([str(item) for item in parsed])
            return ordered_unique(re.split(r"[,\|;/]", token))
        return []

    def normalize_dependency_list(
        raw: Any, *, allowed_slugs: Set[str], feature_slug: str
    ) -> List[str]:
        normalized: List[str] = []
        for token in parse_token_list(raw):
            candidate = token.strip()
            if not candidate:
                continue
            slug = candidate if candidate in allowed_slugs else compact_slug(candidate)
            if not slug or slug == feature_slug or slug not in allowed_slugs:
                continue
            if slug in normalized:
                continue
            normalized.append(slug)
        return normalized

    def normalize_reason_codes(raw: Any) -> List[str]:
        normalized: List[str] = []
        for token in parse_token_list(raw):
            code = re.sub(r"[^a-zA-Z0-9_]+", "_", token.strip().upper()).strip("_")
            if not code or code in normalized:
                continue
            normalized.append(code)
        return normalized

    canonical_slugs = [slug for slug in ordered_slugs if str(slug).strip()]
    all_slugs = set(canonical_slugs)
    raw_decisions_by_slug: Dict[str, Dict[str, Any]] = {}
    for item in decisions:
        if not isinstance(item, dict):
            continue
        raw_slug = str(item.get("feature_slug", "")).strip()
        if not raw_slug:
            continue
        slug = raw_slug if raw_slug in all_slugs else compact_slug(raw_slug)
        if not slug or slug not in all_slugs:
            continue
        raw_decisions_by_slug[slug] = dict(item)

    by_slug = {feature.slug: feature for feature in features}
    dependencies_payload: Dict[str, List[str]] = {}
    canonical_decisions: List[Dict[str, Any]] = []
    ordered_features_payload = []
    for idx, slug in enumerate(canonical_slugs, start=1):
        feature = by_slug[slug]
        raw_decision = raw_decisions_by_slug.get(slug, {})
        fallback_deps = sorted(graph.get(slug, set()))
        depends_on = normalize_dependency_list(
            raw_decision.get("depends_on", fallback_deps),
            allowed_slugs=all_slugs,
            feature_slug=slug,
        )
        dependencies_payload[slug] = depends_on
        reason_codes = normalize_reason_codes(raw_decision.get("reason_codes", []))
        if not reason_codes:
            reason_codes = (
                ["ROOT"] if not depends_on else ["ORDERED", "HAS_DEPENDENCIES"]
            )
        rationale = str(raw_decision.get("rationale", "")).strip()
        if not rationale:
            if depends_on:
                rationale = (
                    "Sequenced after prerequisites: " + ", ".join(depends_on) + "."
                )
            else:
                rationale = "Root feature with no prerequisite dependencies."
        canonical_decision = dict(raw_decision)
        canonical_decision["id"] = str(raw_decision.get("id", "")).strip() or (
            f"order-{idx:03d}"
        )
        canonical_decision["order_index"] = idx
        canonical_decision["feature_slug"] = slug
        canonical_decision["depends_on"] = depends_on
        canonical_decision["rationale"] = rationale
        canonical_decision["reason_codes"] = reason_codes
        canonical_decisions.append(canonical_decision)
        ordered_features_payload.append(
            {
                "index": idx,
                "slug": feature.slug,
                "title": feature.title,
                "priority": feature.priority,
                "dependencies": depends_on,
            }
        )

    return {
        "version": 1,
        "generated_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "ordered_feature_slugs": canonical_slugs,
        "dependencies": dependencies_payload,
        "ordered_features": ordered_features_payload,
        "decisions": canonical_decisions,
        "notes": [
            "This file is machine-managed by tools/pc-prepare-features.",
            "tools/prd-to-features consumes ordered_feature_slugs to preserve dependency order.",
        ],
    }


def order_markdown(payload: Dict[str, object]) -> str:
    rows = [
        "# Feature Order Plan",
        "",
        "> Machine-managed by `tools/pc-prepare-features`.",
        "",
        f"**Generated At (UTC):** {payload.get('generated_at', '')}",
        "",
        "## Ordered features",
        "",
        "| # | Priority | Slug | Title | Dependencies |",
        "| - | -------- | ---- | ----- | ------------ |",
    ]
    for item in payload.get("ordered_features", []):
        if not isinstance(item, dict):
            continue
        deps = item.get("dependencies", [])
        deps_text = ", ".join(deps) if isinstance(deps, list) and deps else "(none)"
        rows.append(
            "| {index:02d} | {priority} | {slug} | {title} | {deps} |".format(
                index=int(item.get("index", 0)),
                priority=str(item.get("priority", "")),
                slug=str(item.get("slug", "")),
                title=str(item.get("title", "")),
                deps=deps_text,
            )
        )

    decisions = payload.get("decisions", [])
    rows.extend(["", "## Decisions", ""])
    if not isinstance(decisions, list) or not decisions:
        rows.append("- No manual decision overrides were required.")
    else:
        for decision in decisions:
            if not isinstance(decision, dict):
                continue
            if decision.get("issue_id"):
                rows.append(
                    "- `{issue}` ({type}): selected `{selected}`; risk: {risk}".format(
                        issue=decision.get("issue_id", "unknown"),
                        type=decision.get("type", "decision"),
                        selected=decision.get("selected", ""),
                        risk=decision.get("risk", ""),
                    )
                )
                continue
            deps = decision.get("depends_on", [])
            deps_text = ", ".join(deps) if isinstance(deps, list) and deps else "(none)"
            rows.append(
                "- `{slug}`: depends_on={deps}; rationale: {rationale}".format(
                    slug=decision.get("feature_slug", "unknown"),
                    deps=deps_text,
                    rationale=decision.get("rationale", ""),
                )
            )

    rows.append("")
    return "\n".join(rows)


def check_required_headings(content: str, headings: Sequence[str]) -> List[str]:
    missing = []
    lowered = content.lower()
    for heading in headings:
        needle = f"## {heading}".lower()
        if needle not in lowered:
            missing.append(heading)
    return missing


def dependency_order_violations(
    ordered_slugs: Sequence[str], graph: Dict[str, Set[str]]
) -> List[str]:
    position = {slug: idx for idx, slug in enumerate(ordered_slugs, start=1)}
    violations: List[str] = []
    for feature_slug, deps in graph.items():
        current_pos = position.get(feature_slug)
        if current_pos is None:
            continue
        for dep in sorted(deps):
            dep_pos = position.get(dep)
            if dep_pos is None:
                continue
            if dep_pos > current_pos:
                violations.append(
                    f"dependency order violation: {feature_slug} depends on {dep} but appears earlier"
                )
    return violations


def generic_signal_issues(design_text: str, ux_text: str) -> List[Dict[str, str]]:
    issues: List[Dict[str, str]] = []
    text_by_step = {"architect": design_text, "ux": ux_text}
    for step, content in text_by_step.items():
        matched = [marker for marker in GENERIC_SIGNAL_MARKERS if marker in content]
        if not matched:
            continue
        preview = ", ".join(f"`{marker}`" for marker in matched[:3])
        issues.append(
            {
                "step": step,
                "summary": (
                    "Generated artifact contains generic template markers "
                    f"({preview})."
                ),
                "risk": "Artifact appears tooling-centric instead of project-specific.",
                "remediation": (
                    "Regenerate with project-specific architecture/journey content "
                    "derived from PRD outcomes and context constraints."
                ),
            }
        )
    return issues


def product_manager_review(
    *,
    features: Sequence[Feature],
    ordered_slugs: Sequence[str],
    graph: Dict[str, Set[str]],
    design_text: str,
    ux_text: str,
    order_payload: Dict[str, object],
    pm_role_payload: Dict[str, Any],
    seed_issues: Sequence[Dict[str, str]],
    enforce_semantic_gate: bool = True,
) -> List[ReviewIssue]:
    issues: List[ReviewIssue] = []
    issue_count = 1

    def add_issue(
        *,
        step: str,
        summary: str,
        risk: str,
        remediation: str,
    ) -> None:
        nonlocal issue_count
        issues.append(
            ReviewIssue(
                issue_id=f"PM-{issue_count:03d}",
                step=normalize_prepare_step(step, default=STEP_PRODUCT_MANAGER),
                summary=summary,
                risk=risk,
                remediation=remediation,
            )
        )
        issue_count += 1

    for seeded in seed_issues:
        add_issue(
            step=str(seeded.get("step", STEP_PRODUCT_MANAGER)).strip()
            or STEP_PRODUCT_MANAGER,
            summary=str(seeded.get("summary", "")).strip()
            or "Missing seeded issue summary.",
            risk=str(seeded.get("risk", "")).strip()
            or "Seeded issue missing risk context.",
            remediation=str(seeded.get("remediation", "")).strip()
            or "Add explicit remediation details for the seeded issue.",
        )

    required_design_headings = (
        "System architecture",
        "Module boundaries",
        "Infra considerations",
        "Design constraints",
        "Build strategy",
    )
    missing_design = check_required_headings(design_text, required_design_headings)
    if missing_design:
        add_issue(
            step=STEP_ARCHITECT,
            summary=f"design.md missing required sections: {', '.join(missing_design)}",
            risk="Feature generation may drift from incomplete architecture constraints.",
            remediation="Regenerate design.md and keep mandatory architecture sections.",
        )

    required_ux_headings = (
        "User journeys",
        "Workflows",
    )
    missing_ux = check_required_headings(ux_text, required_ux_headings)
    if missing_ux:
        add_issue(
            step=STEP_UX,
            summary=f"ux-ui.md missing required sections: {', '.join(missing_ux)}",
            risk="User journeys/workflows may be under-specified for feature generation.",
            remediation="Regenerate ux-ui.md and keep journeys + workflows sections complete.",
        )

    if enforce_semantic_gate:
        for generic_issue in generic_signal_issues(design_text, ux_text):
            add_issue(
                step=generic_issue["step"],
                summary=generic_issue["summary"],
                risk=generic_issue["risk"],
                remediation=generic_issue["remediation"],
            )

    for feature in features:
        title_lower = feature.title.lower()
        if title_lower not in design_text.lower():
            add_issue(
                step=STEP_ARCHITECT,
                summary=f"design.md does not mention feature '{feature.title}'",
                risk="Feature may be generated without architecture alignment.",
                remediation=f"Ensure design.md feature alignment map includes '{feature.title}'.",
            )
        if title_lower not in ux_text.lower():
            add_issue(
                step=STEP_UX,
                summary=f"ux-ui.md does not mention feature '{feature.title}'",
                risk="Feature may be generated without UX journey/workflow alignment.",
                remediation=f"Ensure ux-ui.md journeys/workflows include '{feature.title}'.",
            )

        semantic_tokens = feature_semantic_tokens(feature)
        if enforce_semantic_gate and semantic_tokens:
            design_lower = design_text.lower()
            ux_lower = ux_text.lower()
            if not any(token in design_lower for token in semantic_tokens):
                add_issue(
                    step=STEP_ARCHITECT,
                    summary=(
                        f"design.md lacks feature-specific semantics for '{feature.title}' "
                        f"(expected one of: {', '.join(semantic_tokens)})."
                    ),
                    risk="Architecture can pass structural checks while remaining generic.",
                    remediation=(
                        f"Add project-specific architecture details tied to '{feature.title}' "
                        "outcome/notes from PRD."
                    ),
                )
            if not any(token in ux_lower for token in semantic_tokens):
                add_issue(
                    step=STEP_UX,
                    summary=(
                        f"ux-ui.md lacks feature-specific semantics for '{feature.title}' "
                        f"(expected one of: {', '.join(semantic_tokens)})."
                    ),
                    risk="User journeys may stay generic and miss intended product behavior.",
                    remediation=(
                        f"Add journey/workflow details grounded in '{feature.title}' "
                        "outcome/notes from PRD."
                    ),
                )

    payload_slugs = order_payload.get("ordered_feature_slugs", [])
    if not isinstance(payload_slugs, list):
        payload_slugs = []
    payload_slug_set = {str(item) for item in payload_slugs}
    for feature in features:
        if feature.slug not in payload_slug_set:
            add_issue(
                step=STEP_DEPENDENCY_PLANNER,
                summary=f"feature-order.json missing '{feature.slug}'",
                risk="Feature generation order may be incomplete or non-deterministic.",
                remediation="Regenerate feature-order artifacts and include every P0/P1 feature.",
            )

    for violation in dependency_order_violations(ordered_slugs, graph):
        add_issue(
            step=STEP_DEPENDENCY_PLANNER,
            summary=violation,
            risk="Dependent features may be generated before their prerequisites.",
            remediation="Fix dependency graph or choose a safer cycle/ambiguity resolution.",
        )

    for invalid_step_issue in validate_pm_issue_step_names(
        pm_role_payload.get("issues")
    ):
        add_issue(
            step=invalid_step_issue["step"],
            summary=invalid_step_issue["summary"],
            risk=invalid_step_issue["risk"],
            remediation=invalid_step_issue["remediation"],
        )
    for actionability_issue in validate_pm_issue_actionability(
        pm_role_payload.get("issues")
    ):
        add_issue(
            step=actionability_issue["step"],
            summary=actionability_issue["summary"],
            risk=actionability_issue["risk"],
            remediation=actionability_issue["remediation"],
        )

    pm_decision = str(pm_role_payload.get("decision", "BLOCK")).strip().upper()
    pm_role_issues = normalize_role_issues(
        raw_issues=pm_role_payload.get("issues"),
        default_step=STEP_PRODUCT_MANAGER,
        source="product-manager",
    )
    criteria = pm_role_payload.get("criteria")
    failed_criteria_keys: List[str] = []
    if enforce_semantic_gate and isinstance(criteria, dict):
        for key, value in criteria.items():
            if str(value).strip().lower() not in {"fail", "failed", "block", "blocked"}:
                continue
            failed_criteria_keys.append(str(key).strip())
    for pm_issue in pm_role_issues:
        add_issue(
            step=pm_issue["step"],
            summary=pm_issue["summary"],
            risk=pm_issue["risk"],
            remediation=pm_issue["remediation"],
        )

    if pm_decision not in {"APPROVE", "BLOCK"}:
        add_issue(
            step=STEP_PRODUCT_MANAGER,
            summary="Product Manager decision is invalid (expected APPROVE/BLOCK).",
            risk="Invalid PM output can cause false approvals.",
            remediation="Return PM decision as APPROVE or BLOCK in JSON output.",
        )
    elif pm_decision == "BLOCK" and not pm_role_issues and not failed_criteria_keys:
        add_issue(
            step=STEP_PRODUCT_MANAGER,
            summary="Product Manager returned BLOCK without actionable issues.",
            risk="Prepare loop cannot resolve PM block deterministically.",
            remediation="Return at least one PM issue with summary, risk, and remediation.",
        )
    elif pm_decision == "APPROVE" and pm_role_issues:
        add_issue(
            step=STEP_PRODUCT_MANAGER,
            summary="Product Manager returned APPROVE while listing issues.",
            risk="Contradictory PM output weakens semantic gate integrity.",
            remediation="Return BLOCK when PM issues are present.",
        )

    if pm_decision == "BLOCK":
        owner_statuses = pm_todo_update_owner_statuses(
            pm_role_payload.get("todo_updates")
        )
        if not owner_statuses:
            add_issue(
                step=STEP_PRODUCT_MANAGER,
                summary="Product Manager BLOCK response missing actionable todo_updates.",
                risk="Retry loop may not route work to owners deterministically.",
                remediation=(
                    "On BLOCK, include open/carry todo_updates per unresolved owner "
                    "(architect, ux, dependency-planner)."
                ),
            )
        else:
            unresolved_owners: Set[str] = set()
            for pm_issue in pm_role_issues:
                owner = infer_issue_owner(
                    step=pm_issue["step"],
                    summary=pm_issue["summary"],
                    remediation=pm_issue["remediation"],
                    default=TODO_OWNER_ARCHITECT,
                )
                if owner in TODO_OWNERS:
                    unresolved_owners.add(owner)
            missing_owners = [
                owner
                for owner in sorted(unresolved_owners)
                if not owner_statuses.get(owner, set()).intersection(
                    {TODO_STATUS_OPEN, TODO_STATUS_CARRY}
                )
            ]
            if missing_owners:
                add_issue(
                    step=STEP_PRODUCT_MANAGER,
                    summary=(
                        "Product Manager BLOCK response missing open/carry todo_updates for owners: "
                        + ", ".join(missing_owners)
                    ),
                    risk="Owners may not receive deterministic action items for retry.",
                    remediation=(
                        "Add todo_updates entries with owner and open/carry status for each "
                        "unresolved owner-scoped issue."
                    ),
                )

    for key in failed_criteria_keys:
        if key == "feature_specificity":
            add_issue(
                step=STEP_ARCHITECT,
                summary="PM semantic criterion 'feature_specificity' failed for architecture content.",
                risk="Architecture text may remain generic and fail to guide generation.",
                remediation=(
                    "Update `design.md` in `Feature alignment map` and related architecture "
                    "sections; acceptance: each P0/P1 feature includes project-specific "
                    "architecture rationale tied to PRD outcome/notes."
                ),
            )
            continue
        if key == "journey_specificity":
            add_issue(
                step=STEP_UX,
                summary="PM semantic criterion 'journey_specificity' failed for UX journeys/workflows.",
                risk="UX blueprint may stay generic and not map to expected user behavior.",
                remediation=(
                    "Update `ux-ui.md` in `User journeys` and `Workflows`; acceptance: each "
                    "P0/P1 feature includes journey/workflow details grounded in PRD outcomes."
                ),
            )
            continue
        if key == "dependency_alignment":
            add_issue(
                step=STEP_DEPENDENCY_PLANNER,
                summary="PM semantic criterion 'dependency_alignment' failed for dependency ordering.",
                risk="Feature generation order may violate prerequisites.",
                remediation=(
                    "Update `feature-order.json` dependencies and ordered_feature_slugs; "
                    "acceptance: every feature appears once and dependency order has no violations."
                ),
            )
            continue
        add_issue(
            step=STEP_PRODUCT_MANAGER,
            summary=f"PM semantic criterion '{key}' failed but lacks owner-specific routing.",
            risk="Criterion failures can remain ambiguous and slow retry convergence.",
            remediation=(
                "Map failed criterion to architect, ux, or dependency-planner with explicit "
                "artifact, section, and acceptance condition."
            ),
        )

    return issues


def review_issue_payload(issue: ReviewIssue) -> Dict[str, str]:
    return {
        "issue_id": issue.issue_id,
        "step": issue.step,
        "summary": issue.summary,
        "risk": issue.risk,
        "remediation": issue.remediation,
    }


def normalize_pm_criteria(raw_criteria: Any) -> Dict[str, str]:
    if not isinstance(raw_criteria, dict):
        return {}
    normalized: Dict[str, str] = {}
    for raw_key, raw_value in raw_criteria.items():
        key = str(raw_key).strip()
        if not key:
            continue
        normalized[key] = str(raw_value).strip()
    return normalized


def next_pm_todo_id(pm_todos: Sequence[Dict[str, Any]]) -> str:
    highest = 0
    for todo in pm_todos:
        task_id = str(todo.get("task_id", "")).strip()
        match = re.search(r"(\d+)$", task_id)
        if not match:
            continue
        highest = max(highest, int(match.group(1)))
    return f"PM-TODO-{highest + 1:03d}"


def apply_pm_todo_updates(
    *,
    pm_todos: Sequence[Dict[str, Any]],
    raw_todo_updates: Any,
    review_issues: Sequence[ReviewIssue],
    pm_role_decision: str,
    loop_iteration: int,
) -> Tuple[List[Dict[str, Any]], List[Dict[str, Any]]]:
    todos: List[Dict[str, Any]] = [dict(item) for item in pm_todos]
    for todo in todos:
        todo["owner"] = normalize_todo_owner(todo.get("owner"))
        todo["status"] = normalize_todo_status(todo.get("status"))

    by_id = {
        str(todo.get("task_id", "")).strip(): todo
        for todo in todos
        if str(todo.get("task_id", "")).strip()
    }
    updates_applied: List[Dict[str, Any]] = []
    updates = raw_todo_updates if isinstance(raw_todo_updates, list) else []

    def todo_signature(owner: str, description: str) -> Tuple[str, str]:
        return owner, description.strip()

    def normalize_todo_signature(todo: Dict[str, Any]) -> Tuple[str, str]:
        return todo_signature(
            normalize_todo_owner(todo.get("owner")),
            str(todo.get("description", "")),
        )

    for raw_update in updates:
        if not isinstance(raw_update, dict):
            continue
        task_id = str(raw_update.get("task_id", "")).strip()
        source_issue_id = str(raw_update.get("source_issue_id", "")).strip()
        description = str(raw_update.get("description", "")).strip()
        existing = by_id.get(task_id) if task_id else None
        owner_default = infer_issue_owner(
            step=(str(existing.get("owner", TODO_OWNER_ARCHITECT)) if existing else ""),
            summary=description,
            default=TODO_OWNER_ARCHITECT,
        )
        owner = infer_issue_owner(
            step=raw_update.get("owner"),
            summary=description,
            remediation=source_issue_id,
            default=owner_default,
        )
        status_default = (
            str(existing.get("status", TODO_STATUS_OPEN))
            if existing
            else TODO_STATUS_OPEN
        )
        status = normalize_todo_status(raw_update.get("status"), default=status_default)

        if existing:
            if description:
                existing["description"] = description
            existing["owner"] = owner
            existing["status"] = status
            if source_issue_id:
                existing["source_issue_id"] = source_issue_id
            existing["updated_loop"] = loop_iteration
            updates_applied.append(
                {
                    "action": "update",
                    "task_id": task_id,
                    "owner": owner,
                    "status": status,
                    "source_issue_id": source_issue_id,
                }
            )
            continue

        if not description:
            continue

        new_task_id = next_pm_todo_id(todos)
        new_todo = {
            "task_id": new_task_id,
            "created_loop": loop_iteration,
            "updated_loop": loop_iteration,
            "owner": owner,
            "status": status,
            "description": description,
            "source_issue_id": source_issue_id,
        }
        todos.append(new_todo)
        by_id[new_task_id] = new_todo
        updates_applied.append(
            {
                "action": "create",
                "task_id": new_task_id,
                "owner": owner,
                "status": status,
                "source_issue_id": source_issue_id,
            }
        )

    if review_issues:
        unresolved_signatures: List[Tuple[str, str]] = []
        unresolved_issue_ids: Dict[Tuple[str, str], str] = {}
        for issue in review_issues:
            owner = infer_issue_owner(
                step=issue.step,
                summary=issue.summary,
                remediation=issue.remediation,
                default=TODO_OWNER_ARCHITECT,
            )
            summary = issue.summary.strip()
            if not summary:
                continue
            signature = todo_signature(owner, summary)
            if signature not in unresolved_issue_ids:
                unresolved_signatures.append(signature)
            unresolved_issue_ids[signature] = issue.issue_id

        matched_refs: Set[int] = set()
        unresolved_signature_set = set(unresolved_signatures)

        for signature in unresolved_signatures:
            issue_id = unresolved_issue_ids[signature]
            matched: Optional[Dict[str, Any]] = None
            fallback: Optional[Dict[str, Any]] = None
            for todo in todos:
                if id(todo) in matched_refs:
                    continue
                if normalize_todo_signature(todo) != signature:
                    continue
                todo_status = normalize_todo_status(todo.get("status"))
                if todo_status in {TODO_STATUS_OPEN, TODO_STATUS_CARRY}:
                    matched = todo
                    break
                if fallback is None:
                    fallback = todo
            if matched is None:
                matched = fallback

            if matched is not None:
                previous_status = normalize_todo_status(matched.get("status"))
                next_status = (
                    TODO_STATUS_OPEN
                    if previous_status == TODO_STATUS_OPEN
                    else TODO_STATUS_CARRY
                )
                matched["owner"] = signature[0]
                matched["description"] = signature[1]
                matched["status"] = next_status
                matched["updated_loop"] = loop_iteration
                matched["source_issue_id"] = issue_id
                if not str(matched.get("created_loop", "")).strip():
                    matched["created_loop"] = loop_iteration
                updates_applied.append(
                    {
                        "action": (
                            "auto_carry"
                            if previous_status in {TODO_STATUS_OPEN, TODO_STATUS_CARRY}
                            else "auto_reopen"
                        ),
                        "task_id": str(matched.get("task_id", "")),
                        "owner": signature[0],
                        "status": next_status,
                        "source_issue_id": issue_id,
                    }
                )
                matched_refs.add(id(matched))
                continue

            new_task_id = next_pm_todo_id(todos)
            new_todo = {
                "task_id": new_task_id,
                "created_loop": loop_iteration,
                "updated_loop": loop_iteration,
                "owner": signature[0],
                "status": TODO_STATUS_OPEN,
                "description": signature[1],
                "source_issue_id": issue_id,
            }
            todos.append(new_todo)
            by_id[new_task_id] = new_todo
            matched_refs.add(id(new_todo))
            updates_applied.append(
                {
                    "action": "auto_create",
                    "task_id": new_task_id,
                    "owner": signature[0],
                    "status": TODO_STATUS_OPEN,
                    "source_issue_id": issue_id,
                }
            )

        for todo in todos:
            todo_status = normalize_todo_status(todo.get("status"))
            if todo_status not in {TODO_STATUS_OPEN, TODO_STATUS_CARRY}:
                continue
            if (
                normalize_todo_signature(todo) in unresolved_signature_set
                and id(todo) in matched_refs
            ):
                continue
            todo["status"] = TODO_STATUS_DONE
            todo["updated_loop"] = loop_iteration
            updates_applied.append(
                {
                    "action": "auto_done_resolved",
                    "task_id": str(todo.get("task_id", "")),
                    "owner": normalize_todo_owner(todo.get("owner")),
                    "status": TODO_STATUS_DONE,
                    "source_issue_id": str(todo.get("source_issue_id", "")),
                }
            )
        return todos, updates_applied

    if pm_role_decision == "APPROVE" and not review_issues:
        for todo in todos:
            status = normalize_todo_status(todo.get("status"))
            if status not in {TODO_STATUS_OPEN, TODO_STATUS_CARRY}:
                continue
            todo["status"] = TODO_STATUS_DONE
            todo["updated_loop"] = loop_iteration
            updates_applied.append(
                {
                    "action": "auto_done",
                    "task_id": str(todo.get("task_id", "")),
                    "owner": normalize_todo_owner(todo.get("owner")),
                    "status": TODO_STATUS_DONE,
                    "source_issue_id": str(todo.get("source_issue_id", "")),
                }
            )
        return todos, updates_applied

    return todos, updates_applied


def build_pm_feedback_snapshot(
    *,
    pm_role_payload: Dict[str, Any],
    review_issues: Sequence[ReviewIssue],
    todo_updates: Sequence[Dict[str, Any]],
) -> Dict[str, Any]:
    role_decision = str(pm_role_payload.get("decision", "BLOCK")).strip().upper()
    return {
        "role_decision": role_decision or "BLOCK",
        "criteria": normalize_pm_criteria(pm_role_payload.get("criteria")),
        "raw_issues": normalize_role_issues(
            raw_issues=pm_role_payload.get("issues"),
            default_step=STEP_PRODUCT_MANAGER,
            source="product-manager",
        ),
        "review_issues": [review_issue_payload(issue) for issue in review_issues],
        "todo_updates": [dict(item) for item in todo_updates],
    }


def render_pm_todo_markdown(
    *,
    pm_todos: Sequence[Dict[str, Any]],
    pm_history: Sequence[Dict[str, Any]],
) -> str:
    todos = [dict(item) for item in pm_todos]
    for todo in todos:
        todo["owner"] = normalize_todo_owner(todo.get("owner"))
        todo["status"] = normalize_todo_status(todo.get("status"))

    def sort_key(item: Dict[str, Any]) -> Tuple[int, str]:
        task_id = str(item.get("task_id", "")).strip()
        match = re.search(r"(\d+)$", task_id)
        number = int(match.group(1)) if match else 0
        return number, task_id

    open_or_carry = sorted(
        [
            todo
            for todo in todos
            if normalize_todo_status(todo.get("status"))
            in {TODO_STATUS_OPEN, TODO_STATUS_CARRY}
        ],
        key=sort_key,
    )
    done = sorted(
        [
            todo
            for todo in todos
            if normalize_todo_status(todo.get("status")) == TODO_STATUS_DONE
        ],
        key=sort_key,
    )

    lines = [
        "# Prepare Features PM TODO",
        "",
        "> Machine-managed by `tools/pc-prepare-features`.",
        "",
        "## Open + Carry",
        "",
    ]
    if not open_or_carry:
        lines.append("- (none)")
    else:
        lines.extend(
            [
                "| Task ID | Owner | Status | Loop Created | Loop Updated | Source Issue | Description |",
                "| ------- | ----- | ------ | ------------ | ------------ | ------------ | ----------- |",
            ]
        )
        for todo in open_or_carry:
            lines.append(
                "| {task_id} | {owner} | {status} | {created_loop} | {updated_loop} | {source_issue_id} | {description} |".format(
                    task_id=str(todo.get("task_id", "")).strip() or "(missing)",
                    owner=normalize_todo_owner(todo.get("owner")),
                    status=normalize_todo_status(todo.get("status")),
                    created_loop=str(todo.get("created_loop", "")).strip() or "-",
                    updated_loop=str(todo.get("updated_loop", "")).strip() or "-",
                    source_issue_id=str(todo.get("source_issue_id", "")).strip() or "-",
                    description=str(todo.get("description", "")).strip() or "-",
                )
            )

    lines.extend(["", "## Done", ""])
    if not done:
        lines.append("- (none)")
    else:
        lines.extend(
            [
                "| Task ID | Owner | Loop Updated | Source Issue | Description |",
                "| ------- | ----- | ------------ | ------------ | ----------- |",
            ]
        )
        for todo in done:
            lines.append(
                "| {task_id} | {owner} | {updated_loop} | {source_issue_id} | {description} |".format(
                    task_id=str(todo.get("task_id", "")).strip() or "(missing)",
                    owner=normalize_todo_owner(todo.get("owner")),
                    updated_loop=str(todo.get("updated_loop", "")).strip() or "-",
                    source_issue_id=str(todo.get("source_issue_id", "")).strip() or "-",
                    description=str(todo.get("description", "")).strip() or "-",
                )
            )

    lines.extend(["", "## PM Loop History (summary)", ""])
    if not pm_history:
        lines.append("- (none)")
    else:
        for entry in pm_history:
            lines.append(
                "- loop={iteration} gate={gate_id} decision={decision} pm_role_decision={pm_role_decision} issues={issue_count}".format(
                    iteration=str(entry.get("iteration", "")).strip() or "-",
                    gate_id=str(entry.get("gate_id", "")).strip() or "-",
                    decision=str(entry.get("decision", "")).strip() or "-",
                    pm_role_decision=str(entry.get("pm_role_decision", "")).strip()
                    or "-",
                    issue_count=str(entry.get("issue_count", "")).strip() or "0",
                )
            )

    return "\n".join(lines)


def build_prepare_state_payload(
    *,
    features: Sequence[Feature],
    ordered_slugs: Sequence[str],
    graph: Dict[str, Set[str]],
    dependency_decisions: Sequence[Dict[str, Any]],
    pm_history: Sequence[Dict[str, object]],
    pm_todos: Sequence[Dict[str, Any]],
    pm_final_decision: str,
    skip_generation: bool,
    role_mode: str,
    include_process_features: bool,
    feature_generation_status: str,
    schema_check_status: str,
) -> Dict[str, object]:
    by_slug = {feature.slug: feature for feature in features}
    ordered_features = []
    for index, slug in enumerate(ordered_slugs, start=1):
        feature = by_slug.get(slug)
        if not feature:
            continue
        ordered_features.append(
            {
                "index": index,
                "slug": feature.slug,
                "title": feature.title,
                "priority": feature.priority,
                "dependencies": sorted(graph.get(feature.slug, set())),
            }
        )

    open_todos = [
        todo
        for todo in pm_todos
        if normalize_todo_status(todo.get("status"))
        in {TODO_STATUS_OPEN, TODO_STATUS_CARRY}
    ]
    done_todos = [
        todo
        for todo in pm_todos
        if normalize_todo_status(todo.get("status")) == TODO_STATUS_DONE
    ]

    return {
        "version": 3,
        "generated_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "ordered_feature_slugs": list(ordered_slugs),
        "ordered_features": ordered_features,
        "dependency_decisions": list(dependency_decisions),
        "pm_gate": {
            "blocked_count": len(
                [entry for entry in pm_history if int(entry.get("issue_count", 0)) > 0]
            ),
            "final_decision": pm_final_decision,
            "history": list(pm_history),
        },
        "pm_todos": {
            "open_count": len(open_todos),
            "done_count": len(done_todos),
            "items": [dict(item) for item in pm_todos],
        },
        "execution": {
            "skip_generation": skip_generation,
            "role_mode": role_mode,
            "include_process_features": include_process_features,
            "feature_generation_status": feature_generation_status,
            "schema_check_status": schema_check_status,
        },
        "notes": [
            "Machine-managed by tools/pc-prepare-features.",
            "Captures PM-gate outcomes and execution status for deterministic reruns.",
        ],
    }


def render_pm_issues(issues: Sequence[ReviewIssue]) -> str:
    lines = ["Product Manager findings:"]
    for issue in issues:
        lines.append(f"- [{issue.issue_id}] step={issue.step}")
        lines.append(f"  summary: {issue.summary}")
        lines.append(f"  risk: {issue.risk}")
        lines.append(f"  remediation: {issue.remediation}")
    return "\n".join(lines)


def write_text(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content.rstrip() + "\n", encoding="utf-8")


def snapshot_label_token(raw_label: str) -> str:
    token = re.sub(r"[^a-z0-9._-]+", "-", raw_label.strip().lower()).strip("-")
    return token or "snapshot"


def run_command(root: Path, cmd: Sequence[str], *, label: str) -> None:
    printable = " ".join(cmd)
    print(f"pc-prepare-features: running {label}: {printable}")
    result = subprocess.run(
        list(cmd),
        cwd=str(root),
        check=False,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if result.stdout:
        print(result.stdout, end="")
    if result.stderr:
        print(result.stderr, end="", file=sys.stderr)
    if result.returncode != 0:
        die(
            f"pc-prepare-features: command failed ({label}) with exit {result.returncode}"
        )


def read_text_if_exists(path: Path) -> str:
    if not path.exists():
        return ""
    try:
        return path.read_text(encoding="utf-8")
    except OSError:
        return ""


def read_json_object_if_exists(path: Path) -> Dict[str, Any]:
    if not path.exists():
        return {}
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError):
        return {}
    if not isinstance(payload, dict):
        return {}
    return payload


def state_pm_todos_from_payload(payload: Dict[str, Any]) -> List[Dict[str, Any]]:
    pm_todos_payload = payload.get("pm_todos")
    if not isinstance(pm_todos_payload, dict):
        return []
    items = pm_todos_payload.get("items")
    if not isinstance(items, list):
        return []
    return [dict(item) for item in items if isinstance(item, dict)]


def last_pm_feedback_from_state(payload: Dict[str, Any]) -> List[Dict[str, str]]:
    pm_gate = payload.get("pm_gate")
    if not isinstance(pm_gate, dict):
        return []
    history = pm_gate.get("history")
    if not isinstance(history, list) or not history:
        return []
    for raw_entry in reversed(history):
        if not isinstance(raw_entry, dict):
            continue
        feedback = raw_entry.get("pm_feedback")
        if not isinstance(feedback, dict):
            continue
        review_issues = feedback.get("review_issues")
        if isinstance(review_issues, list):
            return [
                {
                    "issue_id": str(item.get("issue_id", "")).strip(),
                    "step": str(item.get("step", "")).strip(),
                    "summary": str(item.get("summary", "")).strip(),
                    "risk": str(item.get("risk", "")).strip(),
                    "remediation": str(item.get("remediation", "")).strip(),
                }
                for item in review_issues
                if isinstance(item, dict)
            ]
    return []


def order_payload_consistency_issues(
    order_payload: Dict[str, Any], *, ordered_slugs: Sequence[str]
) -> List[str]:
    issues: List[str] = []
    slug_order = [str(slug).strip() for slug in ordered_slugs if str(slug).strip()]
    slug_set = set(slug_order)

    decisions = order_payload.get("decisions")
    dependencies = order_payload.get("dependencies")
    ordered_features = order_payload.get("ordered_features")
    if not isinstance(decisions, list):
        return ["order payload decisions must be a list"]
    if not isinstance(dependencies, dict):
        return ["order payload dependencies must be an object"]
    if not isinstance(ordered_features, list):
        return ["order payload ordered_features must be a list"]

    decision_dep_map: Dict[str, List[str]] = {}
    for item in decisions:
        if not isinstance(item, dict):
            continue
        raw_slug = str(item.get("feature_slug", "")).strip()
        if not raw_slug:
            continue
        slug = raw_slug if raw_slug in slug_set else compact_slug(raw_slug)
        if not slug or slug not in slug_set:
            continue
        depends_on = item.get("depends_on", [])
        if not isinstance(depends_on, list):
            issues.append(f"decisions[{slug}].depends_on must be a list")
            continue
        normalized = []
        for dep in depends_on:
            dep_token = str(dep).strip()
            if not dep_token:
                continue
            dep_slug = dep_token if dep_token in slug_set else compact_slug(dep_token)
            if (
                dep_slug
                and dep_slug in slug_set
                and dep_slug != slug
                and dep_slug not in normalized
            ):
                normalized.append(dep_slug)
        decision_dep_map[slug] = normalized

    for slug in slug_order:
        decision_deps = decision_dep_map.get(slug, [])
        dependency_deps = dependencies.get(slug, [])
        if not isinstance(dependency_deps, list):
            issues.append(f"dependencies[{slug}] must be a list")
            continue
        normalized_dependencies = []
        for dep in dependency_deps:
            dep_token = str(dep).strip()
            if not dep_token:
                continue
            dep_slug = dep_token if dep_token in slug_set else compact_slug(dep_token)
            if (
                dep_slug
                and dep_slug in slug_set
                and dep_slug != slug
                and dep_slug not in normalized_dependencies
            ):
                normalized_dependencies.append(dep_slug)
        if normalized_dependencies != decision_deps:
            issues.append(
                f"dependencies[{slug}] differs from decisions[{slug}].depends_on"
            )

        row = next(
            (
                item
                for item in ordered_features
                if isinstance(item, dict) and str(item.get("slug", "")).strip() == slug
            ),
            None,
        )
        if row is None:
            issues.append(f"ordered_features missing row for {slug}")
            continue
        row_deps = row.get("dependencies", [])
        if not isinstance(row_deps, list):
            issues.append(f"ordered_features[{slug}].dependencies must be a list")
            continue
        normalized_row = []
        for dep in row_deps:
            dep_token = str(dep).strip()
            if not dep_token:
                continue
            dep_slug = dep_token if dep_token in slug_set else compact_slug(dep_token)
            if (
                dep_slug
                and dep_slug in slug_set
                and dep_slug != slug
                and dep_slug not in normalized_row
            ):
                normalized_row.append(dep_slug)
        if normalized_row != decision_deps:
            issues.append(
                f"ordered_features[{slug}].dependencies differs from decisions[{slug}].depends_on"
            )

    return issues


def run_order_payload_autofix_session(
    *,
    root: Path,
    order_payload: Dict[str, Any],
    consistency_issues: Sequence[str],
) -> Dict[str, Any]:
    if shutil.which("codex") is None:
        print(
            "pc-prepare-features: order payload autofix skipped (codex CLI not found)"
        )
        return dict(order_payload)

    issue_lines = "\n".join(f"- {item}" for item in consistency_issues)
    prompt = (
        "You are the dependency autofix role for prepare-features.\n"
        "Fix the order payload so dependency data is machine-consistent.\n"
        'Return ONLY JSON object: {"order_payload": <fixed payload>}.\n'
        "Rules:\n"
        "- Keep ordered_feature_slugs unchanged.\n"
        "- Ensure decisions[*].depends_on are JSON arrays of slugs.\n"
        "- Ensure dependencies[slug] and ordered_features[*].dependencies match decisions.\n"
        "- Do not add unknown slugs.\n\n"
        "Consistency issues:\n"
        f"{issue_lines}\n\n"
        "Current order payload JSON:\n"
        f"{json.dumps(order_payload, ensure_ascii=True, indent=2, sort_keys=True)}\n"
    )
    try:
        payload = codex_exec_json(
            root=root,
            prompt=prompt,
            profile=os.environ.get("PREPARE_ORDERER_AUTOFIX_PROFILE", "Orderer"),
            label="orderer-autofix",
        )
    except RuntimeError as exc:
        print(f"pc-prepare-features: order payload autofix failed: {exc}")
        return dict(order_payload)

    raw_payload = payload.get("order_payload")
    if not isinstance(raw_payload, dict):
        print(
            "pc-prepare-features: order payload autofix ignored invalid output (missing order_payload object)"
        )
        return dict(order_payload)
    return dict(raw_payload)


def run_markdown_autofix_session(
    *,
    root: Path,
    artifact_label: str,
    current_markdown: str,
    issues: Sequence[ReviewIssue],
    profile_env: str,
    profile_default: str,
) -> str:
    if shutil.which("codex") is None:
        print(
            f"pc-prepare-features: {artifact_label} autofix skipped (codex CLI not found)"
        )
        return current_markdown
    if not issues:
        return current_markdown

    issues_markdown = "\n".join(
        f"- [{issue.issue_id}] {issue.summary} | remediation: {issue.remediation}"
        for issue in issues
    )
    prompt = (
        f"You are the {artifact_label} autofix role for prepare-features.\n"
        "Apply minimal edits that resolve the listed issues.\n"
        'Return ONLY JSON object: {"markdown": "..."}.\n'
        "Constraints:\n"
        "- Keep existing section structure.\n"
        "- Preserve unrelated wording.\n"
        "- Resolve only the listed issues.\n\n"
        "Issues:\n"
        f"{issues_markdown}\n\n"
        "Current markdown:\n"
        f"{current_markdown}\n"
    )
    try:
        payload = codex_exec_json(
            root=root,
            prompt=prompt,
            profile=os.environ.get(profile_env, profile_default),
            label=f"{artifact_label}-autofix",
        )
    except RuntimeError as exc:
        print(f"pc-prepare-features: {artifact_label} autofix failed: {exc}")
        return current_markdown

    markdown = str(payload.get("markdown", "")).strip()
    if not markdown:
        print(
            f"pc-prepare-features: {artifact_label} autofix ignored invalid output (missing markdown)"
        )
        return current_markdown
    return markdown


def build_candidate_summary_markdown(
    *,
    run_mode: str,
    loop_iteration: int,
    pm_final_decision: str,
    pm_block_count: int,
    feature_generation_status: str,
    schema_check_status: str,
) -> str:
    lines = [
        "# Prepare Features Candidate Summary",
        "",
        "> Machine-managed by `tools/pc-prepare-features`.",
        "",
        f"- Run mode: `{run_mode}`",
        f"- Loop iteration: `{loop_iteration}`",
        f"- PM final decision: `{pm_final_decision}`",
        f"- PM blocks: `{pm_block_count}`",
        f"- Feature generation status: `{feature_generation_status}`",
        f"- Schema check status: `{schema_check_status}`",
        "",
        "## Candidate Artifacts",
        "",
        f"- `{DESIGN_CANDIDATE_PATH}`",
        f"- `{UX_CANDIDATE_PATH}`",
        f"- `{SECURITY_CANDIDATE_PATH}`",
        f"- `{ORDER_JSON_CANDIDATE_PATH}`",
        f"- `{ORDER_MD_CANDIDATE_PATH}`",
        f"- `{PREPARE_STATE_CANDIDATE_PATH}`",
        f"- `{PREPARE_PM_TODO_CANDIDATE_PATH}`",
    ]
    return "\n".join(lines)


def run_prepare(args: argparse.Namespace) -> int:
    root = Path(args.root).resolve()
    prd_file = root / PRD_PATH
    if not prd_file.exists():
        die(f"pc-prepare-features: missing PRD: {prd_file}")

    prd_module = load_prd_tool(root)
    prd_text = prd_file.read_text(encoding="utf-8")
    features = parse_features(
        prd_module,
        prd_text,
        include_process_features=bool(args.include_process_features),
    )
    if not features:
        die("pc-prepare-features: no P0/P1 features found in PRD")

    overrides = parse_override_choices(os.environ.get("PREPARE_DECISIONS", ""))

    context_boundaries_file = root / CONTEXT_BOUNDARIES_PATH
    context_boundaries = (
        context_boundaries_file.read_text(encoding="utf-8")
        if context_boundaries_file.exists()
        else ""
    )

    existing_state_payload = read_json_object_if_exists(root / PREPARE_STATE_PATH)
    raw_state_version = existing_state_payload.get("version", 1)
    try:
        state_version = int(raw_state_version or 1)
    except (TypeError, ValueError):
        state_version = 1
    has_pm_todos = isinstance(existing_state_payload.get("pm_todos"), dict)
    if existing_state_payload and (state_version < 2 or not has_pm_todos):
        print(
            "pc-prepare-features: warning: detected legacy prepare state "
            "(version<2 or missing pm_todos); this run will refresh artifacts."
        )
    elif (root / PREPARE_STATE_PATH).exists() and not existing_state_payload:
        print(
            "pc-prepare-features: warning: existing prepare state is unreadable; "
            "this run will continue from canonical docs where possible."
        )

    existing_design_doc = read_text_if_exists(root / DESIGN_PATH)
    existing_ux_doc = read_text_if_exists(root / UX_PATH)
    existing_security_doc = read_text_if_exists(root / SECURITY_PATH)
    existing_order_payload = read_json_object_if_exists(root / ORDER_JSON_PATH)
    has_existing_order_payload = bool(
        isinstance(existing_order_payload, dict)
        and isinstance(existing_order_payload.get("ordered_feature_slugs"), list)
    )
    is_first_run = not (
        existing_state_payload
        and existing_design_doc.strip()
        and existing_ux_doc.strip()
        and existing_security_doc.strip()
        and has_existing_order_payload
    )
    run_mode = "first-run" if is_first_run else "rerun"
    print(f"pc-prepare-features: detected run mode -> {run_mode}")

    pm_blocks = 0
    pm_history: List[Dict[str, object]] = []
    pm_todos: List[Dict[str, Any]] = state_pm_todos_from_payload(existing_state_payload)
    graph: Dict[str, Set[str]] = {}
    ordered_slugs: List[str] = []
    dependency_decisions: List[Dict[str, Any]] = []
    pm_final_decision = "pending"
    previous_design_doc = existing_design_doc.strip()
    previous_ux_doc = existing_ux_doc.strip()
    previous_security_doc = existing_security_doc.strip()
    previous_order_payload: Dict[str, object] = (
        dict(existing_order_payload) if has_existing_order_payload else {}
    )
    previous_pm_feedback: List[Dict[str, str]] = last_pm_feedback_from_state(
        existing_state_payload
    )
    retry_owner_scope: Optional[Set[str]] = None
    previous_loop_change_summary = "No previous loop change summary available."
    if previous_pm_feedback:
        last_feedback = previous_pm_feedback[-1]
        feedback_summary = str(last_feedback.get("summary", "")).strip()
        if feedback_summary:
            previous_loop_change_summary = f"Previous PM finding: {feedback_summary}"
    design_doc = previous_design_doc
    ux_doc = previous_ux_doc
    security_doc = previous_security_doc
    order_payload: Dict[str, Any] = dict(previous_order_payload)
    loop_iteration_for_persist = 0
    in_loop_feature_generation_status = "skipped" if args.skip_generation else "pending"
    in_loop_schema_check_status = (
        "skipped" if args.skip_generation or args.skip_schema_check else "pending"
    )
    snapshot_run_id = (
        datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ") + f"-pid{os.getpid()}"
        if args.snapshot_runs
        else ""
    )
    snapshot_root = (
        root / PREPARE_RUNS_DIR / snapshot_run_id if args.snapshot_runs else None
    )
    snapshot_entries: List[Dict[str, Any]] = []
    snapshot_call_count = 0
    if snapshot_root is not None:
        snapshot_root.mkdir(parents=True, exist_ok=True)
        print(f"pc-prepare-features: snapshots enabled -> {snapshot_root}")

    def persist_prepare_state(
        *,
        feature_generation_status: str,
        schema_check_status: str,
        snapshot_label: str = "state",
        promote: bool = False,
    ) -> None:
        payload = build_prepare_state_payload(
            features=features,
            ordered_slugs=ordered_slugs,
            graph=graph,
            dependency_decisions=dependency_decisions,
            pm_history=pm_history,
            pm_todos=pm_todos,
            pm_final_decision=pm_final_decision,
            skip_generation=bool(args.skip_generation),
            role_mode=str(args.role_mode),
            include_process_features=bool(args.include_process_features),
            feature_generation_status=feature_generation_status,
            schema_check_status=schema_check_status,
        )
        pm_todo_markdown = render_pm_todo_markdown(
            pm_todos=pm_todos, pm_history=pm_history
        )
        write_text(
            root / DESIGN_CANDIDATE_PATH,
            design_doc,
        )
        write_text(
            root / UX_CANDIDATE_PATH,
            ux_doc,
        )
        write_text(
            root / SECURITY_CANDIDATE_PATH,
            security_doc,
        )
        write_text(
            root / ORDER_JSON_CANDIDATE_PATH,
            json.dumps(order_payload, ensure_ascii=True, indent=2, sort_keys=True),
        )
        write_text(root / ORDER_MD_CANDIDATE_PATH, order_markdown(order_payload))
        write_text(
            root / PREPARE_STATE_CANDIDATE_PATH,
            json.dumps(payload, ensure_ascii=True, indent=2, sort_keys=True),
        )
        write_text(root / PREPARE_PM_TODO_CANDIDATE_PATH, pm_todo_markdown)
        write_text(
            root / PREPARE_CANDIDATE_SUMMARY_PATH,
            build_candidate_summary_markdown(
                run_mode=run_mode,
                loop_iteration=loop_iteration_for_persist,
                pm_final_decision=pm_final_decision,
                pm_block_count=pm_blocks,
                feature_generation_status=feature_generation_status,
                schema_check_status=schema_check_status,
            ),
        )
        print(
            "pc-prepare-features: wrote candidate artifacts -> "
            f"{DESIGN_CANDIDATE_PATH}, {UX_CANDIDATE_PATH}, {SECURITY_CANDIDATE_PATH}, "
            f"{ORDER_JSON_CANDIDATE_PATH}, "
            f"{PREPARE_STATE_CANDIDATE_PATH}, {PREPARE_PM_TODO_CANDIDATE_PATH}"
        )
        if promote:
            write_text(root / DESIGN_PATH, design_doc)
            write_text(root / UX_PATH, ux_doc)
            write_text(root / SECURITY_PATH, security_doc)
            write_text(
                root / ORDER_JSON_PATH,
                json.dumps(order_payload, ensure_ascii=True, indent=2, sort_keys=True),
            )
            write_text(root / ORDER_MD_PATH, order_markdown(order_payload))
            write_text(
                root / PREPARE_STATE_PATH,
                json.dumps(payload, ensure_ascii=True, indent=2, sort_keys=True),
            )
            write_text(
                root / PREPARE_PM_TODO_PATH,
                pm_todo_markdown,
            )
            print(
                "pc-prepare-features: promoted candidate artifacts -> "
                f"{DESIGN_PATH}, {UX_PATH}, {SECURITY_PATH}, {ORDER_JSON_PATH}, "
                f"{PREPARE_STATE_PATH}, {PREPARE_PM_TODO_PATH}"
            )

        if snapshot_root is None:
            return

        nonlocal snapshot_call_count
        snapshot_call_count += 1
        label_token = snapshot_label_token(snapshot_label)
        snapshot_prefix = f"{snapshot_call_count:03d}-{label_token}"
        state_file_name = f"{snapshot_prefix}-prepare-features-state.json"
        pm_todo_file_name = f"{snapshot_prefix}-prepare-features-pm-todo.md"
        write_text(
            snapshot_root / state_file_name,
            json.dumps(payload, ensure_ascii=True, indent=2, sort_keys=True),
        )
        write_text(snapshot_root / pm_todo_file_name, pm_todo_markdown)

        snapshot_entries.append(
            {
                "index": snapshot_call_count,
                "label": label_token,
                "generated_at": payload.get("generated_at", ""),
                "pm_final_decision": pm_final_decision,
                "feature_generation_status": feature_generation_status,
                "schema_check_status": schema_check_status,
                "state_file": state_file_name,
                "pm_todo_file": pm_todo_file_name,
            }
        )
        snapshot_index_payload = {
            "run_id": snapshot_run_id,
            "snapshot_root": str(PREPARE_RUNS_DIR / snapshot_run_id),
            "snapshots": snapshot_entries,
        }
        write_text(
            snapshot_root / "index.json",
            json.dumps(
                snapshot_index_payload, ensure_ascii=True, indent=2, sort_keys=True
            ),
        )

    while True:
        loop_iteration = pm_blocks + (1 if is_first_run else 2)
        loop_iteration_for_persist = loop_iteration
        run_architect = retry_owner_scope is None or STEP_ARCHITECT in retry_owner_scope
        run_ux = retry_owner_scope is None or STEP_UX in retry_owner_scope
        run_security = retry_owner_scope is None or STEP_SECURITY in retry_owner_scope
        run_orderer = (
            retry_owner_scope is None or STEP_DEPENDENCY_PLANNER in retry_owner_scope
        )
        if retry_owner_scope is None:
            print("pc-prepare-features: retry scope -> full")
        else:
            print(
                "pc-prepare-features: retry scope -> "
                + ", ".join(sorted(retry_owner_scope))
            )

        graph, dependency_decisions = resolve_dependency_graph(
            features, overrides=overrides
        )
        ordered_slugs = topo_order([feature.slug for feature in features], graph)
        if len(ordered_slugs) != len(features):
            die(
                "pc-prepare-features: failed to compute deterministic ordered feature list"
            )

        baseline_order_payload = build_order_payload(
            ordered_slugs=ordered_slugs,
            features=features,
            graph=graph,
            decisions=dependency_decisions,
        )

        design_doc = previous_design_doc
        architect_seed_issues: List[Dict[str, str]] = []
        if run_architect:
            print(
                "pc-prepare-features: architect step -> generating docs/01-product/design.md"
            )
            design_doc, architect_seed_issues = run_architect_role(
                root=root,
                role_mode=args.role_mode,
                prd_text=prd_text,
                context_boundaries=context_boundaries,
                features=features,
                ordered_slugs=ordered_slugs,
                graph=graph,
                dependency_decisions=dependency_decisions,
                prepare_iteration=loop_iteration,
                previous_design_markdown=previous_design_doc,
                previous_ux_markdown=previous_ux_doc,
                pm_feedback=previous_pm_feedback,
                pm_todos=pm_todos,
                previous_loop_change_summary=previous_loop_change_summary,
            )
        elif not design_doc:
            design_doc = design_markdown(
                features=features,
                ordered_slugs=ordered_slugs,
                graph=graph,
                context_boundaries=context_boundaries,
            )

        ux_doc = previous_ux_doc
        ux_seed_issues: List[Dict[str, str]] = []
        if run_ux:
            print("pc-prepare-features: ux step -> generating docs/01-product/ux-ui.md")
            ux_doc, ux_seed_issues = run_ux_role(
                root=root,
                role_mode=args.role_mode,
                prd_text=prd_text,
                context_boundaries=context_boundaries,
                features=features,
                ordered_slugs=ordered_slugs,
                graph=graph,
                dependency_decisions=dependency_decisions,
                prepare_iteration=loop_iteration,
                previous_design_markdown=previous_design_doc,
                previous_ux_markdown=previous_ux_doc,
                pm_feedback=previous_pm_feedback,
                pm_todos=pm_todos,
                previous_loop_change_summary=previous_loop_change_summary,
            )
        elif not ux_doc:
            ux_doc = ux_markdown(
                features=features, ordered_slugs=ordered_slugs, graph=graph
            )

        order_payload = (
            dict(previous_order_payload)
            if previous_order_payload
            else dict(baseline_order_payload)
        )
        orderer_seed_issues: List[Dict[str, str]] = []
        if run_orderer or not previous_order_payload:
            print(
                "pc-prepare-features: orderer step -> generating docs/02-features/feature-order.{json,md}"
            )
            order_payload, orderer_seed_issues = run_orderer_role(
                root=root,
                role_mode=args.role_mode,
                prd_text=prd_text,
                context_boundaries=context_boundaries,
                features=features,
                ordered_slugs=ordered_slugs,
                graph=graph,
                dependency_decisions=dependency_decisions,
                baseline_order_payload=baseline_order_payload,
                prepare_iteration=loop_iteration,
                previous_order_payload=previous_order_payload,
                previous_design_markdown=previous_design_doc,
                previous_ux_markdown=previous_ux_doc,
                pm_feedback=previous_pm_feedback,
                pm_todos=pm_todos,
                previous_loop_change_summary=previous_loop_change_summary,
            )
        else:
            print(
                "pc-prepare-features: orderer step -> reusing previous feature-order payload"
            )

        active_ordered_slugs = [
            str(item).strip()
            for item in order_payload.get("ordered_feature_slugs", [])
            if str(item).strip()
        ]
        if not active_ordered_slugs:
            active_ordered_slugs = list(ordered_slugs)
        raw_consistency_issues = order_payload_consistency_issues(
            order_payload, ordered_slugs=active_ordered_slugs
        )
        if raw_consistency_issues:
            print(
                "pc-prepare-features: dependency planner autofix -> "
                "running dedicated codex session"
            )
            autofixed_payload = run_order_payload_autofix_session(
                root=root,
                order_payload=order_payload,
                consistency_issues=raw_consistency_issues,
            )
            autofixed_slugs = [
                str(item).strip()
                for item in autofixed_payload.get("ordered_feature_slugs", [])
                if str(item).strip()
            ]
            if len(autofixed_slugs) == len(features) and len(
                set(autofixed_slugs)
            ) == len(features):
                active_ordered_slugs = autofixed_slugs
            order_payload = dict(autofixed_payload)

        order_decisions_payload = order_payload.get("decisions")
        if not isinstance(order_decisions_payload, list):
            order_decisions_payload = dependency_decisions
        order_payload = build_order_payload(
            ordered_slugs=active_ordered_slugs,
            features=features,
            graph=graph,
            decisions=[
                dict(item) for item in order_decisions_payload if isinstance(item, dict)
            ],
        )
        consistency_issues = order_payload_consistency_issues(
            order_payload, ordered_slugs=active_ordered_slugs
        )
        if consistency_issues:
            print(
                "pc-prepare-features: dependency planner autofix could not resolve all issues; continuing with normalized payload"
            )
        ordered_slugs = list(active_ordered_slugs)
        pm_dependency_decisions = order_payload.get("decisions")
        if not isinstance(pm_dependency_decisions, list):
            pm_dependency_decisions = dependency_decisions
        dependency_decisions = [
            dict(item) for item in pm_dependency_decisions if isinstance(item, dict)
        ]

        security_doc = previous_security_doc
        security_seed_issues: List[Dict[str, str]] = []
        if run_security:
            print(
                "pc-prepare-features: security step -> generating docs/01-product/security.md"
            )
            security_doc, security_seed_issues = run_security_role(
                root=root,
                role_mode=args.role_mode,
                prd_text=prd_text,
                context_boundaries=context_boundaries,
                design_text=design_doc,
                ux_text=ux_doc,
                order_payload=order_payload,
                features=features,
                ordered_slugs=ordered_slugs,
                graph=graph,
                dependency_decisions=dependency_decisions,
                prepare_iteration=loop_iteration,
                previous_security_markdown=previous_security_doc,
                pm_feedback=previous_pm_feedback,
                pm_todos=pm_todos,
                previous_loop_change_summary=previous_loop_change_summary,
            )
        elif not security_doc:
            security_doc = security_markdown(
                features=features,
                ordered_slugs=ordered_slugs,
                graph=graph,
                context_boundaries=context_boundaries,
                design_markdown_text=design_doc,
                ux_markdown_text=ux_doc,
                order_payload=order_payload,
            )

        current_loop_change_summary = build_loop_change_summary(
            previous_design_markdown=previous_design_doc,
            current_design_markdown=design_doc,
            previous_ux_markdown=previous_ux_doc,
            current_ux_markdown=ux_doc,
            previous_security_markdown=previous_security_doc,
            current_security_markdown=security_doc,
            previous_order_payload=previous_order_payload,
            current_order_payload=order_payload,
        )

        print("pc-prepare-features: product manager gate -> reviewing artifacts")
        pm_role_payload = run_pm_role(
            root=root,
            role_mode=args.role_mode,
            prd_text=prd_text,
            context_boundaries=context_boundaries,
            design_text=design_doc,
            ux_text=ux_doc,
            order_payload=order_payload,
            features=features,
            ordered_slugs=active_ordered_slugs,
            graph=graph,
            dependency_decisions=pm_dependency_decisions,
            prepare_iteration=loop_iteration,
            previous_design_markdown=previous_design_doc,
            previous_ux_markdown=previous_ux_doc,
            pm_feedback=previous_pm_feedback,
            pm_todos=pm_todos,
            previous_loop_change_summary=current_loop_change_summary,
        )
        pm_role_decision = str(pm_role_payload.get("decision", "BLOCK")).strip().upper()
        issues = product_manager_review(
            features=features,
            ordered_slugs=active_ordered_slugs,
            graph=graph,
            design_text=design_doc,
            ux_text=ux_doc,
            order_payload=order_payload,
            pm_role_payload=pm_role_payload,
            seed_issues=[
                *architect_seed_issues,
                *ux_seed_issues,
                *security_seed_issues,
                *orderer_seed_issues,
            ],
            enforce_semantic_gate=args.role_mode != ROLE_MODE_DETERMINISTIC,
        )

        if issues and args.role_mode == ROLE_MODE_CODEX:
            architect_issues = [item for item in issues if item.step == STEP_ARCHITECT]
            ux_issues = [item for item in issues if item.step == STEP_UX]
            autofix_applied = False
            if architect_issues:
                updated_design = run_markdown_autofix_session(
                    root=root,
                    artifact_label="design.md",
                    current_markdown=design_doc,
                    issues=architect_issues,
                    profile_env="PREPARE_ARCHITECT_AUTOFIX_PROFILE",
                    profile_default="Architect",
                )
                if (
                    updated_design.strip()
                    and updated_design.strip() != design_doc.strip()
                ):
                    design_doc = updated_design
                    autofix_applied = True
            if ux_issues:
                updated_ux = run_markdown_autofix_session(
                    root=root,
                    artifact_label="ux-ui.md",
                    current_markdown=ux_doc,
                    issues=ux_issues,
                    profile_env="PREPARE_UX_AUTOFIX_PROFILE",
                    profile_default="UXUI",
                )
                if updated_ux.strip() and updated_ux.strip() != ux_doc.strip():
                    ux_doc = updated_ux
                    autofix_applied = True
            if autofix_applied:
                print(
                    "pc-prepare-features: architect/ux autofix applied -> re-running PM gate"
                )
                current_loop_change_summary = build_loop_change_summary(
                    previous_design_markdown=previous_design_doc,
                    current_design_markdown=design_doc,
                    previous_ux_markdown=previous_ux_doc,
                    current_ux_markdown=ux_doc,
                    previous_security_markdown=previous_security_doc,
                    current_security_markdown=security_doc,
                    previous_order_payload=previous_order_payload,
                    current_order_payload=order_payload,
                )
                pm_role_payload = run_pm_role(
                    root=root,
                    role_mode=args.role_mode,
                    prd_text=prd_text,
                    context_boundaries=context_boundaries,
                    design_text=design_doc,
                    ux_text=ux_doc,
                    order_payload=order_payload,
                    features=features,
                    ordered_slugs=active_ordered_slugs,
                    graph=graph,
                    dependency_decisions=pm_dependency_decisions,
                    prepare_iteration=loop_iteration,
                    previous_design_markdown=previous_design_doc,
                    previous_ux_markdown=previous_ux_doc,
                    pm_feedback=previous_pm_feedback,
                    pm_todos=pm_todos,
                    previous_loop_change_summary=current_loop_change_summary,
                )
                pm_role_decision = (
                    str(pm_role_payload.get("decision", "BLOCK")).strip().upper()
                )
                issues = product_manager_review(
                    features=features,
                    ordered_slugs=active_ordered_slugs,
                    graph=graph,
                    design_text=design_doc,
                    ux_text=ux_doc,
                    order_payload=order_payload,
                    pm_role_payload=pm_role_payload,
                    seed_issues=[
                        *architect_seed_issues,
                        *ux_seed_issues,
                        *security_seed_issues,
                        *orderer_seed_issues,
                    ],
                    enforce_semantic_gate=args.role_mode != ROLE_MODE_DETERMINISTIC,
                )

        pm_todos, todo_updates = apply_pm_todo_updates(
            pm_todos=pm_todos,
            raw_todo_updates=pm_role_payload.get("todo_updates"),
            review_issues=issues,
            pm_role_decision=pm_role_decision,
            loop_iteration=loop_iteration,
        )
        pm_feedback_snapshot = build_pm_feedback_snapshot(
            pm_role_payload=pm_role_payload,
            review_issues=issues,
            todo_updates=todo_updates,
        )
        pm_feedback_snapshot["loop_change_summary"] = current_loop_change_summary

        if not issues and pm_role_decision == "APPROVE":
            pm_history.append(
                {
                    "iteration": loop_iteration,
                    "gate_id": f"PM-REVIEW-{loop_iteration:03d}",
                    "decision": "approve",
                    "pm_role_decision": pm_role_decision,
                    "issue_count": 0,
                    "issues": [],
                    "pm_feedback": pm_feedback_snapshot,
                }
            )
            pm_final_decision = "approve"
            print("pc-prepare-features: Product Manager decision: APPROVE")
            break

        pm_blocks += 1
        print("pc-prepare-features: Product Manager decision: BLOCK")
        print(render_pm_issues(issues))
        if pm_blocks >= MAX_PM_BLOCKS:
            pm_history.append(
                {
                    "iteration": loop_iteration,
                    "gate_id": f"PM-BLOCK-{pm_blocks:03d}",
                    "decision": "max-block-limit",
                    "pm_role_decision": pm_role_decision,
                    "issue_count": len(issues),
                    "issues": [review_issue_payload(issue) for issue in issues],
                    "pm_feedback": pm_feedback_snapshot,
                }
            )
            pm_final_decision = "blocked-max-limit"
            persist_prepare_state(
                feature_generation_status="not-run",
                schema_check_status="not-run",
                snapshot_label=f"iter-{loop_iteration:03d}-max-block",
            )
            die(
                "pc-prepare-features: PM gate reached max block limit; manual intervention required"
            )

        options = [
            DecisionOption(
                key="retry",
                label="Retry failing steps automatically (Recommended)",
                explanation=(
                    "Re-run only unresolved owner steps (architect/ux/orderer) and retry PM review."
                ),
                risk="If source PRD/context is inconsistent, repeated retries may still block.",
            ),
            DecisionOption(
                key="waive",
                label="Continue with PM waiver",
                explanation="Proceed to generation despite PM findings.",
                risk="Features may be generated with architecture/UX drift.",
            ),
            DecisionOption(
                key="abort",
                label="Abort and fix inputs manually",
                explanation="Stop now and edit PRD/context before rerunning.",
                risk="Preparation run stops until docs are corrected.",
            ),
        ]
        choice = choose_option(
            issue_id=f"PM-BLOCK-{pm_blocks:03d}",
            title="Product Manager blocked prepare loop.",
            options=options,
            overrides=overrides,
        )
        pm_history.append(
            {
                "iteration": loop_iteration,
                "gate_id": f"PM-BLOCK-{pm_blocks:03d}",
                "decision": choice.key,
                "pm_role_decision": pm_role_decision,
                "issue_count": len(issues),
                "issues": [review_issue_payload(issue) for issue in issues],
                "pm_feedback": pm_feedback_snapshot,
            }
        )
        if choice.key == "retry":
            previous_design_doc = design_doc
            previous_ux_doc = ux_doc
            previous_security_doc = security_doc
            previous_order_payload = dict(order_payload)
            previous_pm_feedback = [review_issue_payload(issue) for issue in issues]
            previous_loop_change_summary = current_loop_change_summary
            retry_owner_scope = retry_owner_scope_from_issues(issues)
            persist_prepare_state(
                feature_generation_status=in_loop_feature_generation_status,
                schema_check_status=in_loop_schema_check_status,
                snapshot_label=f"iter-{loop_iteration:03d}-retry",
            )
            continue
        if choice.key == "waive":
            pm_final_decision = "waive"
            print("pc-prepare-features: proceeding with PM waiver")
            break
        pm_final_decision = "abort"
        persist_prepare_state(
            feature_generation_status="not-run",
            schema_check_status="not-run",
            snapshot_label=f"iter-{loop_iteration:03d}-abort",
        )
        die("pc-prepare-features: aborted by user at PM gate")

    feature_generation_status = in_loop_feature_generation_status
    schema_check_status = in_loop_schema_check_status
    persist_prepare_state(
        feature_generation_status=feature_generation_status,
        schema_check_status=schema_check_status,
        snapshot_label="post-gate",
        promote=pm_final_decision in {"approve", "waive"},
    )

    if args.skip_generation:
        print(
            "pc-prepare-features: --skip-generation set; stopping before tools/prd-to-features"
        )
        return 0

    run_command(
        root,
        [
            str(root / PRD_TOOL_PATH),
            f"--root={root}",
            *(["--include-process-features"] if args.include_process_features else []),
        ],
        label="feature generation",
    )
    feature_generation_status = "completed"
    persist_prepare_state(
        feature_generation_status=feature_generation_status,
        schema_check_status=schema_check_status,
        snapshot_label="post-generation",
        promote=True,
    )

    if not args.skip_schema_check:
        run_command(
            root,
            [str(root / "tools" / "pc-devtasks-schema-check"), f"--root={root}"],
            label="feature schema validation",
        )
        schema_check_status = "completed"
        persist_prepare_state(
            feature_generation_status=feature_generation_status,
            schema_check_status=schema_check_status,
            snapshot_label="post-schema",
            promote=True,
        )

    print("pc-prepare-features: complete")
    return 0


def main(argv: Optional[Sequence[str]] = None) -> int:
    args = parse_args(argv)
    return run_prepare(args)


if __name__ == "__main__":
    raise SystemExit(main())
