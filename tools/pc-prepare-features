def die(message: str) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(1)


def parse_args(argv: Optional[Sequence[str]] = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Run global prepare workflow: Architect -> UX -> Security -> dependency "
            "planner -> Orderer -> Product Manager gate -> feature generation."
        )
    )
    parser.add_argument(
        "--root",
        default=str(ROOT),
        help="Repository root (defaults to detected root).",
    )
    parser.add_argument(
        "--skip-generation",
        action="store_true",
        help="Generate docs/order and PM-review only; skip tools/prd-to-features.",
    )
    parser.add_argument(
        "--skip-schema-check",
        action="store_true",
        help="Skip tools/pc-devtasks-schema-check at the end of generation.",
    )
    parser.add_argument(
        "--role-mode",
        choices=(ROLE_MODE_CODEX, ROLE_MODE_DETERMINISTIC),
        default=default_role_mode(),
        help=(
            "Role execution mode for Architect/UX/Orderer/PM steps. "
            "'codex' runs prompt-driven role execution; "
            "'deterministic' uses local fallback generators."
        ),
    )
    parser.add_argument(
        "--include-process-features",
        action="store_true",
        help=(
            "Include PRD '## Process Features' entries in dependency planning and "
            "feature generation. Disabled by default."
        ),
    )
    parser.add_argument(
        "--snapshot-runs",
        action="store_true",
        help=(
            "Write per-run prepare snapshots under docs/03-logs/prepare-features-runs/"
            "<run-id>/."
        ),
    )
    return parser.parse_args(argv)


def default_role_mode() -> str:
    raw = os.environ.get("PREPARE_ROLE_MODE", ROLE_MODE_CODEX).strip().lower()
    if raw in {ROLE_MODE_CODEX, ROLE_MODE_DETERMINISTIC}:
        return raw
    return ROLE_MODE_CODEX


def load_prd_tool(root: Path):
    tool_path = root / PRD_TOOL_PATH
    if not tool_path.exists():
        raise FileNotFoundError(f"Missing tool: {tool_path}")
    loader = SourceFileLoader("prepare_features_prd_tool", str(tool_path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise RuntimeError("pc-prepare-features: failed to initialize PRD tool loader")
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def parse_override_choices(raw: str) -> Dict[str, int]:
    overrides: Dict[str, int] = {}
    if not raw.strip():
        return overrides
    for item in raw.split(","):
        token = item.strip()
        if not token:
            continue
        if ":" not in token:
            continue
        issue_id, value = token.split(":", 1)
        issue_key = issue_id.strip()
        try:
            choice = int(value.strip())
        except ValueError:
            continue
        if issue_key:
            overrides[issue_key] = choice
    return overrides


def resolve_override_choice(
    issue_id: str, overrides: Dict[str, int]
) -> Tuple[Optional[int], Optional[str]]:
    if issue_id in overrides:
        return overrides[issue_id], issue_id

    fallback_key: Optional[str] = None
    fallback_choice: Optional[int] = None
    for key, choice in overrides.items():
        if key == issue_id:
            continue
        if not issue_id.startswith(key):
            continue
        if fallback_key is None or len(key) > len(fallback_key):
            fallback_key = key
            fallback_choice = choice
    return fallback_choice, fallback_key


def choose_option(
    *,
    issue_id: str,
    title: str,
    options: Sequence[DecisionOption],
    overrides: Dict[str, int],
) -> DecisionOption:
    if len(options) < 2:
        die(f"pc-prepare-features: issue {issue_id} requires at least 2 choices")
    if len(options) > 4:
        die(f"pc-prepare-features: issue {issue_id} supports at most 4 choices")

    override_choice, override_key = resolve_override_choice(issue_id, overrides)
    if override_choice is not None:
        if 1 <= override_choice <= len(options):
            selected = options[override_choice - 1]
            alias_note = ""
            if override_key and override_key != issue_id:
                alias_note = f" via alias '{override_key}'"
            print(
                f"pc-prepare-features: {issue_id} override selected "
                f"[{override_choice}] {selected.label}{alias_note}"
            )
            return selected
        die(
            "pc-prepare-features: invalid PREPARE_DECISIONS entry for "
            f"{override_key or issue_id}; expected 1..{len(options)}"
        )

    print(f"\npc-prepare-features: {issue_id}")
    print(title)
    for idx, option in enumerate(options, start=1):
        print(f"  {idx}. {option.label}")
        print(f"     - Explanation: {option.explanation}")
        print(f"     - Risk: {option.risk}")

    if not sys.stdin.isatty():
        die(
            "pc-prepare-features: interactive decision required in non-interactive "
            "session. Re-run with PREPARE_DECISIONS='<issue-id>:<choice>'."
        )

    while True:
        raw = input(f"Select option [1-{len(options)}]: ").strip()
        if not raw:
            continue
        if not raw.isdigit():
            print("Please enter a number.")
            continue
        number = int(raw)
        if 1 <= number <= len(options):
            return options[number - 1]
        print(f"Please enter a number between 1 and {len(options)}.")


def normalize_tokens(raw: str) -> str:
    return re.sub(r"\s+", " ", raw.strip().lower())


def compact_slug(raw: str) -> str:
    return re.sub(r"[^a-z0-9]+", "-", raw.strip().lower()).strip("-")


def parse_features(
    prd_module, prd_text: str, *, include_process_features: bool
) -> List[Feature]:
    parse_fn = getattr(prd_module, "parse_prd_features", None)
    if not callable(parse_fn):
        die("pc-prepare-features: loaded PRD tool has no parse_prd_features function")
    try:
        parsed = parse_fn(
            prd_text, include_process_features=bool(include_process_features)
        )
    except TypeError:
        parsed = parse_fn(prd_text)
        if not include_process_features:
            parsed = [
                item
                for item in parsed
                if str(getattr(item, "source", "")).strip().lower() != "process"
            ]

    features: List[Feature] = []
    for item in parsed:
        dependencies = tuple(getattr(item, "dependencies", ()) or ())
        features.append(
            Feature(
                title=str(item.title).strip(),
                priority=str(item.priority).strip(),
                slug=str(item.slug).strip(),
                dependencies=tuple(
                    str(dep).strip() for dep in dependencies if str(dep).strip()
                ),
                outcome=str(getattr(item, "outcome", "")).strip(),
                notes=str(getattr(item, "notes", "")).strip(),
            )
        )
    return features


def feature_title_map(features: Sequence[Feature]) -> Dict[str, str]:
    mapping: Dict[str, str] = {}
    for feature in features:
        key = normalize_tokens(feature.title)
        if key and key not in mapping:
            mapping[key] = feature.slug
    return mapping


def try_resolve_dependency(
    token: str,
    *,
    all_slugs: Set[str],
    title_map: Dict[str, str],
    index_to_slug: Dict[str, str],
) -> Optional[str]:
    candidate = token.strip()
    if not candidate:
        return None

    slug_candidate = compact_slug(candidate)
    if slug_candidate in all_slugs:
        return slug_candidate

    if candidate in index_to_slug:
        return index_to_slug[candidate]
    if candidate.zfill(2) in index_to_slug:
        return index_to_slug[candidate.zfill(2)]

    prefixed = re.match(r"^(\d{1,2})-", candidate)
    if prefixed:
        idx = prefixed.group(1).zfill(2)
        if idx in index_to_slug:
            return index_to_slug[idx]

    title_key = normalize_tokens(candidate)
    if title_key in title_map:
        return title_map[title_key]

    no_quotes = candidate.replace("`", "").replace('"', "")
    no_quotes_key = normalize_tokens(no_quotes)
    if no_quotes_key in title_map:
        return title_map[no_quotes_key]

    return None


def suggest_dependency_candidates(token: str, features: Sequence[Feature]) -> List[str]:
    token_slug = compact_slug(token)
    scored: List[Tuple[int, str]] = []
    for feature in features:
        score = 0
        if token_slug and token_slug in feature.slug:
            score += 3
        title_key = normalize_tokens(feature.title)
        if token_slug and token_slug in compact_slug(title_key):
            score += 2
        if token.strip() and token.strip().lower() in feature.title.lower():
            score += 2
        if score > 0:
            scored.append((score, feature.slug))
    scored.sort(key=lambda item: (-item[0], item[1]))
    ordered: List[str] = []
    for _, slug in scored:
        if slug in ordered:
            continue
        ordered.append(slug)
        if len(ordered) == 2:
            break
    return ordered


def find_cycle_nodes(graph: Dict[str, Set[str]]) -> List[str]:
    visiting: Set[str] = set()
    visited: Set[str] = set()
    stack: List[str] = []

    def dfs(node: str) -> List[str]:
        visiting.add(node)
        stack.append(node)
        for dep in sorted(graph.get(node, set())):
            if dep not in graph:
                continue
            if dep in visiting:
                start_idx = stack.index(dep)
                return stack[start_idx:] + [dep]
            if dep in visited:
                continue
            cycle = dfs(dep)
            if cycle:
                return cycle
        stack.pop()
        visiting.remove(node)
        visited.add(node)
        return []

    for node in sorted(graph):
        if node in visited:
            continue
        cycle = dfs(node)
        if cycle:
            return cycle
    return []


def topo_order(
    slugs_in_priority_order: Sequence[str], graph: Dict[str, Set[str]]
) -> List[str]:
    incoming = {slug: set(graph.get(slug, set())) for slug in slugs_in_priority_order}
    dependents: Dict[str, Set[str]] = {slug: set() for slug in slugs_in_priority_order}
    for slug, deps in incoming.items():
        for dep in deps:
            if dep not in dependents:
                continue
            dependents[dep].add(slug)

    priority_idx = {slug: idx for idx, slug in enumerate(slugs_in_priority_order)}
    ready = [slug for slug, deps in incoming.items() if not deps]
    ready.sort(key=lambda value: priority_idx.get(value, 10_000))

    ordered: List[str] = []
    while ready:
        current = ready.pop(0)
        ordered.append(current)
        for dependent in sorted(
            dependents.get(current, set()),
            key=lambda value: priority_idx.get(value, 10_000),
        ):
            deps = incoming[dependent]
            if current in deps:
                deps.remove(current)
            if not deps and dependent not in ordered and dependent not in ready:
                ready.append(dependent)
        ready.sort(key=lambda value: priority_idx.get(value, 10_000))

    return ordered


def resolve_dependency_graph(
    features: Sequence[Feature],
    *,
    overrides: Dict[str, int],
) -> Tuple[Dict[str, Set[str]], List[Dict[str, str]]]:
    slugs_in_priority_order = [feature.slug for feature in features]
    all_slugs = set(slugs_in_priority_order)
    title_map = feature_title_map(features)
    index_to_slug = {
        f"{idx + 1:02d}": slug for idx, slug in enumerate(slugs_in_priority_order)
    }

    decisions: List[Dict[str, str]] = []
    graph: Dict[str, Set[str]] = {feature.slug: set() for feature in features}
    issue_counter = 1

    for feature in features:
        for token in feature.dependencies:
            resolved = try_resolve_dependency(
                token,
                all_slugs=all_slugs,
                title_map=title_map,
                index_to_slug=index_to_slug,
            )
            if resolved and resolved != feature.slug:
                graph[feature.slug].add(resolved)
                continue
            if resolved == feature.slug:
                issue_id = f"AMB-{issue_counter:03d}"
                issue_counter += 1
                options = [
                    DecisionOption(
                        key="ignore",
                        label="Ignore self-dependency (Recommended)",
                        explanation=(
                            f"Drop self-dependency '{token}' on '{feature.slug}' so ordering can proceed."
                        ),
                        risk="May hide a mistaken PRD dependency if self-reference was accidental.",
                    ),
                    DecisionOption(
                        key="abort",
                        label="Abort and fix PRD manually",
                        explanation="Stop now and update PRD dependency definitions.",
                        risk="Preparation run stops until PRD is corrected.",
                    ),
                ]
                choice = choose_option(
                    issue_id=issue_id,
                    title=(
                        f"Dependency '{token}' on '{feature.title}' resolves to the same feature."
                    ),
                    options=options,
                    overrides=overrides,
                )
                decisions.append(
                    {
                        "issue_id": issue_id,
                        "type": "self_dependency",
                        "feature_slug": feature.slug,
                        "dependency": token,
                        "selected": choice.key,
                        "risk": choice.risk,
                    }
                )
                if choice.key == "abort":
                    die(
                        "pc-prepare-features: aborted by user during dependency resolution"
                    )
                continue

            suggestions = suggest_dependency_candidates(token, features)
            issue_id = f"AMB-{issue_counter:03d}"
            issue_counter += 1
            options: List[DecisionOption] = []
            if suggestions:
                options.append(
                    DecisionOption(
                        key=f"map:{suggestions[0]}",
                        label=f"Map to '{suggestions[0]}' (Recommended)",
                        explanation=(
                            f"Resolve unknown dependency '{token}' to closest known feature slug '{suggestions[0]}'."
                        ),
                        risk="Could map to the wrong prerequisite if naming is ambiguous.",
                    )
                )
                if len(suggestions) > 1:
                    options.append(
                        DecisionOption(
                            key=f"map:{suggestions[1]}",
                            label=f"Map to '{suggestions[1]}'",
                            explanation=(
                                f"Alternative mapping for '{token}' to '{suggestions[1]}'."
                            ),
                            risk="Alternative mapping may still be incorrect and alter generation order.",
                        )
                    )
            options.append(
                DecisionOption(
                    key="ignore",
                    label="Ignore this dependency",
                    explanation=(
                        "Continue without this edge; feature ordering will not enforce this prerequisite."
                    ),
                    risk="Feature may be generated before a true prerequisite.",
                )
            )
            options.append(
                DecisionOption(
                    key="abort",
                    label="Abort and fix PRD manually",
                    explanation="Stop now and update PRD dependency definitions.",
                    risk="Preparation run stops until PRD is corrected.",
                )
            )

            choice = choose_option(
                issue_id=issue_id,
                title=(
                    f"Dependency '{token}' on feature '{feature.title}' does not match any known feature."
                ),
                options=options,
                overrides=overrides,
            )
            decisions.append(
                {
                    "issue_id": issue_id,
                    "type": "unknown_dependency",
                    "feature_slug": feature.slug,
                    "dependency": token,
                    "selected": choice.key,
                    "risk": choice.risk,
                }
            )
            if choice.key == "abort":
                die("pc-prepare-features: aborted by user during dependency resolution")
            if choice.key.startswith("map:"):
                mapped = choice.key.split(":", 1)[1]
                if mapped and mapped != feature.slug:
                    graph[feature.slug].add(mapped)

    cycle_counter = 1
    while True:
        ordered = topo_order(slugs_in_priority_order, graph)
        if len(ordered) == len(slugs_in_priority_order):
            break
        cycle_nodes = find_cycle_nodes(graph)
        if not cycle_nodes:
            die("pc-prepare-features: dependency graph contains unresolved cycle")

        cycle_edges: List[Tuple[str, str]] = []
        for idx in range(len(cycle_nodes) - 1):
            left = cycle_nodes[idx]
            right = cycle_nodes[idx + 1]
            if right in graph.get(left, set()):
                cycle_edges.append((left, right))
        if not cycle_edges:
            die("pc-prepare-features: cycle detected but no removable edge found")

        issue_id = f"CYCLE-{cycle_counter:03d}"
        cycle_counter += 1
        options: List[DecisionOption] = []
        for left, right in cycle_edges[:3]:
            options.append(
                DecisionOption(
                    key=f"drop:{left}:{right}",
                    label=f"Drop edge '{left}' depends on '{right}' (Recommended)",
                    explanation=(
                        f"Remove dependency edge '{left} -> {right}' to break the cycle."
                    ),
                    risk="May allow this feature to be generated before a true prerequisite.",
                )
            )
        options.append(
            DecisionOption(
                key="abort",
                label="Abort and fix PRD manually",
                explanation="Stop now and rewrite cyclical dependencies in PRD.",
                risk="Preparation run stops until PRD dependencies are corrected.",
            )
        )

        cycle_path = " -> ".join(cycle_nodes)
        choice = choose_option(
            issue_id=issue_id,
            title=f"Dependency cycle detected: {cycle_path}",
            options=options,
            overrides=overrides,
        )
        decisions.append(
            {
                "issue_id": issue_id,
                "type": "cycle",
                "cycle": cycle_path,
                "selected": choice.key,
                "risk": choice.risk,
            }
        )
        if choice.key == "abort":
            die("pc-prepare-features: aborted by user due to dependency cycle")

        _, left, right = choice.key.split(":", 2)
        if right in graph.get(left, set()):
            graph[left].remove(right)

    return graph, decisions


def extract_section_bullets(content: str, heading: str) -> List[str]:
    section_pattern = re.compile(
        rf"^##\s+{re.escape(heading)}\s*$", re.MULTILINE | re.IGNORECASE
    )
    match = section_pattern.search(content)
    if not match:
        return []
    start = match.end()
    next_heading = re.search(r"^##\s+", content[start:], re.MULTILINE)
    end = start + next_heading.start() if next_heading else len(content)
    section = content[start:end]
    bullets: List[str] = []
    for line in section.splitlines():
        stripped = line.strip()
        if stripped.startswith("- "):
            bullets.append(stripped[2:].strip())
    return bullets


def extract_json_payload(raw: str) -> str:
    start = raw.find("{")
    end = raw.rfind("}")
    if start == -1 or end == -1 or end < start:
        return raw
    return raw[start : end + 1]


def load_prompt_template(root: Path, prompt_rel_path: Path) -> str:
    prompt_path = root / prompt_rel_path
    if not prompt_path.exists():
        die(
            "pc-prepare-features: missing prompt template "
            f"{prompt_path}; restore prompts under {root / PROMPTS_DIR}"
        )
    return prompt_path.read_text(encoding="utf-8")


def render_prompt_template(template: str, values: Dict[str, str]) -> str:
    class StrictMap(dict):
        def __missing__(self, key):
            die(f"pc-prepare-features: prompt template missing value for '{key}'")
            return ""

    return template.format_map(StrictMap(values))


def truncate_for_error(raw: str, max_chars: int = 800) -> str:
    compact = re.sub(r"\s+", " ", raw.strip())
    if len(compact) <= max_chars:
        return compact
    return compact[:max_chars].rstrip() + "..."


def codex_exec_json(
    *,
    root: Path,
    prompt: str,
    profile: str,
    label: str,
) -> Dict[str, Any]:
    if shutil.which("codex") is None:
        raise RuntimeError("codex CLI not found in PATH")

    cmd = ["codex", "-C", str(root), "--profile", profile, "exec", prompt]
    result = subprocess.run(
        cmd,
        cwd=str(root),
        check=False,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if result.returncode != 0:
        combined = "\n".join(part for part in [result.stdout, result.stderr] if part)
        raise RuntimeError(
            f"{label} role execution failed with exit {result.returncode}: "
            f"{truncate_for_error(combined)}"
        )
    payload = extract_json_payload(result.stdout or "")
    try:
        data = json.loads(payload)
    except json.JSONDecodeError as exc:
        raise RuntimeError(
            f"{label} role returned non-JSON output: {truncate_for_error(result.stdout or '')}"
        ) from exc
    if not isinstance(data, dict):
        raise RuntimeError(f"{label} role JSON payload must be an object")
    return data


def feature_context_payload(
    *,
    features: Sequence[Feature],
    ordered_slugs: Sequence[str],
    graph: Dict[str, Set[str]],
) -> List[Dict[str, Any]]:
    by_slug = {feature.slug: feature for feature in features}
    payload: List[Dict[str, Any]] = []
    for idx, slug in enumerate(ordered_slugs, start=1):
        feature = by_slug.get(slug)
        if not feature:
            continue
        payload.append(
            {
                "index": idx,
                "slug": feature.slug,
                "title": feature.title,
                "priority": feature.priority,
                "dependencies": sorted(graph.get(feature.slug, set())),
                "outcome": feature.outcome,
                "notes": feature.notes,
            }
        )
    return payload


def normalize_step_token(raw_step: Any) -> str:
    token = re.sub(r"[^a-z0-9]+", "-", str(raw_step).strip().lower())
    return token.strip("-")


def normalize_prepare_step_with_known(
    raw_step: Any, *, default: str = STEP_PRODUCT_MANAGER
) -> Tuple[str, bool]:
    token = normalize_step_token(raw_step)
    default_token = normalize_step_token(default)
    if default_token not in CANONICAL_PREPARE_STEPS:
        default_token = STEP_PRODUCT_MANAGER
    if not token:
        return default_token, False

    direct_aliases = {
        "architect": STEP_ARCHITECT,
        "architecture": STEP_ARCHITECT,
        "ux": STEP_UX,
        "ui": STEP_UX,
        "ux-ui": STEP_UX,
        "ux-ui-role": STEP_UX,
        "uxui": STEP_UX,
        "designer": STEP_UX,
        "dependency-planner": STEP_DEPENDENCY_PLANNER,
        "dependency-planning": STEP_DEPENDENCY_PLANNER,
        "dependency-planner-step": STEP_DEPENDENCY_PLANNER,
        "dependency-decision-records": STEP_DEPENDENCY_PLANNER,
        "dependency-decision-record": STEP_DEPENDENCY_PLANNER,
        "dependency-decision": STEP_DEPENDENCY_PLANNER,
        "feature-order-json-ordering": STEP_DEPENDENCY_PLANNER,
        "feature-order-ordering": STEP_DEPENDENCY_PLANNER,
        "feature-order-json": STEP_DEPENDENCY_PLANNER,
        "feature-order-md": STEP_DEPENDENCY_PLANNER,
        "feature-order": STEP_DEPENDENCY_PLANNER,
        "orderer": STEP_DEPENDENCY_PLANNER,
        "ordering": STEP_DEPENDENCY_PLANNER,
        "order": STEP_DEPENDENCY_PLANNER,
        "security": STEP_SECURITY,
        "security-expert": STEP_SECURITY,
        "security-review": STEP_SECURITY,
        "security-blueprint": STEP_SECURITY,
        "security-md": STEP_SECURITY,
        "product-manager": STEP_PRODUCT_MANAGER,
        "product-manager-gate": STEP_PRODUCT_MANAGER,
        "product_manager": STEP_PRODUCT_MANAGER,
        "pm": STEP_PRODUCT_MANAGER,
    }
    if token in direct_aliases:
        return direct_aliases[token], True
    if "feature-order" in token:
        return STEP_DEPENDENCY_PLANNER, True
    if token.startswith("dependency-decision"):
        return STEP_DEPENDENCY_PLANNER, True
    if "dependency" in token and "order" in token:
        return STEP_DEPENDENCY_PLANNER, True
    if "security" in token:
        return STEP_SECURITY, True
    if "architect" in token or "architecture" in token:
        return STEP_ARCHITECT, True
    if token in {"uxui", "ux-ui"} or token.startswith("ux-"):
        return STEP_UX, True
    if token.startswith("pm-") or "product-manager" in token:
        return STEP_PRODUCT_MANAGER, True
    return default_token, False


def normalize_prepare_step(
    raw_step: Any, *, default: str = STEP_PRODUCT_MANAGER
) -> str:
    normalized, _ = normalize_prepare_step_with_known(raw_step, default=default)
    return normalized


def infer_issue_owner(
    *,
    step: Any,
    summary: str = "",
    remediation: str = "",
    default: str = TODO_OWNER_ARCHITECT,
) -> str:
    normalized_step = normalize_prepare_step(step, default=STEP_PRODUCT_MANAGER)
    if normalized_step in TODO_OWNERS:
        return normalized_step

    text = f"{summary} {remediation}".lower()
    if any(
        marker in text
        for marker in {
            "feature-order",
            "dependency",
            "ordering",
            "pipeline-first",
            "order payload",
            "ordered_feature_slugs",
        }
    ):
        return TODO_OWNER_DEPENDENCY_PLANNER
    if any(
        marker in text for marker in {"ux", "ui", "journey", "workflows", "workflow"}
    ):
        return TODO_OWNER_UX
    if any(
        marker in text
        for marker in {
            "security",
            "threat",
            "redaction",
            "secret",
            "credential",
            "authorization",
            "authn",
            "authz",
            "path traversal",
            "least privilege",
        }
    ):
        return TODO_OWNER_SECURITY
    if any(
        marker in text
        for marker in {"architect", "architecture", "design.md", "module", "infra"}
    ):
        return TODO_OWNER_ARCHITECT

    fallback = normalize_prepare_step(default, default=TODO_OWNER_ARCHITECT)
    if fallback in TODO_OWNERS:
        return fallback
    return TODO_OWNER_ARCHITECT


def normalize_todo_owner(raw_owner: Any, *, default: str = TODO_OWNER_ARCHITECT) -> str:
    return infer_issue_owner(step=raw_owner, default=default)


def normalize_todo_status(raw_status: Any, *, default: str = TODO_STATUS_OPEN) -> str:
    token = str(raw_status).strip().lower()
    if token in {"done", "closed", "resolved", "complete", "completed"}:
        return TODO_STATUS_DONE
    if token in {"carry", "carried", "carry-forward", "carry_forward", "blocked"}:
        return TODO_STATUS_CARRY
    if token in {"open", "todo", "pending", "new", "in-progress", "in_progress"}:
        return TODO_STATUS_OPEN
    return default


def owner_actionable_todos(
    pm_todos: Sequence[Dict[str, Any]], *, owner: str
) -> List[Dict[str, Any]]:
    normalized_owner = normalize_todo_owner(owner, default=owner)
    actionable: List[Dict[str, Any]] = []
    for todo in pm_todos:
        status = normalize_todo_status(todo.get("status"), default=TODO_STATUS_OPEN)
        todo_owner = normalize_todo_owner(todo.get("owner"))
        if todo_owner != normalized_owner:
            continue
        if status not in {TODO_STATUS_OPEN, TODO_STATUS_CARRY}:
            continue
        actionable.append(dict(todo))
    return actionable


def summarize_markdown_diff(
    *,
    previous_text: str,
    current_text: str,
    label: str,
    max_lines: int = 40,
) -> str:
    previous = previous_text.strip()
    current = current_text.strip()
    if not previous:
        return f"{label}: first iteration baseline (no previous artifact)."
    if previous == current:
        return f"{label}: no changes."

    diff_lines = list(
        difflib.unified_diff(
            previous.splitlines(),
            current.splitlines(),
            fromfile=f"previous/{label}",
            tofile=f"current/{label}",
            lineterm="",
        )
    )
    if len(diff_lines) > max_lines:
        diff_lines = [*diff_lines[:max_lines], "... (truncated)"]
    return "\n".join(diff_lines)


def build_loop_change_summary(
    *,
    previous_design_markdown: str,
    current_design_markdown: str,
    previous_ux_markdown: str,
    current_ux_markdown: str,
    previous_security_markdown: str = "",
    current_security_markdown: str = "",
    previous_order_payload: Optional[Dict[str, Any]] = None,
    current_order_payload: Optional[Dict[str, Any]] = None,
) -> str:
    previous_order_json = (
        json.dumps(
            previous_order_payload or {}, ensure_ascii=True, indent=2, sort_keys=True
        )
        if previous_order_payload
        else ""
    )
    current_order_json = json.dumps(
        current_order_payload or {}, ensure_ascii=True, indent=2, sort_keys=True
    )
    sections = [
        "## design.md diff",
        summarize_markdown_diff(
            previous_text=previous_design_markdown,
            current_text=current_design_markdown,
            label="design.md",
        ),
        "",
        "## ux-ui.md diff",
        summarize_markdown_diff(
            previous_text=previous_ux_markdown,
            current_text=current_ux_markdown,
            label="ux-ui.md",
        ),
        "",
        "## security.md diff",
        summarize_markdown_diff(
            previous_text=previous_security_markdown,
            current_text=current_security_markdown,
            label="security.md",
        ),
        "",
        "## feature-order.json diff",
        summarize_markdown_diff(
            previous_text=previous_order_json,
            current_text=current_order_json,
            label="feature-order.json",
        ),
    ]
    return "\n".join(sections).strip()


def prompt_values(
    *,
    features: Sequence[Feature],
    ordered_slugs: Sequence[str],
    graph: Dict[str, Set[str]],
    prd_text: str,
    context_boundaries: str,
    dependency_decisions: Sequence[Dict[str, Any]],
    prepare_iteration: int = 1,
    previous_design_markdown: str = "",
    previous_ux_markdown: str = "",
    previous_security_markdown: str = "",
    previous_order_payload: Optional[Dict[str, Any]] = None,
    pm_feedback: Sequence[Dict[str, str]] = (),
    pm_todos: Sequence[Dict[str, Any]] = (),
    previous_loop_change_summary: str = "",
) -> Dict[str, str]:
    feature_payload = feature_context_payload(
        features=features, ordered_slugs=ordered_slugs, graph=graph
    )
    pm_todo_payload = [dict(item) for item in pm_todos]
    architect_todos = owner_actionable_todos(
        pm_todo_payload, owner=TODO_OWNER_ARCHITECT
    )
    ux_todos = owner_actionable_todos(pm_todo_payload, owner=TODO_OWNER_UX)
    security_todos = owner_actionable_todos(pm_todo_payload, owner=TODO_OWNER_SECURITY)
    orderer_todos = owner_actionable_todos(
        pm_todo_payload, owner=TODO_OWNER_DEPENDENCY_PLANNER
    )
    return {
        "prd_markdown": prd_text,
        "context_boundaries_markdown": context_boundaries,
        "ordered_features_json": json.dumps(
            feature_payload, ensure_ascii=True, indent=2, sort_keys=True
        ),
        "dependency_decisions_json": json.dumps(
            list(dependency_decisions), ensure_ascii=True, indent=2, sort_keys=True
        ),
        "prepare_iteration": str(prepare_iteration),
        "previous_design_markdown": previous_design_markdown,
        "previous_ux_markdown": previous_ux_markdown,
        "previous_security_markdown": previous_security_markdown,
        "previous_order_payload_json": json.dumps(
            previous_order_payload or {}, ensure_ascii=True, indent=2, sort_keys=True
        ),
        "pm_feedback_json": json.dumps(
            list(pm_feedback), ensure_ascii=True, indent=2, sort_keys=True
        ),
        "pm_todos_json": json.dumps(
            pm_todo_payload, ensure_ascii=True, indent=2, sort_keys=True
        ),
        "architect_open_todos_json": json.dumps(
            architect_todos, ensure_ascii=True, indent=2, sort_keys=True
        ),
        "ux_open_todos_json": json.dumps(
            ux_todos, ensure_ascii=True, indent=2, sort_keys=True
        ),
        "security_open_todos_json": json.dumps(
            security_todos, ensure_ascii=True, indent=2, sort_keys=True
        ),
        "orderer_open_todos_json": json.dumps(
            orderer_todos, ensure_ascii=True, indent=2, sort_keys=True
        ),
        "previous_loop_change_summary": previous_loop_change_summary,
    }


def normalize_role_issues(
    *,
    raw_issues: Any,
    default_step: str,
    source: str,
) -> List[Dict[str, str]]:
    default_canonical = normalize_prepare_step(
        default_step, default=STEP_PRODUCT_MANAGER
    )
    if raw_issues is None:
        return []
    if not isinstance(raw_issues, list):
        return [
            {
                "step": default_canonical,
                "summary": f"{source} returned non-list issues payload.",
                "risk": "Malformed role output can bypass semantic gates.",
                "remediation": f"Fix {source} prompt output to return issues as a JSON list.",
            }
        ]

    issues: List[Dict[str, str]] = []
    for item in raw_issues:
        if not isinstance(item, dict):
            continue
        summary = str(item.get("summary", "")).strip()
        if not summary:
            continue
        issues.append(
            {
                "step": normalize_prepare_step(
                    item.get("step", default_canonical), default=default_canonical
                ),
                "summary": summary,
                "risk": str(item.get("risk", "")).strip()
                or "Role output lacks semantic confidence.",
                "remediation": str(item.get("remediation", "")).strip()
                or "Update role output to include project-specific rationale and concrete fixes.",
            }
        )
    return issues


def canonical_level2_heading(raw_heading: Any) -> str:
    return re.sub(r"\s+", " ", str(raw_heading).strip().lower())


def parse_level2_sections(markdown: str) -> Dict[str, str]:
    sections: Dict[str, str] = {}
    active_heading = ""
    active_lines: List[str] = []
    for raw_line in markdown.splitlines():
        heading_match = re.match(r"^##\s+(.+?)\s*$", raw_line.strip())
        if heading_match:
            if active_heading:
                sections[active_heading] = "\n".join(active_lines).strip()
            active_heading = canonical_level2_heading(heading_match.group(1))
            active_lines = []
            continue
        if active_heading:
            active_lines.append(raw_line.rstrip())
    if active_heading:
        sections[active_heading] = "\n".join(active_lines).strip()
    return sections


def changed_level2_sections(
    *, previous_markdown: str, current_markdown: str
) -> List[str]:
    previous_sections = parse_level2_sections(previous_markdown)
    current_sections = parse_level2_sections(current_markdown)
    changed: List[str] = []
    for heading in sorted(set(previous_sections) | set(current_sections)):
        if (
            previous_sections.get(heading, "").strip()
            == current_sections.get(heading, "").strip()
        ):
            continue
        changed.append(heading)
    return changed


def normalize_changed_sections(raw_changed_sections: Any) -> List[str]:
    if not isinstance(raw_changed_sections, list):
        return []
    normalized: List[str] = []
    seen: Set[str] = set()
    for item in raw_changed_sections:
        heading = canonical_level2_heading(item)
        if not heading or heading in seen:
            continue
        normalized.append(heading)
        seen.add(heading)
    return normalized


def role_has_relevant_pm_feedback(
    *,
    pm_feedback: Sequence[Dict[str, str]],
    owner: str,
) -> bool:
    normalized_owner = normalize_todo_owner(owner, default=owner)
    for item in pm_feedback:
        if not isinstance(item, dict):
            continue
        issue_owner = infer_issue_owner(
            step=item.get("step"),
            summary=str(item.get("summary", "")),
            remediation=str(item.get("remediation", "")),
            default=normalized_owner,
        )
        if issue_owner == normalized_owner:
            return True
    return False


def role_change_contract_issues(
    *,
    role_step: str,
    role_label: str,
    prepare_iteration: int,
    previous_markdown: str,
    current_markdown: str,
    pm_feedback: Sequence[Dict[str, str]],
    pm_todos: Sequence[Dict[str, Any]],
    changed_sections_payload: Any,
    change_rationale: str,
) -> List[Dict[str, str]]:
    if prepare_iteration <= 1 or not previous_markdown.strip():
        return []

    normalized_owner = normalize_todo_owner(role_step, default=role_step)
    actionable_todos = owner_actionable_todos(pm_todos, owner=normalized_owner)
    has_relevant_feedback = role_has_relevant_pm_feedback(
        pm_feedback=pm_feedback, owner=normalized_owner
    )
    expects_no_change = not actionable_todos and not has_relevant_feedback

    previous_body = previous_markdown.strip()
    current_body = current_markdown.strip()
    changed = previous_body != current_body
    declared_sections = normalize_changed_sections(changed_sections_payload)
    actual_sections = (
        changed_level2_sections(
            previous_markdown=previous_markdown, current_markdown=current_markdown
        )
        if changed
        else []
    )

    issues: List[Dict[str, str]] = []
    if expects_no_change:
        if changed:
            issues.append(
                {
                    "step": role_step,
                    "summary": (
                        f"{role_label} changed artifact content without actionable "
                        "PM TODO/feedback in this iteration."
                    ),
                    "risk": "Unnecessary rewrites increase diff noise and can hide real fixes.",
                    "remediation": (
                        f"Return previous {role_label.lower()} artifact unchanged when no "
                        "owner-scoped open/carry TODOs or relevant PM feedback exist."
                    ),
                }
            )
        if declared_sections:
            issues.append(
                {
                    "step": role_step,
                    "summary": (
                        f"{role_label} reported changed_sections despite no actionable "
                        "PM TODO/feedback."
                    ),
                    "risk": "Change metadata becomes unreliable for review and rerun diagnostics.",
                    "remediation": (
                        "Set changed_sections to [] and keep artifact content unchanged when "
                        "no actionable owner-scoped work exists."
                    ),
                }
            )
        return issues

    if not changed:
        issues.append(
            {
                "step": role_step,
                "summary": (
                    f"{role_label} returned unchanged artifact despite actionable "
                    "PM TODO/feedback."
                ),
                "risk": "PM blockers may persist across retries without concrete progress.",
                "remediation": (
                    f"Apply targeted updates for {role_label.lower()} owner TODOs and PM "
                    "feedback, then return updated artifact content."
                ),
            }
        )
        return issues

    if not declared_sections:
        print(
            f"pc-prepare-features: {role_label.lower()} metadata warning: "
            "changed_sections omitted; using detected section diff for diagnostics"
        )
    else:
        undeclared = [
            heading for heading in actual_sections if heading not in declared_sections
        ]
        if undeclared:
            print(
                f"pc-prepare-features: {role_label.lower()} metadata warning: "
                "declared changed_sections missing detected headings -> "
                + ", ".join(undeclared)
            )

    change_rationale_text = change_rationale.strip()
    if not change_rationale_text:
        issues.append(
            {
                "step": role_step,
                "summary": f"{role_label} changed artifact but omitted change_rationale.",
                "risk": "There is no auditable explanation linking edits to PM feedback.",
                "remediation": (
                    "Provide change_rationale referencing relevant PM issue ids and/or PM TODO ids."
                ),
            }
        )
    elif not re.search(r"(PM-TODO-\d+|PM-\d+)", change_rationale_text):
        issues.append(
            {
                "step": role_step,
                "summary": (
                    f"{role_label} change_rationale does not reference PM issue/TODO ids."
                ),
                "risk": "Reviewers cannot trace edits to specific PM blockers deterministically.",
                "remediation": (
                    "Include PM ids (for example PM-001 or PM-TODO-001) in change_rationale."
                ),
            }
        )

    return issues


def validate_pm_issue_actionability(raw_issues: Any) -> List[Dict[str, str]]:
    if not isinstance(raw_issues, list):
        return []
    violations: List[Dict[str, str]] = []
    artifact_tokens = {
        "design.md",
        "ux-ui.md",
        "security.md",
        "feature-order.json",
        "feature-order.md",
    }
    section_tokens = {
        "section",
        "heading",
        "system architecture",
        "module boundaries",
        "infra considerations",
        "design constraints",
        "build strategy",
        "feature alignment map",
        "user journeys",
        "workflows",
        "ux constraints",
        "ordered_feature_slugs",
        "dependencies",
        "decisions",
        "security scope boundaries",
        "threat model",
        "attack surface",
        "feature security focus map",
        "security controls",
        "verification and evidence",
    }
    acceptance_tokens = {"must", "acceptance", "verify", "should", "passes", "contains"}
    for item in raw_issues:
        if not isinstance(item, dict):
            continue
        summary = str(item.get("summary", "")).strip()
        if not summary:
            continue
        step = normalize_prepare_step(item.get("step"), default=STEP_PRODUCT_MANAGER)
        if step not in TODO_OWNERS:
            continue
        remediation = str(item.get("remediation", "")).strip()
        combined = f"{summary} {remediation}".lower()
        missing_parts: List[str] = []
        if not any(token in combined for token in artifact_tokens):
            missing_parts.append("target artifact")
        if not any(token in combined for token in section_tokens):
            missing_parts.append("target section/heading")
        if not any(token in combined for token in acceptance_tokens):
            missing_parts.append("acceptance condition")
        if not missing_parts:
            continue
        violations.append(
            {
                "step": STEP_PRODUCT_MANAGER,
                "summary": (
                    f"PM issue for step '{step}' is ambiguous; missing "
                    + ", ".join(missing_parts)
                    + "."
                ),
                "risk": "Ambiguous PM feedback can trigger noisy rewrites or failed retries.",
                "remediation": (
                    "For each PM issue, specify target artifact, target section/heading, "
                    "and explicit acceptance condition."
                ),
            }
        )
    return violations


def pm_todo_update_owner_statuses(raw_todo_updates: Any) -> Dict[str, Set[str]]:
    if not isinstance(raw_todo_updates, list):
        return {}
    owner_statuses: Dict[str, Set[str]] = {}
    for item in raw_todo_updates:
        if not isinstance(item, dict):
            continue
        owner = normalize_todo_owner(item.get("owner"))
        status = normalize_todo_status(item.get("status"), default=TODO_STATUS_OPEN)
        owner_statuses.setdefault(owner, set()).add(status)
    return owner_statuses


def validate_pm_issue_step_names(raw_issues: Any) -> List[Dict[str, str]]:
    if not isinstance(raw_issues, list):
        return []
    issues: List[Dict[str, str]] = []
    allowed_text = "|".join(CANONICAL_PREPARE_STEPS)
    for item in raw_issues:
        if not isinstance(item, dict):
            continue
        summary = str(item.get("summary", "")).strip()
        if not summary:
            continue
        raw_step = str(item.get("step", "")).strip()
        if not raw_step:
            continue
        _, known = normalize_prepare_step_with_known(
            raw_step, default=STEP_PRODUCT_MANAGER
        )
        if known:
            continue
        issues.append(
            {
                "step": STEP_PRODUCT_MANAGER,
                "summary": (
                    f"PM issue step '{raw_step}' is not allowed; use one of {allowed_text}."
                ),
                "risk": "Unknown PM step ownership can route feedback to the wrong role.",
                "remediation": (
                    "Normalize PM issue steps to architect, ux, security, "
                    "dependency-planner, or product-manager."
                ),
            }
        )
    return issues


def retry_owner_scope_from_issues(issues: Sequence[ReviewIssue]) -> Set[str]:
    owners: Set[str] = set()
    for issue in issues:
        canonical_step = normalize_prepare_step(
            issue.step, default=STEP_PRODUCT_MANAGER
        )
        if canonical_step in TODO_OWNERS:
            owners.add(canonical_step)
            continue
        if canonical_step != STEP_PRODUCT_MANAGER:
            continue
        text = f"{issue.summary} {issue.remediation}".lower()
        matched = False
        if any(
            token in text
            for token in {"feature-order", "dependency", "ordering", "order"}
        ):
            owners.add(TODO_OWNER_DEPENDENCY_PLANNER)
            matched = True
        if any(token in text for token in {"ux", "ui", "journey", "workflow"}):
            owners.add(TODO_OWNER_UX)
            matched = True
        if any(
            token in text
            for token in {
                "security",
                "threat",
                "redaction",
                "secret",
                "credential",
                "authorization",
                "authn",
                "authz",
            }
        ):
            owners.add(TODO_OWNER_SECURITY)
            matched = True
        if any(
            token in text
            for token in {"architect", "architecture", "design.md", "module", "infra"}
        ):
            owners.add(TODO_OWNER_ARCHITECT)
            matched = True
        if not matched:
            owners.update(TODO_OWNERS)
    if owners:
        return owners
    return set(TODO_OWNERS)


