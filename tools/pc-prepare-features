@dataclass(frozen=True)
class Feature:
    title: str
    priority: str
    slug: str
    dependencies: Tuple[str, ...]
    outcome: str = ""
    notes: str = ""


@dataclass(frozen=True)
class ReviewIssue:
    issue_id: str
    step: str
    summary: str
    risk: str
    remediation: str


@dataclass(frozen=True)
class DecisionOption:
    key: str
    label: str
    explanation: str
    risk: str


def die(message: str) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(1)


def parse_args(argv: Optional[Sequence[str]] = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Run global prepare workflow: Architect -> UX -> dependency ordering "
            "-> Product Manager gate -> feature generation."
        )
    )
    parser.add_argument(
        "--root",
        default=str(ROOT),
        help="Repository root (defaults to detected root).",
    )
    parser.add_argument(
        "--skip-generation",
        action="store_true",
        help="Generate docs/order and PM-review only; skip tools/prd-to-features.",
    )
    parser.add_argument(
        "--skip-schema-check",
        action="store_true",
        help="Skip tools/pc-devtasks-schema-check at the end of generation.",
    )
    parser.add_argument(
        "--role-mode",
        choices=(ROLE_MODE_CODEX, ROLE_MODE_DETERMINISTIC),
        default=default_role_mode(),
        help=(
            "Role execution mode for Architect/UX/PM steps. "
            "'codex' runs prompt-driven role execution; "
            "'deterministic' uses local fallback generators."
        ),
    )
    parser.add_argument(
        "--include-process-features",
        action="store_true",
        help=(
            "Include PRD '## Process Features' entries in dependency planning and "
            "feature generation. Disabled by default."
        ),
    )
    return parser.parse_args(argv)


def default_role_mode() -> str:
    raw = os.environ.get("PREPARE_ROLE_MODE", ROLE_MODE_CODEX).strip().lower()
    if raw in {ROLE_MODE_CODEX, ROLE_MODE_DETERMINISTIC}:
        return raw
    return ROLE_MODE_CODEX


def load_prd_tool(root: Path):
    tool_path = root / PRD_TOOL_PATH
    if not tool_path.exists():
        raise FileNotFoundError(f"Missing tool: {tool_path}")
    loader = SourceFileLoader("prepare_features_prd_tool", str(tool_path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise RuntimeError("pc-prepare-features: failed to initialize PRD tool loader")
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def parse_override_choices(raw: str) -> Dict[str, int]:
    overrides: Dict[str, int] = {}
    if not raw.strip():
        return overrides
    for item in raw.split(","):
        token = item.strip()
        if not token:
            continue
        if ":" not in token:
            continue
        issue_id, value = token.split(":", 1)
        issue_key = issue_id.strip()
        try:
            choice = int(value.strip())
        except ValueError:
            continue
        if issue_key:
            overrides[issue_key] = choice
    return overrides


def resolve_override_choice(
    issue_id: str, overrides: Dict[str, int]
) -> Tuple[Optional[int], Optional[str]]:
    if issue_id in overrides:
        return overrides[issue_id], issue_id

    fallback_key: Optional[str] = None
    fallback_choice: Optional[int] = None
    for key, choice in overrides.items():
        if key == issue_id:
            continue
        if not issue_id.startswith(key):
            continue
        if fallback_key is None or len(key) > len(fallback_key):
            fallback_key = key
            fallback_choice = choice
    return fallback_choice, fallback_key


def choose_option(
    *,
    issue_id: str,
    title: str,
    options: Sequence[DecisionOption],
    overrides: Dict[str, int],
) -> DecisionOption:
    if len(options) < 2:
        die(f"pc-prepare-features: issue {issue_id} requires at least 2 choices")
    if len(options) > 4:
        die(f"pc-prepare-features: issue {issue_id} supports at most 4 choices")

    override_choice, override_key = resolve_override_choice(issue_id, overrides)
    if override_choice is not None:
        if 1 <= override_choice <= len(options):
            selected = options[override_choice - 1]
            alias_note = ""
            if override_key and override_key != issue_id:
                alias_note = f" via alias '{override_key}'"
            print(
                f"pc-prepare-features: {issue_id} override selected "
                f"[{override_choice}] {selected.label}{alias_note}"
            )
            return selected
        die(
            "pc-prepare-features: invalid PREPARE_DECISIONS entry for "
            f"{override_key or issue_id}; expected 1..{len(options)}"
        )

    print(f"\npc-prepare-features: {issue_id}")
    print(title)
    for idx, option in enumerate(options, start=1):
        print(f"  {idx}. {option.label}")
        print(f"     - Explanation: {option.explanation}")
        print(f"     - Risk: {option.risk}")

    if not sys.stdin.isatty():
        die(
            "pc-prepare-features: interactive decision required in non-interactive "
            "session. Re-run with PREPARE_DECISIONS='<issue-id>:<choice>'."
        )

    while True:
        raw = input(f"Select option [1-{len(options)}]: ").strip()
        if not raw:
            continue
        if not raw.isdigit():
            print("Please enter a number.")
            continue
        number = int(raw)
        if 1 <= number <= len(options):
            return options[number - 1]
        print(f"Please enter a number between 1 and {len(options)}.")


def normalize_tokens(raw: str) -> str:
    return re.sub(r"\s+", " ", raw.strip().lower())


def compact_slug(raw: str) -> str:
    return re.sub(r"[^a-z0-9]+", "-", raw.strip().lower()).strip("-")


def parse_features(
    prd_module, prd_text: str, *, include_process_features: bool
) -> List[Feature]:
    parse_fn = getattr(prd_module, "parse_prd_features", None)
    if not callable(parse_fn):
        die("pc-prepare-features: loaded PRD tool has no parse_prd_features function")
    try:
        parsed = parse_fn(
            prd_text, include_process_features=bool(include_process_features)
        )
    except TypeError:
        parsed = parse_fn(prd_text)
        if not include_process_features:
            parsed = [
                item
                for item in parsed
                if str(getattr(item, "source", "")).strip().lower() != "process"
            ]

    features: List[Feature] = []
    for item in parsed:
        dependencies = tuple(getattr(item, "dependencies", ()) or ())
        features.append(
            Feature(
                title=str(item.title).strip(),
                priority=str(item.priority).strip(),
                slug=str(item.slug).strip(),
                dependencies=tuple(
                    str(dep).strip() for dep in dependencies if str(dep).strip()
                ),
                outcome=str(getattr(item, "outcome", "")).strip(),
                notes=str(getattr(item, "notes", "")).strip(),
            )
        )
    return features


def feature_title_map(features: Sequence[Feature]) -> Dict[str, str]:
    mapping: Dict[str, str] = {}
    for feature in features:
        key = normalize_tokens(feature.title)
        if key and key not in mapping:
            mapping[key] = feature.slug
    return mapping


def try_resolve_dependency(
    token: str,
    *,
    all_slugs: Set[str],
    title_map: Dict[str, str],
    index_to_slug: Dict[str, str],
) -> Optional[str]:
    candidate = token.strip()
    if not candidate:
        return None

    slug_candidate = compact_slug(candidate)
    if slug_candidate in all_slugs:
        return slug_candidate

    if candidate in index_to_slug:
        return index_to_slug[candidate]
    if candidate.zfill(2) in index_to_slug:
        return index_to_slug[candidate.zfill(2)]

    prefixed = re.match(r"^(\d{1,2})-", candidate)
    if prefixed:
        idx = prefixed.group(1).zfill(2)
        if idx in index_to_slug:
            return index_to_slug[idx]

    title_key = normalize_tokens(candidate)
    if title_key in title_map:
        return title_map[title_key]

    no_quotes = candidate.replace("`", "").replace('"', "")
    no_quotes_key = normalize_tokens(no_quotes)
    if no_quotes_key in title_map:
        return title_map[no_quotes_key]

    return None


def suggest_dependency_candidates(token: str, features: Sequence[Feature]) -> List[str]:
    token_slug = compact_slug(token)
    scored: List[Tuple[int, str]] = []
    for feature in features:
        score = 0
        if token_slug and token_slug in feature.slug:
            score += 3
        title_key = normalize_tokens(feature.title)
        if token_slug and token_slug in compact_slug(title_key):
            score += 2
        if token.strip() and token.strip().lower() in feature.title.lower():
            score += 2
        if score > 0:
            scored.append((score, feature.slug))
    scored.sort(key=lambda item: (-item[0], item[1]))
    ordered: List[str] = []
    for _, slug in scored:
        if slug in ordered:
            continue
        ordered.append(slug)
        if len(ordered) == 2:
            break
    return ordered


def find_cycle_nodes(graph: Dict[str, Set[str]]) -> List[str]:
    visiting: Set[str] = set()
    visited: Set[str] = set()
    stack: List[str] = []

    def dfs(node: str) -> List[str]:
        visiting.add(node)
        stack.append(node)
        for dep in sorted(graph.get(node, set())):
            if dep not in graph:
                continue
            if dep in visiting:
                start_idx = stack.index(dep)
                return stack[start_idx:] + [dep]
            if dep in visited:
                continue
            cycle = dfs(dep)
            if cycle:
                return cycle
        stack.pop()
        visiting.remove(node)
        visited.add(node)
        return []

    for node in sorted(graph):
        if node in visited:
            continue
        cycle = dfs(node)
        if cycle:
            return cycle
    return []


def topo_order(
    slugs_in_priority_order: Sequence[str], graph: Dict[str, Set[str]]
) -> List[str]:
    incoming = {slug: set(graph.get(slug, set())) for slug in slugs_in_priority_order}
    dependents: Dict[str, Set[str]] = {slug: set() for slug in slugs_in_priority_order}
    for slug, deps in incoming.items():
        for dep in deps:
            if dep not in dependents:
                continue
            dependents[dep].add(slug)

    priority_idx = {slug: idx for idx, slug in enumerate(slugs_in_priority_order)}
    ready = [slug for slug, deps in incoming.items() if not deps]
    ready.sort(key=lambda value: priority_idx.get(value, 10_000))

    ordered: List[str] = []
    while ready:
        current = ready.pop(0)
        ordered.append(current)
        for dependent in sorted(
            dependents.get(current, set()),
            key=lambda value: priority_idx.get(value, 10_000),
        ):
            deps = incoming[dependent]
            if current in deps:
                deps.remove(current)
            if not deps and dependent not in ordered and dependent not in ready:
                ready.append(dependent)
        ready.sort(key=lambda value: priority_idx.get(value, 10_000))

    return ordered


def resolve_dependency_graph(
    features: Sequence[Feature],
    *,
    overrides: Dict[str, int],
) -> Tuple[Dict[str, Set[str]], List[Dict[str, str]]]:
    slugs_in_priority_order = [feature.slug for feature in features]
    all_slugs = set(slugs_in_priority_order)
    title_map = feature_title_map(features)
    index_to_slug = {
        f"{idx + 1:02d}": slug for idx, slug in enumerate(slugs_in_priority_order)
    }

    decisions: List[Dict[str, str]] = []
    graph: Dict[str, Set[str]] = {feature.slug: set() for feature in features}
    issue_counter = 1

    for feature in features:
        for token in feature.dependencies:
            resolved = try_resolve_dependency(
                token,
                all_slugs=all_slugs,
                title_map=title_map,
                index_to_slug=index_to_slug,
            )
            if resolved and resolved != feature.slug:
                graph[feature.slug].add(resolved)
                continue
            if resolved == feature.slug:
                issue_id = f"AMB-{issue_counter:03d}"
                issue_counter += 1
                options = [
                    DecisionOption(
                        key="ignore",
                        label="Ignore self-dependency (Recommended)",
                        explanation=(
                            f"Drop self-dependency '{token}' on '{feature.slug}' so ordering can proceed."
                        ),
                        risk="May hide a mistaken PRD dependency if self-reference was accidental.",
                    ),
                    DecisionOption(
                        key="abort",
                        label="Abort and fix PRD manually",
                        explanation="Stop now and update PRD dependency definitions.",
                        risk="Preparation run stops until PRD is corrected.",
                    ),
                ]
                choice = choose_option(
                    issue_id=issue_id,
                    title=(
                        f"Dependency '{token}' on '{feature.title}' resolves to the same feature."
                    ),
                    options=options,
                    overrides=overrides,
                )
                decisions.append(
                    {
                        "issue_id": issue_id,
                        "type": "self_dependency",
                        "feature_slug": feature.slug,
                        "dependency": token,
                        "selected": choice.key,
                        "risk": choice.risk,
                    }
                )
                if choice.key == "abort":
                    die(
                        "pc-prepare-features: aborted by user during dependency resolution"
                    )
                continue

            suggestions = suggest_dependency_candidates(token, features)
            issue_id = f"AMB-{issue_counter:03d}"
            issue_counter += 1
            options: List[DecisionOption] = []
            if suggestions:
                options.append(
                    DecisionOption(
                        key=f"map:{suggestions[0]}",
                        label=f"Map to '{suggestions[0]}' (Recommended)",
                        explanation=(
                            f"Resolve unknown dependency '{token}' to closest known feature slug '{suggestions[0]}'."
                        ),
                        risk="Could map to the wrong prerequisite if naming is ambiguous.",
                    )
                )
                if len(suggestions) > 1:
                    options.append(
                        DecisionOption(
                            key=f"map:{suggestions[1]}",
                            label=f"Map to '{suggestions[1]}'",
                            explanation=(
                                f"Alternative mapping for '{token}' to '{suggestions[1]}'."
                            ),
                            risk="Alternative mapping may still be incorrect and alter generation order.",
                        )
                    )
            options.append(
                DecisionOption(
                    key="ignore",
                    label="Ignore this dependency",
                    explanation=(
                        "Continue without this edge; feature ordering will not enforce this prerequisite."
                    ),
                    risk="Feature may be generated before a true prerequisite.",
                )
            )
            options.append(
                DecisionOption(
                    key="abort",
                    label="Abort and fix PRD manually",
                    explanation="Stop now and update PRD dependency definitions.",
                    risk="Preparation run stops until PRD is corrected.",
                )
            )

            choice = choose_option(
                issue_id=issue_id,
                title=(
                    f"Dependency '{token}' on feature '{feature.title}' does not match any known feature."
                ),
                options=options,
                overrides=overrides,
            )
            decisions.append(
                {
                    "issue_id": issue_id,
                    "type": "unknown_dependency",
                    "feature_slug": feature.slug,
                    "dependency": token,
                    "selected": choice.key,
                    "risk": choice.risk,
                }
            )
            if choice.key == "abort":
                die("pc-prepare-features: aborted by user during dependency resolution")
            if choice.key.startswith("map:"):
                mapped = choice.key.split(":", 1)[1]
                if mapped and mapped != feature.slug:
                    graph[feature.slug].add(mapped)

    cycle_counter = 1
    while True:
        ordered = topo_order(slugs_in_priority_order, graph)
        if len(ordered) == len(slugs_in_priority_order):
            break
        cycle_nodes = find_cycle_nodes(graph)
        if not cycle_nodes:
            die("pc-prepare-features: dependency graph contains unresolved cycle")

        cycle_edges: List[Tuple[str, str]] = []
        for idx in range(len(cycle_nodes) - 1):
            left = cycle_nodes[idx]
            right = cycle_nodes[idx + 1]
            if right in graph.get(left, set()):
                cycle_edges.append((left, right))
        if not cycle_edges:
            die("pc-prepare-features: cycle detected but no removable edge found")

        issue_id = f"CYCLE-{cycle_counter:03d}"
        cycle_counter += 1
        options: List[DecisionOption] = []
        for left, right in cycle_edges[:3]:
            options.append(
                DecisionOption(
                    key=f"drop:{left}:{right}",
                    label=f"Drop edge '{left}' depends on '{right}' (Recommended)",
                    explanation=(
                        f"Remove dependency edge '{left} -> {right}' to break the cycle."
                    ),
                    risk="May allow this feature to be generated before a true prerequisite.",
                )
            )
        options.append(
            DecisionOption(
                key="abort",
                label="Abort and fix PRD manually",
                explanation="Stop now and rewrite cyclical dependencies in PRD.",
                risk="Preparation run stops until PRD dependencies are corrected.",
            )
        )

        cycle_path = " -> ".join(cycle_nodes)
        choice = choose_option(
            issue_id=issue_id,
            title=f"Dependency cycle detected: {cycle_path}",
            options=options,
            overrides=overrides,
        )
        decisions.append(
            {
                "issue_id": issue_id,
                "type": "cycle",
                "cycle": cycle_path,
                "selected": choice.key,
                "risk": choice.risk,
            }
        )
        if choice.key == "abort":
            die("pc-prepare-features: aborted by user due to dependency cycle")

        _, left, right = choice.key.split(":", 2)
        if right in graph.get(left, set()):
            graph[left].remove(right)

    return graph, decisions


def extract_section_bullets(content: str, heading: str) -> List[str]:
    section_pattern = re.compile(
        rf"^##\s+{re.escape(heading)}\s*$", re.MULTILINE | re.IGNORECASE
    )
    match = section_pattern.search(content)
    if not match:
        return []
    start = match.end()
    next_heading = re.search(r"^##\s+", content[start:], re.MULTILINE)
    end = start + next_heading.start() if next_heading else len(content)
    section = content[start:end]
    bullets: List[str] = []
    for line in section.splitlines():
        stripped = line.strip()
        if stripped.startswith("- "):
            bullets.append(stripped[2:].strip())
    return bullets


def extract_json_payload(raw: str) -> str:
    start = raw.find("{")
    end = raw.rfind("}")
    if start == -1 or end == -1 or end < start:
        return raw
    return raw[start : end + 1]


def load_prompt_template(root: Path, prompt_rel_path: Path) -> str:
    prompt_path = root / prompt_rel_path
    if not prompt_path.exists():
        die(
            "pc-prepare-features: missing prompt template "
            f"{prompt_path}; restore prompts under {root / PROMPTS_DIR}"
        )
    return prompt_path.read_text(encoding="utf-8")


def render_prompt_template(template: str, values: Dict[str, str]) -> str:
    class StrictMap(dict):
        def __missing__(self, key):
            die(f"pc-prepare-features: prompt template missing value for '{key}'")
            return ""

    return template.format_map(StrictMap(values))


def truncate_for_error(raw: str, max_chars: int = 800) -> str:
    compact = re.sub(r"\s+", " ", raw.strip())
    if len(compact) <= max_chars:
        return compact
    return compact[:max_chars].rstrip() + "..."


def codex_exec_json(
    *,
    root: Path,
    prompt: str,
    profile: str,
    label: str,
) -> Dict[str, Any]:
    if shutil.which("codex") is None:
        raise RuntimeError("codex CLI not found in PATH")

    cmd = ["codex", "-C", str(root), "--profile", profile, "exec", prompt]
    result = subprocess.run(
        cmd,
        cwd=str(root),
        check=False,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if result.returncode != 0:
        combined = "\n".join(part for part in [result.stdout, result.stderr] if part)
        raise RuntimeError(
            f"{label} role execution failed with exit {result.returncode}: "
            f"{truncate_for_error(combined)}"
        )
    payload = extract_json_payload(result.stdout or "")
    try:
        data = json.loads(payload)
    except json.JSONDecodeError as exc:
        raise RuntimeError(
            f"{label} role returned non-JSON output: {truncate_for_error(result.stdout or '')}"
        ) from exc
    if not isinstance(data, dict):
        raise RuntimeError(f"{label} role JSON payload must be an object")
    return data


def feature_context_payload(
    *,
    features: Sequence[Feature],
    ordered_slugs: Sequence[str],
    graph: Dict[str, Set[str]],
) -> List[Dict[str, Any]]:
    by_slug = {feature.slug: feature for feature in features}
    payload: List[Dict[str, Any]] = []
    for idx, slug in enumerate(ordered_slugs, start=1):
        feature = by_slug.get(slug)
        if not feature:
            continue
        payload.append(
            {
                "index": idx,
                "slug": feature.slug,
                "title": feature.title,
                "priority": feature.priority,
                "dependencies": sorted(graph.get(feature.slug, set())),
                "outcome": feature.outcome,
                "notes": feature.notes,
            }
        )
    return payload


def prompt_values(
    *,
    features: Sequence[Feature],
    ordered_slugs: Sequence[str],
    graph: Dict[str, Set[str]],
    prd_text: str,
    context_boundaries: str,
    dependency_decisions: Sequence[Dict[str, str]],
) -> Dict[str, str]:
    feature_payload = feature_context_payload(
        features=features, ordered_slugs=ordered_slugs, graph=graph
    )
    return {
        "prd_markdown": prd_text,
        "context_boundaries_markdown": context_boundaries,
        "ordered_features_json": json.dumps(
            feature_payload, ensure_ascii=True, indent=2, sort_keys=True
        ),
        "dependency_decisions_json": json.dumps(
            list(dependency_decisions), ensure_ascii=True, indent=2, sort_keys=True
        ),
    }


def normalize_role_issues(
    *,
    raw_issues: Any,
    default_step: str,
    source: str,
) -> List[Dict[str, str]]:
    if raw_issues is None:
        return []
    if not isinstance(raw_issues, list):
        return [
            {
                "step": default_step,
                "summary": f"{source} returned non-list issues payload.",
                "risk": "Malformed role output can bypass semantic gates.",
                "remediation": f"Fix {source} prompt output to return issues as a JSON list.",
            }
        ]

    issues: List[Dict[str, str]] = []
    for item in raw_issues:
        if not isinstance(item, dict):
            continue
        summary = str(item.get("summary", "")).strip()
        if not summary:
            continue
        issues.append(
            {
                "step": str(item.get("step", default_step)).strip() or default_step,
                "summary": summary,
                "risk": str(item.get("risk", "")).strip()
                or "Role output lacks semantic confidence.",
                "remediation": str(item.get("remediation", "")).strip()
                or "Update role output to include project-specific rationale and concrete fixes.",
            }
        )
    return issues


