def build_order_payload(
    *,
    ordered_slugs: Sequence[str],
    features: Sequence[Feature],
    graph: Dict[str, Set[str]],
    decisions: Sequence[Dict[str, str]],
) -> Dict[str, object]:
    by_slug = {feature.slug: feature for feature in features}
    ordered_features_payload = []
    for idx, slug in enumerate(ordered_slugs, start=1):
        feature = by_slug[slug]
        ordered_features_payload.append(
            {
                "index": idx,
                "slug": feature.slug,
                "title": feature.title,
                "priority": feature.priority,
                "dependencies": sorted(graph.get(feature.slug, set())),
            }
        )

    return {
        "version": 1,
        "generated_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "ordered_feature_slugs": list(ordered_slugs),
        "dependencies": {
            slug: sorted(graph.get(slug, set())) for slug in ordered_slugs
        },
        "ordered_features": ordered_features_payload,
        "decisions": list(decisions),
        "notes": [
            "This file is machine-managed by tools/pc-prepare-features.",
            "tools/prd-to-features consumes ordered_feature_slugs to preserve dependency order.",
        ],
    }


def order_markdown(payload: Dict[str, object]) -> str:
    rows = [
        "# Feature Order Plan",
        "",
        "> Machine-managed by `tools/pc-prepare-features`.",
        "",
        f"**Generated At (UTC):** {payload.get('generated_at', '')}",
        "",
        "## Ordered features",
        "",
        "| # | Priority | Slug | Title | Dependencies |",
        "| - | -------- | ---- | ----- | ------------ |",
    ]
    for item in payload.get("ordered_features", []):
        if not isinstance(item, dict):
            continue
        deps = item.get("dependencies", [])
        deps_text = ", ".join(deps) if isinstance(deps, list) and deps else "(none)"
        rows.append(
            "| {index:02d} | {priority} | {slug} | {title} | {deps} |".format(
                index=int(item.get("index", 0)),
                priority=str(item.get("priority", "")),
                slug=str(item.get("slug", "")),
                title=str(item.get("title", "")),
                deps=deps_text,
            )
        )

    decisions = payload.get("decisions", [])
    rows.extend(["", "## Decisions", ""])
    if not isinstance(decisions, list) or not decisions:
        rows.append("- No manual decision overrides were required.")
    else:
        for decision in decisions:
            if not isinstance(decision, dict):
                continue
            rows.append(
                "- `{issue}` ({type}): selected `{selected}`; risk: {risk}".format(
                    issue=decision.get("issue_id", "unknown"),
                    type=decision.get("type", "decision"),
                    selected=decision.get("selected", ""),
                    risk=decision.get("risk", ""),
                )
            )

    rows.append("")
    return "\n".join(rows)


def check_required_headings(content: str, headings: Sequence[str]) -> List[str]:
    missing = []
    lowered = content.lower()
    for heading in headings:
        needle = f"## {heading}".lower()
        if needle not in lowered:
            missing.append(heading)
    return missing


def dependency_order_violations(
    ordered_slugs: Sequence[str], graph: Dict[str, Set[str]]
) -> List[str]:
    position = {slug: idx for idx, slug in enumerate(ordered_slugs, start=1)}
    violations: List[str] = []
    for feature_slug, deps in graph.items():
        current_pos = position.get(feature_slug)
        if current_pos is None:
            continue
        for dep in sorted(deps):
            dep_pos = position.get(dep)
            if dep_pos is None:
                continue
            if dep_pos > current_pos:
                violations.append(
                    f"dependency order violation: {feature_slug} depends on {dep} but appears earlier"
                )
    return violations


def generic_signal_issues(design_text: str, ux_text: str) -> List[Dict[str, str]]:
    issues: List[Dict[str, str]] = []
    text_by_step = {"architect": design_text, "ux": ux_text}
    for step, content in text_by_step.items():
        matched = [marker for marker in GENERIC_SIGNAL_MARKERS if marker in content]
        if not matched:
            continue
        preview = ", ".join(f"`{marker}`" for marker in matched[:3])
        issues.append(
            {
                "step": step,
                "summary": (
                    "Generated artifact contains generic template markers "
                    f"({preview})."
                ),
                "risk": "Artifact appears tooling-centric instead of project-specific.",
                "remediation": (
                    "Regenerate with project-specific architecture/journey content "
                    "derived from PRD outcomes and context constraints."
                ),
            }
        )
    return issues


def product_manager_review(
    *,
    features: Sequence[Feature],
    ordered_slugs: Sequence[str],
    graph: Dict[str, Set[str]],
    design_text: str,
    ux_text: str,
    order_payload: Dict[str, object],
    pm_role_payload: Dict[str, Any],
    seed_issues: Sequence[Dict[str, str]],
    enforce_semantic_gate: bool = True,
) -> List[ReviewIssue]:
    issues: List[ReviewIssue] = []
    issue_count = 1

    def add_issue(
        *,
        step: str,
        summary: str,
        risk: str,
        remediation: str,
    ) -> None:
        nonlocal issue_count
        issues.append(
            ReviewIssue(
                issue_id=f"PM-{issue_count:03d}",
                step=step,
                summary=summary,
                risk=risk,
                remediation=remediation,
            )
        )
        issue_count += 1

    for seeded in seed_issues:
        add_issue(
            step=str(seeded.get("step", "product-manager")).strip()
            or "product-manager",
            summary=str(seeded.get("summary", "")).strip()
            or "Missing seeded issue summary.",
            risk=str(seeded.get("risk", "")).strip()
            or "Seeded issue missing risk context.",
            remediation=str(seeded.get("remediation", "")).strip()
            or "Add explicit remediation details for the seeded issue.",
        )

    required_design_headings = (
        "System architecture",
        "Module boundaries",
        "Infra considerations",
        "Design constraints",
        "Build strategy",
    )
    missing_design = check_required_headings(design_text, required_design_headings)
    if missing_design:
        add_issue(
            step="architect",
            summary=f"design.md missing required sections: {', '.join(missing_design)}",
            risk="Feature generation may drift from incomplete architecture constraints.",
            remediation="Regenerate design.md and keep mandatory architecture sections.",
        )

    required_ux_headings = (
        "User journeys",
        "Workflows",
    )
    missing_ux = check_required_headings(ux_text, required_ux_headings)
    if missing_ux:
        add_issue(
            step="ux",
            summary=f"ux-ui.md missing required sections: {', '.join(missing_ux)}",
            risk="User journeys/workflows may be under-specified for feature generation.",
            remediation="Regenerate ux-ui.md and keep journeys + workflows sections complete.",
        )

    if enforce_semantic_gate:
        for generic_issue in generic_signal_issues(design_text, ux_text):
            add_issue(
                step=generic_issue["step"],
                summary=generic_issue["summary"],
                risk=generic_issue["risk"],
                remediation=generic_issue["remediation"],
            )

    for feature in features:
        title_lower = feature.title.lower()
        if title_lower not in design_text.lower():
            add_issue(
                step="architect",
                summary=f"design.md does not mention feature '{feature.title}'",
                risk="Feature may be generated without architecture alignment.",
                remediation=f"Ensure design.md feature alignment map includes '{feature.title}'.",
            )
        if title_lower not in ux_text.lower():
            add_issue(
                step="ux",
                summary=f"ux-ui.md does not mention feature '{feature.title}'",
                risk="Feature may be generated without UX journey/workflow alignment.",
                remediation=f"Ensure ux-ui.md journeys/workflows include '{feature.title}'.",
            )

        semantic_tokens = feature_semantic_tokens(feature)
        if enforce_semantic_gate and semantic_tokens:
            design_lower = design_text.lower()
            ux_lower = ux_text.lower()
            if not any(token in design_lower for token in semantic_tokens):
                add_issue(
                    step="architect",
                    summary=(
                        f"design.md lacks feature-specific semantics for '{feature.title}' "
                        f"(expected one of: {', '.join(semantic_tokens)})."
                    ),
                    risk="Architecture can pass structural checks while remaining generic.",
                    remediation=(
                        f"Add project-specific architecture details tied to '{feature.title}' "
                        "outcome/notes from PRD."
                    ),
                )
            if not any(token in ux_lower for token in semantic_tokens):
                add_issue(
                    step="ux",
                    summary=(
                        f"ux-ui.md lacks feature-specific semantics for '{feature.title}' "
                        f"(expected one of: {', '.join(semantic_tokens)})."
                    ),
                    risk="User journeys may stay generic and miss intended product behavior.",
                    remediation=(
                        f"Add journey/workflow details grounded in '{feature.title}' "
                        "outcome/notes from PRD."
                    ),
                )

    payload_slugs = order_payload.get("ordered_feature_slugs", [])
    if not isinstance(payload_slugs, list):
        payload_slugs = []
    payload_slug_set = {str(item) for item in payload_slugs}
    for feature in features:
        if feature.slug not in payload_slug_set:
            add_issue(
                step="dependency-planner",
                summary=f"feature-order.json missing '{feature.slug}'",
                risk="Feature generation order may be incomplete or non-deterministic.",
                remediation="Regenerate feature-order artifacts and include every P0/P1 feature.",
            )

    for violation in dependency_order_violations(ordered_slugs, graph):
        add_issue(
            step="dependency-planner",
            summary=violation,
            risk="Dependent features may be generated before their prerequisites.",
            remediation="Fix dependency graph or choose a safer cycle/ambiguity resolution.",
        )

    pm_decision = str(pm_role_payload.get("decision", "BLOCK")).strip().upper()
    pm_role_issues = normalize_role_issues(
        raw_issues=pm_role_payload.get("issues"),
        default_step="product-manager",
        source="product-manager",
    )
    for pm_issue in pm_role_issues:
        add_issue(
            step=pm_issue["step"],
            summary=pm_issue["summary"],
            risk=pm_issue["risk"],
            remediation=pm_issue["remediation"],
        )

    if pm_decision not in {"APPROVE", "BLOCK"}:
        add_issue(
            step="product-manager",
            summary="Product Manager decision is invalid (expected APPROVE/BLOCK).",
            risk="Invalid PM output can cause false approvals.",
            remediation="Return PM decision as APPROVE or BLOCK in JSON output.",
        )
    elif pm_decision == "BLOCK" and not pm_role_issues:
        add_issue(
            step="product-manager",
            summary="Product Manager returned BLOCK without actionable issues.",
            risk="Prepare loop cannot resolve PM block deterministically.",
            remediation="Return at least one PM issue with summary, risk, and remediation.",
        )
    elif pm_decision == "APPROVE" and pm_role_issues:
        add_issue(
            step="product-manager",
            summary="Product Manager returned APPROVE while listing issues.",
            risk="Contradictory PM output weakens semantic gate integrity.",
            remediation="Return BLOCK when PM issues are present.",
        )

    criteria = pm_role_payload.get("criteria")
    if enforce_semantic_gate and isinstance(criteria, dict):
        for key, value in criteria.items():
            if str(value).strip().lower() not in {"fail", "failed", "block", "blocked"}:
                continue
            add_issue(
                step="product-manager",
                summary=f"PM semantic criterion '{key}' failed.",
                risk="Semantic quality gate failed while artifacts may still look structurally complete.",
                remediation=(
                    "Address the failed PM criterion and rerun prepare before generation."
                ),
            )

    return issues


def review_issue_payload(issue: ReviewIssue) -> Dict[str, str]:
    return {
        "issue_id": issue.issue_id,
        "step": issue.step,
        "summary": issue.summary,
        "risk": issue.risk,
        "remediation": issue.remediation,
    }


def build_prepare_state_payload(
    *,
    features: Sequence[Feature],
    ordered_slugs: Sequence[str],
    graph: Dict[str, Set[str]],
    dependency_decisions: Sequence[Dict[str, str]],
    pm_history: Sequence[Dict[str, object]],
    pm_final_decision: str,
    skip_generation: bool,
    role_mode: str,
    include_process_features: bool,
    feature_generation_status: str,
    schema_check_status: str,
) -> Dict[str, object]:
    by_slug = {feature.slug: feature for feature in features}
    ordered_features = []
    for index, slug in enumerate(ordered_slugs, start=1):
        feature = by_slug.get(slug)
        if not feature:
            continue
        ordered_features.append(
            {
                "index": index,
                "slug": feature.slug,
                "title": feature.title,
                "priority": feature.priority,
                "dependencies": sorted(graph.get(feature.slug, set())),
            }
        )

    return {
        "version": 1,
        "generated_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "ordered_feature_slugs": list(ordered_slugs),
        "ordered_features": ordered_features,
        "dependency_decisions": list(dependency_decisions),
        "pm_gate": {
            "blocked_count": len(
                [entry for entry in pm_history if int(entry.get("issue_count", 0)) > 0]
            ),
            "final_decision": pm_final_decision,
            "history": list(pm_history),
        },
        "execution": {
            "skip_generation": skip_generation,
            "role_mode": role_mode,
            "include_process_features": include_process_features,
            "feature_generation_status": feature_generation_status,
            "schema_check_status": schema_check_status,
        },
        "notes": [
            "Machine-managed by tools/pc-prepare-features.",
            "Captures PM-gate outcomes and execution status for deterministic reruns.",
        ],
    }


def render_pm_issues(issues: Sequence[ReviewIssue]) -> str:
    lines = ["Product Manager findings:"]
    for issue in issues:
        lines.append(f"- [{issue.issue_id}] step={issue.step}")
        lines.append(f"  summary: {issue.summary}")
        lines.append(f"  risk: {issue.risk}")
        lines.append(f"  remediation: {issue.remediation}")
    return "\n".join(lines)


def write_text(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content.rstrip() + "\n", encoding="utf-8")


def run_command(root: Path, cmd: Sequence[str], *, label: str) -> None:
    printable = " ".join(cmd)
    print(f"pc-prepare-features: running {label}: {printable}")
    result = subprocess.run(
        list(cmd),
        cwd=str(root),
        check=False,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if result.stdout:
        print(result.stdout, end="")
    if result.stderr:
        print(result.stderr, end="", file=sys.stderr)
    if result.returncode != 0:
        die(
            f"pc-prepare-features: command failed ({label}) with exit {result.returncode}"
        )


def run_prepare(args: argparse.Namespace) -> int:
    root = Path(args.root).resolve()
    prd_file = root / PRD_PATH
    if not prd_file.exists():
        die(f"pc-prepare-features: missing PRD: {prd_file}")

    prd_module = load_prd_tool(root)
    prd_text = prd_file.read_text(encoding="utf-8")
    features = parse_features(
        prd_module,
        prd_text,
        include_process_features=bool(args.include_process_features),
    )
    if not features:
        die("pc-prepare-features: no P0/P1 features found in PRD")

    overrides = parse_override_choices(os.environ.get("PREPARE_DECISIONS", ""))

    context_boundaries_file = root / CONTEXT_BOUNDARIES_PATH
    context_boundaries = (
        context_boundaries_file.read_text(encoding="utf-8")
        if context_boundaries_file.exists()
        else ""
    )

    pm_blocks = 0
    pm_history: List[Dict[str, object]] = []
    graph: Dict[str, Set[str]] = {}
    ordered_slugs: List[str] = []
    dependency_decisions: List[Dict[str, str]] = []
    pm_final_decision = "pending"

    def persist_prepare_state(
        *,
        feature_generation_status: str,
        schema_check_status: str,
    ) -> None:
        payload = build_prepare_state_payload(
            features=features,
            ordered_slugs=ordered_slugs,
            graph=graph,
            dependency_decisions=dependency_decisions,
            pm_history=pm_history,
            pm_final_decision=pm_final_decision,
            skip_generation=bool(args.skip_generation),
            role_mode=str(args.role_mode),
            include_process_features=bool(args.include_process_features),
            feature_generation_status=feature_generation_status,
            schema_check_status=schema_check_status,
        )
        write_text(
            root / PREPARE_STATE_PATH,
            json.dumps(payload, ensure_ascii=True, indent=2, sort_keys=True),
        )
        print(f"pc-prepare-features: wrote state artifact -> {PREPARE_STATE_PATH}")

    while True:
        print(
            "pc-prepare-features: architect step -> generating docs/01-product/design.md"
        )
        graph, dependency_decisions = resolve_dependency_graph(
            features, overrides=overrides
        )
        ordered_slugs = topo_order([feature.slug for feature in features], graph)
        if len(ordered_slugs) != len(features):
            die(
                "pc-prepare-features: failed to compute deterministic ordered feature list"
            )

        order_payload = build_order_payload(
            ordered_slugs=ordered_slugs,
            features=features,
            graph=graph,
            decisions=dependency_decisions,
        )

        design_doc, architect_seed_issues = run_architect_role(
            root=root,
            role_mode=args.role_mode,
            prd_text=prd_text,
            context_boundaries=context_boundaries,
            features=features,
            ordered_slugs=ordered_slugs,
            graph=graph,
            dependency_decisions=dependency_decisions,
        )
        write_text(root / DESIGN_PATH, design_doc)

        print("pc-prepare-features: ux step -> generating docs/01-product/ux-ui.md")
        ux_doc, ux_seed_issues = run_ux_role(
            root=root,
            role_mode=args.role_mode,
            prd_text=prd_text,
            context_boundaries=context_boundaries,
            features=features,
            ordered_slugs=ordered_slugs,
            graph=graph,
            dependency_decisions=dependency_decisions,
        )
        write_text(root / UX_PATH, ux_doc)

        print(
            "pc-prepare-features: dependency planner step -> generating docs/02-features/feature-order.{json,md}"
        )
        write_text(
            root / ORDER_JSON_PATH,
            json.dumps(order_payload, ensure_ascii=True, indent=2, sort_keys=True),
        )
        write_text(root / ORDER_MD_PATH, order_markdown(order_payload))

        print("pc-prepare-features: product manager gate -> reviewing artifacts")
        pm_role_payload = run_pm_role(
            root=root,
            role_mode=args.role_mode,
            prd_text=prd_text,
            context_boundaries=context_boundaries,
            design_text=design_doc,
            ux_text=ux_doc,
            order_payload=order_payload,
            features=features,
            ordered_slugs=ordered_slugs,
            graph=graph,
            dependency_decisions=dependency_decisions,
        )
        pm_role_decision = str(pm_role_payload.get("decision", "BLOCK")).strip().upper()
        issues = product_manager_review(
            features=features,
            ordered_slugs=ordered_slugs,
            graph=graph,
            design_text=design_doc,
            ux_text=ux_doc,
            order_payload=order_payload,
            pm_role_payload=pm_role_payload,
            seed_issues=[*architect_seed_issues, *ux_seed_issues],
            enforce_semantic_gate=args.role_mode != ROLE_MODE_DETERMINISTIC,
        )
        if not issues and pm_role_decision == "APPROVE":
            pm_history.append(
                {
                    "iteration": pm_blocks + 1,
                    "gate_id": f"PM-REVIEW-{pm_blocks + 1:03d}",
                    "decision": "approve",
                    "pm_role_decision": pm_role_decision,
                    "issue_count": 0,
                    "issues": [],
                }
            )
            pm_final_decision = "approve"
            print("pc-prepare-features: Product Manager decision: APPROVE")
            break

        pm_blocks += 1
        print("pc-prepare-features: Product Manager decision: BLOCK")
        print(render_pm_issues(issues))
        if pm_blocks >= MAX_PM_BLOCKS:
            pm_history.append(
                {
                    "iteration": pm_blocks,
                    "gate_id": f"PM-BLOCK-{pm_blocks:03d}",
                    "decision": "max-block-limit",
                    "pm_role_decision": pm_role_decision,
                    "issue_count": len(issues),
                    "issues": [review_issue_payload(issue) for issue in issues],
                }
            )
            pm_final_decision = "blocked-max-limit"
            persist_prepare_state(
                feature_generation_status="not-run",
                schema_check_status="not-run",
            )
            die(
                "pc-prepare-features: PM gate reached max block limit; manual intervention required"
            )

        options = [
            DecisionOption(
                key="retry",
                label="Retry failing steps automatically (Recommended)",
                explanation=(
                    "Re-run architect/ux/dependency planner in the same command and retry PM review."
                ),
                risk="If source PRD/context is inconsistent, repeated retries may still block.",
            ),
            DecisionOption(
                key="waive",
                label="Continue with PM waiver",
                explanation="Proceed to generation despite PM findings.",
                risk="Features may be generated with architecture/UX drift.",
            ),
            DecisionOption(
                key="abort",
                label="Abort and fix inputs manually",
                explanation="Stop now and edit PRD/context before rerunning.",
                risk="Preparation run stops until docs are corrected.",
            ),
        ]
        choice = choose_option(
            issue_id=f"PM-BLOCK-{pm_blocks:03d}",
            title="Product Manager blocked prepare loop.",
            options=options,
            overrides=overrides,
        )
        pm_history.append(
            {
                "iteration": pm_blocks,
                "gate_id": f"PM-BLOCK-{pm_blocks:03d}",
                "decision": choice.key,
                "pm_role_decision": pm_role_decision,
                "issue_count": len(issues),
                "issues": [review_issue_payload(issue) for issue in issues],
            }
        )
        if choice.key == "retry":
            continue
        if choice.key == "waive":
            pm_final_decision = "waive"
            print("pc-prepare-features: proceeding with PM waiver")
            break
        pm_final_decision = "abort"
        persist_prepare_state(
            feature_generation_status="not-run",
            schema_check_status="not-run",
        )
        die("pc-prepare-features: aborted by user at PM gate")

    feature_generation_status = "skipped" if args.skip_generation else "pending"
    schema_check_status = (
        "skipped" if args.skip_generation or args.skip_schema_check else "pending"
    )
    persist_prepare_state(
        feature_generation_status=feature_generation_status,
        schema_check_status=schema_check_status,
    )

    if args.skip_generation:
        print(
            "pc-prepare-features: --skip-generation set; stopping before tools/prd-to-features"
        )
        return 0

    run_command(
        root,
        [
            str(root / PRD_TOOL_PATH),
            f"--root={root}",
            *(["--include-process-features"] if args.include_process_features else []),
        ],
        label="feature generation",
    )
    feature_generation_status = "completed"
    persist_prepare_state(
        feature_generation_status=feature_generation_status,
        schema_check_status=schema_check_status,
    )

    if not args.skip_schema_check:
        run_command(
            root,
            [str(root / "tools" / "pc-devtasks-schema-check"), f"--root={root}"],
            label="feature schema validation",
        )
        schema_check_status = "completed"
        persist_prepare_state(
            feature_generation_status=feature_generation_status,
            schema_check_status=schema_check_status,
        )

    print("pc-prepare-features: complete")
    return 0


def main(argv: Optional[Sequence[str]] = None) -> int:
    args = parse_args(argv)
    return run_prepare(args)


if __name__ == "__main__":
    raise SystemExit(main())
