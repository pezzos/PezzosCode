                baseline_order_payload, ensure_ascii=True, indent=2, sort_keys=True
            )
        }
    )
    prompt = render_prompt_template(template, values)
    try:
        payload = codex_exec_json(
            root=root,
            prompt=prompt,
            profile=os.environ.get("PREPARE_ORDERER_PROFILE", "Orderer"),
            label="orderer",
        )
    except RuntimeError as exc:
        return (
            dict(baseline_order_payload),
            [
                {
                    "step": STEP_DEPENDENCY_PLANNER,
                    "summary": f"Orderer role execution failed: {exc}",
                    "risk": "Dependency ordering may regress without explicit owner review.",
                    "remediation": "Fix orderer prompt execution and rerun prepare.",
                }
            ],
        )

    issues = normalize_role_issues(
        raw_issues=payload.get("issues"),
        default_step=STEP_DEPENDENCY_PLANNER,
        source="orderer",
    )
    decision = str(payload.get("decision", "APPROVE")).strip().upper()
    if decision not in {"APPROVE", "BLOCK"}:
        issues.append(
            {
                "step": STEP_DEPENDENCY_PLANNER,
                "summary": "Orderer decision is invalid (expected APPROVE/BLOCK).",
                "risk": "Malformed orderer output can bypass ordering validation.",
                "remediation": "Return orderer decision as APPROVE or BLOCK in JSON output.",
            }
        )
    if decision == "BLOCK" and not issues:
        issues.append(
            {
                "step": STEP_DEPENDENCY_PLANNER,
                "summary": "Orderer returned BLOCK without actionable issues.",
                "risk": "Prepare loop cannot resolve dependency planner block deterministically.",
                "remediation": "Return orderer issues with summary, risk, and remediation.",
            }
        )
    if decision == "APPROVE" and issues:
        issues.append(
            {
                "step": STEP_DEPENDENCY_PLANNER,
                "summary": "Orderer returned APPROVE while listing issues.",
                "risk": "Contradictory orderer output weakens ordering gate integrity.",
                "remediation": "Return BLOCK when orderer issues are present.",
            }
        )

    fallback_slugs = list(ordered_slugs)
    raw_slugs = payload.get("ordered_feature_slugs")
    candidate_slugs = fallback_slugs
    if isinstance(raw_slugs, list):
        candidate_slugs = [str(item).strip() for item in raw_slugs if str(item).strip()]
        expected = {feature.slug for feature in features}
        actual = set(candidate_slugs)
        if (
            len(candidate_slugs) != len(features)
            or len(actual) != len(candidate_slugs)
            or actual != expected
        ):
            issues.append(
                {
                    "step": STEP_DEPENDENCY_PLANNER,
                    "summary": "Orderer returned invalid ordered_feature_slugs coverage.",
                    "risk": "Missing/duplicate slugs can produce non-deterministic generation order.",
                    "remediation": "Return every feature slug exactly once in ordered_feature_slugs.",
                }
            )
            candidate_slugs = fallback_slugs
    else:
        issues.append(
            {
                "step": STEP_DEPENDENCY_PLANNER,
                "summary": "Orderer output missing ordered_feature_slugs list.",
                "risk": "PM cannot validate ordering intent without explicit ordered slugs.",
                "remediation": "Return ordered_feature_slugs as a JSON list.",
            }
        )

    decisions_payload: List[Dict[str, Any]] = [
        dict(item) for item in dependency_decisions
    ]
    raw_decisions = payload.get("decisions")
    if isinstance(raw_decisions, list):
        decisions_payload = []
        for item in raw_decisions:
            if isinstance(item, dict):
                decisions_payload.append(dict(item))
    elif raw_decisions is not None:
        issues.append(
            {
                "step": STEP_DEPENDENCY_PLANNER,
                "summary": "Orderer returned non-list decisions payload.",
                "risk": "Ordering rationale can become unreadable and non-deterministic.",
                "remediation": "Return decisions as a JSON list of decision objects.",
            }
        )

    order_payload = build_order_payload(
        ordered_slugs=candidate_slugs,
        features=features,
        graph=graph,
        decisions=decisions_payload,
    )
    return order_payload, issues


