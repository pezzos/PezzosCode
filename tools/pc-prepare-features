def feature_semantic_tokens(feature: Feature) -> List[str]:
    raw = f"{feature.outcome} {feature.notes}".strip().lower()
    if not raw:
        return []
    candidates = re.findall(r"[a-z0-9]{4,}", raw)
    stop_tokens = {
        "feature",
        "features",
        "deliver",
        "workflow",
        "workflows",
        "project",
        "system",
        "process",
        "prepare",
        "review",
        "execute",
        "priority",
        "notes",
    }
    ordered: List[str] = []
    for token in candidates:
        if token in stop_tokens:
            continue
        if token in ordered:
            continue
        ordered.append(token)
        if len(ordered) >= 5:
            break
    return ordered


def feature_security_focus(feature: Feature) -> str:
    text = f"{feature.title} {feature.outcome} {feature.notes}".lower()
    if any(token in text for token in {"offload", "log", "artifact", "trace"}):
        return (
            "Protect offloaded/log artifacts: redact sensitive values and enforce "
            "allowed output paths."
        )
    if any(token in text for token in {"commit", "gate", "evidence"}):
        return (
            "Harden commit and evidence gates: require machine-verifiable evidence "
            "and block bypass paths."
        )
    if any(token in text for token in {"template", "bootstrap", "reapply", "update"}):
        return (
            "Constrain file writes: prevent traversal/symlink escapes and preserve "
            "protected paths during reapply flows."
        )
    if any(token in text for token in {"workflow", "orchestrator", "role", "agent"}):
        return (
            "Preserve role boundaries: enforce scoped writes and deterministic handoff "
            "artifacts between roles."
        )
    return (
        "Map feature behavior to least-privilege execution, deterministic output, and "
        "explicit failure handling."
    )


def security_markdown(
    *,
    features: Sequence[Feature],
    ordered_slugs: Sequence[str],
    graph: Dict[str, Set[str]],
    context_boundaries: str,
    design_markdown_text: str,
    ux_markdown_text: str,
    order_payload: Dict[str, Any],
) -> str:
    generated_on = datetime.now().strftime("%Y-%m-%d")
    scope_boundaries = extract_section_bullets(context_boundaries, "Scope Boundaries")
    non_goals = extract_section_bullets(context_boundaries, "Non-Goals")
    by_slug = {feature.slug: feature for feature in features}
    ordered_features = [by_slug[slug] for slug in ordered_slugs if slug in by_slug]

    if not scope_boundaries:
        scope_boundaries = [
            "Local CLI-only execution with explicit human command authority.",
            "No cloud runtime and no background service assumptions.",
        ]

    security_scope_lines = [f"- {item}" for item in scope_boundaries[:6]]
    if non_goals:
        security_scope_lines.extend(
            [f"- Non-goal: {item}" for item in non_goals[:4] if item.strip()]
        )

    attack_surface_rows = [
        "| Surface | Project-specific risk | Control direction |",
        "| ------- | --------------------- | ----------------- |",
        "| `make prepare-features` artifacts | Global docs can drift from project constraints across reruns. | Keep machine-managed artifacts deterministic and rerun-safe. |",
        "| `make review-features` findings | Review findings can create noisy or duplicate remediation work. | Keep findings scoped to active feature deltas and canonical task format. |",
        "| `make feature` execution loop | Role outputs and logs can leak sensitive data or bypass gates. | Enforce scoped writes, explicit gates, and auditable evidence pointers. |",
    ]

    feature_rows = [
        "| Ordered # | Feature | Dependencies | Security focus for implementation |",
        "| --------- | ------- | ------------ | --------------------------------- |",
    ]
    for idx, feature in enumerate(ordered_features, start=1):
        deps = sorted(graph.get(feature.slug, set()))
        deps_value = ", ".join(deps) if deps else "(none)"
        feature_rows.append(
            "| {idx:02d} | `{slug}` | {deps} | {focus} |".format(
                idx=idx,
                slug=feature.slug,
                deps=deps_value,
                focus=feature_security_focus(feature),
            )
        )

    ordered_in_payload = order_payload.get("ordered_feature_slugs", [])
    order_note = (
        ", ".join(str(item) for item in ordered_in_payload[:6])
        if isinstance(ordered_in_payload, list) and ordered_in_payload
        else "(none)"
