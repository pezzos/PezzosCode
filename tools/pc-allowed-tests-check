#!/usr/bin/env python3
import argparse
import os
from pathlib import Path
import shlex


def module_to_path(module: str) -> str:
    return os.path.join(*module.split(".")) + ".py"


def check_unittest_targets(targets: list[str]) -> list[str]:
    missing: list[str] = []
    for arg in targets:
        if arg.startswith("-"):
            continue
        target = arg.split(":", 1)[0]
        if not target:
            continue
        if target.endswith(".py") or "/" in target:
            if not os.path.exists(target):
                missing.append(arg)
            continue
        file_path = module_to_path(target)
        if os.path.exists(file_path):
            continue
        pkg_path = os.path.join(*target.split("."))
        if os.path.isdir(pkg_path) and os.path.exists(
            os.path.join(pkg_path, "__init__.py")
        ):
            continue
        missing.append(arg)
    return missing


def check_unittest_discover(args: list[str]) -> list[str]:
    missing: list[str] = []
    start_dir: str | None = None
    pattern: str | None = None
    top_level_dir: str | None = None
    positional: list[str] = []
    idx = 0
    while idx < len(args):
        arg = args[idx]
        if arg in {
            "-s",
            "--start-directory",
            "-p",
            "--pattern",
            "-t",
            "--top-level-directory",
        }:
            if idx + 1 >= len(args):
                missing.append(f"missing value for {arg}")
                break
            value = args[idx + 1]
            if arg in {"-s", "--start-directory"}:
                start_dir = value
            elif arg in {"-p", "--pattern"}:
                pattern = value
            else:
                top_level_dir = value
            idx += 2
            continue
        if arg.startswith("-"):
            idx += 1
            continue
        positional.append(arg)
        idx += 1

    if positional:
        if start_dir is None:
            start_dir = positional[0]
        if len(positional) > 1 and pattern is None:
            pattern = positional[1]
        if len(positional) > 2 and top_level_dir is None:
            top_level_dir = positional[2]

    if start_dir is None:
        start_dir = "."
    if pattern is None:
        pattern = "test*.py"

    start = Path(start_dir)
    if not start.exists() or not start.is_dir():
        missing.append(f"start directory not found: {start_dir}")
        return missing

    if top_level_dir:
        top = Path(top_level_dir)
        if not top.exists() or not top.is_dir():
            missing.append(f"top-level directory not found: {top_level_dir}")

    matches = list(start.rglob(pattern))
    if not any(path.is_file() for path in matches):
        missing.append(f"no tests match pattern '{pattern}' under '{start_dir}'")
    return missing


def check_unittest(parts: list[str]) -> list[str]:
    if len(parts) <= 3:
        return []
    if parts[3] == "discover":
        return check_unittest_discover(parts[4:])
    return check_unittest_targets(parts[3:])


def check_pytest(parts: list[str], start_idx: int) -> list[str]:
    missing: list[str] = []
    options_with_value = {
        "-k",
        "-m",
        "-c",
        "--maxfail",
        "--lfnf",
        "--durations",
        "--rootdir",
        "--basetemp",
    }
    idx = start_idx
    while idx < len(parts):
        arg = parts[idx]
        if arg.startswith("-"):
            if arg in options_with_value and idx + 1 < len(parts):
                idx += 2
                continue
            idx += 1
            continue
        target = arg.split("::", 1)[0]
        if not os.path.exists(target):
            missing.append(arg)
        idx += 1
    return missing


def check_command(raw: str) -> list[str]:
    try:
        parts = shlex.split(raw)
    except ValueError:
        return [raw]
    if not parts:
        return []
    if parts[0] == "tools/offload-proxy/pp":
        parts = parts[1:]
        if not parts:
            return [f"unsupported test command: {raw}"]
    if len(parts) >= 2 and parts[0] == "make" and parts[1] == "ci":
        return [f"forbidden command: {raw}"]
    if (
        parts[0] in {"python", "python3"}
        and len(parts) >= 3
        and parts[1] == "-m"
        and parts[2] == "unittest"
    ):
        return check_unittest(parts)
    if parts[0] in {"pytest", "py.test"}:
        return check_pytest(parts, 1)
    if (
        parts[0] in {"python", "python3"}
        and len(parts) >= 3
        and parts[1] == "-m"
        and parts[2] == "pytest"
    ):
        return check_pytest(parts, 3)
    return [f"unsupported test command: {raw}"]


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Validate that allowed test commands reference existing tests."
    )
    parser.add_argument("--cmd", action="append", default=[], help="Test command")
    args = parser.parse_args()

    missing: list[str] = []
    for raw in args.cmd:
        missing.extend(check_command(raw))

    if missing:
        for entry in missing:
            print(entry)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
