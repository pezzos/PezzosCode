#!/usr/bin/env python3
"""Validate required dev-tasks.md sections for all feature folders."""

from __future__ import annotations

import argparse
import re
import sys
from pathlib import Path
from typing import Iterable, List

DEFAULT_ROOT = Path(__file__).resolve().parents[1]
FEATURES_DIR = Path("docs/02-features")
TEMPLATE_DIRNAME = "feature-template"

REQUIRED_SECTIONS = ("Execution Log",)
TEMPLATE_ALLOWED_TESTS_HEADING = "Allowed Tests"
TEMPLATE_ALLOWED_TESTS_GUIDANCE_MARKERS = (
    "list exact commands",
    "tools/pc-allowed-tests-check",
)
WORK_ITEM_ENTRY_PATTERN = re.compile(r"^###\s+(WI-\d{8}-\d{2})\b.*$", re.MULTILINE)
SECTION_HEADING_PATTERN = re.compile(r"^####\s+(.+?)\s*$", re.MULTILINE)
TESTS_RUN_PATTERN = re.compile(r"^-\s+Tests run:\s*\S+", re.MULTILINE)
SECTION_OUTCOME_PATTERN = re.compile(
    r"Outcome:\s*(PASS|FAIL|NEEDS REPLAN|SKIPPED)", re.IGNORECASE
)
FEEDBACK_OUTCOME_LINE_PATTERN = re.compile(
    r"^\s*-\s*Outcome\s*:", re.IGNORECASE | re.MULTILINE
)
SCHEMA_COMPAT_MARKER = "feedback-outcome-v1"
SCHEMA_COMPAT_TEMPLATE_PATTERN = re.compile(
    r"devtasks-schema-compat:\s*([A-Za-z0-9._-]+)", re.IGNORECASE
)
SCHEMA_COMPAT_PC_FEATURE_PATTERN = re.compile(
    r'DEVTASKS_SCHEMA_COMPAT_MARKER\s*=\s*"([^"]+)"'
)
REQUIRED_WORK_ITEM_SECTIONS = (
    "Preflight Report",
    "TDD Plan",
    "Allowed Tests",
    "Files to Change",
    "Docs Updated",
    "Plan",
    "Patch",
    "Test Results",
    "Reporter Review",
    "Gates",
    "Autofix Attempts",
    "Tester Feedback",
    "Reporter Feedback",
    "Iteration Log",
    "Commit",
    "Final Report",
)
SECTION_ALIASES = {
    "Files to Change": ("Files to Change + Change Budget",),
}
TEMPLATE_REQUIRED_FEEDBACK_SECTIONS = ("Tester Feedback", "Reporter Feedback")


def section_pattern(section: str) -> re.Pattern[str]:
    return re.compile(
        rf"^\s*##\s+{re.escape(section)}\s*$", re.IGNORECASE | re.MULTILINE
    )


def parse_args(argv: List[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Validate required dev-tasks.md sections across features."
    )
    parser.add_argument(
        "--root",
        default=str(DEFAULT_ROOT),
        help="Repository root (defaults to detected root).",
    )
    parser.add_argument(
        "--verbose",
        action="store_true",
        help="Print success summary.",
    )
    return parser.parse_args(argv)


def feature_dirs(features_root: Path) -> Iterable[Path]:
    for entry in sorted(features_root.iterdir(), key=lambda item: item.name):
        if not entry.is_dir():
            continue
        if entry.name == TEMPLATE_DIRNAME:
            continue
        if re.match(r"^\d+-", entry.name):
            yield entry


def missing_sections(content: str) -> List[str]:
    missing: List[str] = []
    for section in REQUIRED_SECTIONS:
        if not section_pattern(section).search(content):
            missing.append(section)
    return missing


def work_item_blocks(content: str) -> Iterable[tuple[str, str]]:
    matches = list(WORK_ITEM_ENTRY_PATTERN.finditer(content))
    for idx, marker in enumerate(matches):
        start = marker.start()
        end = matches[idx + 1].start() if idx + 1 < len(matches) else len(content)
        yield marker.group(1), content[start:end]


def missing_work_item_sections(block: str) -> List[str]:
    headings = {
        match.group(1).strip()
        for match in SECTION_HEADING_PATTERN.finditer(block)
        if match.group(1).strip()
    }
    tests_run_present = bool(TESTS_RUN_PATTERN.search(block))
    missing: List[str] = []
    for section in REQUIRED_WORK_ITEM_SECTIONS:
        variants = (section,) + SECTION_ALIASES.get(section, ())
        if any(variant in headings for variant in variants):
            continue
        if section == "Allowed Tests" and tests_run_present:
            continue
        missing.append(section)
    return missing


def work_item_section_bodies(block: str) -> dict[str, str]:
    matches = list(SECTION_HEADING_PATTERN.finditer(block))
    sections: dict[str, str] = {}
    for idx, marker in enumerate(matches):
        section = marker.group(1).strip()
        if not section:
            continue
        start = marker.end()
        end = matches[idx + 1].start() if idx + 1 < len(matches) else len(block)
        sections[section] = block[start:end].strip()
    return sections


def markdown_h4_sections(content: str) -> dict[str, str]:
    matches = list(SECTION_HEADING_PATTERN.finditer(content))
    sections: dict[str, str] = {}
    for idx, marker in enumerate(matches):
        section = marker.group(1).strip()
        if not section:
            continue
        start = marker.end()
        end = matches[idx + 1].start() if idx + 1 < len(matches) else len(content)
        sections[section] = content[start:end].strip()
    return sections


def extract_template_schema_marker(content: str) -> str:
    match = SCHEMA_COMPAT_TEMPLATE_PATTERN.search(content or "")
    if not match:
        return ""
    return match.group(1).strip()


def extract_pc_feature_schema_marker(content: str) -> str:
    match = SCHEMA_COMPAT_PC_FEATURE_PATTERN.search(content or "")
    if not match:
        return ""
    return match.group(1).strip()


def template_feedback_outcome_issues(content: str) -> List[str]:
    sections = markdown_h4_sections(content)
    issues: List[str] = []
    for section in TEMPLATE_REQUIRED_FEEDBACK_SECTIONS:
        body = sections.get(section, "")
        if not body:
            issues.append(f"missing section '{section}'")
            continue
        if not FEEDBACK_OUTCOME_LINE_PATTERN.search(body):
            issues.append(f"missing Outcome field in '{section}'")
    return issues


def parse_section_outcome(text: str) -> str | None:
    match = SECTION_OUTCOME_PATTERN.search(text or "")
    if not match:
        return None
    return match.group(1).upper()


def section_complete(text: str) -> bool:
    if not text.strip():
        return False
    return "(pending)" not in text.lower()


def section_body_for_variants(sections: dict[str, str], section: str) -> str:
    variants = (section,) + SECTION_ALIASES.get(section, ())
    for variant in variants:
        if variant in sections:
            return sections[variant]
    return ""


def semantic_work_item_errors(
    work_item_id: str, block: str, *, label: str, path: Path
) -> List[str]:
    sections = work_item_section_bodies(block)
    test_results = section_body_for_variants(sections, "Test Results")
    tester_feedback = section_body_for_variants(sections, "Tester Feedback")

    if section_complete(test_results) and not parse_section_outcome(tester_feedback):
        return [
            f"{label}: semantic invariant violation in {path.as_posix()} "
            f"for {work_item_id}: missing critical artifact: "
            "test results exist without tester feedback outcome"
        ]
    return []


def check_dev_tasks_file(path: Path, *, label: str) -> List[str]:
    if not path.exists():
        return [f"{label}: missing file {path.as_posix()}"]
    content = path.read_text(encoding="utf-8")
    missing = missing_sections(content)
    errors = [
        f"{label}: missing section '## {section}' in {path.as_posix()}"
        for section in missing
    ]
    for work_item_id, block in work_item_blocks(content):
        missing_work_item = missing_work_item_sections(block)
        if not missing_work_item:
            errors.extend(
                semantic_work_item_errors(
                    work_item_id,
                    block,
                    label=label,
                    path=path,
                )
            )
        else:
            errors.append(
                f"{label}: missing required work-item section(s) in {path.as_posix()} "
                f"for {work_item_id}: {', '.join(missing_work_item)}"
            )
    return errors


def check_template_allowed_tests(path: Path) -> List[str]:
    if not path.exists():
        return []
    content = path.read_text(encoding="utf-8")
    errors: List[str] = []
    heading = re.compile(
        rf"^\s*##{{2,4}}\s+{re.escape(TEMPLATE_ALLOWED_TESTS_HEADING)}\s*$",
        re.IGNORECASE | re.MULTILINE,
    )
    if not heading.search(content):
        errors.append(
            f"feature-template: missing section '## {TEMPLATE_ALLOWED_TESTS_HEADING}' in {path.as_posix()}"
        )
    for marker in TEMPLATE_ALLOWED_TESTS_GUIDANCE_MARKERS:
        if marker not in content:
            errors.append(
                "feature-template: missing Allowed Tests guidance marker "
                f"'{marker}' in {path.as_posix()}"
            )
    return errors


def tooling_coherence_errors(root: Path) -> List[str]:
    pc_feature_path = root / "tools" / "pc-feature"
    live_template_path = root / FEATURES_DIR / TEMPLATE_DIRNAME / "dev-tasks.md"
    template_copy_path = (
        root
        / "tools"
        / "templates"
        / "docs"
        / "02-features"
        / TEMPLATE_DIRNAME
        / "dev-tasks.md"
    )
    if not pc_feature_path.exists() and not template_copy_path.exists():
        # Unit-test and standalone schema-check fixtures may only include docs/.
        return []

    errors: List[str] = []
    if not pc_feature_path.exists():
        errors.append(
            "tooling coherence guard: missing tools/pc-feature "
            f"(expected DEVTASKS_SCHEMA_COMPAT_MARKER='{SCHEMA_COMPAT_MARKER}')"
        )
    else:
        pc_feature_content = pc_feature_path.read_text(encoding="utf-8")
        marker = extract_pc_feature_schema_marker(pc_feature_content)
        if not marker:
            errors.append(
                "tooling coherence guard: tools/pc-feature missing "
                "DEVTASKS_SCHEMA_COMPAT_MARKER declaration"
            )
        elif marker != SCHEMA_COMPAT_MARKER:
            errors.append(
                "tooling coherence guard: tools/pc-feature marker mismatch "
                f"(found '{marker}', expected '{SCHEMA_COMPAT_MARKER}')"
            )

    for label, path in (
        ("live feature-template", live_template_path),
        ("template source copy", template_copy_path),
    ):
        if not path.exists():
            errors.append(
                f"tooling coherence guard: missing {path.as_posix()} ({label})"
            )
            continue
        template_content = path.read_text(encoding="utf-8")
        marker = extract_template_schema_marker(template_content)
        if not marker:
            errors.append(
                f"tooling coherence guard: {path.as_posix()} missing "
                "devtasks-schema-compat marker"
            )
        elif marker != SCHEMA_COMPAT_MARKER:
            errors.append(
                "tooling coherence guard: "
                f"{path.as_posix()} marker mismatch (found '{marker}', expected '{SCHEMA_COMPAT_MARKER}')"
            )
        for issue in template_feedback_outcome_issues(template_content):
            errors.append(f"tooling coherence guard: {path.as_posix()} {issue}")
    return errors


def run_check(root: Path) -> List[str]:
    features_root = root / FEATURES_DIR
    if not features_root.exists():
        return [f"missing features directory: {(FEATURES_DIR).as_posix()}"]

    errors: List[str] = []
    template_path = features_root / TEMPLATE_DIRNAME / "dev-tasks.md"
    errors.extend(check_dev_tasks_file(template_path, label="feature-template"))
    errors.extend(check_template_allowed_tests(template_path))

    for feature_dir in feature_dirs(features_root):
        if not any(feature_dir.iterdir()):
            continue
        dev_tasks_path = feature_dir / "dev-tasks.md"
        errors.extend(check_dev_tasks_file(dev_tasks_path, label=feature_dir.name))
    return errors


def main(argv: List[str] | None = None) -> int:
    args = parse_args(argv)
    root = Path(args.root).resolve()
    coherence_errors = tooling_coherence_errors(root)
    if coherence_errors:
        print(
            "pc-devtasks-schema-check: tooling/template coherence guard failed:",
            file=sys.stderr,
        )
        for item in coherence_errors:
            print(f"- {item}", file=sys.stderr)
        print(
            "remediation: sync tools/pc-feature plus both feature-template dev-tasks.md files "
            "from the same PezzosCode revision, run tools/pc-devtasks-migrate-legacy --root <repo>, "
            "then rerun pre-commit.",
            file=sys.stderr,
        )
        return 1

    errors = run_check(root)
    if errors:
        print(
            "pc-devtasks-schema-check: invalid dev-tasks schema detected:",
            file=sys.stderr,
        )
        for item in errors:
            print(f"- {item}", file=sys.stderr)
        print(
            "remediation: align files with docs/02-features/feature-template/dev-tasks.md, "
            "ensure required sections are present for each work item, and add "
            "Tester Feedback outcome when Test Results are complete",
            file=sys.stderr,
        )
        return 1

    if args.verbose:
        checked_count = 1 + sum(1 for _ in feature_dirs(root / FEATURES_DIR))
        print(f"pc-devtasks-schema-check: ok ({checked_count} files)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
