#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import shutil
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from lib import codex_exec  # noqa: E402


def utc_now() -> str:
    return datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Codex fallback autofix for staged pre-commit failures")
    parser.add_argument("--issues-file", help="Path to deterministic check output")
    parser.add_argument("--allowed-path", action="append", default=[], help="Allowed relative path")
    parser.add_argument("--retry-max", type=int, default=1)
    parser.add_argument("--stage", default="pre-commit")
    parser.add_argument("--output-json")
    parser.add_argument("--hook-fallback", action="store_true", help="No-op unless hook trigger env is set")
    return parser.parse_args()


def load_issues(path: str | None) -> str:
    if not path:
        return ""
    p = Path(path)
    if not p.exists():
        return ""
    text = p.read_text(encoding="utf-8", errors="replace")
    return text[:12000]


def normalize(path: str) -> str:
    return str(Path(path).as_posix()).strip()


def related_test_candidates(path: str) -> list[str]:
    rel = Path(path)
    stem = rel.stem
    candidates: list[Path] = []

    if rel.suffix == ".py":
        candidates.extend(
            [
                Path("tests") / f"test_{stem}.py",
                rel.parent / f"test_{stem}.py",
                rel.parent / "tests" / f"test_{stem}.py",
            ]
        )

    if rel.suffix in {".js", ".jsx", ".ts", ".tsx"}:
        for suffix in (".test.js", ".test.ts", ".spec.js", ".spec.ts"):
            candidates.extend(
                [
                    rel.with_name(f"{stem}{suffix}"),
                    Path("tests") / f"{stem}{suffix}",
                ]
            )

    existing = []
    for candidate in candidates:
        if candidate.exists():
            existing.append(candidate.as_posix())
    return existing


def git_changed_files() -> set[str]:
    def out(args: list[str]) -> list[str]:
        completed = subprocess.run(
            ["git", *args],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=True,
        )
        return [line.strip() for line in completed.stdout.splitlines() if line.strip()]

    changed = set(out(["diff", "--name-only"]))
    changed.update(out(["diff", "--cached", "--name-only"]))
    changed.update(out(["ls-files", "--others", "--exclude-standard"]))
    return changed


def run_scope_guard(allowed: list[str], artifact_path: Path) -> tuple[bool, dict[str, Any]]:
    command = ["tools/scope-guard"]
    for path in allowed:
        command.extend(["--allowed-path", path])
    command.extend(["--output-json", str(artifact_path)])
    completed = subprocess.run(command, text=True)
    payload = {}
    if artifact_path.exists():
        payload = json.loads(artifact_path.read_text(encoding="utf-8"))
    return completed.returncode == 0, payload


def stage_allowed(allowed: list[str]) -> list[str]:
    changed = git_changed_files()
    to_stage = sorted(path for path in changed if normalize(path) in {normalize(p) for p in allowed})
    if to_stage:
        subprocess.run(["git", "add", "--", *to_stage], check=True)
    return to_stage


def build_prompt(issues: str, allowed: list[str], stage: str) -> str:
    allowed_render = "\n".join(f"- {path}" for path in allowed)
    return (
        "You are autofix-coder.\n"
        "Goal: fix deterministic lint/test failures for this repository.\n"
        "Stage: "
        + stage
        + "\n"
        "Hard constraints:\n"
        "- Edit ONLY allowed files listed below.\n"
        "- Keep changes minimal and deterministic.\n"
        "- Run needed format/lint/test commands to validate fixes.\n"
        "- Do not refactor unrelated areas.\n"
        "Allowed files:\n"
        + allowed_render
        + "\n\n"
        "Failure output to resolve:\n"
        + issues
    )


def run_codex(prompt: str, message_path: Path, jsonl_path: Path) -> subprocess.CompletedProcess:
    if shutil.which("codex") is None:
        raise RuntimeError("codex-autofix: codex CLI not found in PATH")
    prepared = codex_exec.prepare_codex_env(
        Path.cwd(),
        ".codex_precommit",
        error_prefix="codex-autofix",
    )
    command = [
        "codex",
        "exec",
        "--full-auto",
        "--skip-git-repo-check",
        "--sandbox",
        "workspace-write",
        "--output-last-message",
        str(message_path),
        "--json",
        "-",
    ]
    completed = subprocess.run(
        command,
        input=prompt,
        text=True,
        env=prepared.env,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
    )
    jsonl_path.parent.mkdir(parents=True, exist_ok=True)
    jsonl_path.write_text(completed.stdout or "", encoding="utf-8")
    return completed


def main() -> int:
    args = parse_args()

    if args.hook_fallback:
        # Fallback hook is orchestrated by tools/git_precommit; stay no-op in standalone pre-commit execution.
        print("codex-autofix: hook fallback skipped (handled by tools/git_precommit)")
        return 0

    if not args.allowed_path:
        print("codex-autofix: no allowed paths provided")
        return 1

    allowed = sorted({normalize(path) for path in args.allowed_path if path.strip()})
    expanded = set(allowed)
    for path in allowed:
        expanded.update(related_test_candidates(path))
    allowed = sorted(expanded)

    issues = load_issues(args.issues_file)
    task_id = f"autofix-{datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')}"
    artifact_root = Path(".orchestrator") / "autofix" / task_id
    artifact_root.mkdir(parents=True, exist_ok=True)

    attempts = 0
    codex_error = None
    scope_report: dict[str, Any] = {}
    staged_paths: list[str] = []
    status = "failed"

    for attempt in range(args.retry_max + 1):
        attempts = attempt + 1
        prompt = build_prompt(issues, allowed, args.stage)
        message_path = artifact_root / f"attempt-{attempt + 1}.last_message.txt"
        jsonl_path = artifact_root / f"attempt-{attempt + 1}.jsonl"
        completed = run_codex(prompt, message_path, jsonl_path)
        if completed.returncode != 0:
            codex_error = f"codex exec failed on attempt {attempt + 1}"
            continue

        scope_ok, scope_report = run_scope_guard(
            allowed, artifact_root / f"attempt-{attempt + 1}.scope.json"
        )
        if not scope_ok:
            status = "blocked_scope"
            codex_error = "scope violation detected"
            break

        staged_paths = stage_allowed(allowed)
        status = "fixed"
        codex_error = None
        break

    changed = sorted(git_changed_files())
    changed_allowed = [
        {"path": path, "reason": "changed by Codex autofix"}
        for path in changed
        if path in set(allowed)
    ]

    payload = {
        "schema_version": "autofix_result_v1",
        "task_id": task_id,
        "status": status,
        "attempts": attempts,
        "allowed_paths": allowed,
        "changed_files": changed_allowed,
        "staged_paths": staged_paths,
        "tests": [],
        "errors": [] if codex_error is None else [codex_error],
        "scope_report": scope_report,
        "next_step": "rerun_deterministic_checks" if status == "fixed" else "manual_intervention",
        "generated_at": utc_now(),
        "artifact_root": str(artifact_root),
    }

    if args.output_json:
        output = Path(args.output_json).expanduser().resolve()
        output.parent.mkdir(parents=True, exist_ok=True)
        output.write_text(json.dumps(payload, indent=2), encoding="utf-8")

    print(json.dumps(payload, indent=2))
    return 0 if status == "fixed" else 1


if __name__ == "__main__":
    raise SystemExit(main())
