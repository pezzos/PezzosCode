#!/usr/bin/env bash
# Purpose: Copy repo docs, skills, and tooling into another repo for bootstrapping.
set -euo pipefail

usage() {
  cat <<'EOF' >&2
Usage: bootstrap-into [--self] <target-repo-path>
EOF
}
use_self=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --self)
      use_self=true
      shift
      ;;
    --reapply)
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "Unknown option: $1" >&2
      usage
      exit 1
      ;;
    *)
      break
      ;;
  esac
done

if ! "$use_self" && [[ $# -ne 1 ]]; then
  usage
  exit 1
fi

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if "$use_self"; then
  target_repo="$repo_root"
else
  target_repo="$1"
fi

if [[ ! -d "$target_repo" ]]; then
  echo "Target repo does not exist: $target_repo" >&2
  exit 1
fi

marker_for_file() {
  local file="$1"
  local hash="$2"
  local base
  base="$(basename "$file")"

  if [[ "$base" == "Makefile" ]]; then
    if [[ -n "$hash" ]]; then
      echo "# PezzosCode bootstrap sha256:${hash}"
    else
      echo "# PezzosCode bootstrap"
    fi
    return
  fi

  case "${file##*.}" in
    md)
      if [[ -n "$hash" ]]; then
        echo "<!-- PezzosCode bootstrap sha256:${hash} -->"
      else
        echo "<!-- PezzosCode bootstrap -->"
      fi
      ;;
    sh|bash|zsh|yml|yaml|toml|txt)
      if [[ -n "$hash" ]]; then
        echo "# PezzosCode bootstrap sha256:${hash}"
      else
        echo "# PezzosCode bootstrap"
      fi
      ;;
    *)
      if [[ -n "$hash" ]]; then
        echo "# PezzosCode bootstrap sha256:${hash}"
      else
        echo "# PezzosCode bootstrap"
      fi
      ;;
  esac
}

marker_prefix_for_file() {
  local file="$1"
  local base
  base="$(basename "$file")"

  if [[ "$base" == "Makefile" ]]; then
    echo "# PezzosCode bootstrap"
    return
  fi

  case "${file##*.}" in
    md)
      echo "<!-- PezzosCode bootstrap"
      ;;
    sh|bash|zsh|yml|yaml|toml|txt)
      echo "# PezzosCode bootstrap"
      ;;
    *)
      echo "# PezzosCode bootstrap"
      ;;
  esac
}

has_marker() {
  local file="$1"
  local marker_prefix
  marker_prefix="$(marker_prefix_for_file "$file")"

  [[ -f "$file" ]] || return 1
  local last
  last="$(awk 'NF {line=$0} END {print line}' "$file" 2>/dev/null || true)"
  [[ "$last" == "$marker_prefix"* ]]
}

append_marker() {
  local file="$1"
  local marker
  local hash
  hash="$(file_hash_without_marker "$file")"
  marker="$(marker_for_file "$file" "$hash")"

  if [[ -f "$file" ]]; then
    if has_marker "$file"; then
      return
    fi
    printf "\n%s\n" "$marker" >> "$file"
  fi
}

normalize_for_compare() {
  local file="$1"
  local out="$2"
  local marker_prefix

  marker_prefix="$(marker_prefix_for_file "$file")"

  awk -v marker_prefix="$marker_prefix" '
  { lines[NR] = $0 }
  END {
    n = NR
    while (n > 0 && lines[n] ~ /^[[:space:]]*$/) { n-- }
    if (n > 0 && index(lines[n], marker_prefix) == 1) { n-- }
    while (n > 0 && lines[n] ~ /^[[:space:]]*$/) { n-- }
    for (i = 1; i <= n; i++) { print lines[i] }
  }' "$file" > "$out"
}

file_hash_without_marker() {
  local file="$1"
  local tmp
  tmp="$(mktemp)"
  normalize_for_compare "$file" "$tmp"
  local hash
  hash="$(shasum -a 256 "$tmp" | awk '{print $1}')"
  rm -f "$tmp"
  echo "$hash"
}

marker_hash_from_file() {
  local file="$1"
  local marker_prefix
  marker_prefix="$(marker_prefix_for_file "$file")"
  local last
  last="$(awk 'NF {line=$0} END {print line}' "$file" 2>/dev/null || true)"
  if [[ "$last" != "$marker_prefix"* ]]; then
    return
  fi
  echo "$last" | awk -F 'sha256:' 'NF>1 {print $2}' | awk '{gsub(/[^0-9a-f]/,"",$0); print}'
}

files_equal_ignoring_marker() {
  local src="$1"
  local dest="$2"
  local tmp_src
  local tmp_dest

  tmp_src="$(mktemp)"
  tmp_dest="$(mktemp)"

  normalize_for_compare "$src" "$tmp_src"
  normalize_for_compare "$dest" "$tmp_dest"

  if cmp -s "$tmp_src" "$tmp_dest"; then
    rm -f "$tmp_src" "$tmp_dest"
    return 0
  fi

  rm -f "$tmp_src" "$tmp_dest"
  return 1
}

prompt_action() {
  local dest="$1"
  local choice
  local prompt_in="/dev/tty"

  if [[ ! -r "$prompt_in" ]]; then
    prompt_in="/dev/stdin"
  fi

  while true; do
    echo "File exists: $dest" >&2
    echo "Choose action: [o]verwrite, [m]erge (codex), [s]kip" >&2
    read -r -p "Selection: " choice < "$prompt_in"
    case "$choice" in
      o|O)
        echo "overwrite"
        return
        ;;
      m|M)
        echo "merge"
        return
        ;;
      s|S|"")
        echo "skip"
        return
        ;;
      *)
        echo "Invalid choice."
        ;;
    esac
  done
}

is_syncable_path() {
  local rel="$1"

  if [[ "$rel" == "AGENTS.md" || "$rel" == ".codex.toml" ]]; then
    echo "conditional"
    return
  fi

  if [[ "$rel" == "tools/"* || "$rel" == ".codex/skills/"* ]]; then
    if [[ "$rel" == "tools/bootstrap-into" ]]; then
      echo "never"
    else
      echo "sync"
    fi
    return
  fi

  if [[ "$rel" == "docs/04-process/"* ]]; then
    echo "sync"
    return
  fi

  if [[ "$rel" == "docs/02-features/feature-template/"* ]]; then
    echo "sync"
    return
  fi

  if [[ "$rel" == "docs/03-logs/tickets/worklog-template.md" ]]; then
    echo "sync"
    return
  fi

  if [[ "$rel" == "docs/README.md" ]]; then
    echo "sync"
    return
  fi

  if [[ "$rel" == "docs/AGENTS.md" || "$rel" == "docs/"*"/AGENTS.md" ]]; then
    echo "sync"
    return
  fi

  if [[ "$rel" == "docs/01-product/AGENTS.md" ]]; then
    echo "sync"
    return
  fi

  if [[ "$rel" == "docs/02-features/AGENTS.md" ]]; then
    echo "sync"
    return
  fi

  if [[ "$rel" == "docs/03-logs/AGENTS.md" ]]; then
    echo "sync"
    return
  fi

  if [[ "$rel" == "docs/00-context/"* ]]; then
    echo "protected"
    return
  fi

  if [[ "$rel" == "docs/01-product/prd.md" ]]; then
    echo "protected"
    return
  fi

  if [[ "$rel" == "docs/02-features/"* ]]; then
    echo "protected"
    return
  fi

  if [[ "$rel" == "docs/03-logs/"* ]]; then
    echo "protected"
    return
  fi

  if [[ "$rel" == ".gitmessage" || "$rel" == "LICENSE" || "$rel" == "Makefile" || "$rel" == "pp.yml" ]]; then
    echo "sync"
    return
  fi

  echo "protected"
}

copy_file() {
  local src="$1"
  local dest="$2"
  local rel="$3"
  local policy

  policy="$(is_syncable_path "$rel")"

  if [[ "$policy" == "never" ]]; then
    echo "Skipping (excluded): $dest"
    return 0
  fi

  if [[ "$policy" == "protected" && -f "$dest" ]]; then
    echo "Skipping (protected): $dest"
    return 0
  fi

  if [[ "$policy" == "conditional" && -f "$dest" ]]; then
    local marker_hash
    local current_hash
    marker_hash="$(marker_hash_from_file "$dest")"
    current_hash="$(file_hash_without_marker "$dest")"
    if [[ -n "$marker_hash" && "$marker_hash" == "$current_hash" ]]; then
      if files_equal_ignoring_marker "$src" "$dest"; then
        echo "Skipping (no changes): $dest"
        return 0
      fi
    else
      echo "Skipping (locally modified): $dest"
      return 0
    fi
  fi

  if [[ -f "$dest" ]] && files_equal_ignoring_marker "$src" "$dest"; then
    echo "Skipping (no changes): $dest"
    return 0
  fi

  mkdir -p "$(dirname "$dest")"
  cp "$src" "$dest"
  append_marker "$dest"
}

copy_dir_files() {
  local src_dir="$1"
  local dest_dir="$2"
  local rel_prefix="$3"
  local src_file
  local rel
  local dest_rel

  [[ -d "$src_dir" ]] || return 0

  while IFS= read -r -d '' src_file; do
    rel="${src_file#$src_dir/}"
    dest_rel="$rel_prefix/$rel"
    if [[ "$rel" == *"/__pycache__/"* || "$rel" == *".pyc" ]]; then
      continue
    fi
    copy_file "$src_file" "$dest_dir/$rel" "$dest_rel"
  done < <(find "$src_dir" -type f -print0)
}

copy_dir_files "$repo_root/tools/templates/docs" "$target_repo/docs" "docs"
copy_dir_files "$repo_root/.codex/skills" "$target_repo/.codex/skills" ".codex/skills"
copy_dir_files "$repo_root/tools" "$target_repo/tools" "tools"
copy_file "$repo_root/AGENTS.md" "$target_repo/AGENTS.md" "AGENTS.md"
copy_file "$repo_root/.codex.toml" "$target_repo/.codex.toml" ".codex.toml"
copy_file "$repo_root/.gitignore" "$target_repo/.gitignore" ".gitignore"
copy_file "$repo_root/.gitmessage" "$target_repo/.gitmessage" ".gitmessage"
copy_file "$repo_root/LICENSE" "$target_repo/LICENSE" "LICENSE"
copy_file "$repo_root/Makefile" "$target_repo/Makefile" "Makefile"
copy_file "$repo_root/pp.yml" "$target_repo/pp.yml" "pp.yml"
