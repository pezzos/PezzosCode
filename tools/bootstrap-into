#!/usr/bin/env bash
# Purpose: Copy repo docs, skills, and tooling into another repo for bootstrapping.
set -euo pipefail

usage() {
  cat <<'EOF' >&2
Usage: bootstrap-into [--self] [--reapply] [--dry-run] [-v|--verbose] <target-repo-path>
EOF
}
use_self=false
verbose=false
dry_run=false
reapply=false
preflight_gate_emitted=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --self)
      use_self=true
      shift
      ;;
    --dry-run)
      dry_run=true
      shift
      ;;
    -v|--verbose)
      verbose=true
      shift
      ;;
    --reapply)
      reapply=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "Unknown option: $1" >&2
      usage
      exit 1
      ;;
    *)
      break
      ;;
  esac
done

if ! "$use_self" && [[ $# -ne 1 ]]; then
  usage
  exit 1
fi

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if "$use_self"; then
  target_repo="$repo_root"
else
  target_repo="$1"
fi

if [[ ! -d "$target_repo" ]]; then
  echo "Target repo does not exist: $target_repo" >&2
  exit 1
fi

if [[ ! -e "$target_repo/.git" ]]; then
  echo "bootstrap-into: target repo is not a git repository: $target_repo" >&2
  exit 1
fi

require_cmd() {
  local cmd="$1"
  if ! command -v "$cmd" >/dev/null 2>&1; then
    echo "bootstrap-into: missing required command: $cmd" >&2
    exit 1
  fi
}

for cmd in cmp find; do
  require_cmd "$cmd"
done

# Preserve original stdin for prompts (loops below use process substitution).
exec 3<&0

log_skip() {
  local message="$1"
  if "$verbose"; then
    echo "$message"
  fi
}

files_equal() {
  local src="$1"
  local dest="$2"
  [[ -f "$dest" ]] || return 1
  cmp -s "$src" "$dest"
}

prompt_action() {
  local dest="$1"
  local choice

  while true; do
    echo "File exists: $dest" >&2
    echo "Choose action: [o]verwrite, [m]erge (codex), [s]kip" >&2
    if [[ -t 0 && -r "/dev/tty" ]]; then
      read -r -p "Selection: " choice < "/dev/tty"
    else
      read -r -p "Selection: " choice <&3
    fi
    case "$choice" in
      o|O)
        echo "overwrite"
        return
        ;;
      m|M)
        echo "merge"
        return
        ;;
      s|S|"")
        echo "skip"
        return
        ;;
      *)
        echo "Invalid choice."
        ;;
    esac
  done
}

emit_preflight_validation_gate() {
  if [[ "$preflight_gate_emitted" -eq 0 ]]; then
    echo "Preflight validation gate: verifying the target repository state before reapply." >&2
    preflight_gate_emitted=1
  fi
}

emit_template_diff_gate() {
  local rel="$1"
  echo "Template diff review gate: reviewing the diff for $rel before acting." >&2
}

emit_conflict_summary() {
  local rel="$1"
  local summary="$2"
  echo "Conflict summary output: $rel -> $summary." >&2
}

is_syncable_path() {
  local rel="$1"

  if [[ "$rel" == "AGENTS.md" || "$rel" == ".codex.toml" || "$rel" == ".editorconfig" || "$rel" == ".gitignore" || "$rel" == ".gitmessage" || "$rel" == "LICENSE" || "$rel" == "Makefile" || "$rel" == "pp.yml" || "$rel" == ".pre-commit-config.yaml" || "$rel" == ".serena/"* || "$rel" == ".githooks/"* ]]; then
    echo "conditional"
    return
  fi

  if [[ "$rel" == "tools/"* || "$rel" == "lib/"* || "$rel" == ".codex/skills/"* ]]; then
    if [[ "$rel" == "tools/bootstrap-into" ]]; then
      echo "never"
    else
      echo "sync"
    fi
    return
  fi

  if [[ "$rel" == "docs/04-process/"* ]]; then
    echo "sync"
    return
  fi

  if [[ "$rel" == "docs/02-features/feature-template/"* ]]; then
    echo "sync"
    return
  fi

  if [[ "$rel" == "docs/03-logs/tickets/worklog-template.md" ]]; then
    echo "sync"
    return
  fi

  if [[ "$rel" == "docs/README.md" ]]; then
    echo "sync"
    return
  fi

  if [[ "$rel" == "docs/AGENTS.md" || "$rel" == "docs/"*"/AGENTS.md" ]]; then
    echo "sync"
    return
  fi

  if [[ "$rel" == "docs/01-product/AGENTS.md" ]]; then
    echo "sync"
    return
  fi

  if [[ "$rel" == "docs/02-features/AGENTS.md" ]]; then
    echo "sync"
    return
  fi

  if [[ "$rel" == "docs/03-logs/AGENTS.md" ]]; then
    echo "sync"
    return
  fi

  if [[ "$rel" == "prompts/"* ]]; then
    echo "sync"
    return
  fi

  if [[ "$rel" == "docs/00-context/"* ]]; then
    echo "protected"
    return
  fi

  if [[ "$rel" == "docs/01-product/prd.md" ]]; then
    echo "protected"
    return
  fi

  if [[ "$rel" == "docs/02-features/"* ]]; then
    echo "protected"
    return
  fi

  if [[ "$rel" == "docs/03-logs/"* ]]; then
    echo "protected"
    return
  fi

  echo "protected"
}

copy_file() {
  local src="$1"
  local dest="$2"
  local rel="$3"
  local policy
  local choice

  policy="$(is_syncable_path "$rel")"

  if [[ "$policy" == "never" ]]; then
    log_skip "Skipping (excluded): $dest"
    return 0
  fi

  if [[ "$policy" == "protected" && -f "$dest" ]]; then
    log_skip "Skipping (protected): $dest"
    return 0
  fi

  if [[ -f "$dest" ]] && files_equal "$src" "$dest"; then
    log_skip "Skipping (no changes): $dest"
    return 0
  fi

  if [[ -f "$dest" ]]; then
    if "$reapply" && [[ "$policy" == "sync" || "$policy" == "conditional" ]]; then
      if "$dry_run"; then
        echo "Dry-run: would update: $dest"
        return 0
      fi
      emit_preflight_validation_gate
      emit_template_diff_gate "$rel"
      emit_conflict_summary "$rel" "overwrite (reapply)"
    elif [[ "$policy" == "conditional" ]]; then
      log_skip "Skipping (locally modified): $dest"
      return 0
    elif [[ "$policy" == "sync" ]]; then
      if "$dry_run"; then
        echo "Dry-run: would update: $dest"
        return 0
      fi
      emit_preflight_validation_gate
      emit_template_diff_gate "$rel"
      choice="$(prompt_action "$dest")"
      case "$choice" in
        overwrite)
          emit_conflict_summary "$rel" "overwrite"
          ;;
        merge)
          echo "Merge not supported yet; skipping: $dest" >&2
          log_skip "Skipping (merge unsupported): $dest"
          emit_conflict_summary "$rel" "merge unsupported"
          return 0
          ;;
        skip)
          log_skip "Skipping (user): $dest"
          emit_conflict_summary "$rel" "skipped by user"
          return 0
          ;;
      esac
    fi
  fi

  if "$dry_run"; then
    echo "Dry-run: would update: $dest"
    return 0
  fi

  mkdir -p "$(dirname "$dest")"
  cp "$src" "$dest"
  echo "Updated: $dest"
}

copy_dir_files() {
  local src_dir="$1"
  local dest_dir="$2"
  local rel_prefix="$3"
  local src_file
  local rel
  local dest_rel

  [[ -d "$src_dir" ]] || return 0

  while IFS= read -r -d '' src_file; do
    rel="${src_file#$src_dir/}"
    if [[ -z "$rel_prefix" ]]; then
      dest_rel="$rel"
    else
      dest_rel="$rel_prefix/$rel"
    fi
    if [[ "$rel" == *"/__pycache__/"* || "$rel" == *".pyc" ]]; then
      continue
    fi
    if [[ "$rel_prefix" == "tools" && "$rel" == "templates/"* ]]; then
      continue
    fi
    copy_file "$src_file" "$dest_dir/$rel" "$dest_rel"
  done < <(find "$src_dir" -type f -print0)
}

copy_dir_files "$repo_root/tools/templates/root" "$target_repo" ""
copy_dir_files "$repo_root/tools/templates/docs" "$target_repo/docs" "docs"
copy_dir_files "$repo_root/tools/templates/prompts" "$target_repo/prompts" "prompts"
copy_dir_files "$repo_root/.codex/skills" "$target_repo/.codex/skills" ".codex/skills"
copy_dir_files "$repo_root/lib" "$target_repo/lib" "lib"
copy_dir_files "$repo_root/tools" "$target_repo/tools" "tools"

if ! "$dry_run"; then
  if [[ -d "$target_repo/.git" ]]; then
    if command -v pre-commit >/dev/null 2>&1; then
      if ! (cd "$target_repo" && pre-commit install --hook-type pre-commit --hook-type pre-push); then
        echo "Warning: pre-commit install failed; skipping hook install." >&2
      fi
    else
      echo "Warning: pre-commit not installed; skipping hook install." >&2
    fi
  else
    echo "Warning: target repo is not a git repository; skipping hook install." >&2
  fi
fi
