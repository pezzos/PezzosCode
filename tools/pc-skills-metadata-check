#!/usr/bin/env python3
"""Validate Codex skill metadata and interface contracts."""

from __future__ import annotations

import argparse
import re
import sys
from pathlib import Path
from typing import Dict, List, Tuple

import yaml


DEFAULT_ROOT = Path(__file__).resolve().parents[1]
SKILLS_DIR = Path(".codex/skills")
SKILL_NAME_RE = re.compile(r"^[a-z0-9-]{1,64}$")
FRONTMATTER_RE = re.compile(r"^---\n(.*?)\n---", re.DOTALL)
ABSOLUTE_PATH_RE = re.compile(r"(/Users/|/home/|[A-Za-z]:\\\\)")


def parse_args(argv: List[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Validate metadata contracts for local Codex skills."
    )
    parser.add_argument(
        "--root",
        default=str(DEFAULT_ROOT),
        help="Repository root (defaults to detected root).",
    )
    parser.add_argument(
        "--verbose",
        action="store_true",
        help="Print success summary.",
    )
    return parser.parse_args(argv)


def load_yaml(path: Path) -> Dict[str, object] | None:
    try:
        data = yaml.safe_load(path.read_text(encoding="utf-8"))
    except yaml.YAMLError:
        return None
    if not isinstance(data, dict):
        return None
    return data


def extract_frontmatter(skill_md: Path) -> Dict[str, object] | None:
    text = skill_md.read_text(encoding="utf-8")
    match = FRONTMATTER_RE.match(text)
    if not match:
        return None
    try:
        loaded = yaml.safe_load(match.group(1))
    except yaml.YAMLError:
        return None
    if not isinstance(loaded, dict):
        return None
    return loaded


def validate_frontmatter(skill_dir: Path) -> List[str]:
    errors: List[str] = []
    skill_md = skill_dir / "SKILL.md"
    if not skill_md.exists():
        return [f"{skill_dir.name}: missing SKILL.md"]
    frontmatter = extract_frontmatter(skill_md)
    if frontmatter is None:
        return [f"{skill_dir.name}: invalid SKILL.md frontmatter"]

    allowed_keys = {"name", "description"}
    unknown = sorted(set(frontmatter.keys()) - allowed_keys)
    if unknown:
        errors.append(
            f"{skill_dir.name}: unsupported frontmatter keys: {', '.join(unknown)}"
        )

    name = frontmatter.get("name")
    description = frontmatter.get("description")
    if not isinstance(name, str) or not name.strip():
        errors.append(f"{skill_dir.name}: frontmatter name missing/invalid")
    else:
        if name != skill_dir.name:
            errors.append(
                f"{skill_dir.name}: frontmatter name '{name}' does not match folder"
            )
        if not SKILL_NAME_RE.match(name):
            errors.append(f"{skill_dir.name}: frontmatter name has invalid format")

    if not isinstance(description, str) or not description.strip():
        errors.append(f"{skill_dir.name}: frontmatter description missing/invalid")
    else:
        if "TODO" in description:
            errors.append(f"{skill_dir.name}: frontmatter description contains TODO")
        if "<" in description or ">" in description:
            errors.append(
                f"{skill_dir.name}: frontmatter description cannot contain angle brackets"
            )

    return errors


def validate_openai_yaml(skill_dir: Path) -> List[str]:
    errors: List[str] = []
    config_path = skill_dir / "agents" / "openai.yaml"
    if not config_path.exists():
        return [f"{skill_dir.name}: missing agents/openai.yaml"]
    config = load_yaml(config_path)
    if config is None:
        return [f"{skill_dir.name}: invalid YAML in agents/openai.yaml"]

    interface = config.get("interface")
    if not isinstance(interface, dict):
        return [f"{skill_dir.name}: interface section missing in agents/openai.yaml"]

    required_interface = ("display_name", "short_description", "default_prompt")
    for key in required_interface:
        value = interface.get(key)
        if not isinstance(value, str) or not value.strip():
            errors.append(f"{skill_dir.name}: interface.{key} missing/invalid")

    short_description = interface.get("short_description")
    if isinstance(short_description, str):
        size = len(short_description)
        if size < 25 or size > 64:
            errors.append(
                f"{skill_dir.name}: interface.short_description length {size} outside 25..64"
            )

    default_prompt = interface.get("default_prompt")
    if isinstance(default_prompt, str) and f"${skill_dir.name}" not in default_prompt:
        errors.append(
            f"{skill_dir.name}: interface.default_prompt must mention ${skill_dir.name}"
        )

    dependencies = config.get("dependencies")
    if dependencies is not None:
        if not isinstance(dependencies, dict):
            errors.append(f"{skill_dir.name}: dependencies must be a map")
        else:
            tools = dependencies.get("tools", [])
            if not isinstance(tools, list):
                errors.append(f"{skill_dir.name}: dependencies.tools must be a list")
            else:
                for idx, item in enumerate(tools):
                    if not isinstance(item, dict):
                        errors.append(
                            f"{skill_dir.name}: dependencies.tools[{idx}] must be a map"
                        )
                        continue
                    if item.get("type") != "mcp":
                        errors.append(
                            f"{skill_dir.name}: dependencies.tools[{idx}].type must be 'mcp'"
                        )
                    value = item.get("value")
                    if not isinstance(value, str) or not value.strip():
                        errors.append(
                            f"{skill_dir.name}: dependencies.tools[{idx}].value missing/invalid"
                        )

    policy = config.get("policy")
    if policy is not None:
        if not isinstance(policy, dict):
            errors.append(f"{skill_dir.name}: policy must be a map")
        else:
            allow = policy.get("allow_implicit_invocation")
            if not isinstance(allow, bool):
                errors.append(
                    f"{skill_dir.name}: policy.allow_implicit_invocation must be boolean"
                )

    return errors


def find_absolute_path_violations(skill_dir: Path) -> List[str]:
    violations: List[str] = []
    for path in sorted(skill_dir.rglob("*")):
        if not path.is_file():
            continue
        try:
            content = path.read_text(encoding="utf-8")
        except UnicodeDecodeError:
            continue
        if ABSOLUTE_PATH_RE.search(content):
            rel = path.relative_to(skill_dir).as_posix()
            violations.append(f"{skill_dir.name}: absolute local path found in {rel}")
    return violations


def iter_skill_dirs(skills_root: Path) -> List[Path]:
    return sorted(
        [p for p in skills_root.iterdir() if p.is_dir()], key=lambda p: p.name
    )


def run_check(root: Path) -> Tuple[List[str], int]:
    errors: List[str] = []
    skills_root = root / SKILLS_DIR
    if not skills_root.exists():
        return [f"missing skills directory: {SKILLS_DIR.as_posix()}"], 0

    skill_dirs = iter_skill_dirs(skills_root)
    for skill_dir in skill_dirs:
        errors.extend(validate_frontmatter(skill_dir))
        errors.extend(validate_openai_yaml(skill_dir))
        errors.extend(find_absolute_path_violations(skill_dir))
    return errors, len(skill_dirs)


def main(argv: List[str] | None = None) -> int:
    args = parse_args(argv)
    root = Path(args.root).resolve()
    errors, checked_count = run_check(root)
    if errors:
        print(
            "pc-skills-metadata-check: invalid skill metadata detected:",
            file=sys.stderr,
        )
        for item in errors:
            print(f"- {item}", file=sys.stderr)
        print(
            "remediation: fix SKILL.md frontmatter, agents/openai.yaml, or absolute path usage",
            file=sys.stderr,
        )
        return 1
    if args.verbose:
        print(f"pc-skills-metadata-check: ok ({checked_count} skills)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
