#!/usr/bin/env bash
# Purpose: Run checks, enforce allowed paths, and guide standardized commits.
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: tools/pc-commit [options]

Options:
  --allow <path>    Allow changed path (repeatable)
  --work-item-id <id>  Validate commit evidence against this work item (WI-YYYYMMDD-NN)
  --message <msg>   Use full commit message (skip prompts)
  --type <type>     Commit type: feat|fix|docs|chore
  --scope <scope>   Commit scope (required unless --message)
  --summary <text>  Commit summary (required unless --message)
  --dry-run         Show actions without executing
  --yes             Skip confirmation prompt
  -h, --help        Show help
USAGE
}

dry_run=false
assume_yes=false
message=""
type=""
scope=""
summary=""
allow_paths=()
work_item_id=""
commit_evidence_remediation='Remediation: complete required "Test Results", "Commit", and "Final Report" evidence before commit.'
runtime_shell_snapshot_prefix=".codex_subagent/shell_snapshots/"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --allow)
      allow_paths+=("$2")
      shift 2
      ;;
    --work-item-id)
      work_item_id="$2"
      shift 2
      ;;
    --message)
      message="$2"
      shift 2
      ;;
    --type)
      type="$2"
      shift 2
      ;;
    --scope)
      scope="$2"
      shift 2
      ;;
    --summary)
      summary="$2"
      shift 2
      ;;
    --dry-run)
      dry_run=true
      shift
      ;;
    --yes)
      assume_yes=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Not inside a git repository." >&2
  exit 1
fi
repo_root="$(git rev-parse --show-toplevel)"
script_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ ${#allow_paths[@]} -eq 0 ]]; then
  staged_paths=()
  if command -v mapfile >/dev/null 2>&1; then
    mapfile -t staged_paths < <(git diff --cached --name-only)
  else
    while IFS= read -r line; do
      staged_paths+=("$line")
    done < <(git diff --cached --name-only)
  fi
  allow_paths=("${staged_paths[@]}")
fi

if [[ ${#allow_paths[@]} -eq 0 ]]; then
  echo "No staged changes detected. Stage files or use --allow." >&2
  exit 1
fi

is_allowed_path() {
  local path="$1"
  local allowed_path
  local normalized_allowed
  for allowed_path in "${allow_paths[@]}"; do
    normalized_allowed="${allowed_path%/}"
    if [[ "$path" == "$normalized_allowed" || "$path" == "$normalized_allowed/"* ]]; then
      return 0
    fi
  done
  return 1
}

is_runtime_shell_snapshot_path() {
  local path="$1"
  [[ "$path" == "$runtime_shell_snapshot_prefix"* ]]
}

print_snapshot_scope_remediation() {
  echo "Remediation: remove tracked runtime shell snapshots from feature scope before commit." >&2
}

has_runtime_shell_snapshot_paths() {
  local path
  for path in "$@"; do
    if is_runtime_shell_snapshot_path "$path"; then
      return 0
    fi
  done
  return 1
}

collect_allowed_changed_paths() {
  local allowed_changed_local
  allowed_changed_local=()
  local line
  local path
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    path="${line:3}"
    if [[ "$path" == *" -> "* ]]; then
      path="${path##* -> }"
    fi
    if is_runtime_shell_snapshot_path "$path"; then
      continue
    fi
    if is_allowed_path "$path"; then
      allowed_changed_local+=("$path")
    fi
  done < <(git status --porcelain)

  if [[ ${#allowed_changed_local[@]} -gt 0 ]]; then
    printf '%s\n' "${allowed_changed_local[@]}"
  fi
}

collect_disallowed_paths() {
  local disallowed_local
  disallowed_local=()
  local line
  local path
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    path="${line:3}"
    if [[ "$path" == *" -> "* ]]; then
      path="${path##* -> }"
    fi
    if is_runtime_shell_snapshot_path "$path" || ! is_allowed_path "$path"; then
      disallowed_local+=("$path")
    fi
  done < <(git status --porcelain)
  if [[ ${#disallowed_local[@]} -gt 0 ]]; then
    printf '%s\n' "${disallowed_local[@]}"
  fi
}

disallowed=()
if command -v mapfile >/dev/null 2>&1; then
  mapfile -t disallowed < <(collect_disallowed_paths)
else
  while IFS= read -r line; do
    disallowed+=("$line")
  done < <(collect_disallowed_paths)
fi

if [[ ${#disallowed[@]} -gt 0 ]]; then
  echo "Unexpected changes detected:" >&2
  printf ' - %s\n' "${disallowed[@]}" >&2
  if has_runtime_shell_snapshot_paths "${disallowed[@]}"; then
    print_snapshot_scope_remediation
  fi
  echo "Use --allow <path> to permit expected files." >&2
  exit 1
fi

contains_path() {
  local candidate="$1"
  local path
  for path in "${staged_paths[@]}"; do
    if [[ "$path" == "$candidate" ]]; then
      return 0
    fi
  done
  return 1
}

validate_commit_evidence_gate() {
  local dev_tasks_paths=()
  if command -v mapfile >/dev/null 2>&1; then
    mapfile -t dev_tasks_paths < <(
      git diff --cached --name-only -- "docs/02-features/*/dev-tasks.md"
    )
  else
    while IFS= read -r line; do
      dev_tasks_paths+=("$line")
    done < <(git diff --cached --name-only -- "docs/02-features/*/dev-tasks.md")
  fi

  [[ ${#dev_tasks_paths[@]} -eq 0 ]] && return 0

  local validation_output
  if ! validation_output="$(
    PC_COMMIT_REPO_ROOT="$repo_root" \
    PC_COMMIT_LIB_ROOT="$script_root" \
    PC_COMMIT_WORK_ITEM_ID="$work_item_id" \
    python3 - "${dev_tasks_paths[@]}" <<'PY'
import os
import sys
from pathlib import Path

LIB_ROOT_RAW = os.environ.get("PC_COMMIT_LIB_ROOT", "").strip()
if not LIB_ROOT_RAW:
    raise SystemExit("pc-commit: missing library root for commit evidence checks")
LIB_ROOT = Path(LIB_ROOT_RAW).resolve()
sys.path.insert(0, str(LIB_ROOT))

from lib import commit_evidence_gate  # noqa: E402

TARGET_WORK_ITEM_ID = os.environ.get("PC_COMMIT_WORK_ITEM_ID", "").strip()


def validate(path: Path):
    content = path.read_text(encoding="utf-8")
    selected_work_item_id, issues = commit_evidence_gate.commit_evidence_gate_issues(
        content,
        work_item_id=TARGET_WORK_ITEM_ID,
    )
    if issues:
        if issues == [commit_evidence_gate.MISSING_ENTRY_HEADER_ISSUE]:
            return [f"{path}: {issues[0]}"]
        label = selected_work_item_id or TARGET_WORK_ITEM_ID or "unknown-work-item"
        return [f"{path} [{label}]: {issue}" for issue in issues]
    return []


all_issues = []
for arg in sorted(sys.argv[1:]):
    all_issues.extend(validate(Path(arg)))

if all_issues:
    print("\n".join(sorted(set(all_issues))))
    raise SystemExit(1)
PY
  )"; then
    echo "Commit evidence gate failed:" >&2
    echo "$validation_output" >&2
    echo "$commit_evidence_remediation" >&2
    return 1
  fi

  return 0
}

auto_restage_linted() {
  staged_paths=()
  unstaged_paths=()
  untracked_paths=()
  disallowed_untracked=()

  if command -v mapfile >/dev/null 2>&1; then
    mapfile -t staged_paths < <(git diff --cached --name-only)
    mapfile -t unstaged_paths < <(git diff --name-only)
    mapfile -t untracked_paths < <(git ls-files --others --exclude-standard)
  else
    while IFS= read -r line; do
      staged_paths+=("$line")
    done < <(git diff --cached --name-only)
    while IFS= read -r line; do
      unstaged_paths+=("$line")
    done < <(git diff --name-only)
    while IFS= read -r line; do
      untracked_paths+=("$line")
    done < <(git ls-files --others --exclude-standard)
  fi

  if [[ ${#unstaged_paths[@]} -eq 0 ]]; then
    return 1
  fi
  if [[ ${#untracked_paths[@]} -gt 0 ]]; then
    local path
    for path in "${untracked_paths[@]}"; do
      if ! is_allowed_path "$path"; then
        disallowed_untracked+=("$path")
      fi
    done
    if [[ ${#disallowed_untracked[@]} -gt 0 ]]; then
      echo "Unexpected untracked files detected after lint:" >&2
      printf ' - %s\n' "${disallowed_untracked[@]}" >&2
      return 1
    fi
  fi

  local path
  for path in "${unstaged_paths[@]}"; do
    if is_runtime_shell_snapshot_path "$path"; then
      echo "Unexpected unstaged runtime shell snapshot path: $path" >&2
      print_snapshot_scope_remediation
      return 1
    fi
    if ! contains_path "$path"; then
      echo "Unexpected unstaged file not already staged: $path" >&2
      return 1
    fi
  done

  git add -- "${unstaged_paths[@]}"
  echo "Auto-restaged linted files:"
  printf ' - %s\n' "${unstaged_paths[@]}"
  return 0
}

if [[ "$dry_run" == true ]]; then
  echo "[dry-run] make check"
else
  if ! validate_commit_evidence_gate; then
    exit 1
  fi
  set +e
  make check
  status=$?
  set -e
  if [[ "$status" -ne 0 ]]; then
    if auto_restage_linted; then
      make lint
      make test
    else
      exit "$status"
    fi
  fi
  allowed_changed_paths=()
  if command -v mapfile >/dev/null 2>&1; then
    mapfile -t allowed_changed_paths < <(collect_allowed_changed_paths)
  else
    while IFS= read -r line; do
      allowed_changed_paths+=("$line")
    done < <(collect_allowed_changed_paths)
  fi
  if [[ ${#allowed_changed_paths[@]} -gt 0 ]]; then
    git add -- "${allowed_changed_paths[@]}"
  fi
  disallowed=()
  if command -v mapfile >/dev/null 2>&1; then
    mapfile -t disallowed < <(collect_disallowed_paths)
  else
    while IFS= read -r line; do
      disallowed+=("$line")
    done < <(collect_disallowed_paths)
  fi
  if [[ ${#disallowed[@]} -gt 0 ]]; then
    echo "Unexpected changes detected after checks:" >&2
    printf ' - %s\n' "${disallowed[@]}" >&2
    if has_runtime_shell_snapshot_paths "${disallowed[@]}"; then
      print_snapshot_scope_remediation
    fi
    echo "Use --allow <path> to permit expected files." >&2
    exit 1
  fi
  if ! validate_commit_evidence_gate; then
    exit 1
  fi
fi

allowed_types=("feat" "fix" "docs" "chore")

contains_type() {
  local candidate="$1"
  local t
  for t in "${allowed_types[@]}"; do
    if [[ "$candidate" == "$t" ]]; then
      return 0
    fi
  done
  return 1
}

if [[ -z "$message" ]]; then
  if [[ -z "$type" ]]; then
    read -r -p "Type (feat/fix/docs/chore) [feat]: " type
    type="${type:-feat}"
  fi
  if ! contains_type "$type"; then
    echo "Invalid type: $type" >&2
    exit 1
  fi
  while [[ -z "$scope" ]]; do
    read -r -p "Scope (required): " scope
  done
  while [[ -z "$summary" ]]; do
    read -r -p "Summary (required): " summary
  done
  message="${type}(${scope}): ${summary}"
fi

echo "Proposed commit message:"
echo "$message"

if [[ "$dry_run" == true ]]; then
  echo "[dry-run] git commit -m \"$message\""
  exit 0
fi

if [[ "$assume_yes" != true ]]; then
  read -r -p "Proceed with commit? [y/N] " confirm
  case "$confirm" in
    y|Y|yes|YES) ;;
    *) echo "Aborted."; exit 1 ;;
  esac
fi

git commit -m "$message"
