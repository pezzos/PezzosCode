#!/usr/bin/env bash
# Purpose: Run checks, enforce allowed paths, and guide standardized commits.
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: tools/pc-commit [options]

Options:
  --allow <path>    Allow changed path (repeatable)
  --work-item-id <id>  Validate commit evidence against this work item (WI-YYYYMMDD-NN)
  --message <msg>   Use full commit message (skip prompts)
  --type <type>     Commit type: feat|fix|docs|chore
  --scope <scope>   Commit scope (required unless --message)
  --summary <text>  Commit summary (required unless --message)
  --dry-run         Show actions without executing
  --yes             Skip confirmation prompt
  -h, --help        Show help
USAGE
}

dry_run=false
assume_yes=false
message=""
type=""
scope=""
summary=""
allow_paths=()
work_item_id=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --allow)
      allow_paths+=("$2")
      shift 2
      ;;
    --work-item-id)
      work_item_id="$2"
      shift 2
      ;;
    --message)
      message="$2"
      shift 2
      ;;
    --type)
      type="$2"
      shift 2
      ;;
    --scope)
      scope="$2"
      shift 2
      ;;
    --summary)
      summary="$2"
      shift 2
      ;;
    --dry-run)
      dry_run=true
      shift
      ;;
    --yes)
      assume_yes=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Not inside a git repository." >&2
  exit 1
fi

if [[ ${#allow_paths[@]} -eq 0 ]]; then
  staged_paths=()
  if command -v mapfile >/dev/null 2>&1; then
    mapfile -t staged_paths < <(git diff --cached --name-only)
  else
    while IFS= read -r line; do
      staged_paths+=("$line")
    done < <(git diff --cached --name-only)
  fi
  allow_paths=("${staged_paths[@]}")
fi

if [[ ${#allow_paths[@]} -eq 0 ]]; then
  echo "No staged changes detected. Stage files or use --allow." >&2
  exit 1
fi

is_allowed_path() {
  local path="$1"
  local allowed_path
  local normalized_allowed
  for allowed_path in "${allow_paths[@]}"; do
    normalized_allowed="${allowed_path%/}"
    if [[ "$path" == "$normalized_allowed" || "$path" == "$normalized_allowed/"* ]]; then
      return 0
    fi
  done
  return 1
}

collect_allowed_changed_paths() {
  local allowed_changed_local
  allowed_changed_local=()
  local line
  local path
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    path="${line:3}"
    if [[ "$path" == *" -> "* ]]; then
      path="${path##* -> }"
    fi
    if is_allowed_path "$path"; then
      allowed_changed_local+=("$path")
    fi
  done < <(git status --porcelain)

  if [[ ${#allowed_changed_local[@]} -gt 0 ]]; then
    printf '%s\n' "${allowed_changed_local[@]}"
  fi
}

collect_disallowed_paths() {
  local disallowed_local
  disallowed_local=()
  local line
  local path
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    path="${line:3}"
    if [[ "$path" == *" -> "* ]]; then
      path="${path##* -> }"
    fi
    if ! is_allowed_path "$path"; then
      disallowed_local+=("$path")
    fi
  done < <(git status --porcelain)
  if [[ ${#disallowed_local[@]} -gt 0 ]]; then
    printf '%s\n' "${disallowed_local[@]}"
  fi
}

disallowed=()
if command -v mapfile >/dev/null 2>&1; then
  mapfile -t disallowed < <(collect_disallowed_paths)
else
  while IFS= read -r line; do
    disallowed+=("$line")
  done < <(collect_disallowed_paths)
fi

if [[ ${#disallowed[@]} -gt 0 ]]; then
  echo "Unexpected changes detected:" >&2
  printf ' - %s\n' "${disallowed[@]}" >&2
  echo "Use --allow <path> to permit expected files." >&2
  exit 1
fi

contains_path() {
  local candidate="$1"
  local path
  for path in "${staged_paths[@]}"; do
    if [[ "$path" == "$candidate" ]]; then
      return 0
    fi
  done
  return 1
}

validate_commit_evidence_gate() {
  local dev_tasks_paths=()
  if command -v mapfile >/dev/null 2>&1; then
    mapfile -t dev_tasks_paths < <(
      git diff --cached --name-only -- "docs/02-features/*/dev-tasks.md"
    )
  else
    while IFS= read -r line; do
      dev_tasks_paths+=("$line")
    done < <(git diff --cached --name-only -- "docs/02-features/*/dev-tasks.md")
  fi

  [[ ${#dev_tasks_paths[@]} -eq 0 ]] && return 0

  local validation_output
  if ! validation_output="$(
    PC_COMMIT_WORK_ITEM_ID="$work_item_id" python3 - "${dev_tasks_paths[@]}" <<'PY'
import os
import re
import sys
from pathlib import Path

REQUIRED_SECTIONS = ("Test Results", "Commit", "Final Report")
REQUIRED_FINAL_REPORT_FIELDS = (
    "What changed (files)",
    "Tests written (names) + results",
    "Docs/logs updated checklist",
    "make ci results",
    "Commands run (use pp for noisy output)",
    "Commit message",
)
ENTRY_PATTERN = re.compile(r"^###\s+(WI-\d{8}-\d{2})\b.*$", re.MULTILINE)
SECTION_PATTERN = re.compile(r"^####\s+(.+?)\s*$", re.MULTILINE)
OUTCOME_PATTERN = re.compile(
    r"Outcome:\s*(PASS|FAIL|NEEDS REPLAN|SKIPPED)",
    re.IGNORECASE,
)
COMPLETED_TICKET_STATUSES = {"completed", "pass"}
WORK_ITEM_PATTERN = re.compile(r"^WI-(\d{8})-(\d{2})$")
TARGET_WORK_ITEM_ID = os.environ.get("PC_COMMIT_WORK_ITEM_ID", "").strip()


def parse_label(text: str, label: str) -> str:
    pattern = re.compile(
        rf"^(?:-\s*)?{re.escape(label)}\s*:\s*(.+)$",
        re.MULTILINE | re.IGNORECASE,
    )
    match = pattern.search(text)
    return match.group(1).strip() if match else ""


def normalize_ticket_status(value: str) -> str:
    return " ".join(str(value or "").strip().split()).lower()


def work_item_sort_key(work_item_id: str):
    match = WORK_ITEM_PATTERN.fullmatch(work_item_id or "")
    if not match:
        return ("00000000", 0)
    return (match.group(1), int(match.group(2)))


def collect_entry_blocks(content: str):
    matches = list(ENTRY_PATTERN.finditer(content))
    if not matches:
        return []
    entries = []
    for idx, marker in enumerate(matches):
        start = marker.start()
        end = matches[idx + 1].start() if idx + 1 < len(matches) else len(content)
        entries.append((marker.group(1), content[start:end]))
    return entries


def select_entry_block(content: str):
    entries = collect_entry_blocks(content)
    if not entries:
        return "", "", ""
    if TARGET_WORK_ITEM_ID:
        for candidate_id, candidate_block in entries:
            if candidate_id == TARGET_WORK_ITEM_ID:
                return candidate_id, candidate_block, ""
        return (
            TARGET_WORK_ITEM_ID,
            "",
            f"requested work-item execution entry not found: {TARGET_WORK_ITEM_ID}",
        )
    selected_id, selected_block = max(entries, key=lambda item: work_item_sort_key(item[0]))
    return selected_id, selected_block, ""


def parse_sections(block: str):
    sections = {}
    duplicates = set()
    matches = list(SECTION_PATTERN.finditer(block))
    for idx, match in enumerate(matches):
        title = match.group(1).strip()
        start = match.end()
        end = matches[idx + 1].start() if idx + 1 < len(matches) else len(block)
        body = block[start:end].strip()
        if title in sections:
            duplicates.add(title)
        else:
            sections[title] = body
    return sections, duplicates


def validate(path: Path):
    content = path.read_text(encoding="utf-8")
    work_item_id, block, selection_issue = select_entry_block(content)
    if selection_issue:
        label = work_item_id or "unknown-work-item"
        return [f"{path} [{label}]: {selection_issue}"]
    if not block:
        return [f"{path}: missing work-item execution entry header (expected `### WI-YYYYMMDD-NN`)"]
    issues = []
    sections, duplicates = parse_sections(block)
    tests_run_field = parse_label(block, "Tests run")
    if not tests_run_field:
        issues.append("missing top execution field: Tests run")
    ticket_status_field = parse_label(block, "Outcome")
    normalized_ticket_status = normalize_ticket_status(ticket_status_field)
    if not normalized_ticket_status:
        issues.append("missing top execution field: Outcome")
    elif normalized_ticket_status not in COMPLETED_TICKET_STATUSES:
        issues.append(
            "active ticket status is not completed: "
            f"Outcome={ticket_status_field or '(empty)'}"
        )

    for section in REQUIRED_SECTIONS:
        if section in duplicates:
            issues.append(f"duplicate required section heading: {section}")
        body = sections.get(section, "").strip()
        if section not in sections:
            issues.append(f"missing required section: {section}")
            continue
        if not body:
            issues.append(f"required section is empty: {section}")
            continue
        if "(pending)" in body.lower():
            issues.append(f"required section still pending: {section}")

    test_results = sections.get("Test Results", "")
    if test_results:
        if not OUTCOME_PATTERN.search(test_results):
            issues.append("Test Results is missing Outcome")

    commit_section = sections.get("Commit", "")
    if commit_section and not parse_label(commit_section, "Commit message"):
        issues.append("Commit section is missing Commit message")

    final_report = sections.get("Final Report", "")
    if final_report:
        for field in REQUIRED_FINAL_REPORT_FIELDS:
            if not parse_label(final_report, field):
                issues.append(f"Final Report is missing required field: {field}")

    if issues:
        label = work_item_id or "unknown-work-item"
        return [f"{path} [{label}]: {issue}" for issue in issues]
    return []


all_issues = []
for arg in sys.argv[1:]:
    all_issues.extend(validate(Path(arg)))

if all_issues:
    print("\n".join(all_issues))
    raise SystemExit(1)
PY
  )"; then
    echo "Commit evidence gate failed:" >&2
    echo "$validation_output" >&2
    echo 'Remediation: complete required "Test Results", "Commit", and "Final Report" evidence before commit.' >&2
    return 1
  fi

  return 0
}

auto_restage_linted() {
  staged_paths=()
  unstaged_paths=()
  untracked_paths=()
  disallowed_untracked=()

  if command -v mapfile >/dev/null 2>&1; then
    mapfile -t staged_paths < <(git diff --cached --name-only)
    mapfile -t unstaged_paths < <(git diff --name-only)
    mapfile -t untracked_paths < <(git ls-files --others --exclude-standard)
  else
    while IFS= read -r line; do
      staged_paths+=("$line")
    done < <(git diff --cached --name-only)
    while IFS= read -r line; do
      unstaged_paths+=("$line")
    done < <(git diff --name-only)
    while IFS= read -r line; do
      untracked_paths+=("$line")
    done < <(git ls-files --others --exclude-standard)
  fi

  if [[ ${#unstaged_paths[@]} -eq 0 ]]; then
    return 1
  fi
  if [[ ${#untracked_paths[@]} -gt 0 ]]; then
    local path
    for path in "${untracked_paths[@]}"; do
      if ! is_allowed_path "$path"; then
        disallowed_untracked+=("$path")
      fi
    done
    if [[ ${#disallowed_untracked[@]} -gt 0 ]]; then
      echo "Unexpected untracked files detected after lint:" >&2
      printf ' - %s\n' "${disallowed_untracked[@]}" >&2
      return 1
    fi
  fi

  local path
  for path in "${unstaged_paths[@]}"; do
    if ! contains_path "$path"; then
      echo "Unexpected unstaged file not already staged: $path" >&2
      return 1
    fi
  done

  git add -- "${unstaged_paths[@]}"
  echo "Auto-restaged linted files:"
  printf ' - %s\n' "${unstaged_paths[@]}"
  return 0
}

if [[ "$dry_run" == true ]]; then
  echo "[dry-run] make check"
else
  if ! validate_commit_evidence_gate; then
    exit 1
  fi
  set +e
  make check
  status=$?
  set -e
  if [[ "$status" -ne 0 ]]; then
    if auto_restage_linted; then
      make lint
      make test
    else
      exit "$status"
    fi
  fi
  allowed_changed_paths=()
  if command -v mapfile >/dev/null 2>&1; then
    mapfile -t allowed_changed_paths < <(collect_allowed_changed_paths)
  else
    while IFS= read -r line; do
      allowed_changed_paths+=("$line")
    done < <(collect_allowed_changed_paths)
  fi
  if [[ ${#allowed_changed_paths[@]} -gt 0 ]]; then
    git add -- "${allowed_changed_paths[@]}"
  fi
  disallowed=()
  if command -v mapfile >/dev/null 2>&1; then
    mapfile -t disallowed < <(collect_disallowed_paths)
  else
    while IFS= read -r line; do
      disallowed+=("$line")
    done < <(collect_disallowed_paths)
  fi
  if [[ ${#disallowed[@]} -gt 0 ]]; then
    echo "Unexpected changes detected after checks:" >&2
    printf ' - %s\n' "${disallowed[@]}" >&2
    echo "Use --allow <path> to permit expected files." >&2
    exit 1
  fi
  if ! validate_commit_evidence_gate; then
    exit 1
  fi
fi

allowed_types=("feat" "fix" "docs" "chore")

contains_type() {
  local candidate="$1"
  local t
  for t in "${allowed_types[@]}"; do
    if [[ "$candidate" == "$t" ]]; then
      return 0
    fi
  done
  return 1
}

if [[ -z "$message" ]]; then
  if [[ -z "$type" ]]; then
    read -r -p "Type (feat/fix/docs/chore) [feat]: " type
    type="${type:-feat}"
  fi
  if ! contains_type "$type"; then
    echo "Invalid type: $type" >&2
    exit 1
  fi
  while [[ -z "$scope" ]]; do
    read -r -p "Scope (required): " scope
  done
  while [[ -z "$summary" ]]; do
    read -r -p "Summary (required): " summary
  done
  message="${type}(${scope}): ${summary}"
fi

echo "Proposed commit message:"
echo "$message"

if [[ "$dry_run" == true ]]; then
  echo "[dry-run] git commit -m \"$message\""
  exit 0
fi

if [[ "$assume_yes" != true ]]; then
  read -r -p "Proceed with commit? [y/N] " confirm
  case "$confirm" in
    y|Y|yes|YES) ;;
    *) echo "Aborted."; exit 1 ;;
  esac
fi

git commit -m "$message"
