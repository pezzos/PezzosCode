#!/usr/bin/env python3
import difflib
import os
import shutil
import subprocess
import sys
import tempfile
from dataclasses import dataclass
from pathlib import Path
from typing import Optional


def codex_overrides() -> list[str]:
    uvx_path = shutil.which("uvx") or str(Path.home() / ".local" / "bin" / "uvx")
    serena_payload = (
        f'{{command="{uvx_path}",args=["--refresh","--from","git+https://github.com/oraios/serena",'
        '"serena","start-mcp-server","--context","codex","--project-from-cwd"],'
        "optional=true,autostart=false,startup_timeout_ms=30000,request_timeout_ms=15000}"
    )
    return [
        "-c",
        'approval_policy="never"',
        "-c",
        'sandbox_mode="workspace-write"',
        "-c",
        "network_access=false",
        "-c",
        f"mcp_servers.serena={serena_payload}",
    ]


@dataclass(frozen=True)
class Pair:
    live: Path
    template: Path


@dataclass(frozen=True)
class Mismatch:
    source: Path
    target: Path
    diff: str


def die(message: str) -> None:
    print(message, file=sys.stderr)
    sys.exit(1)


def run(
    cmd: list[str], cwd: Path, env: Optional[dict] = None
) -> subprocess.CompletedProcess:
    return subprocess.run(
        cmd,
        check=False,
        cwd=str(cwd),
        env=env,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )


def git_root() -> Path:
    result = run(["git", "rev-parse", "--show-toplevel"], Path.cwd())
    if result.returncode != 0:
        die(f"pc-template-sync: git root not found\n{result.stderr}")
    return Path(result.stdout.strip())


def codex_env(root: Path) -> dict:
    env = os.environ.copy()
    env.pop("OPENAI_API_KEY", None)
    codex_home = root / ".codex_subagent"
    codex_home.mkdir(parents=True, exist_ok=True)
    config_path = codex_home / "config.toml"
    if not config_path.exists():
        config_path.write_text(
            'approval_policy = "never"\n'
            'sandbox_mode = "workspace-write"\n'
            "network_access = false\n",
            encoding="utf-8",
        )
    auth_src = Path.home() / ".codex" / "auth.json"
    auth_dst = codex_home / "auth.json"
    if auth_src.exists() and not auth_dst.exists():
        try:
            shutil.copy2(auth_src, auth_dst)
        except Exception as exc:
            print(
                f"pc-template-sync: failed to copy auth.json: {exc}",
                file=sys.stderr,
            )
    if not auth_dst.exists():
        print(
            "pc-template-sync: warning: auth.json missing; codex exec may fail.",
            file=sys.stderr,
        )
    env["CODEX_HOME"] = str(codex_home)
    return env


def codex_profile() -> str:
    return os.environ.get("CODEX_PROFILE", "Default")


def staged_paths(root: Path) -> set[str]:
    result = run(["git", "diff", "--cached", "--name-only", "-z"], root)
    if result.returncode != 0:
        die(f"pc-template-sync: failed to list staged files\n{result.stderr}")
    entries = result.stdout.split("\0")
    return {entry for entry in entries if entry}


def untracked_paths(root: Path) -> set[str]:
    result = run(["git", "ls-files", "--others", "--exclude-standard", "-z"], root)
    if result.returncode != 0:
        die(f"pc-template-sync: failed to list untracked files\n{result.stderr}")
    entries = result.stdout.split("\0")
    return {entry for entry in entries if entry}


def build_pairs(root: Path) -> list[Pair]:
    pairs: list[Pair] = []
    docs_template_root = root / "tools" / "templates" / "docs"
    docs_live_root = root / "docs"
    docs_patterns = [
        "README.md",
        "AGENTS.md",
        "*/AGENTS.md",
        "04-process/**",
        "02-features/feature-template/*",
        "03-logs/tickets/*",
    ]
    for pattern in docs_patterns:
        for template_path in docs_template_root.glob(pattern):
            if template_path.is_dir():
                continue
            rel = template_path.relative_to(docs_template_root)
            live_path = docs_live_root / rel
            pairs.append(Pair(live=live_path, template=template_path))

    root_template_root = root / "tools" / "templates" / "root"
    root_patterns = [
        "Makefile",
        ".pre-commit-config.yaml",
        ".gitmessage",
        ".githooks/*",
    ]
    for pattern in root_patterns:
        for template_path in root_template_root.glob(pattern):
            if template_path.is_dir():
                continue
            rel = template_path.relative_to(root_template_root)
            live_path = root / rel
            pairs.append(Pair(live=live_path, template=template_path))

    unique: dict[tuple[Path, Path], Pair] = {}
    for pair in pairs:
        unique[(pair.live, pair.template)] = pair
    return list(unique.values())


def read_text(path: Path) -> list[str]:
    return path.read_text(encoding="utf-8", errors="replace").splitlines(keepends=True)


def diff_text(source: Path, target: Path) -> str:
    source_lines = read_text(source)
    target_lines = read_text(target)
    diff_lines = difflib.unified_diff(
        source_lines,
        target_lines,
        fromfile=str(source),
        tofile=str(target),
    )
    return "".join(diff_lines)


def codex_exec(prompt: str, root: Path) -> None:
    if shutil.which("codex") is None:
        die("pc-template-sync: codex CLI not found in PATH")
    env = codex_env(root)
    with tempfile.NamedTemporaryFile(delete=False) as tmp:
        output_path = tmp.name
    cmd = [
        "codex",
        "-C",
        str(root),
        "--profile",
        codex_profile(),
        *codex_overrides(),
        "exec",
        "--skip-git-repo-check",
        "--output-last-message",
        output_path,
        "--dangerously-bypass-approvals-and-sandbox",
        prompt,
    ]
    try:
        result = run(cmd, root, env=env)
        if result.returncode != 0:
            die("pc-template-sync: codex exec failed")
    finally:
        try:
            Path(output_path).unlink(missing_ok=True)
        except Exception:
            pass


def main() -> int:
    root = git_root()
    os.chdir(root)

    changed = staged_paths(root) | untracked_paths(root)
    pairs = build_pairs(root)

    mismatches: list[Mismatch] = []
    errors: list[str] = []

    for pair in pairs:
        if not pair.live.exists():
            errors.append(f"missing live file: {pair.live}")
            continue
        if not pair.template.exists():
            errors.append(f"missing template file: {pair.template}")
            continue
        if pair.live.read_text(
            encoding="utf-8", errors="replace"
        ) == pair.template.read_text(encoding="utf-8", errors="replace"):
            continue
        live_rel = str(pair.live.relative_to(root))
        template_rel = str(pair.template.relative_to(root))
        live_changed = live_rel in changed
        template_changed = template_rel in changed
        if live_changed ^ template_changed:
            source = pair.live if live_changed else pair.template
            target = pair.template if live_changed else pair.live
            diff = diff_text(source, target)
            mismatches.append(Mismatch(source=source, target=target, diff=diff))
        else:
            reason = (
                "both changed"
                if live_changed and template_changed
                else "neither changed"
            )
            errors.append(f"out-of-sync pair ({reason}): {live_rel} <-> {template_rel}")

    if errors:
        detail = "\n".join(f"- {entry}" for entry in errors)
        die(
            "pc-template-sync: template/living mismatch requires manual resolution:\n"
            + detail
        )

    if not mismatches:
        return 0

    diff_payload = []
    for mismatch in mismatches:
        diff_payload.append(
            f"Source (changed): {mismatch.source}\nTarget (update to match): {mismatch.target}\n"
            f"{mismatch.diff}"
        )
    prompt = (
        "Sync template and living files based on the changed source files. "
        "For each pair, update the target to match the source if the changes are related. "
        "If any change looks unrelated, do not alter files. "
        "Diffs follow:\n\n" + "\n".join(diff_payload)
    )
    codex_exec(prompt, root)

    # Re-check after codex run.
    remaining: list[str] = []
    for mismatch in mismatches:
        if mismatch.source.read_text(
            encoding="utf-8", errors="replace"
        ) != mismatch.target.read_text(encoding="utf-8", errors="replace"):
            remaining.append(f"{mismatch.source} <-> {mismatch.target}")
    if remaining:
        detail = "\n".join(f"- {entry}" for entry in remaining)
        die(
            "pc-template-sync: out-of-sync files remain after codex autofix:\n" + detail
        )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
