#!/usr/bin/env python3
import argparse
import os
import shutil
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path


@dataclass(frozen=True)
class Pair:
    live: Path
    template: Path


@dataclass(frozen=True)
class Mismatch:
    source: Path
    target: Path
    reason: str


def die(message: str) -> None:
    print(message, file=sys.stderr)
    sys.exit(1)


def run(cmd: list[str], cwd: Path) -> subprocess.CompletedProcess:
    return subprocess.run(
        cmd,
        check=False,
        cwd=str(cwd),
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )


def git_root() -> Path:
    result = run(["git", "rev-parse", "--show-toplevel"], Path.cwd())
    if result.returncode != 0:
        die(f"pc-template-sync: git root not found\n{result.stderr}")
    return Path(result.stdout.strip())


def staged_paths(root: Path) -> set[str]:
    result = run(["git", "diff", "--cached", "--name-only", "-z"], root)
    if result.returncode != 0:
        die(f"pc-template-sync: failed to list staged files\n{result.stderr}")
    entries = result.stdout.split("\0")
    return {entry for entry in entries if entry}


def untracked_paths(root: Path) -> set[str]:
    result = run(["git", "ls-files", "--others", "--exclude-standard", "-z"], root)
    if result.returncode != 0:
        die(f"pc-template-sync: failed to list untracked files\n{result.stderr}")
    entries = result.stdout.split("\0")
    return {entry for entry in entries if entry}


def build_pairs(root: Path) -> list[Pair]:
    pairs: list[Pair] = []
    docs_template_root = root / "tools" / "templates" / "docs"
    docs_live_root = root / "docs"
    docs_patterns = [
        "README.md",
        "AGENTS.md",
        "*/AGENTS.md",
        "04-process/**",
        "02-features/feature-template/*",
        "03-logs/tickets/*",
    ]
    for pattern in docs_patterns:
        for template_path in docs_template_root.glob(pattern):
            if template_path.is_dir():
                continue
            rel = template_path.relative_to(docs_template_root)
            live_path = docs_live_root / rel
            pairs.append(Pair(live=live_path, template=template_path))

    root_template_root = root / "tools" / "templates" / "root"
    root_patterns = [
        "Makefile",
        ".pre-commit-config.yaml",
        ".gitmessage",
        ".githooks/*",
    ]
    for pattern in root_patterns:
        for template_path in root_template_root.glob(pattern):
            if template_path.is_dir():
                continue
            rel = template_path.relative_to(root_template_root)
            live_path = root / rel
            pairs.append(Pair(live=live_path, template=template_path))

    unique: dict[tuple[Path, Path], Pair] = {}
    for pair in pairs:
        unique[(pair.live, pair.template)] = pair
    return list(unique.values())


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Check or apply template/living file synchronization."
    )
    parser.add_argument(
        "--apply",
        action="store_true",
        help="Apply deterministic one-sided sync changes.",
    )
    parser.add_argument(
        "--stage",
        action="store_true",
        help="Stage synced target files after applying changes.",
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    root = git_root()
    os.chdir(root)

    changed = staged_paths(root) | untracked_paths(root)
    pairs = build_pairs(root)

    mismatches: list[Mismatch] = []
    codex_conflicts: list[str] = []
    errors: list[str] = []

    for pair in pairs:
        if not pair.live.exists():
            errors.append(f"missing live file: {pair.live}")
            continue
        if not pair.template.exists():
            errors.append(f"missing template file: {pair.template}")
            continue
        if pair.live.read_text(
            encoding="utf-8", errors="replace"
        ) == pair.template.read_text(encoding="utf-8", errors="replace"):
            continue
        live_rel = str(pair.live.relative_to(root))
        template_rel = str(pair.template.relative_to(root))
        live_changed = live_rel in changed
        template_changed = template_rel in changed
        if live_changed ^ template_changed:
            source = pair.live if live_changed else pair.template
            target = pair.template if live_changed else pair.live
            mismatches.append(
                Mismatch(
                    source=source,
                    target=target,
                    reason="changed side copied to unchanged side",
                )
            )
        else:
            if live_changed and template_changed:
                codex_conflicts.append(f"{live_rel} <-> {template_rel}")
                continue
            if args.apply:
                mismatches.append(
                    Mismatch(
                        source=pair.live,
                        target=pair.template,
                        reason="neither side changed; copied live to template",
                    )
                )
            else:
                errors.append(
                    f"out-of-sync pair (neither changed): {live_rel} <-> {template_rel}"
                )

    if errors:
        detail = "\n".join(f"- {entry}" for entry in errors)
        die(
            "pc-template-sync: template/living mismatch requires manual resolution:\n"
            + detail
        )

    if not mismatches:
        if not codex_conflicts:
            return 0
        detail = "\n".join(f"- {entry}" for entry in codex_conflicts)
        die(
            "pc-template-sync: out-of-sync pair(s) with both sides changed require "
            "Codex-assisted merge before copy-sync:\n" + detail + "\nResolution:\n"
            "- Merge intent into one side.\n"
            "- Copy the merged file content to its paired file."
        )

    if not args.apply:
        detail = "\n".join(
            f"- {m.source.relative_to(root)} -> {m.target.relative_to(root)}"
            for m in mismatches
        )
        die(
            "pc-template-sync: out-of-sync files detected. "
            "Run 'tools/pc-template-sync --apply' to sync deterministic pairs:\n"
            + detail
        )

    for mismatch in mismatches:
        mismatch.target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(mismatch.source, mismatch.target)
        if args.stage:
            target_rel = str(mismatch.target.relative_to(root))
            add_result = run(["git", "add", "--", target_rel], root)
            if add_result.returncode != 0:
                die(
                    "pc-template-sync: failed to stage synced file "
                    f"{target_rel}\n{add_result.stderr}"
                )
        print(
            "pc-template-sync: synced "
            f"{mismatch.target.relative_to(root)} from {mismatch.source.relative_to(root)} "
            f"({mismatch.reason})"
        )

    if codex_conflicts:
        detail = "\n".join(f"- {entry}" for entry in codex_conflicts)
        die(
            "pc-template-sync: out-of-sync pair(s) with both sides changed require "
            "Codex-assisted merge before copy-sync:\n" + detail + "\nResolution:\n"
            "- Merge intent into one side.\n"
            "- Copy the merged file content to its paired file."
        )

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
