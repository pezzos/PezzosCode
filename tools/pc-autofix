#!/usr/bin/env python3
import argparse
import json
import os
import shutil
import subprocess
import sys
import tempfile
from datetime import datetime
from pathlib import Path
from typing import Optional

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from lib import codex_exec as codex_cli, pc_runner  # noqa: E402

FORBIDDEN_PREFIXES = (
    "docs/03-logs/",
    "docs/02-features/",
)
AUTH_REFRESH_ERROR_TOKENS = (
    "refresh token",
    "refresh_token_reused",
    "access token could not be refreshed",
)


def die(message: str) -> None:
    print(message, file=sys.stderr)
    sys.exit(1)


def parse_last_refresh(path: Path) -> Optional[datetime]:
    return codex_cli.parse_last_refresh(path)


def source_auth_is_newer(auth_src: Path, auth_dst: Path) -> bool:
    return codex_cli.source_auth_is_newer(auth_src, auth_dst)


def sync_auth_file(auth_src: Path, auth_dst: Path, *, force: bool = False) -> bool:
    try:
        return codex_cli.sync_auth_file(
            auth_src,
            auth_dst,
            force=force,
            error_prefix="pc-autofix",
        )
    except codex_cli.CodexEnvError as exc:
        die(str(exc))


def is_auth_refresh_error(output: str) -> bool:
    lowered = output.lower()
    return any(token in lowered for token in AUTH_REFRESH_ERROR_TOKENS)


def read_text(path: str) -> str:
    with open(path, "r", encoding="utf-8") as handle:
        return handle.read()


def git_root() -> Path:
    result = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if result.returncode != 0:
        die(f"pc-autofix: git root not found\n{result.stderr}")
    return Path(result.stdout.strip())


def codex_env(root: Path) -> tuple[dict, Path, Path]:
    try:
        prepared = codex_cli.prepare_codex_env(
            root,
            ".codex_precommit",
            error_prefix="pc-autofix",
        )
    except codex_cli.CodexEnvError as exc:
        die(str(exc))
    return prepared.env, prepared.auth_src, prepared.auth_dst


def codex_profile() -> str:
    return os.environ.get("CODEX_PROFILE", "").strip()


def codex_exec(prompt: str) -> None:
    if shutil.which("codex") is None:
        die("pc-autofix: codex CLI not found in PATH")
    root = git_root()
    env, auth_src, auth_dst = codex_env(root)
    with tempfile.NamedTemporaryFile(delete=False) as tmp:
        output_path = tmp.name
    cmd = [
        "codex",
        "-C",
        str(root),
    ]
    profile = codex_profile()
    if profile:
        cmd.extend(["--profile", profile])
    cmd.extend(
        [
            "exec",
            "--skip-git-repo-check",
            "--output-last-message",
            output_path,
            prompt,
        ]
    )
    try:
        result = subprocess.run(
            cmd,
            check=False,
            cwd=str(root),
            env=env,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        combined = (result.stdout or "") + (result.stderr or "")
        if result.returncode != 0 and is_auth_refresh_error(combined):
            if sync_auth_file(auth_src, auth_dst, force=True):
                print(
                    "pc-autofix: retrying codex exec after auth sync.",
                    file=sys.stderr,
                )
                result = subprocess.run(
                    cmd,
                    check=False,
                    cwd=str(root),
                    env=env,
                    text=True,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                )
                combined = (result.stdout or "") + (result.stderr or "")
        if result.returncode != 0:
            if is_auth_refresh_error(combined):
                die(
                    "pc-autofix: codex auth refresh failed after retry. "
                    "Run `codex logout`, `codex login`, then remove "
                    f"`{auth_dst}` before retrying.\n{combined}"
                )
            if combined.strip():
                die(f"pc-autofix: codex exec failed\n{combined}")
            die("pc-autofix: codex exec failed")
    finally:
        try:
            Path(output_path).unlink(missing_ok=True)
        except Exception:
            pass


def build_prompt(mode: str, issues: str, allowed_paths: list[str]) -> str:
    issues = issues.strip()
    if not issues:
        issues = "(no output captured)"
    if mode == "stash-conflict":
        return (
            "Resolve the git stash pop conflicts. Fix conflict markers and leave the "
            "working tree clean. Here are the conflicts:\n" + issues
        )
    scoped_paths = "\n".join(f"- {path}" for path in sorted(set(allowed_paths)))
    if not scoped_paths:
        scoped_paths = "- (none provided)"
    return (
        "Fix only unresolved pre-commit failures. Keep edits minimal and scoped.\n"
        "Allowed files (edit only these paths):\n"
        f"{scoped_paths}\n"
        "Forbidden edits:\n"
        "- docs/03-logs/*\n"
        "- docs/02-features/*/dev-tasks.md\n"
        "- docs/02-features/*/planner-log.md\n"
        "- docs/02-features/*/validation-log.md\n"
        "- docs/02-features/*/reporter-log.md\n"
        "Do not add features, refactors, or unrelated cleanups.\n"
        "Issues:\n" + issues
    )


def collect_changed_paths(root: Path) -> set[str]:
    result = subprocess.run(
        ["git", "status", "--porcelain"],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        cwd=root,
    )
    if result.returncode != 0:
        die(f"pc-autofix: failed to inspect changed paths\n{result.stderr}")
    changed: set[str] = set()
    for raw in result.stdout.splitlines():
        line = raw.rstrip()
        if not line:
            continue
        path = line[3:]
        if " -> " in path:
            path = path.split(" -> ", 1)[1]
        changed.add(path.strip())
    return changed


def compute_scope_violations(
    changed_paths: set[str], allowed_paths: set[str]
) -> list[str]:
    violations: list[str] = []
    for path in sorted(changed_paths):
        if path in allowed_paths:
            continue
        if path.startswith(FORBIDDEN_PREFIXES):
            violations.append(path)
            continue
        violations.append(path)
    return violations


def validate_scope(mode: str, allowed_paths: list[str], root: Path) -> None:
    if mode != "pre-commit":
        return
    allowed_set = {path for path in allowed_paths if path}
    if not allowed_set:
        die("pc-autofix: no allowed scope passed for pre-commit mode")
    changed_paths = collect_changed_paths(root)
    violations = compute_scope_violations(changed_paths, allowed_set)
    if violations:
        die(
            "pc-autofix: out-of-scope changes detected after autofix:\n- "
            + "\n- ".join(violations)
        )


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Run codex to fix pre-commit issues.")
    parser.add_argument("--issues-file", required=True, help="Path to issue output.")
    parser.add_argument(
        "--mode",
        choices=("pre-commit", "stash-conflict"),
        default="pre-commit",
    )
    parser.add_argument(
        "--allowed-path",
        action="append",
        default=[],
        help="Relative path that autofix is allowed to edit (repeatable).",
    )
    parser.add_argument(
        "--work-item-id",
        default=os.environ.get("PC_WORK_ITEM_ID"),
        help="Work item id (WI-YYYYMMDD-XX).",
    )
    parser.add_argument(
        "--agent-name",
        default=os.environ.get("PC_AGENT_NAME", "pc-autofix"),
        help="Agent name for logging.",
    )
    parser.add_argument(
        "--run-id",
        default=os.environ.get("PC_RUN_ID"),
        help="Optional run id for logging.",
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    metadata = None
    if args.work_item_id:
        try:
            metadata = pc_runner.build_metadata(
                args.work_item_id, args.agent_name, args.run_id
            )
        except ValueError as exc:
            die(str(exc))
    else:
        print(
            "pc-autofix: warning: work item id missing; structured logging disabled.",
            file=sys.stderr,
        )
    root = git_root()
    if metadata:
        pc_runner.log_message(metadata, "autofix", f"start mode={args.mode}", root=root)
    issues = read_text(args.issues_file)
    prompt = build_prompt(args.mode, issues, args.allowed_path)
    codex_exec(prompt)
    validate_scope(args.mode, args.allowed_path, root)
    if metadata:
        pc_runner.log_message(metadata, "autofix", "complete", root=root)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
