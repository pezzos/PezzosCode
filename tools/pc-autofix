#!/usr/bin/env python3
import argparse
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Optional

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from lib import pc_runner  # noqa: E402

FORBIDDEN_PREFIXES = (
    "docs/03-logs/",
    "docs/02-features/",
)


def die(message: str) -> None:
    print(message, file=sys.stderr)
    sys.exit(1)


def run(
    cmd: list[str], *, cwd: Optional[Path] = None, env: Optional[dict] = None
) -> None:
    try:
        subprocess.run(cmd, check=True, cwd=str(cwd) if cwd else None, env=env)
    except subprocess.CalledProcessError:
        die("pc-autofix: codex exec failed")


def read_text(path: str) -> str:
    with open(path, "r", encoding="utf-8") as handle:
        return handle.read()


def git_root() -> Path:
    result = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if result.returncode != 0:
        die(f"pc-autofix: git root not found\n{result.stderr}")
    return Path(result.stdout.strip())


def codex_env(root: Path) -> dict:
    env = os.environ.copy()
    env.pop("OPENAI_API_KEY", None)
    codex_home = root / ".codex_precommit"
    codex_home.mkdir(parents=True, exist_ok=True)
    config_path = codex_home / "config.toml"
    config_path.write_text(
        'approval_policy = "never"\n'
        'sandbox_mode = "workspace-write"\n'
        "network_access = false\n",
        encoding="utf-8",
    )
    auth_src = Path.home() / ".codex" / "auth.json"
    auth_dst = codex_home / "auth.json"
    if auth_src.exists() and not auth_dst.exists():
        try:
            shutil.copy2(auth_src, auth_dst)
        except Exception as exc:
            print(f"pc-autofix: failed to copy auth.json: {exc}", file=sys.stderr)
    if not auth_dst.exists():
        print(
            "pc-autofix: warning: auth.json missing; codex exec may fail.",
            file=sys.stderr,
        )
    env["CODEX_HOME"] = str(codex_home)
    return env


def codex_profile() -> str:
    return os.environ.get("CODEX_PROFILE", "").strip()


def codex_exec(prompt: str) -> None:
    if shutil.which("codex") is None:
        die("pc-autofix: codex CLI not found in PATH")
    root = git_root()
    env = codex_env(root)
    with tempfile.NamedTemporaryFile(delete=False) as tmp:
        output_path = tmp.name
    cmd = [
        "codex",
        "-C",
        str(root),
    ]
    profile = codex_profile()
    if profile:
        cmd.extend(["--profile", profile])
    cmd.extend(
        [
            "exec",
            "--skip-git-repo-check",
            "--output-last-message",
            output_path,
            prompt,
        ]
    )
    try:
        run(cmd, cwd=root, env=env)
    finally:
        try:
            Path(output_path).unlink(missing_ok=True)
        except Exception:
            pass


def build_prompt(mode: str, issues: str, allowed_paths: list[str]) -> str:
    issues = issues.strip()
    if not issues:
        issues = "(no output captured)"
    if mode == "stash-conflict":
        return (
            "Resolve the git stash pop conflicts. Fix conflict markers and leave the "
            "working tree clean. Here are the conflicts:\n" + issues
        )
    scoped_paths = "\n".join(f"- {path}" for path in sorted(set(allowed_paths)))
    if not scoped_paths:
        scoped_paths = "- (none provided)"
    return (
        "Fix only unresolved pre-commit failures. Keep edits minimal and scoped.\n"
        "Allowed files (edit only these paths):\n"
        f"{scoped_paths}\n"
        "Forbidden edits:\n"
        "- docs/03-logs/*\n"
        "- docs/02-features/*/dev-tasks.md\n"
        "- docs/02-features/*/planner-log.md\n"
        "- docs/02-features/*/validation-log.md\n"
        "- docs/02-features/*/reporter-log.md\n"
        "Do not add features, refactors, or unrelated cleanups.\n"
        "Issues:\n" + issues
    )


def collect_changed_paths(root: Path) -> set[str]:
    result = subprocess.run(
        ["git", "status", "--porcelain"],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        cwd=root,
    )
    if result.returncode != 0:
        die(f"pc-autofix: failed to inspect changed paths\n{result.stderr}")
    changed: set[str] = set()
    for raw in result.stdout.splitlines():
        line = raw.rstrip()
        if not line:
            continue
        path = line[3:]
        if " -> " in path:
            path = path.split(" -> ", 1)[1]
        changed.add(path.strip())
    return changed


def compute_scope_violations(
    changed_paths: set[str], allowed_paths: set[str]
) -> list[str]:
    violations: list[str] = []
    for path in sorted(changed_paths):
        if path in allowed_paths:
            continue
        if path.startswith(FORBIDDEN_PREFIXES):
            violations.append(path)
            continue
        violations.append(path)
    return violations


def validate_scope(mode: str, allowed_paths: list[str], root: Path) -> None:
    if mode != "pre-commit":
        return
    allowed_set = {path for path in allowed_paths if path}
    if not allowed_set:
        die("pc-autofix: no allowed scope passed for pre-commit mode")
    changed_paths = collect_changed_paths(root)
    violations = compute_scope_violations(changed_paths, allowed_set)
    if violations:
        die(
            "pc-autofix: out-of-scope changes detected after autofix:\n- "
            + "\n- ".join(violations)
        )


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Run codex to fix pre-commit issues.")
    parser.add_argument("--issues-file", required=True, help="Path to issue output.")
    parser.add_argument(
        "--mode",
        choices=("pre-commit", "stash-conflict"),
        default="pre-commit",
    )
    parser.add_argument(
        "--allowed-path",
        action="append",
        default=[],
        help="Relative path that autofix is allowed to edit (repeatable).",
    )
    parser.add_argument(
        "--work-item-id",
        default=os.environ.get("PC_WORK_ITEM_ID"),
        help="Work item id (WI-YYYYMMDD-XX).",
    )
    parser.add_argument(
        "--agent-name",
        default=os.environ.get("PC_AGENT_NAME", "pc-autofix"),
        help="Agent name for logging.",
    )
    parser.add_argument(
        "--run-id",
        default=os.environ.get("PC_RUN_ID"),
        help="Optional run id for logging.",
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    metadata = None
    if args.work_item_id:
        try:
            metadata = pc_runner.build_metadata(
                args.work_item_id, args.agent_name, args.run_id
            )
        except ValueError as exc:
            die(str(exc))
    else:
        print(
            "pc-autofix: warning: work item id missing; structured logging disabled.",
            file=sys.stderr,
        )
    root = git_root()
    if metadata:
        pc_runner.log_message(metadata, "autofix", f"start mode={args.mode}", root=root)
    issues = read_text(args.issues_file)
    prompt = build_prompt(args.mode, issues, args.allowed_path)
    codex_exec(prompt)
    validate_scope(args.mode, args.allowed_path, root)
    if metadata:
        pc_runner.log_message(metadata, "autofix", "complete", root=root)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
