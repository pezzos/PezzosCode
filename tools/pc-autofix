#!/usr/bin/env python3
import argparse
import shutil
import subprocess
import sys
import tempfile


def die(message: str) -> None:
    print(message, file=sys.stderr)
    sys.exit(1)


def run(cmd: list[str]) -> None:
    try:
        subprocess.run(cmd, check=True)
    except subprocess.CalledProcessError:
        die("pc-autofix: codex exec failed")


def read_text(path: str) -> str:
    with open(path, "r", encoding="utf-8") as handle:
        return handle.read()


def codex_exec(prompt: str) -> None:
    if shutil.which("codex") is None:
        die("pc-autofix: codex CLI not found in PATH")
    with tempfile.NamedTemporaryFile(delete=False) as tmp:
        output_path = tmp.name
    cmd = [
        "codex",
        "exec",
        "--skip-git-repo-check",
        "--output-last-message",
        output_path,
        "--dangerously-bypass-approvals-and-sandbox",
        prompt,
    ]
    try:
        run(cmd)
    finally:
        try:
            subprocess.run(["rm", "-f", output_path], check=False)
        except Exception:
            pass


def build_prompt(mode: str, issues: str) -> str:
    issues = issues.strip()
    if not issues:
        issues = "(no output captured)"
    if mode == "stash-conflict":
        return (
            "Resolve the git stash pop conflicts. Fix conflict markers and leave the "
            "working tree clean. Here are the conflicts:\n" + issues
        )
    return (
        "Fix the code issues raised by the pre-commit hooks. Here are the issues:\n"
        + issues
    )


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Run codex to fix pre-commit issues.")
    parser.add_argument("--issues-file", required=True, help="Path to issue output.")
    parser.add_argument(
        "--mode",
        choices=("pre-commit", "stash-conflict"),
        default="pre-commit",
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    issues = read_text(args.issues_file)
    prompt = build_prompt(args.mode, issues)
    codex_exec(prompt)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
