def parse_labeled_line(text: str, label: str) -> str:
    prefix = f"{label}:"
    target = prefix.lower()
    for raw_line in text.splitlines():
        line = raw_line.strip()
        if not line.lower().startswith(target):
            continue
        return line.split(":", 1)[1].strip()
    return ""


