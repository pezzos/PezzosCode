def required_compacted_output_paths(content: str, work_item_id: str) -> List[str]:
    raw_text = entry_block_text(content, work_item_id)
    entry_text = raw_text.lower()
    required: Set[str] = set()
    for path in compacted_log_output_paths().values():
        normalized = normalize_repo_rel(path)
        basename = os.path.basename(normalized)
        if normalized.lower() in entry_text or basename.lower() in entry_text:
            required.add(normalized)
    for match in re.findall(r"docs/03-logs/compacted/[^\s,`]+", raw_text):
        normalized = normalize_repo_rel(match)
        basename = os.path.basename(normalized).lower()
        if (
            "decision-log-compact" in basename
            or "implementation-log-compact" in basename
            or "validation-log-compact" in basename
        ):
            required.add(normalized)
    if "docs/03-logs/compacted/*" in entry_text:
        required.update(
            normalize_repo_rel(path) for path in compacted_log_output_paths().values()
        )
    return sorted(required)


def missing_compacted_output_paths(
    worktree_path: str, required_paths: List[str]
) -> List[str]:
    missing: List[str] = []
    for path in required_paths:
        absolute = os.path.join(worktree_path, normalize_repo_rel(path))
        if not os.path.exists(absolute):
            missing.append(normalize_repo_rel(path))
    return sorted(set(missing))


def reporter_traceability_issues(
