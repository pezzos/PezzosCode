            must_exist=True,
        )
    )

    review_items: List[str] = []

    content = read_file(dev_tasks_path)
    preflight_complete = entry_section_complete(
        content, work_item_id, "Preflight Report"
    )
    if not preflight_complete:
        actual_changed_paths: List[str] = []
        if os.path.exists(patcher_path) and os.path.exists(
            os.path.join(patcher_path, ".git")
        ):
            actual_changed_paths = filter_ignored_paths(get_status_paths(patcher_path))
        preflight_prompt = (
            "You are preparing preflight data for a work item execution.\n"
