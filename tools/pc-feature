def generate_tickets(feature_dir: str, feature_id: str) -> List[str]:
    dev_tasks_path = os.path.join(feature_dir, "dev-tasks.md")
    if not os.path.exists(dev_tasks_path):
        die(f"pc-feature: missing dev-tasks.md at {dev_tasks_path}")
    feature_name = parse_feature_name(dev_tasks_path)
    tasks = parse_tasks(dev_tasks_path)
    if not tasks:
        die(f"pc-feature: no tasks found in {dev_tasks_path}")
    prd_priority, prd_section = parse_prd_feature(
        "docs/01-product/prd.md", feature_name
    )
    created = []
    for task in tasks:
        ticket_path = os.path.join(feature_dir, f"TASK-{task.task_id}.md")
        if os.path.exists(ticket_path):
            continue
        ticket_content = build_ticket(
            task=task,
            feature_id=feature_id,
            feature_name=feature_name,
            feature_dir=feature_dir,
            prd_priority=prd_priority,
            prd_section=prd_section,
        )
        write_file(ticket_path, ticket_content)
        created.append(ticket_path)
    return created


def list_ticket_ids(feature_dir: str) -> List[str]:
    ticket_ids = []
    for name in os.listdir(feature_dir):
        match = re.match(r"^TASK-(\d+)\.md$", name)
        if match:
            ticket_ids.append(match.group(1))
    return sorted(ticket_ids, key=lambda value: int(value))


def run_ticket_loop(feature_id: str, ticket_ids: List[str], manual: bool) -> None:
    if not ticket_ids:
        die("pc-feature: no tickets found to execute")
    for ticket_id in ticket_ids:
        cmd = ["make", "ticket", f"T={ticket_id}", f"F={feature_id}"]
        if manual:
            cmd.append("MANUAL=1")
        result = subprocess.run(cmd, check=False)
        if result.returncode != 0:
            sys.exit(result.returncode)


def main() -> None:
    feature_id, manual = parse_args(sys.argv[1:])
    feature_root = os.path.join("docs", "02-features")
    feature_dir = resolve_feature_dir(feature_root, feature_id)
    created = generate_tickets(feature_dir, feature_id)
    if created:
        print("pc-feature: created tickets:")
        for path in created:
            print(f"- {path}")
    ticket_ids = list_ticket_ids(feature_dir)
    run_ticket_loop(feature_id, ticket_ids, manual)


if __name__ == "__main__":
    main()
