def reconcile_runtime_execution_record(
    content: str,
    work_item_id: str,
    *,
    patch_completed: bool,
    tester_feedback: str,
    reporter_feedback: str,
    reporter_outcome: str,
) -> Tuple[str, List[str]]:
    updated = content
    repaired: List[str] = []

    if patch_completed:
        if resume_section_is_pending(updated, work_item_id, "Patch"):
            updated = replace_entry_section(
                updated,
                work_item_id,
                "Patch",
                build_runtime_patch_reconciliation_body(),
            )
            repaired.append("Patch")
        updated, field_changed = ensure_entry_field_if_missing(
            updated, work_item_id, "Patcher", "Codex"
        )
        if field_changed:
            repaired.append("field:Patcher")

    if tester_feedback.strip():
        if resume_section_is_pending(updated, work_item_id, "Test Results"):
            updated = replace_entry_section(
                updated,
                work_item_id,
                "Test Results",
                build_runtime_test_results_body(tester_feedback),
            )
            repaired.append("Test Results")
        updated, field_changed = ensure_entry_field_if_missing(
            updated, work_item_id, "Tester", "Codex"
        )
        if field_changed:
            repaired.append("field:Tester")
        tests_run = parse_labeled_line(tester_feedback, "Tests run")
        updated, field_changed = ensure_entry_field_if_missing(
            updated, work_item_id, "Tests run", tests_run
        )
        if field_changed:
            repaired.append("field:Tests run")

    if reporter_feedback.strip():
        updated, field_changed = ensure_entry_field_if_missing(
            updated, work_item_id, "Reporter", "Codex"
        )
        if field_changed:
            repaired.append("field:Reporter")
        docs_updated = parse_labeled_line(reporter_feedback, "Docs/logs updated")
        updated, field_changed = ensure_entry_field_if_missing(
            updated, work_item_id, "Docs/logs updated", docs_updated
        )
        if field_changed:
            repaired.append("field:Docs/logs updated")
        if reporter_outcome != "SKIPPED" and resume_section_is_pending(
            updated, work_item_id, "Reporter Review"
        ):
            updated = replace_entry_section(
                updated,
                work_item_id,
                "Reporter Review",
                build_runtime_reporter_review_body(reporter_feedback),
            )
            repaired.append("Reporter Review")

    return updated, repaired


def execution_handoff_completeness_issues(
