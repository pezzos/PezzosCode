def read_role_log_artifact(
    log_path: Optional[str], work_item_id: str
) -> Dict[str, Any]:
    artifact: Dict[str, Any] = {
        "exists": False,
        "entry": "",
        "outcome": None,
        "tests_run": "",
        "docs_updated": "",
        "notes": "",
    }
    if not log_path or not os.path.exists(log_path):
        return artifact
    try:
        log_content = read_file(log_path)
    except OSError:
        return artifact
    entry = latest_role_log_entry(log_content, work_item_id)
    if not entry:
        return artifact
    artifact["exists"] = True
    artifact["entry"] = entry
    artifact["outcome"] = parse_section_outcome(entry)
    artifact["tests_run"] = parse_labeled_line(entry, "Tests run")
    artifact["docs_updated"] = parse_labeled_line(entry, "Docs/logs updated")
    artifact["notes"] = parse_labeled_line(entry, "Notes")
    return artifact


