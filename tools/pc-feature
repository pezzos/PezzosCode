def reconcile_resume_pending_sections(
    content: str,
    work_item_id: str,
    *,
    tester_log_path: Optional[str] = None,
    reporter_log_path: Optional[str] = None,
) -> Tuple[str, List[str]]:
    tester_artifact = read_role_log_artifact(tester_log_path, work_item_id)
    reporter_artifact = read_role_log_artifact(reporter_log_path, work_item_id)
    repaired_sections: List[str] = []
    updated = content

    if resume_section_is_pending(updated, work_item_id, "Patch") and (
        tester_artifact.get("exists") or reporter_artifact.get("exists")
    ):
        updated = replace_entry_section(
            updated,
            work_item_id,
            "Patch",
            build_resume_patch_repair_body(tester_artifact, reporter_artifact),
        )
        repaired_sections.append("Patch")

    if resume_section_is_pending(
        updated, work_item_id, "Test Results"
    ) and tester_artifact.get("exists"):
        updated = replace_entry_section(
            updated,
            work_item_id,
            "Test Results",
            build_resume_test_results_repair_body(tester_artifact),
        )
        repaired_sections.append("Test Results")

    reporter_requires_review = bool(reporter_artifact.get("exists")) and (
        reporter_artifact.get("outcome") != "SKIPPED"
    )
    if resume_section_is_pending(updated, work_item_id, "Reporter Review") and (
        reporter_requires_review
    ):
        updated = replace_entry_section(
            updated,
            work_item_id,
            "Reporter Review",
            build_resume_reporter_review_repair_body(reporter_artifact),
        )
        repaired_sections.append("Reporter Review")

    if repaired_sections:
        updated = append_iteration_log_note(
            updated,
            work_item_id,
            "Startup auto-repair aligned pending sections from role artifacts: "
            + ", ".join(repaired_sections)
            + ".",
        )
    return updated, repaired_sections


def detect_resume_route(
    content: str,
    work_item_id: str,
    *,
    planner_log_path: Optional[str] = None,
    reviewer_log_path: Optional[str] = None,
    tester_log_path: Optional[str] = None,
    reporter_log_path: Optional[str] = None,
) -> Tuple[str, Optional[str]]:
    def role_log_has_work_item(log_path: Optional[str]) -> bool:
        if not log_path or not os.path.exists(log_path):
            return False
        try:
            log_content = read_file(log_path)
        except OSError:
            return False
        return f"### {work_item_id} " in log_content

    def is_complete(section: str) -> bool:
        body = get_entry_section(content, work_item_id, section)
        if not body or "(pending)" in body:
            return False
        return True

    plan_complete = is_complete("Plan")
    patch_complete = is_complete("Patch")
    test_results_complete = is_complete("Test Results")
    reporter_review_complete = is_complete("Reporter Review")
    tester_feedback = get_entry_section(content, work_item_id, "Tester Feedback")
    reporter_feedback = get_entry_section(content, work_item_id, "Reporter Feedback")
    tester_artifact = read_role_log_artifact(tester_log_path, work_item_id)
    reporter_artifact = read_role_log_artifact(reporter_log_path, work_item_id)
    tester_outcome = parse_section_outcome(tester_feedback) or tester_artifact.get(
        "outcome"
    )
    reporter_outcome = parse_section_outcome(
        reporter_feedback
    ) or reporter_artifact.get("outcome")
    tester_log_has_artifact = bool(tester_artifact.get("exists"))
    reporter_log_has_artifact = bool(reporter_artifact.get("exists"))
    reporter_requires_review = reporter_log_has_artifact and (
        reporter_outcome != "SKIPPED"
    )
    planner_log_has_artifact = role_log_has_work_item(planner_log_path)
    reviewer_log_has_artifact = role_log_has_work_item(reviewer_log_path)

    contradictions: List[str] = []
    if planner_log_has_artifact and not plan_complete:
        contradictions.append("planner artifact exists while plan section is pending")
    if reviewer_log_has_artifact and not plan_complete:
        contradictions.append(
            "plan-reviewer artifact exists while plan section is pending"
        )
    if tester_log_has_artifact and not patch_complete:
        contradictions.append("tester artifact exists while patch section is pending")
    if tester_log_has_artifact and not test_results_complete:
        contradictions.append(
            "tester artifact exists while test results section is pending"
        )
    if reporter_log_has_artifact and not patch_complete:
        contradictions.append("reporter artifact exists while patch section is pending")
    if reporter_log_has_artifact and not test_results_complete:
        contradictions.append(
            "reporter artifact exists while test results section is pending"
        )
    if reporter_requires_review and not reporter_review_complete:
        contradictions.append(
            "reporter artifact exists while reporter review section is pending"
        )
    if (
        reporter_outcome
        and reporter_outcome != "SKIPPED"
        and test_results_complete
        and not reporter_review_complete
    ):
        contradictions.append(
            "reporter feedback exists while reporter review section is pending"
        )
    if patch_complete and not plan_complete:
        contradictions.append("patch exists without complete plan")
    if test_results_complete and not patch_complete:
        contradictions.append("test results exist without complete patch")
    if reporter_review_complete and not test_results_complete:
        contradictions.append("reporter review exists without test results")
    if tester_outcome == "FAIL" and reporter_outcome == "PASS":
        contradictions.append("tester failed but reporter is pass")
    if (
        tester_outcome == "FAIL"
        and reporter_review_complete
        and reporter_outcome != "SKIPPED"
    ):
        contradictions.append("tester failed but reporter review is complete")
    if contradictions:
        return (
            "block",
            "contradictory resume state: "
            + "; ".join(contradictions)
            + "; remediation: align pending sections and role artifacts before resume",
        )

    if test_results_complete and not tester_outcome:
        return (
            "block",
            "missing critical artifact: test results exist without tester feedback",
        )
    if reporter_review_complete and not reporter_outcome:
        return (
            "block",
            "missing critical artifact: reporter review exists without reporter feedback",
        )
    if reporter_outcome and reporter_outcome != "SKIPPED" and not test_results_complete:
        return (
            "block",
            "missing critical artifact: reporter feedback exists without test results",
        )

    if tester_outcome == "FAIL":
        return ("planner", None)
    if not plan_complete:
        return ("planner", None)
    if not patch_complete:
        return ("patcher", None)
    return ("tester", None)


def append_iteration_log_note(content: str, work_item_id: str, note: str) -> str:
    body = get_entry_section(content, work_item_id, "Iteration Log")
    entry = f"- {note.strip()}"
    if not body or body.strip() in {"-", "(pending)"}:
        new_body = entry
    elif entry in body:
        new_body = body
    else:
        new_body = body.rstrip() + "\n" + entry
    return replace_entry_section(content, work_item_id, "Iteration Log", new_body)


