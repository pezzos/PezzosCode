def reporter_feedback_focus_text(reporter_feedback: str) -> str:
    fields = ("Check", "Evidence", "Expected fix", "Notes")
    parts: List[str] = []
    for field in fields:
        value = parse_labeled_line(reporter_feedback, field)
        if value:
            parts.append(value.lower())
    if parts:
        return " ".join(" ".join(parts).split())
    return " ".join((reporter_feedback or "").lower().split())


def is_finalization_only_reporter_failure(reporter_feedback: str) -> bool:
    if parse_outcome(reporter_feedback) != "FAIL":
        return False
    focus = reporter_feedback_focus_text(reporter_feedback)
    finalization_markers = (
        "commit message",
        "final report",
        "no runs yet",
        "final execution summary",
        "gates",
        "make ci",
    )
    if not any(marker in focus for marker in finalization_markers):
        return False
    non_finalization_markers = (
        "reporter review",
        "test results",
        "patch section",
        "tests run",
        "top execution field is blank: patcher",
        "top execution field is blank: tester",
        "top execution field is blank: tests run",
        "top execution field is blank: reporter",
        "top execution field is blank: docs/logs updated",
        "required compacted output missing",
        "traceability evidence",
        "allowed tests",
    )
    return not any(marker in focus for marker in non_finalization_markers)


