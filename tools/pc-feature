def die(message: str) -> None:
    print(message, file=sys.stderr)
    sys.exit(1)


def read_file(path: str) -> str:
    with open(path, "r", encoding="utf-8") as handle:
        return handle.read()


def write_file(path: str, content: str) -> None:
    with open(path, "w", encoding="utf-8") as handle:
        handle.write(content)


def parse_args(argv: List[str]) -> Tuple[str, bool]:
    feature_id = ""
    manual = False
    for arg in argv:
        if arg.startswith("F="):
            feature_id = arg[len("F=") :].strip()
        elif arg.startswith("MANUAL="):
            manual = arg.split("=", 1)[1].strip() == "1"
        else:
            die(f"pc-feature: unknown argument '{arg}'")
    if not feature_id:
        die("pc-feature: missing required F=<feature-id>")
    return feature_id, manual


def list_feature_dirs(root: str) -> List[Tuple[int, str, str]]:
    features = []
    for entry in os.listdir(root):
        path = os.path.join(root, entry)
        if not os.path.isdir(path):
            continue
        if entry == "feature-template":
            continue
        match = re.match(r"^(\d+)-", entry)
        if not match:
            continue
        features.append((int(match.group(1)), entry, path))
    return sorted(features, key=lambda item: item[0])


def resolve_feature_dir(root: str, feature_id: str) -> str:
    feature_id = feature_id.strip()
    for _, name, path in list_feature_dirs(root):
        if name.startswith(f"{feature_id}-"):
            return path
    die(f"pc-feature: feature folder not found for id {feature_id}")


def normalize_work_item_id(raw: str) -> str:
    match = re.match(r"^WI-(\d{8})-(\d{2})$", raw.strip())
    if not match:
        die("pc-feature: invalid work item id")
    return raw.strip()


def next_work_item_id(content: str) -> str:
    today = datetime.now().strftime("%Y%m%d")
    pattern = re.compile(r"WI-(\d{8})-(\d{2})")
    max_seq = 0
    for match in pattern.finditer(content):
        if match.group(1) != today:
            continue
        seq = int(match.group(2))
        max_seq = max(max_seq, seq)
    return f"WI-{today}-{max_seq + 1:02d}"


def ensure_execution_log(content: str) -> None:
    if not any(
        line.strip().startswith(EXEC_LOG_HEADER) for line in content.splitlines()
    ):
        die("pc-feature: dev-tasks.md missing Execution Log section")


def insert_execution_entry(content: str, entry: str) -> str:
    lines = content.splitlines()
    for idx, line in enumerate(lines):
        if line.strip().startswith(EXEC_LOG_HEADER):
            insert_at = idx + 1
            while insert_at < len(lines) and lines[insert_at].strip() == "":
                insert_at += 1
            lines[insert_at:insert_at] = [entry.rstrip(), ""]
            return "\n".join(lines) + "\n"
    die("pc-feature: Execution Log header not found")
    return content


def list_entry_headers(lines: List[str]) -> List[str]:
    headers = []
    pattern = re.compile(r"^WI-(\d{8})-(\d{2})$")
    for line in lines:
        if line.startswith(ENTRY_HEADER_PREFIX):
            header = line[len(ENTRY_HEADER_PREFIX) :].strip()
            if header.startswith("WI-"):
                candidate = header.split(" ", 1)[0]
                if pattern.match(candidate):
                    headers.append(candidate)
    return headers


def find_entry_block(lines: List[str], work_item_id: str) -> Tuple[int, int]:
    header = f"{ENTRY_HEADER_PREFIX}{work_item_id}"
    start = -1
    for idx, line in enumerate(lines):
        if line.startswith(header):
            start = idx
            break
    if start == -1:
        die(f"pc-feature: execution entry {work_item_id} not found")
    end = len(lines)
    for idx in range(start + 1, len(lines)):
        if lines[idx].startswith(ENTRY_HEADER_PREFIX) and lines[idx].strip() != "":
            end = idx
            break
    return start, end


def get_entry_section(content: str, work_item_id: str, section_title: str) -> str:
    lines = content.splitlines()
    start, end = find_entry_block(lines, work_item_id)
    entry_lines = lines[start:end]
    section_header = f"{SECTION_PREFIX}{section_title}"
    section_start = None
    for idx, line in enumerate(entry_lines):
        if line.strip() == section_header:
            section_start = idx
            break
    if section_start is None:
        die(f"pc-feature: missing section {section_title} in entry {work_item_id}")
    section_end = len(entry_lines)
    for idx in range(section_start + 1, len(entry_lines)):
        if entry_lines[idx].startswith(SECTION_PREFIX):
            section_end = idx
            break
    body = "\n".join(entry_lines[section_start + 1 : section_end]).strip()
    return body


def replace_entry_section(
    content: str, work_item_id: str, section_title: str, new_body: str
) -> str:
    lines = content.splitlines()
    start, end = find_entry_block(lines, work_item_id)
    entry_lines = lines[start:end]
    section_header = f"{SECTION_PREFIX}{section_title}"
    section_start = None
    for idx, line in enumerate(entry_lines):
        if line.strip() == section_header:
            section_start = idx
            break
    if section_start is None:
        die(f"pc-feature: missing section {section_title} in entry {work_item_id}")
    section_end = len(entry_lines)
    for idx in range(section_start + 1, len(entry_lines)):
        if entry_lines[idx].startswith(SECTION_PREFIX):
            section_end = idx
            break
    new_body_lines = new_body.strip().splitlines()
    entry_lines = (
        entry_lines[: section_start + 1]
        + ["", *new_body_lines]
        + [""]
        + entry_lines[section_end:]
    )
    return "\n".join(lines[:start] + entry_lines + lines[end:]) + "\n"


def update_entry_field(content: str, work_item_id: str, field: str, value: str) -> str:
    lines = content.splitlines()
    start, end = find_entry_block(lines, work_item_id)
    entry_lines = lines[start:end]
    prefix = f"- {field}:"
    updated = False
    for idx, line in enumerate(entry_lines):
        if line.strip().startswith(prefix):
            entry_lines[idx] = f"{prefix} {value}"
            updated = True
            break
    if not updated:
        die(f"pc-feature: field '{field}' not found in entry {work_item_id}")
    return "\n".join(lines[:start] + entry_lines + lines[end:]) + "\n"


def parse_field_value(lines: List[str], field: str) -> str:
    prefix = f"- {field}:"
    for line in lines:
        if line.strip().startswith(prefix):
            return line.split(":", 1)[1].strip()
    return ""


def format_review_item(command: str, status: int) -> str:
    suffix = "ok" if status == 0 else "FAIL"
    return f"{command}: {suffix}"


def build_preflight_block(
    data: Dict,
    work_item_id: str,
    change_budget: Dict,
    risk_level: str,
    triggers: List[str],
    review_summary: Optional[str] = None,
) -> str:
    review_line = (
        f"Systematic review: {review_summary}"
        if review_summary
        else "Systematic review:"
    )
    files = data.get("files_to_change") or []
    trigger_text = ", ".join(triggers) if triggers else "(none)"
    return (
        f"- Work Item: {work_item_id}\n"
        f"- PRD ref: {data.get('prd_ref', '')}\n"
        f"- Risk level: {risk_level}\n"
        f"- Triggers: {trigger_text}\n"
        f"- Scope in: {data.get('scope_in', '')}\n"
        f"- Scope out: {data.get('scope_out', '')}\n"
        f"- Non-goals reminder: {data.get('non_goals_reminder', '')}\n"
        f"- Files to change: {', '.join(files) if files else '(none)'}\n"
        f"- Change budget: max_files={change_budget['max_files']}, max_new_modules={change_budget['max_new_modules']}\n"
        f"- TDD plan: {', '.join(data.get('tdd_tests', []) or [])}\n"
        f"- {review_line}"
    )


def build_tdd_plan_block(tests: List[str]) -> str:
    if not tests:
        return "- Tests to write first: (none)"
    lines = ["- Tests to write first:"]
    lines.extend([f"  - {test}" for test in tests])
    return "\n".join(lines)


def build_files_block(files: List[str], change_budget: Dict) -> str:
    files_line = ", ".join(files) if files else "(none)"
    return (
        f"- Files: {files_line}\n"
        f"- Change budget: max_files: {change_budget['max_files']}, max_new_modules: {change_budget['max_new_modules']}"
    )


def build_docs_block(doc_updates: List[str]) -> str:
    if not doc_updates:
        return "- (none)"
    return "\n".join([f"- {item}" for item in doc_updates])


def build_gates_block(command: str, status: str) -> str:
    return f"- {command}: {status}"


def classify_risk(data: Dict, change_budget: Dict) -> Tuple[str, List[str]]:
    triggers = []
    if data.get("touches_secret_blocking"):
        triggers.append("touches secret blocking or fail-close behavior")
    if data.get("touches_restore"):
        triggers.append("affects restore apply semantics or permissions")
    if data.get("touches_secret_scanning"):
        triggers.append("modifies secret scanning dependencies/policies")
    modules = data.get("cross_cutting_refactor_modules", 0)
    if modules and modules >= 3:
        triggers.append("cross-cutting refactor impacting 3+ modules")
    files_to_change = data.get("files_to_change") or []
    if len(files_to_change) > change_budget["max_files"]:
        triggers.append("change budget exceeded (file count)")
    planned_new_modules = data.get("planned_new_modules", 0)
    if planned_new_modules > change_budget["max_new_modules"]:
        triggers.append("change budget exceeded (new modules)")
    return ("HIGH" if triggers else "LOW", triggers)


def git_repo_root(path: Optional[str]) -> str:
    result = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        cwd=path,
    )
    if result.returncode != 0:
        die(f"pc-feature: git root not found\n{result.stderr}")
    return result.stdout.strip()


def codex_overrides() -> List[str]:
    uvx_path = shutil.which("uvx") or os.path.join(
        os.path.expanduser("~"), ".local", "bin", "uvx"
    )
    serena_payload = (
        f'{{command="{uvx_path}",args=["--refresh","--from","git+https://github.com/oraios/serena",'
        '"serena","start-mcp-server","--context","codex","--project-from-cwd"],'
        "optional=true,autostart=false,startup_timeout_ms=30000,request_timeout_ms=15000}"
    )
    return [
        "-c",
        'approval_policy="never"',
        "-c",
        'sandbox_mode="workspace-write"',
        "-c",
        "network_access=false",
        "-c",
        f"mcp_servers.serena={serena_payload}",
    ]


def codex_exec(
    prompt: str,
    capture_output: bool = True,
    cwd: Optional[str] = None,
    profile: Optional[str] = None,
) -> str:
    if shutil.which("codex") is None:
        die("pc-feature: codex CLI not found in PATH")
    project_root = git_repo_root(cwd)
    codex_home = os.path.join(project_root, ".codex_subagent")
    os.makedirs(codex_home, exist_ok=True)
    config_path = os.path.join(codex_home, "config.toml")
    if not os.path.exists(config_path):
        with open(config_path, "w", encoding="utf-8") as handle:
            handle.write(
                'approval_policy = "never"\n'
                'sandbox_mode = "workspace-write"\n'
                "network_access = false\n"
            )
    auth_src = os.path.join(os.path.expanduser("~"), ".codex", "auth.json")
    auth_dst = os.path.join(codex_home, "auth.json")
    if os.path.exists(auth_src) and not os.path.exists(auth_dst):
        try:
            shutil.copy2(auth_src, auth_dst)
        except Exception as exc:
            print(
                f"pc-feature: failed to copy auth.json: {exc}",
                file=sys.stderr,
            )
    if not os.path.exists(auth_dst):
        print(
            "pc-feature: warning: auth.json missing; codex exec may fail.",
            file=sys.stderr,
        )
    env = os.environ.copy()
    env.pop("OPENAI_API_KEY", None)
    env["CODEX_HOME"] = codex_home
    codex_profile = profile or os.environ.get("CODEX_PROFILE", "Default")
    cmd = [
        "codex",
        "-C",
        project_root,
        "--profile",
        codex_profile,
        *codex_overrides(),
        "exec",
        prompt,
    ]
    result = subprocess.run(
        cmd,
        check=False,
        cwd=cwd,
        text=True,
        env=env,
        stdout=subprocess.PIPE if capture_output else None,
        stderr=subprocess.PIPE if capture_output else None,
    )
    if result.returncode != 0:
        combined = ""
        if result.stdout:
            combined += result.stdout
        if result.stderr:
            combined += result.stderr
        die(f"pc-feature: codex exec failed\n{combined}")
    return result.stdout or ""


def build_worktree_path(root: str, feature_name: str, agent: str) -> str:
    repo_name = os.path.basename(root)
    safe_feature = re.sub(r"[^a-zA-Z0-9]+", "-", feature_name).strip("-")
    safe_agent = re.sub(r"[^a-zA-Z0-9]+", "-", agent).strip("-")
    parent = os.path.dirname(root)
    return os.path.join(parent, f"{repo_name}-{safe_feature}-{safe_agent}")


def build_worktree_branch(feature_name: str, agent: str) -> str:
    safe_feature = re.sub(r"[^a-zA-Z0-9]+", "-", feature_name).strip("-")
    safe_agent = re.sub(r"[^a-zA-Z0-9]+", "-", agent).strip("-")
    return f"feature-{safe_feature}-{safe_agent}"


def git_current_branch(path: str) -> str:
    result = subprocess.run(
        ["git", "rev-parse", "--abbrev-ref", "HEAD"],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        cwd=path,
    )
    if result.returncode != 0:
        die(f"pc-feature: failed to resolve current branch\n{result.stderr}")
    branch = result.stdout.strip()
    if branch.startswith("heads/"):
        branch = branch[len("heads/") :]
    if branch.startswith("refs/heads/"):
        branch = branch[len("refs/heads/") :]
    return branch


def git_branch_exists(root: str, branch: str) -> bool:
    result = subprocess.run(
        ["git", "show-ref", "--verify", f"refs/heads/{branch}"],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        cwd=root,
    )
    return result.returncode == 0


def resolve_base_ref(root: str, base_branch: str) -> str:
    if git_branch_exists(root, base_branch):
        return f"refs/heads/{base_branch}"
    return base_branch


def prepare_worktree(
    root: str, feature_name: str, agent: str, base_branch: str
) -> Tuple[str, str]:
    path = build_worktree_path(root, feature_name, agent)
    branch = build_worktree_branch(feature_name, agent)
    if os.path.exists(path):
        actual_branch = git_current_branch(path)
        if actual_branch == "main":
            die(f"pc-feature: worktree for {agent} is on main")
        return path, actual_branch
    if git_branch_exists(root, branch):
        cmd = ["git", "worktree", "add", path, branch]
    else:
        resolved_base = resolve_base_ref(root, base_branch)
        cmd = ["git", "worktree", "add", "-b", branch, path, resolved_base]
    result = subprocess.run(
        cmd,
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        cwd=root,
    )
    if result.returncode != 0:
        die(f"pc-feature: failed to create worktree for {agent}\n{result.stderr}")
    return path, branch


def worktree_role_paths(feature_dir: str) -> Dict[str, str]:
    return {
        role: os.path.join(feature_dir, filename)
        for role, filename in ROLE_LOG_FILES.items()
    }


def ensure_role_log(path: str, role: str) -> None:
    if os.path.exists(path):
        return
    title = f"{role.title()} Log"
    content = f"# {title}\n\n## Entries\n"
    write_file(path, content)


def append_role_log(path: str, work_item_id: str, body: str) -> None:
    timestamp = datetime.now().strftime("%Y-%m-%d")
    entry = f"### {work_item_id} - {timestamp}\n\n{body.strip()}\n"
    if not os.path.exists(path):
        write_file(path, "# Log\n\n## Entries\n")
    content = read_file(path).rstrip()
    content = content + "\n\n" + entry + "\n"
    write_file(path, content)


def parse_status_paths(status_lines: List[str]) -> List[str]:
    paths: List[str] = []
    for line in status_lines:
        if not line.strip():
            continue
        entry = line[3:] if len(line) > 3 else ""
        if "->" in entry:
            parts = entry.split("->")
            paths.extend(part.strip() for part in parts if part.strip())
        else:
            paths.append(entry.strip())
    return paths


def get_status_paths(path: str) -> List[str]:
    result = subprocess.run(
        ["git", "status", "--porcelain"],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        cwd=path,
    )
    if result.returncode != 0:
        die(f"pc-feature: failed to read git status for {path}\n{result.stderr}")
    lines = result.stdout.splitlines()
    return parse_status_paths(lines)


def filter_ignored_paths(paths: List[str]) -> List[str]:
    ignored_prefixes = (
        ".tmp/",
        ".codex_subagent/",
        ".offload/",
    )
    ignored_files = {
        ".codex_subagent/config.toml",
    }
    filtered: List[str] = []
    for entry in paths:
        if entry in ignored_files:
            continue
        if any(entry.startswith(prefix) for prefix in ignored_prefixes):
            continue
        filtered.append(entry)
    return filtered


def enforce_role_scope(
    worktree_path: str,
    role: str,
    feature_dir: str,
) -> None:
    paths = get_status_paths(worktree_path)
    paths = filter_ignored_paths(paths)
    if not paths:
        return
    role_paths = worktree_role_paths(feature_dir)
    allowed = set()
    forbidden = set(role_paths.values())
    if role in role_paths:
        allowed.add(role_paths[role])
    if role == "patcher":
        illegal = [path for path in paths if path in forbidden]
        if illegal:
            die(
                "pc-feature: patcher edited role-scoped files: "
                + ", ".join(sorted(illegal))
            )
        return
    illegal = [path for path in paths if path not in allowed]
    if illegal:
        die(
            f"pc-feature: {role} edited out-of-scope files: "
            + ", ".join(sorted(illegal))
        )


def commit_worktree_changes(worktree_path: str, role: str, work_item_id: str) -> None:
    paths = get_status_paths(worktree_path)
    paths = filter_ignored_paths(paths)
    if not paths:
        return
    add_cmd = ["git", "add", "--"] + paths
    result = subprocess.run(add_cmd, check=False, cwd=worktree_path)
    if result.returncode != 0:
        die(f"pc-feature: failed to stage changes for {role}")
    message = f"{role}: updates for {work_item_id}"
    commit_cmd = ["git", "commit", "--no-verify", "-m", message]
    result = subprocess.run(
        commit_cmd,
        check=False,
        cwd=worktree_path,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if result.returncode != 0:
        detail = ""
        if result.stdout:
            detail += result.stdout
        if result.stderr:
            detail += result.stderr
        die(f"pc-feature: failed to commit changes for {role}\n{detail}")


def write_worktree_manifest(feature_dir: str, entries: List[Dict[str, str]]) -> None:
    manifest = {
        "generated_at": datetime.now().strftime("%Y-%m-%dT%H:%M:%S"),
        "worktrees": entries,
    }
    path = os.path.join(feature_dir, "feature-worktrees.json")
    write_file(path, json.dumps(manifest, indent=2) + "\n")


def branch_ahead_count(root: str, base_ref: str, branch: str) -> int:
    result = subprocess.run(
        ["git", "rev-list", "--count", f"{base_ref}..{branch}"],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        cwd=root,
    )
    if result.returncode != 0:
        die(f"pc-feature: failed to compare {branch} to {base_ref}\n{result.stderr}")
    return int(result.stdout.strip() or "0")


def apply_branch_diff(root: str, base_ref: str, branch: str) -> bool:
    result = subprocess.run(
        ["git", "diff", "--binary", f"{base_ref}..{branch}"],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=False,
        cwd=root,
    )
    if result.returncode != 0:
        die(
            f"pc-feature: failed to generate diff for {branch}\n{result.stderr.decode('utf-8', errors='replace')}"
        )
    patch = result.stdout
    if not patch:
        return True
    apply_result = subprocess.run(
        ["git", "apply", "--3way", "--whitespace=nowarn"],
        check=False,
        input=patch,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        cwd=root,
    )
    if apply_result.returncode != 0:
        return False
    return True


def cleanup_worktrees(root: str) -> None:
    result = subprocess.run(
        ["git", "worktree", "list", "--porcelain"],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        cwd=root,
    )
    if result.returncode != 0:
        die(f"pc-feature: failed to list worktrees\n{result.stderr}")
    lines = result.stdout.splitlines()
    worktree_paths: List[str] = []
    worktree_branches: List[str] = []
    current_path = None
    for line in lines:
        if line.startswith("worktree "):
            current_path = line.split(" ", 1)[1].strip()
            worktree_paths.append(current_path)
        elif line.startswith("branch ") and current_path:
            worktree_branches.append(
                line.split(" ", 1)[1].strip().replace("refs/heads/", "")
            )
    for path in worktree_paths:
        if os.path.abspath(path) == os.path.abspath(root):
            continue
        subprocess.run(
            ["git", "worktree", "remove", "--force", path], check=False, cwd=root
        )
    for branch in worktree_branches:
        if branch == "main":
            continue
        subprocess.run(["git", "branch", "-D", branch], check=False, cwd=root)


def parse_outcome(text: str) -> str:
    match = re.search(r"Outcome:\s*(PASS|FAIL|NEEDS REPLAN)", text, re.IGNORECASE)
    if not match:
        return "FAIL"
    return match.group(1).upper()


def extract_field(text: str, label: str) -> str:
    match = re.search(rf"^{label}:\s*(.+)$", text, re.MULTILINE | re.IGNORECASE)
    return match.group(1).strip() if match else ""


def run_command(cmd: List[str]) -> int:
    result = subprocess.run(cmd, check=False)
    return result.returncode


def build_execution_entry(work_item_id: str) -> str:
    return f"""### {work_item_id} - Work item execution\n\n- Date: {datetime.now().strftime('%Y-%m-%d')}\n- Scope / tasks covered: \n- Planner: \n- Patcher: \n- Tester: \n- Reporter: \n- Outcome: \n- Tests run: \n- Offload ids (if any): \n- Docs/logs updated: \n- Notes: \n\n#### Preflight Report\n\n- Work Item: {work_item_id}\n- PRD ref: \n- Risk level: \n- Triggers: \n- Scope in: \n- Scope out: \n- Non-goals reminder: \n- Files to change: \n- Change budget: max_files={DEFAULT_CHANGE_BUDGET['max_files']}, max_new_modules={DEFAULT_CHANGE_BUDGET['max_new_modules']}\n- TDD plan: \n- Systematic review: \n\n#### TDD Plan\n\n- Tests to write first: \n\n#### Files to Change + Change Budget\n\n- Files: \n- Change budget: max_files: {DEFAULT_CHANGE_BUDGET['max_files']}, max_new_modules: {DEFAULT_CHANGE_BUDGET['max_new_modules']}\n\n#### Docs Updated\n\n- [ ] Implementation log\n- [ ] Decision log (if needed)\n- [ ] Bug log (if needed)\n- [ ] Validation log (if needed)\n- [ ] Feature docs\n- [ ] PRD (if needed)\n\n#### Plan\n\n- (pending)\n\n#### Patch\n\n- (pending)\n\n#### Test Results\n\n- (pending)\n\n#### Reporter Review\n\n- (pending)\n\n#### Gates\n\n- make ci: \n\n#### Autofix Attempts\n\n- (none)\n\n#### Tester Feedback\n\n- Notes: \n\n#### Reporter Feedback\n\n- Notes: \n\n#### Iteration Log\n\n- \n\n#### Commit\n\n- Commit message: \n\n#### Final Report\n\n- \n"""


def entry_section_complete(content: str, work_item_id: str, section: str) -> bool:
    body = get_entry_section(content, work_item_id, section)
    if not body or "(pending)" in body:
        return False
    if section == "Preflight Report":
        lines = body.splitlines()
        risk_level = parse_field_value(lines, "Risk level")
        return bool(risk_level)
    if section == "Gates":
        return "make ci" in body and "PASS" in body
    if section == "Commit":
        return (
            "Commit message:" in body
            and len(body.split("Commit message:", 1)[1].strip()) > 0
        )
    return True


def entry_outcome(content: str, work_item_id: str) -> str:
    entry_lines = content.splitlines()
    start, end = find_entry_block(entry_lines, work_item_id)
    field = parse_field_value(entry_lines[start:end], "Outcome")
    return field.lower()


def append_log_line(path: str, line: str) -> None:
    content = read_file(path)
    if line in content:
        return
    content = content.rstrip() + f"\n\n- {line}\n"
    write_file(path, content)


def main() -> None:
    feature_id, manual = parse_args(sys.argv[1:])
    root = os.getcwd()
    current_branch = git_current_branch(root)
    if current_branch != "main":
        die("pc-feature: run from main branch only")
    feature_root = os.path.join("docs", "02-features")
    feature_dir = resolve_feature_dir(feature_root, feature_id)
    dev_tasks_path = os.path.join(feature_dir, "dev-tasks.md")
    if not os.path.exists(dev_tasks_path):
        die(f"pc-feature: missing dev-tasks.md at {dev_tasks_path}")
    content = read_file(dev_tasks_path)
    ensure_execution_log(content)

    lines = content.splitlines()
    headers = list_entry_headers(lines)
    work_item_id = None
    if headers:
        last_id = headers[-1]
        normalize_work_item_id(last_id)
        outcome = entry_outcome(content, last_id)
        if outcome and outcome.startswith("pass"):
            work_item_id = None
        else:
            work_item_id = last_id
    if not work_item_id:
        work_item_id = next_work_item_id(content)
        entry = build_execution_entry(work_item_id)
        content = insert_execution_entry(content, entry)
        write_file(dev_tasks_path, content)

    if manual:
        print("pc-feature: manual mode enabled; execution log entry ready")
        return

    feature_spec = read_file(os.path.join(feature_dir, "feature-spec.md"))
    tech_design = read_file(os.path.join(feature_dir, "tech-design.md"))
    test_plan = read_file(os.path.join(feature_dir, "test-plan.md"))

    review_items: List[str] = []

    content = read_file(dev_tasks_path)
    if not entry_section_complete(content, work_item_id, "Preflight Report"):
        preflight_prompt = (
            "You are preparing preflight data for a work item execution.\n"
            "Return ONLY valid JSON with keys: prd_ref, scope_in, scope_out, non_goals_reminder, "
            "files_to_change (array), planned_new_modules (int), touches_secret_blocking (bool), "
            "touches_restore (bool), touches_secret_scanning (bool), cross_cutting_refactor_modules (int), "
            "tdd_tests (array), doc_updates (array).\n"
            f"Work Item ID: {work_item_id}\n"
            f"Feature spec:\n{feature_spec}\n\n"
            f"Tech design:\n{tech_design}\n\n"
            f"Test plan:\n{test_plan}\n\n"
            f"Dev tasks:\n{content}\n"
        )
        preflight_raw = codex_exec(preflight_prompt).strip()
        try:
            preflight_data = json.loads(preflight_raw)
        except json.JSONDecodeError:
            die(f"pc-feature: failed to parse preflight JSON\n{preflight_raw}")

        risk_level, triggers = classify_risk(preflight_data, DEFAULT_CHANGE_BUDGET)
        content = read_file(dev_tasks_path)
        content = replace_entry_section(
            content,
            work_item_id,
            "Preflight Report",
            build_preflight_block(
                preflight_data,
                work_item_id,
                DEFAULT_CHANGE_BUDGET,
                risk_level,
                triggers,
                "; ".join(review_items) if review_items else None,
            ),
        )
        content = replace_entry_section(
            content,
            work_item_id,
            "TDD Plan",
            build_tdd_plan_block(preflight_data.get("tdd_tests") or []),
        )
        content = replace_entry_section(
            content,
            work_item_id,
            "Files to Change + Change Budget",
            build_files_block(
                preflight_data.get("files_to_change") or [], DEFAULT_CHANGE_BUDGET
            ),
        )
        content = replace_entry_section(
            content,
            work_item_id,
            "Docs Updated",
            build_docs_block(preflight_data.get("doc_updates") or []),
        )
        write_file(dev_tasks_path, content)

        if risk_level == "HIGH":
            content = update_entry_field(
                content, work_item_id, "Outcome", "needs replan"
            )
            content = update_entry_field(
                content, work_item_id, "Notes", "Awaiting PO Approval"
            )
            write_file(dev_tasks_path, content)
            die("pc-feature: high-risk work item requires PO approval")

    feature_slug = os.path.basename(feature_dir)
    patcher_path, patcher_branch = prepare_worktree(
        root, feature_slug, "patcher", "main"
    )
    planner_path = patcher_path
    tester_path = patcher_path
    reporter_path = patcher_path
    role_paths = worktree_role_paths(feature_dir)
    for role, rel_path in role_paths.items():
        ensure_role_log(os.path.join(root, rel_path), role)
    write_worktree_manifest(
        feature_dir,
        [
            {"role": "planner", "path": patcher_path, "branch": patcher_branch},
            {"role": "patcher", "path": patcher_path, "branch": patcher_branch},
            {"role": "tester", "path": patcher_path, "branch": patcher_branch},
            {"role": "reporter", "path": patcher_path, "branch": patcher_branch},
        ],
    )

    for attempt in range(1, MAX_LOOPS + 1):
        content = read_file(dev_tasks_path)
        if not entry_section_complete(content, work_item_id, "Plan"):
            plan_prompt = (
                "You are the Planner agent. Provide a concise plan for this work item. "
                "Include approach, files to change, risks, and tests.\n"
                f"Work Item ID: {work_item_id}\n"
                f"Feature spec:\n{feature_spec}\n\n"
                f"Tech design:\n{tech_design}\n\n"
                f"Dev tasks:\n{content}\n"
            )
            plan_text = codex_exec(
                plan_prompt, cwd=planner_path, profile="Planner"
            ).strip()
            content = read_file(dev_tasks_path)
            content = update_entry_field(content, work_item_id, "Planner", "Codex")
            content = replace_entry_section(content, work_item_id, "Plan", plan_text)
            write_file(dev_tasks_path, content)
            ensure_role_log(
                os.path.join(planner_path, role_paths["planner"]), "planner"
            )
            append_role_log(
                os.path.join(planner_path, role_paths["planner"]),
                work_item_id,
                plan_text,
            )
            enforce_role_scope(planner_path, "planner", feature_dir)
            commit_worktree_changes(planner_path, "planner", work_item_id)

        content = read_file(dev_tasks_path)
        if not entry_section_complete(content, work_item_id, "Patch"):
            patch_prompt = (
                "You are the Patcher agent. Apply the smallest possible diff to satisfy the plan. "
                "Return a concise summary of what changed and any commands run.\n"
                f"Work Item ID: {work_item_id}\n"
                f"Plan:\n{get_entry_section(content, work_item_id, 'Plan')}\n"
            )
            patch_text = codex_exec(
                patch_prompt,
                capture_output=True,
                cwd=patcher_path,
                profile="Patcher",
            ).strip()
            content = read_file(dev_tasks_path)
            content = update_entry_field(content, work_item_id, "Patcher", "Codex")
            content = replace_entry_section(
                content,
                work_item_id,
                "Patch",
                patch_text or "(see worktree changes)",
            )
            write_file(dev_tasks_path, content)
            enforce_role_scope(patcher_path, "patcher", feature_dir)
            commit_worktree_changes(patcher_path, "patcher", work_item_id)

        test_prompt = (
            "You are the Tester agent. Run the agreed tests and report results. "
            "Return in this exact format:\n"
            "Outcome: PASS|FAIL\n"
            "Tests run: ...\n"
            "Notes: ...\n"
            f"Work Item ID: {work_item_id}\n"
        )
        tester_feedback = codex_exec(
            test_prompt, cwd=tester_path, profile="Tester"
        ).strip()
        tester_outcome = parse_outcome(tester_feedback)
        tests_run = extract_field(tester_feedback, "Tests run")
        content = read_file(dev_tasks_path)
        content = update_entry_field(content, work_item_id, "Tester", "Codex")
        content = replace_entry_section(
            content, work_item_id, "Test Results", tester_feedback
        )
        content = replace_entry_section(
            content, work_item_id, "Tester Feedback", tester_feedback
        )
        if tests_run:
            content = update_entry_field(content, work_item_id, "Tests run", tests_run)
        write_file(dev_tasks_path, content)
        ensure_role_log(os.path.join(tester_path, role_paths["tester"]), "tester")
        append_role_log(
            os.path.join(tester_path, role_paths["tester"]),
            work_item_id,
            tester_feedback,
        )
        enforce_role_scope(tester_path, "tester", feature_dir)
        commit_worktree_changes(tester_path, "tester", work_item_id)

        reporter_prompt = (
            "You are the Reporter agent. Review changes for scope and completeness. "
            "Compare against main (e.g., `git diff --stat refs/heads/main..HEAD`) to ensure "
            "you are reviewing the patcher's changes, not just working tree status. "
            "Return in this exact format:\n"
            "Outcome: PASS|FAIL\n"
            "Docs/logs updated: ...\n"
            "Notes: ...\n"
            f"Work Item ID: {work_item_id}\n"
        )
        reporter_feedback = codex_exec(
            reporter_prompt, cwd=reporter_path, profile="Reporter"
        ).strip()
        reporter_outcome = parse_outcome(reporter_feedback)
        docs_updated = extract_field(reporter_feedback, "Docs/logs updated")
        content = read_file(dev_tasks_path)
        content = update_entry_field(content, work_item_id, "Reporter", "Codex")
        content = replace_entry_section(
            content, work_item_id, "Reporter Review", reporter_feedback
        )
        content = replace_entry_section(
            content, work_item_id, "Reporter Feedback", reporter_feedback
        )
        if docs_updated:
            content = update_entry_field(
                content, work_item_id, "Docs/logs updated", docs_updated
            )
        write_file(dev_tasks_path, content)
        ensure_role_log(os.path.join(reporter_path, role_paths["reporter"]), "reporter")
        append_role_log(
            os.path.join(reporter_path, role_paths["reporter"]),
            work_item_id,
            reporter_feedback,
        )
        enforce_role_scope(reporter_path, "reporter", feature_dir)
        commit_worktree_changes(reporter_path, "reporter", work_item_id)

        content = read_file(dev_tasks_path)
        content = replace_entry_section(
            content,
            work_item_id,
            "Iteration Log",
            f"- Attempt {attempt}: tester={tester_outcome}, reporter={reporter_outcome}",
        )
        write_file(dev_tasks_path, content)

        if tester_outcome != "PASS" or reporter_outcome != "PASS":
            content = read_file(dev_tasks_path)
            content = update_entry_field(
                content, work_item_id, "Outcome", "needs replan"
            )
            write_file(dev_tasks_path, content)
            continue

        break
    else:
        die("pc-feature: max iteration attempts reached; check execution log")

    base_ref = "HEAD"
    role_branches = [patcher_branch]
    for branch in role_branches:
        if branch_ahead_count(root, base_ref, branch) == 0:
            continue
        if not apply_branch_diff(root, base_ref, branch):
            content = read_file(dev_tasks_path)
            content = update_entry_field(
                content, work_item_id, "Outcome", "needs replan"
            )
            content = update_entry_field(
                content, work_item_id, "Notes", "Awaiting PO Approval"
            )
            write_file(dev_tasks_path, content)
            die("pc-feature: conflict detected while collecting worktrees")

    gate_status = "FAIL"
    autofix_notes: List[str] = []
    for attempt in range(1, MAX_AUTOFIX_ATTEMPTS + 1):
        cmd = ["tools/offload-proxy/pp", "make", "ci"]
        exit_code = run_command(cmd)
        review_items.append(
            format_review_item("tools/offload-proxy/pp make ci", exit_code)
        )
        if exit_code == 0:
            gate_status = "PASS"
            break
        autofix_cmd = ["tools/offload-proxy/pp", "pre-commit", "run", "--all-files"]
        autofix_exit = run_command(autofix_cmd)
        autofix_notes.append(
            format_review_item(
                "tools/offload-proxy/pp pre-commit run --all-files", autofix_exit
            )
        )
    content = read_file(dev_tasks_path)
    content = replace_entry_section(
        content, work_item_id, "Gates", build_gates_block("make ci", gate_status)
    )
    if autofix_notes:
        content = replace_entry_section(
            content, work_item_id, "Autofix Attempts", "\n".join(autofix_notes)
        )
    write_file(dev_tasks_path, content)

    if gate_status != "PASS":
        content = read_file(dev_tasks_path)
        content = update_entry_field(content, work_item_id, "Outcome", "needs replan")
        write_file(dev_tasks_path, content)
        die("pc-feature: make ci failed after autofix attempts")

    commit_prompt = (
        "You are generating a concise, scoped commit message for this work item. "
        "Return ONLY the commit subject line.\n"
        f"Work Item ID: {work_item_id}\n"
    )
    commit_message = codex_exec(commit_prompt).strip()
    if not commit_message:
        die("pc-feature: empty commit message from agent")
    content = read_file(dev_tasks_path)
    content = replace_entry_section(
        content,
        work_item_id,
        "Commit",
        f"- Commit message: {commit_message}",
    )

    final_report = (
        "What changed (files): (see git diff)\n"
        f"Tests written (names) + results: {get_entry_section(content, work_item_id, 'Test Results')}\n"
        "Docs/logs updated checklist: (see Docs Updated)\n"
        f"make ci results: {gate_status}\n"
        f"Commands run (use pp for noisy output): {'; '.join(review_items)}\n"
        f"Commit message: {commit_message}"
    )
    content = replace_entry_section(content, work_item_id, "Final Report", final_report)
    content = update_entry_field(content, work_item_id, "Outcome", "pass")
    write_file(dev_tasks_path, content)

    append_log_line(
        os.path.join("docs", "03-logs", "implementation-log.md"),
        "Documented the Execute work item workflow gating summary",
    )
    append_log_line(
        os.path.join("docs", "03-logs", "validation-log.md"),
        "Recorded the validation findings for the Execute work item workflow gating steps",
    )

    commit_result = subprocess.run(
        ["git", "add", "-A"],
        check=False,
        cwd=root,
    )
    if commit_result.returncode != 0:
        die("pc-feature: failed to stage collected changes")
    commit_result = subprocess.run(
        ["git", "commit", "-m", commit_message],
        check=False,
        cwd=root,
    )
    if commit_result.returncode != 0:
        die("pc-feature: failed to commit collected changes")
    cleanup_worktrees(root)

    print("pc-feature: complete")


if __name__ == "__main__":
    main()
