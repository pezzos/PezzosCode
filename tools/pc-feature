        ):
            actual_changed_paths = filter_ignored_paths(get_status_paths(patcher_path))
        preflight_prompt = (
            "You are preparing preflight data for a work item execution.\n"
            "Return ONLY valid JSON. No prose, no markdown, no extra text.\n"
            "Required keys: prd_ref, scope_in, scope_out, non_goals_reminder, "
