    def revise_plan_from_feedback(
        *,
        attempt: int,
        current_plan: str,
        tdd_section: str,
        feedback: str,
        iteration_reason: str,
        planner_log_step: str,
        failure_context: str,
    ) -> None:
        nonlocal planner_revision_attempts
        nonlocal stagnation_count
        nonlocal last_stagnation_signature
        nonlocal last_failure_context

        last_failure_context = failure_context
        if planner_revision_attempts >= MAX_PLANNER_REVISIONS:
            content = read_file(dev_tasks_path)
            content = update_entry_field(
                content, work_item_id, "Outcome", "needs replan"
            )
            content = append_iteration_log_note(
                content,
                work_item_id,
                "Planner revision limit reached while handling reviewer blocks; "
                f"planner_revision={planner_revision_attempts}/{MAX_PLANNER_REVISIONS}; "
                f"reviewer_block={reviewer_blocks}/{MAX_REVIEWER_BLOCKS}.",
            )
            content = update_entry_field(
                content,
                work_item_id,
                "Notes",
                "Planner revision limit reached during plan-reviewer loop.",
            )
            write_file(dev_tasks_path, content)
            flush_pending_failure_proposals("planner revision limit reached")
            die(
                "pc-feature: max planner revision attempts reached in plan-reviewer loop"
            )

        planner_revision_attempts += 1
        planner_update_prompt = render_prompt_template(
            load_prompt_template("planner", "update-from-feedback"),
            {
                "work_item_id": work_item_id,
                "current_plan": current_plan,
                "reviewer_feedback": feedback,
            },
        )
        revised_plan_raw = codex_exec(
            planner_update_prompt,
            cwd=planner_path,
            profile="Planner",
            runner_metadata=runner_metadata,
            root=str(runner_root),
        ).strip()
        if not revised_plan_raw:
            flush_pending_failure_proposals("planner returned empty revised plan")
            die("pc-feature: planner returned empty plan after feedback block")

        revised_plan = merge_revised_plan(current_plan, revised_plan_raw)
        quality_issues = revised_plan_quality_issues(
            revised_plan,
            previous_plan=current_plan,
        )
        content = read_file(dev_tasks_path)
        if should_enforce_anti_hardcode(content, work_item_id):
            quality_issues.extend(
                anti_hardcode_coverage_issues(revised_plan, tdd_section)
            )
        if quality_issues:
            flush_pending_failure_proposals("revised plan quality check failed")
            die(
                "pc-feature: revised plan failed quality checks: "
                + "; ".join(sorted(set(quality_issues)))
            )

        allowed_section = get_entry_section(content, work_item_id, "Allowed Tests")
        allowed_tests_for_policy = parse_allowed_tests(allowed_section)
        unresolved_policy_issues = plan_policy_violations(
            revised_plan,
            allowed_tests=allowed_tests_for_policy,
        )
        if unresolved_policy_issues:
            stagnation_signature = "|".join(sorted(set(unresolved_policy_issues)))
            if stagnation_signature == last_stagnation_signature:
                stagnation_count += 1
            else:
                last_stagnation_signature = stagnation_signature
                stagnation_count = 1
            if stagnation_count >= MAX_STAGNANT_REVIEWER_BLOCKS:
                content = read_file(dev_tasks_path)
                content = update_entry_field(
                    content, work_item_id, "Outcome", "needs replan"
                )
                content = append_iteration_log_note(
                    content,
                    work_item_id,
                    "Planner/reviewer loop stagnation detected; "
                    f"repeat_count={stagnation_count}/{MAX_STAGNANT_REVIEWER_BLOCKS}; "
                    f"issues={stagnation_signature}",
                )
                content = update_entry_field(
                    content,
                    work_item_id,
                    "Notes",
                    "Planner/reviewer stagnation detected; manual intervention required.",
                )
                write_file(dev_tasks_path, content)
                die(
                    "pc-feature: planner/reviewer loop is stagnant; repeated unresolved policy issues"
                )
        else:
            stagnation_count = 0
            last_stagnation_signature = ""

        content = read_file(dev_tasks_path)
        content = replace_entry_section(content, work_item_id, "Plan", revised_plan)
        content = append_iteration_log_note(
            content,
            work_item_id,
            f"Attempt {attempt}: {iteration_reason}; planner updated plan "
            f"(reviewer_block={reviewer_blocks}/{MAX_REVIEWER_BLOCKS}, "
            f"planner_revision={planner_revision_attempts}/{MAX_PLANNER_REVISIONS}, "
            f"execution_cycle={attempt}).",
        )
        write_file(dev_tasks_path, content)
        ensure_role_log(os.path.join(planner_path, role_paths["planner"]), "planner")
        append_role_log(
            os.path.join(planner_path, role_paths["planner"]),
            work_item_id,
            f"{planner_log_step}\n\n{summarize_feedback(feedback)}",
            role="planner",
        )
        commit_role_step(
            root,
            planner_path,
            patcher_branch,
            "planner",
            work_item_id,
            feature_dir,
        )

    def handle_patcher_scope_violation(
        *,
        attempt: int,
        current_plan: str,
        tdd_section: str,
        source_label: str,
    ) -> bool:
        patcher_dirty_paths = filter_ignored_paths(get_status_paths(patcher_path))
        illegal_patcher_paths = sorted(
            {
                path
                for path in patcher_dirty_paths
                if role_scoped_path_forbidden_for_patcher(path)
            }
        )
        if not illegal_patcher_paths:
            return False
        restore_dirty_paths(patcher_path, patcher_dirty_paths)
        residual_dirty = filter_ignored_paths(get_status_paths(patcher_path))
        if residual_dirty:
            die(
                "pc-feature: patcher cleanup after scope violation failed: "
                + ", ".join(sorted(residual_dirty))
            )
        illegal_paths = ", ".join(illegal_patcher_paths)
        patcher_scope_feedback = (
            "Decision: Block\n"
            "Reasons:\n"
            "- Patcher touched role-scoped/global-log files, which violates orchestrator scope policy.\n"
            "Required changes:\n"
            f"- Remove forbidden paths from the plan and patch instructions: {illegal_paths}\n"
            "- Keep patcher changes limited to implementation files only; planner owns dev-tasks and role logs.\n"
            "Optional suggestions:\n"
            "- Replace broad file patterns with exact non-role-scoped paths.\n"
        )
        revise_plan_from_feedback(
            attempt=attempt,
            current_plan=current_plan,
            tdd_section=tdd_section,
            feedback=patcher_scope_feedback,
            iteration_reason=f"{source_label} ({illegal_paths})",
            planner_log_step=(
                f"Step Planner revise after {source_label} at attempt {attempt}."
            ),
            failure_context=(
                "patcher touched role-scoped/global-log files; "
                f"planner revision required ({illegal_paths})."
            ),
        )
        return True

    while True:
        current_main_head = git_ref_sha(root, "refs/heads/main")
        if current_main_head != locked_main_head:
            content = read_file(dev_tasks_path)
            content = update_entry_field(
                content, work_item_id, "Outcome", "needs replan"
            )
            content = append_iteration_log_note(
                content,
                work_item_id,
                "Main moved during execution; "
                f"locked={locked_main_head}, current={current_main_head}.",
            )
            write_file(dev_tasks_path, content)
            emit_workflow_event(
                "feature",
                "FAIL",
                outcome="FAIL",
                reason="main branch changed during execution",
                state="FAILED",
            )
            die(
                "pc-feature: main branch changed during execution; "
                "stop and restart the feature from a clean baseline."
            )
        attempt = execution_attempt + 1
        emit_workflow_event("planner", "START", attempt=attempt)
        planner_changed = False
        content = read_file(dev_tasks_path)
        if not extract_field(content, "Planner"):
            content = update_entry_field(content, work_item_id, "Planner", "Codex")
            write_file(dev_tasks_path, content)
            planner_changed = True
        if not extract_field(content, "Plan Reviewer"):
            content = update_entry_field(
                content, work_item_id, "Plan Reviewer", "Codex"
            )
            write_file(dev_tasks_path, content)
            planner_changed = True
        force_planner_step = (
            execution_attempt == 0
            and resuming_existing_work_item
            and force_planner_on_resume
        )
        if force_planner_step or not entry_section_complete(
            content, work_item_id, "Plan"
        ):
            plan_prompt = render_prompt_template(
                load_prompt_template("planner", "create"),
                {
                    "work_item_id": work_item_id,
                    "feature_spec": feature_spec,
                    "tech_design": tech_design,
                    "dev_tasks": content,
                },
            )
            plan_text = codex_exec(
                plan_prompt,
                cwd=planner_path,
                profile="Planner",
                runner_metadata=runner_metadata,
                root=str(runner_root),
            ).strip()
            content = read_file(dev_tasks_path)
            content = replace_entry_section(content, work_item_id, "Plan", plan_text)
            write_file(dev_tasks_path, content)
            ensure_role_log(
                os.path.join(planner_path, role_paths["planner"]), "planner"
            )
            append_role_log(
                os.path.join(planner_path, role_paths["planner"]),
                work_item_id,
                plan_text,
                role="planner",
            )
            planner_changed = True

        content = read_file(dev_tasks_path)
        planner_updates = False
        planner_note = ""
        allowed_tests: List[str] = []
        forbidden: List[str] = []
        missing: List[str] = []
        for attempt_fix in range(2):
            allowed_section = get_entry_section(content, work_item_id, "Allowed Tests")
            allowed_tests = parse_allowed_tests(allowed_section)
            forbidden = [cmd for cmd in allowed_tests if is_forbidden_test(cmd)]
            missing = check_allowed_tests_exist(allowed_tests, planner_path)
            if not allowed_tests or forbidden or missing:
                issues: List[str] = []
                if not allowed_tests:
                    issues.append("No allowed tests are listed.")
                if forbidden:
                    issues.append("Forbidden commands detected (do not use `make ci`).")
                if missing:
                    issues.append("Missing tests: " + "; ".join(sorted(set(missing))))
                planner_prompt = render_prompt_template(
                    load_prompt_template("planner", "update-allowed-tests"),
                    {
                        "work_item_id": work_item_id,
                        "issues": " ".join(issues),
                    },
                )
                allowed_tests_snapshot = collect_dirty_snapshot(planner_path)
                planner_response = codex_exec(
                    planner_prompt,
                    cwd=planner_path,
                    profile="Planner",
                    runner_metadata=runner_metadata,
                    root=str(runner_root),
                ).strip()
                _, planner_dirty_delta = ensure_plan_reviewer_read_only(
                    planner_path,
                    baseline_snapshot=allowed_tests_snapshot,
                )
                if planner_dirty_delta:
                    restore_dirty_paths(planner_path, planner_dirty_delta)
                    _, residual_delta = ensure_plan_reviewer_read_only(
                        planner_path,
                        baseline_snapshot=allowed_tests_snapshot,
                    )
                    if residual_delta:
                        die(
                            "pc-feature: planner allowed-tests update modified files and cleanup failed: "
                            + ", ".join(sorted(residual_delta))
                        )
                    print(
                        "pc-feature: discarded planner allowed-tests side effects: "
                        + ", ".join(sorted(planner_dirty_delta))
                    )
                if planner_response:
                    sanitized_response = sanitize_allowed_tests_response(
                        planner_response
                    )
                    if not sanitized_response:
                        planner_note = "Ignored planner Allowed Tests response with no valid test commands."
                        continue
                    content = replace_entry_section(
                        content, work_item_id, "Allowed Tests", sanitized_response
                    )
                    write_file(dev_tasks_path, content)
                    planner_updates = True
                    planner_changed = True
                    content = read_file(dev_tasks_path)
                    continue
            break

        if planner_updates:
            ensure_role_log(
                os.path.join(planner_path, role_paths["planner"]), "planner"
            )
            note = (
                planner_note
                or "Updated Allowed Tests to satisfy existence and scope checks."
            )
            append_role_log(
                os.path.join(planner_path, role_paths["planner"]),
                work_item_id,
                note,
                role="planner",
            )
            planner_changed = True
        if planner_changed:
            commit_role_step(
                root,
                planner_path,
                patcher_branch,
                "planner",
                work_item_id,
                feature_dir,
            )
            emit_workflow_event("planner", "DONE", attempt=attempt, outcome="UPDATED")
        else:
            emit_workflow_event("planner", "DONE", attempt=attempt, outcome="NO_CHANGE")

        if not allowed_tests or forbidden or missing:
            emit_workflow_event(
                "plan-reviewer",
                "SKIP",
                attempt=attempt,
                reason="blocked by invalid allowed tests",
            )
            emit_workflow_event(
                "patcher",
                "SKIP",
                attempt=attempt,
                reason="blocked by invalid allowed tests",
            )
            emit_workflow_event("tester", "START", attempt=attempt)
            issues: List[str] = []
            if not allowed_tests:
                issues.append("no allowed tests listed")
            if forbidden:
                issues.append("forbidden commands: " + "; ".join(forbidden))
            if missing:
                issues.append("missing targets: " + "; ".join(sorted(set(missing))))
            remediation = (
                "Allowed Tests must contain only specific, existing unittest/pytest commands. "
                "Do not include `make ci`, `make feature`, `pc-feature`, or placeholders."
            )
            issue_summary = " | ".join(issues)
            tester_feedback = (
                "Outcome: FAIL\n"
                "Tests run: (none)\n"
                f"Notes: Invalid Allowed Tests after planner remediation attempts ({issue_summary}). "
                f"{remediation}\n"
                f"File/Path: {dev_tasks_repo_path}\n"
                "Check: Allowed Tests must list existing scoped unittest/pytest commands.\n"
                f"Evidence: {issue_summary}\n"
                f"Expected fix: {remediation}\n"
                f"Work Item ID: {work_item_id}\n"
            )
            ensure_role_log(os.path.join(tester_path, role_paths["tester"]), "tester")
            append_role_log(
                os.path.join(tester_path, role_paths["tester"]),
                work_item_id,
                tester_feedback,
                role="tester",
            )
            commit_role_step(
                root,
                tester_path,
                patcher_branch,
                "tester",
                work_item_id,
                feature_dir,
            )
            emit_workflow_event(
                "tester",
                "FAIL",
                attempt=attempt,
                outcome="FAIL",
                reason=issue_summary,
            )
            emit_workflow_event(
                "reporter",
                "SKIP",
                attempt=attempt,
                reason="blocked by invalid allowed tests",
            )
            tester_failures += 1
            execution_attempt += 1
            last_failure_context = (
                "allowed tests validation failed: "
                + issue_summary
                + "; remediation: "
                + remediation
            )
            content = read_file(dev_tasks_path)
            content = update_entry_field(
                content, work_item_id, "Outcome", "needs replan"
            )
            content = append_iteration_log_note(
                content,
                work_item_id,
                f"Attempt {attempt}: allowed-tests validation failed; routed back to planner "
                f"(tester_retry={tester_failures}/{MAX_LOOPS}). Issues: {issue_summary}.",
            )
            content = append_noop_step_note(
                content,
                work_item_id,
                attempt=attempt,
                step="plan-reviewer",
                reason="blocked by invalid allowed tests",
            )
            content = append_noop_step_note(
                content,
                work_item_id,
                attempt=attempt,
                step="patcher",
                reason="blocked by invalid allowed tests",
            )
            content = append_noop_step_note(
                content,
                work_item_id,
                attempt=attempt,
                step="reporter",
                reason="blocked by invalid allowed tests",
            )
            write_file(dev_tasks_path, content)
            if tester_failures >= MAX_LOOPS:
                queue_failure_proposal(
                    build_failure_outcome_payload(
                        work_item_id=work_item_id,
                        tester_outcome="FAIL",
                        reporter_outcome="SKIPPED",
                        tester_feedback=tester_feedback,
                        reporter_feedback=(
                            "Outcome: SKIPPED\n"
                            "Docs/logs updated: reporter deferred\n"
                            "Notes: Reporter skipped because tester failed during allowed-tests validation.\n"
                            f"Work Item ID: {work_item_id}\n"
                        ),
                    ),
                    pending_failure_proposals,
                    runner_metadata=runner_metadata,
                    root=runner_root,
                )
                content = update_entry_field(
                    content, work_item_id, "Outcome", "needs replan"
                )
                content = update_entry_field(
                    content,
                    work_item_id,
                    "Notes",
                    "Tester retry limit reached; unresolved Allowed Tests validation failures require manual intervention.",
                )
                write_file(dev_tasks_path, content)
                flush_pending_failure_proposals("tester retry limit reached")
                die(
                    "pc-feature: max tester retry attempts reached; "
                    "resolve Allowed Tests failures before retrying"
                )
            continue

        emit_workflow_event("plan-reviewer", "START", attempt=attempt)
        content = read_file(dev_tasks_path)
        current_plan = get_entry_section(content, work_item_id, "Plan")
        allowed_section = get_entry_section(content, work_item_id, "Allowed Tests")
        tdd_section = get_entry_section(content, work_item_id, "TDD Plan")
        pre_reviewer_snapshot = collect_dirty_snapshot(reviewer_path)
        auto_reviewer_hygiene = parse_bool_env(AUTO_REVIEWER_HYGIENE_ENV)
        if auto_reviewer_hygiene is None:
            auto_reviewer_hygiene = True
        if auto_reviewer_hygiene and pre_reviewer_snapshot:
            allowed_preexisting = {
                role_paths["plan-reviewer"],
            }
            unexpected_preexisting = sorted(
                path
                for path in pre_reviewer_snapshot.keys()
                if path not in allowed_preexisting
            )
            if unexpected_preexisting:
                emit_workflow_event(
                    "plan-reviewer",
                    "FAIL",
                    attempt=attempt,
                    outcome="FAIL",
                    reason="pre-review hygiene found unexpected dirty paths",
                    state="FAILED",
                )
                die(
                    "pc-feature: pre-review hygiene found unexpected dirty paths: "
                    + ", ".join(unexpected_preexisting)
                )

        anti_hardcode_issues: List[str] = []
        if should_enforce_anti_hardcode(content, work_item_id):
            anti_hardcode_issues = anti_hardcode_coverage_issues(
                current_plan, tdd_section
            )
        policy_issues = plan_policy_violations(
            current_plan,
            allowed_tests=allowed_tests,
        )
        deterministic_reviewer_issues = policy_issues + anti_hardcode_issues
        reviewer_dirty_delta: List[str] = []
        if deterministic_reviewer_issues:
            reviewer_feedback = plan_policy_block_feedback(
                deterministic_reviewer_issues
            )
            reviewer_decision = "BLOCK"
        else:
            plan_reviewer_prompt = render_prompt_template(
                load_prompt_template("plan-reviewer", "gate"),
                {
                    "work_item_id": work_item_id,
                    "current_plan": current_plan,
                    "allowed_tests": allowed_section,
                },
            )
            reviewer_feedback = codex_exec(
                plan_reviewer_prompt,
                cwd=reviewer_path,
                profile="PlanReviewer",
                runner_metadata=runner_metadata,
                root=str(runner_root),
            ).strip()
            _, reviewer_dirty_delta = ensure_plan_reviewer_read_only(
                reviewer_path, baseline_snapshot=pre_reviewer_snapshot
            )
            reviewer_decision = parse_plan_reviewer_decision(reviewer_feedback)
        if reviewer_dirty_delta:
            delta_text = ", ".join(reviewer_dirty_delta)
            emit_workflow_event(
                "plan-reviewer",
                "FAIL",
                attempt=attempt,
                outcome="FAIL",
                reason="plan reviewer modified files in writable worktree",
                state="FAILED",
            )
            die(
                "pc-feature: plan reviewer modified files in writable worktree: "
                + delta_text
            )

        ensure_role_log(
            os.path.join(reviewer_path, role_paths["plan-reviewer"]),
            "plan-reviewer",
        )
        append_role_log(
            os.path.join(reviewer_path, role_paths["plan-reviewer"]),
            work_item_id,
            f"Step Plan Reviewer {reviewer_decision} at attempt {attempt}.\n\n{reviewer_feedback}",
            role="plan-reviewer",
        )
        commit_role_step(
            root,
            reviewer_path,
            patcher_branch,
            "plan-reviewer",
            work_item_id,
            feature_dir,
        )

        if reviewer_decision == "CONFLICT":
            emit_workflow_event(
                "plan-reviewer",
                "FAIL",
                attempt=attempt,
                outcome="CONFLICT",
                reason="plan reviewer conflict",
                state="FAILED",
            )
            content = read_file(dev_tasks_path)
            content = update_entry_field(
                content, work_item_id, "Outcome", "needs replan"
            )
            content = update_entry_field(
                content,
                work_item_id,
                "Notes",
                "Plan reviewer conflict; resolve conflicting instructions and update Plan/Allowed Tests before retrying.",
            )
            content = append_iteration_log_note(
                content,
                work_item_id,
                "Plan reviewer conflict; resolve conflicting requirements and retry after updating the Plan.",
            )
            write_file(dev_tasks_path, content)
            flush_pending_failure_proposals("plan reviewer conflict")
            die(
                "pc-feature: plan reviewer conflict; resolve conflicting plan guidance "
                "and update the Plan/Allowed Tests before retrying"
            )

        if reviewer_decision == "BLOCK":
            emit_workflow_event(
                "plan-reviewer",
                "BLOCK",
                attempt=attempt,
                outcome="BLOCK",
                reason=summarize_feedback(reviewer_feedback),
            )
            reviewer_blocks += 1
            if reviewer_blocks >= MAX_REVIEWER_BLOCKS:
                content = read_file(dev_tasks_path)
                content = update_entry_field(
                    content, work_item_id, "Outcome", "needs replan"
                )
                content = append_iteration_log_note(
                    content,
                    work_item_id,
                    "Plan reviewer block limit reached; "
                    f"reviewer_block={reviewer_blocks}/{MAX_REVIEWER_BLOCKS}; "
                    f"execution_cycle={attempt}; "
                    f"feedback={summarize_feedback(reviewer_feedback)}",
                )
                content = update_entry_field(
                    content,
                    work_item_id,
                    "Notes",
                    "Plan-reviewer block limit reached; resolve reviewer feedback and resume.",
                )
                write_file(dev_tasks_path, content)
                flush_pending_failure_proposals("plan reviewer block limit reached")
                die(
                    "pc-feature: max plan-reviewer block attempts reached; "
                    "check planner/reviewer feedback for unresolved policy constraints"
                )
            revise_plan_from_feedback(
                attempt=attempt,
                current_plan=current_plan,
                tdd_section=tdd_section,
                feedback=reviewer_feedback,
                iteration_reason="Plan Reviewer BLOCK",
                planner_log_step=(
                    f"Step Planner revise after Plan Reviewer BLOCK at attempt {attempt}."
                ),
                failure_context="plan reviewer blocked plan; planner revision required.",
            )
            continue

        emit_workflow_event(
            "plan-reviewer",
            "DONE",
            attempt=attempt,
            outcome="APPROVE",
        )
        reviewer_blocks = 0
        stagnation_count = 0
        last_stagnation_signature = ""
        execution_attempt += 1
        smoke_command = allowed_tests[0] if allowed_tests else ""
        if smoke_command:
            smoke_cmd = ["tools/offload-proxy/pp"] + shlex.split(smoke_command)
            smoke_exit = run_command(smoke_cmd, cwd=patcher_path)
            review_items.append(
                format_review_item(f"prepatch smoke {smoke_command}", smoke_exit)
            )

        content = read_file(dev_tasks_path)
        current_plan = get_entry_section(content, work_item_id, "Plan")
        prepatch_policy_issues = plan_policy_violations(
            current_plan,
            allowed_tests=allowed_tests,
        )
        if prepatch_policy_issues:
            emit_workflow_event(
                "patcher",
                "SKIP",
                attempt=attempt,
                reason="blocked by pre-patch policy recheck",
            )
            prepatch_feedback = plan_policy_block_feedback(prepatch_policy_issues)
            revise_plan_from_feedback(
                attempt=attempt,
                current_plan=current_plan,
                tdd_section=tdd_section,
                feedback=prepatch_feedback,
                iteration_reason="pre-patch policy recheck BLOCK",
                planner_log_step=(
                    f"Step Planner revise after pre-patch policy recheck BLOCK at attempt {attempt}."
                ),
                failure_context=(
                    "pre-patch policy recheck blocked plan; planner revision required."
                ),
            )
            continue

        if not entry_section_complete(content, work_item_id, "Patch"):
            emit_workflow_event("patcher", "START", attempt=attempt)
            patch_prompt = render_prompt_template(
                load_prompt_template("patcher", "apply"),
                {
                    "work_item_id": work_item_id,
                    "plan": current_plan,
                },
            )
            codex_exec(
                patch_prompt,
                capture_output=True,
                cwd=patcher_path,
                profile="Patcher",
                runner_metadata=runner_metadata,
                root=str(runner_root),
            ).strip()
            if handle_patcher_scope_violation(
                attempt=attempt,
                current_plan=current_plan,
                tdd_section=tdd_section,
                source_label="patcher role-scope violation",
            ):
                emit_workflow_event(
                    "patcher",
                    "BLOCK",
                    attempt=attempt,
                    outcome="BLOCK",
                    reason="patcher role-scope violation",
                )
                continue
            patcher_committed = commit_role_step(
                root,
                patcher_path,
                patcher_branch,
                "patcher",
                work_item_id,
                feature_dir,
            )
            emit_workflow_event(
                "patcher",
                "DONE",
                attempt=attempt,
                outcome="CHANGED" if patcher_committed else "NO_CHANGE",
            )
            requires_global_logs = requires_global_logs or process_docs_changed(
                commit_paths(patcher_path)
            )
        else:
            emit_workflow_event(
                "patcher",
                "SKIP",
                attempt=attempt,
                reason="patch already present",
            )
            content = append_noop_step_note(
                content,
                work_item_id,
                attempt=attempt,
                step="patcher",
                reason="patch already present",
            )
            write_file(dev_tasks_path, content)

        emit_workflow_event("tester", "START", attempt=attempt)
        reset_dev_tasks_if_dirty(tester_path, dev_tasks_path)
        content = read_file(dev_tasks_path)
        allowed_section = get_entry_section(content, work_item_id, "Allowed Tests")
        allowed_tests = parse_allowed_tests(allowed_section)
        forbidden = [cmd for cmd in allowed_tests if is_forbidden_test(cmd)]
        missing = check_allowed_tests_exist(allowed_tests, tester_path)
        if not allowed_tests or forbidden or missing:
            if not allowed_tests:
                note = "No allowed tests are listed."
            elif forbidden:
                note = "Forbidden tests detected: " + "; ".join(forbidden)
            else:
                note = "Missing tests: " + "; ".join(sorted(set(missing)))
            tester_feedback = (
                "Outcome: FAIL\n"
                "Tests run: (none)\n"
                f"Notes: {note} Add specific, scoped tests to Allowed Tests; "
                "`make ci`, `make feature`, and `pc-feature` are forbidden.\n"
                f"File/Path: {dev_tasks_repo_path}\n"
                "Check: Allowed Tests must list existing scoped unittest/pytest commands.\n"
                f"Evidence: {note}\n"
                "Expected fix: Update Allowed Tests with exact commands that exit 0.\n"
                f"Work Item ID: {work_item_id}\n"
            )
            ensure_role_log(os.path.join(tester_path, role_paths["tester"]), "tester")
            append_role_log(
                os.path.join(tester_path, role_paths["tester"]),
                work_item_id,
                tester_feedback,
                role="tester",
            )
            commit_role_step(
                root,
                tester_path,
                patcher_branch,
                "tester",
                work_item_id,
                feature_dir,
            )
            emit_workflow_event(
                "tester",
                "FAIL",
                attempt=attempt,
                outcome="FAIL",
                reason=note,
                state="FAILED",
            )
            queue_failure_proposal(
                build_failure_outcome_payload(
                    work_item_id=work_item_id,
                    tester_outcome="FAIL",
                    reporter_outcome="SKIPPED",
                    tester_feedback=tester_feedback,
                    reporter_feedback=(
                        "Outcome: SKIPPED\n"
                        "Docs/logs updated: reporter deferred\n"
                        "Notes: Reporter skipped because tester failed during allowed-tests validation.\n"
                        f"Work Item ID: {work_item_id}\n"
                    ),
                ),
                pending_failure_proposals,
                runner_metadata=runner_metadata,
                root=runner_root,
            )
            flush_pending_failure_proposals("terminal allowed-tests validation failure")
            die("pc-feature: missing or forbidden allowed tests; update Allowed Tests")

        test_results: List[str] = []
        discovery_summaries: List[str] = []
        failed = False
        for cmd in allowed_tests:
            cmd_list = ["tools/offload-proxy/pp"] + shlex.split(cmd)
            exit_code, command_output = run_command_with_step_log_capture(
                cmd_list,
                runner_metadata,
                step="tests",
                root=runner_root,
                label=cmd,
                cwd=tester_path,
            )
            test_results.append(f"`{cmd}` -> {exit_code}")
            summary = extract_test_discovery_summary(command_output)
            if summary:
                discovery_summaries.append(f"`{cmd}` => {summary}")
            if exit_code != 0:
                failed = True
        tester_outcome = "FAIL" if failed else "PASS"
        tests_run = "; ".join(f"`{cmd}`" for cmd in allowed_tests)
        failure_evidence = "; ".join(
            item for item in test_results if not item.strip().endswith("-> 0")
        )
        discovery_line = (
            f"\nDiscovery: {'; '.join(discovery_summaries)}"
            if discovery_summaries
            else "\nDiscovery: no explicit discovery summary found in command output."
        )
        if tester_outcome == "FAIL":
            tester_notes = (
                f"Results: {'; '.join(test_results)}\n"
                f"File/Path: logs/{work_item_id}/tests.log\n"
                "Check: Allowed Tests commands must all exit 0.\n"
                f"Evidence: {failure_evidence or 'non-zero exit detected'}\n"
                "Expected fix: adjust plan/patch until all allowed tests pass."
                f"{discovery_line}"
            )
        else:
            tester_notes = f"Results: {'; '.join(test_results)}{discovery_line}"
        tester_feedback = (
            f"Outcome: {tester_outcome}\n"
            f"Tests run: {tests_run}\n"
            f"Notes: {tester_notes}\n"
            f"Work Item ID: {work_item_id}\n"
        )
        ensure_role_log(os.path.join(tester_path, role_paths["tester"]), "tester")
        append_role_log(
            os.path.join(tester_path, role_paths["tester"]),
            work_item_id,
            tester_feedback,
            role="tester",
        )
        commit_role_step(
            root,
            tester_path,
            patcher_branch,
            "tester",
            work_item_id,
            feature_dir,
        )
        if tester_outcome == "PASS":
            emit_workflow_event(
                "tester",
                "DONE",
                attempt=attempt,
                outcome="PASS",
            )
        else:
            emit_workflow_event(
                "tester",
                "FAIL",
                attempt=attempt,
                outcome="FAIL",
                reason=failure_evidence or "non-zero exit detected",
            )
        content = read_file(dev_tasks_path)
        content, runtime_updates = reconcile_runtime_execution_record(
            content,
            work_item_id,
            patch_completed=True,
            tester_feedback=tester_feedback,
            reporter_feedback="",
            reporter_outcome="",
        )
        if runtime_updates:
            content = append_iteration_log_note(
                content,
                work_item_id,
                "Runtime reconciliation updated execution record after tester step: "
                + ", ".join(runtime_updates)
                + ".",
            )
        write_file(dev_tasks_path, content)

        if tester_outcome != "PASS":
            emit_workflow_event(
                "reporter",
                "SKIP",
                attempt=attempt,
                reason="tester failed",
            )
            reporter_feedback = (
                "Outcome: SKIPPED\n"
                "Docs/logs updated: reporter deferred\n"
                "Notes: Reporter skipped because tester failed; planner must replan before review.\n"
                f"Work Item ID: {work_item_id}\n"
            )
            reporter_outcome = "SKIPPED"
            ensure_role_log(
                os.path.join(reporter_path, role_paths["reporter"]), "reporter"
            )
            append_role_log(
                os.path.join(reporter_path, role_paths["reporter"]),
                work_item_id,
                reporter_feedback,
                role="reporter",
            )
            commit_role_step(
                root,
                reporter_path,
                patcher_branch,
                "reporter",
                work_item_id,
                feature_dir,
            )
            if reporter_outcome == "PASS":
                emit_workflow_event(
                    "reporter",
                    "DONE",
                    attempt=attempt,
                    outcome="PASS",
                )
            elif reporter_outcome == "FAIL":
                emit_workflow_event(
                    "reporter",
                    "FAIL",
                    attempt=attempt,
                    outcome="FAIL",
                    reason=summarize_feedback(reporter_feedback),
                )
            else:
                emit_workflow_event(
                    "reporter",
                    "DONE",
                    attempt=attempt,
                    outcome=reporter_outcome or "UNKNOWN",
                )
            content = read_file(dev_tasks_path)
            content, runtime_updates = reconcile_runtime_execution_record(
                content,
                work_item_id,
                patch_completed=True,
                tester_feedback=tester_feedback,
                reporter_feedback=reporter_feedback,
                reporter_outcome=reporter_outcome,
            )
            if runtime_updates:
                content = append_iteration_log_note(
                    content,
                    work_item_id,
                    "Runtime reconciliation updated execution record after reporter skip: "
                    + ", ".join(runtime_updates)
                    + ".",
                )
            content = append_noop_step_note(
                content,
                work_item_id,
                attempt=attempt,
                step="reporter",
                reason="tester failed",
            )
            write_file(dev_tasks_path, content)
        else:
            emit_workflow_event("reporter", "START", attempt=attempt)
            pre_reporter_issues = execution_handoff_completeness_issues(
                content, work_item_id, require_reporter_review=False
            )
            reporter_finalization_normalized = False
            if pre_reporter_issues:
                reporter_feedback = build_reporter_handoff_block_feedback(
                    work_item_id=work_item_id,
                    dev_tasks_repo_path=dev_tasks_repo_path,
                    issues=pre_reporter_issues,
                    prefix_note=("Reporter blocked by pre-handoff completeness gate"),
                )
                reporter_outcome = "FAIL"
            else:
                reporter_note = ""
                if requires_global_logs:
                    reporter_note = (
                        "Global logs will be auto-appended after gates when process docs change. "
                        "Do not fail solely due to missing docs/03-logs updates; note any gaps."
                    )
                reporter_prompt = render_prompt_template(
                    load_prompt_template("reporter", "review"),
                    {
                        "work_item_id": work_item_id,
                        "reporter_note": reporter_note,
                        "feature_dir": feature_dir,
                        "dev_tasks_path": dev_tasks_repo_path,
                    },
                )
                reporter_feedback = codex_exec(
                    reporter_prompt,
                    cwd=reporter_path,
                    profile="Reporter",
                    runner_metadata=runner_metadata,
                    root=str(runner_root),
                ).strip()
                reporter_feedback = with_failure_context_guard(
                    reporter_feedback, role="reporter"
                )
                reporter_outcome = parse_outcome(reporter_feedback)
                if (
                    reporter_outcome == "FAIL"
                    and is_finalization_only_reporter_failure(reporter_feedback)
                ):
                    reporter_feedback = build_finalization_only_reporter_pass_feedback(
                        work_item_id=work_item_id,
                        dev_tasks_repo_path=dev_tasks_repo_path,
                        original_feedback=reporter_feedback,
                    )
                    reporter_outcome = "PASS"
                    reporter_finalization_normalized = True
            content = read_file(dev_tasks_path)
            content, _preview_updates = reconcile_runtime_execution_record(
                content,
                work_item_id,
                patch_completed=True,
                tester_feedback=tester_feedback,
                reporter_feedback=reporter_feedback,
                reporter_outcome=reporter_outcome,
            )
            post_reporter_issues: List[str] = []
            if reporter_outcome == "PASS":
                post_reporter_issues.extend(
                    execution_handoff_completeness_issues(
                        content, work_item_id, require_reporter_review=True
                    )
                )
                required_compacted_paths = required_compacted_output_paths(
                    content, work_item_id
                )
                missing_compacted = missing_compacted_output_paths(
                    patcher_path, required_compacted_paths
                )
                post_reporter_issues.extend(
                    f"required compacted output missing: {path}"
                    for path in missing_compacted
                )
                post_reporter_issues.extend(
                    reporter_traceability_issues(
                        reporter_feedback, required_compacted_paths
                    )
                )
            if post_reporter_issues:
                reporter_feedback = build_reporter_handoff_block_feedback(
                    work_item_id=work_item_id,
                    dev_tasks_repo_path=dev_tasks_repo_path,
                    issues=post_reporter_issues,
                    prefix_note=(
                        "Reporter PASS blocked by post-review completeness gate"
                    ),
                )
                reporter_outcome = "FAIL"

            ensure_role_log(
                os.path.join(reporter_path, role_paths["reporter"]), "reporter"
            )
            append_role_log(
                os.path.join(reporter_path, role_paths["reporter"]),
                work_item_id,
                reporter_feedback,
                role="reporter",
            )
            commit_role_step(
                root,
                reporter_path,
                patcher_branch,
                "reporter",
                work_item_id,
                feature_dir,
            )

            content = read_file(dev_tasks_path)
            content, runtime_updates = reconcile_runtime_execution_record(
                content,
                work_item_id,
                patch_completed=True,
                tester_feedback=tester_feedback,
                reporter_feedback=reporter_feedback,
                reporter_outcome=reporter_outcome,
            )
            if runtime_updates:
                content = append_iteration_log_note(
                    content,
                    work_item_id,
                    "Runtime reconciliation updated execution record after reporter step: "
                    + ", ".join(runtime_updates)
                    + ".",
                )
            if reporter_finalization_normalized:
                content = append_iteration_log_note(
                    content,
                    work_item_id,
                    "Reporter finalization-only FAIL normalized to PASS; final gates own Commit/Final Report placeholders.",
                )
            if post_reporter_issues:
                content = replace_entry_section(
                    content,
                    work_item_id,
                    "Reporter Review",
                    build_runtime_reporter_review_body(reporter_feedback),
                )
            write_file(dev_tasks_path, content)

        if tester_outcome == "PASS":
            tester_failures = 0
        else:
            tester_failures += 1

        if reporter_outcome == "PASS":
            reporter_failures = 0
        elif reporter_outcome == "FAIL":
            reporter_failures += 1

        if tester_outcome != "PASS" or reporter_outcome != "PASS":
            outcome_payload = build_failure_outcome_payload(
                work_item_id=work_item_id,
                tester_outcome=tester_outcome,
                reporter_outcome=reporter_outcome,
                tester_feedback=tester_feedback,
                reporter_feedback=reporter_feedback,
            )
            queue_failure_proposal(
                outcome_payload,
                pending_failure_proposals,
                runner_metadata=runner_metadata,
                root=runner_root,
            )
            last_failure_context = (
                f"tester={tester_outcome}; reporter={reporter_outcome}; "
                f"tester_feedback={summarize_feedback(tester_feedback)}; "
                f"reporter_feedback={summarize_feedback(reporter_feedback)}"
            )
            content = read_file(dev_tasks_path)
            current_plan = get_entry_section(content, work_item_id, "Plan")
            feedback_blob = (
                "Tester feedback:\n"
                f"{tester_feedback.strip()}\n\n"
                "Reporter feedback:\n"
                f"{reporter_feedback.strip()}\n"
            )
            planner_feedback_prompt = render_prompt_template(
                load_prompt_template("planner", "update_from_feedback"),
                {
                    "work_item_id": work_item_id,
                    "current_plan": current_plan,
                    "tester_feedback": tester_feedback.strip(),
                    "reporter_feedback": reporter_feedback.strip(),
                    "failure_feedback": feedback_blob.strip(),
                },
            )
            emit_workflow_event("planner-feedback", "START", attempt=attempt)
            planner_feedback = codex_exec(
                planner_feedback_prompt,
                cwd=planner_path,
                profile="Planner",
                runner_metadata=runner_metadata,
                root=str(runner_root),
            ).strip()
            planner_decision = parse_feedback_plan_decision(planner_feedback)
            planner_rationale = parse_feedback_rationale(planner_feedback)
            updated_plan = current_plan
            if planner_decision == "REVISE_PLAN":
                revised_plan_raw = parse_feedback_revised_plan(planner_feedback)
                if not revised_plan_raw:
                    flush_pending_failure_proposals(
                        "planner missing Revised Plan in feedback loop"
                    )
                    die(
                        "pc-feature: planner marked REVISE_PLAN but returned no Revised Plan section"
                    )
                revised_plan = merge_revised_plan(current_plan, revised_plan_raw)
                quality_issues = revised_plan_quality_issues(
                    revised_plan,
                    previous_plan=current_plan,
                )
                if should_enforce_anti_hardcode(content, work_item_id):
                    quality_issues.extend(
                        anti_hardcode_coverage_issues(
                            revised_plan,
                            get_entry_section(content, work_item_id, "TDD Plan"),
                        )
                    )
                if quality_issues:
                    flush_pending_failure_proposals(
                        "planner revised plan quality check failed in feedback loop"
                    )
                    die(
                        "pc-feature: revised plan failed quality checks: "
                        + "; ".join(sorted(set(quality_issues)))
                    )
                content = replace_entry_section(
                    content, work_item_id, "Plan", revised_plan
                )
                updated_plan = revised_plan
            rationale = planner_rationale if planner_rationale else "(not provided)"
            content = update_entry_field(
                content, work_item_id, "Outcome", "needs replan"
            )
            content = append_iteration_log_note(
                content,
                work_item_id,
                f"Attempt {attempt}: tester={tester_outcome}, reporter={reporter_outcome}; "
                f"tester_retry={tester_failures}/{MAX_LOOPS}; "
                f"reporter_retry={reporter_failures}/{MAX_LOOPS}; "
                f"planner decision={planner_decision}; rationale={rationale}; "
                "patcher feedback pending.",
            )
            write_file(dev_tasks_path, content)
            if tester_outcome != "PASS" and tester_failures >= MAX_LOOPS:
                content = update_entry_field(
                    content, work_item_id, "Outcome", "needs replan"
                )
                content = update_entry_field(
                    content,
                    work_item_id,
                    "Notes",
                    "Tester retry limit reached; unresolved test failures require manual intervention.",
                )
                write_file(dev_tasks_path, content)
                flush_pending_failure_proposals("tester retry limit reached")
                die(
                    "pc-feature: max tester retry attempts reached; "
                    "check tester feedback for unresolved failures"
                )
            if reporter_outcome == "FAIL" and reporter_failures >= MAX_LOOPS:
                content = update_entry_field(
                    content, work_item_id, "Outcome", "needs replan"
                )
                content = update_entry_field(
                    content,
                    work_item_id,
                    "Notes",
                    "Reporter retry limit reached; unresolved reporting failures require manual intervention.",
                )
                write_file(dev_tasks_path, content)
                flush_pending_failure_proposals("reporter retry limit reached")
                die(
                    "pc-feature: max reporter retry attempts reached; "
                    "check reporter feedback for unresolved scope gaps"
                )
            ensure_role_log(
                os.path.join(planner_path, role_paths["planner"]), "planner"
            )
            append_role_log(
                os.path.join(planner_path, role_paths["planner"]),
                work_item_id,
                planner_feedback,
                role="planner",
            )
            commit_role_step(
                root,
                planner_path,
                patcher_branch,
                "planner",
                work_item_id,
                feature_dir,
            )
            emit_workflow_event(
                "planner-feedback",
                "DONE",
                attempt=attempt,
                outcome=planner_decision,
            )

            patcher_feedback_prompt = render_prompt_template(
                load_prompt_template("patcher", "update_from_feedback"),
                {
                    "work_item_id": work_item_id,
                    "plan": updated_plan,
                    "tester_feedback": tester_feedback.strip(),
                    "reporter_feedback": reporter_feedback.strip(),
                    "failure_feedback": feedback_blob.strip(),
                    "planner_decision": planner_decision,
                    "planner_rationale": planner_rationale,
                },
            )
            emit_workflow_event("patcher-feedback", "START", attempt=attempt)
            codex_exec(
                patcher_feedback_prompt,
                capture_output=True,
                cwd=patcher_path,
                profile="Patcher",
                runner_metadata=runner_metadata,
                root=str(runner_root),
            ).strip()
            content = read_file(dev_tasks_path)
            feedback_tdd_section = get_entry_section(content, work_item_id, "TDD Plan")
            if handle_patcher_scope_violation(
                attempt=attempt,
                current_plan=updated_plan,
                tdd_section=feedback_tdd_section,
                source_label="patcher feedback role-scope violation",
            ):
                emit_workflow_event(
                    "patcher-feedback",
                    "BLOCK",
                    attempt=attempt,
                    outcome="BLOCK",
                    reason="patcher feedback role-scope violation",
                )
                continue
            patcher_feedback_committed = commit_role_step(
                root,
                patcher_path,
                patcher_branch,
                "patcher",
                work_item_id,
                feature_dir,
            )
            emit_workflow_event(
                "patcher-feedback",
                "DONE",
                attempt=attempt,
                outcome="CHANGED" if patcher_feedback_committed else "NO_CHANGE",
            )
            requires_global_logs = requires_global_logs or process_docs_changed(
                commit_paths(patcher_path)
            )
            continue

        break

    flush_pending_failure_proposals("post-loop before final gates")
    candidate_autofix_paths, skipped_autofix_paths = collect_patcher_autofix_paths(
        root,
        "refs/heads/main",
        patcher_branch,
        dev_tasks_path=dev_tasks_repo_path,
        feature_dir=feature_dir,
    )
    if skipped_autofix_paths:
        print(
            "pc-feature: scoped autofix skipped patcher-forbidden paths: "
            + ", ".join(skipped_autofix_paths)
        )
    gate_status = "FAIL"
    autofix_notes: List[str] = []
    ci_cmd = ["tools/offload-proxy/pp", "make", "ci"]
    emit_workflow_event("ci", "START", attempt=execution_attempt)
    first_ci_exit = run_command_with_step_log(
        ci_cmd,
        runner_metadata,
        step="ci",
        root=runner_root,
        label="make ci attempt=1",
        cwd=patcher_path,
    )
    review_items.append(
        format_review_item("tools/offload-proxy/pp make ci", first_ci_exit)
    )
    if first_ci_exit == 0:
        gate_status = "PASS"
    else:
        if candidate_autofix_paths:
            autofix_exit = run_scoped_autofix_paths(
                patcher_path, candidate_autofix_paths
            )
            autofix_notes.append(
                format_review_item(
                    "tools/offload-proxy/pp pre-commit run --files <scoped>",
                    autofix_exit,
                )
            )
            if filter_ignored_paths(get_status_paths(patcher_path)):
                commit_role_step(
                    root,
                    patcher_path,
                    patcher_branch,
                    "patcher",
                    work_item_id,
                    feature_dir,
                )
        else:
            if skipped_autofix_paths:
                autofix_notes.append(
                    "tools/offload-proxy/pp pre-commit run --files <scoped>: skipped "
                    "(no patcher-safe candidate paths)"
                )
            else:
                autofix_notes.append(
                    "tools/offload-proxy/pp pre-commit run --files <scoped>: skipped (no candidate paths)"
                )
        second_ci_exit = run_command_with_step_log(
            ci_cmd,
            runner_metadata,
            step="ci",
            root=runner_root,
            label="make ci attempt=2",
            cwd=patcher_path,
        )
        review_items.append(
            format_review_item("tools/offload-proxy/pp make ci", second_ci_exit)
        )
        if second_ci_exit == 0:
            gate_status = "PASS"
    if gate_status == "PASS":
        emit_workflow_event("ci", "DONE", attempt=execution_attempt, outcome="PASS")
    else:
        emit_workflow_event(
            "ci",
            "FAIL",
            attempt=execution_attempt,
            outcome="FAIL",
            reason=f"make ci failed after {MAX_CI_ATTEMPTS} attempts",
            state="FAILED",
        )
    content = read_file(dev_tasks_path)
    content = replace_entry_section(
        content, work_item_id, "Gates", build_gates_block("make ci", gate_status)
    )
    if autofix_notes:
        content = replace_entry_section(
            content, work_item_id, "Autofix Attempts", "\n".join(autofix_notes)
        )
    write_file(dev_tasks_path, content)

    if gate_status != "PASS":
        content = read_file(dev_tasks_path)
        content = update_entry_field(content, work_item_id, "Outcome", "needs replan")
        write_file(dev_tasks_path, content)
        flush_pending_failure_proposals("final gate failure")
        emit_workflow_event(
            "feature",
            "FAIL",
            outcome="FAIL",
            reason="make ci failed after final gate retry",
            state="FAILED",
        )
        die(
            "pc-feature: make ci failed after final gate retry "
            f"(max attempts: {MAX_CI_ATTEMPTS})"
        )

    reporter_global_prompt = render_prompt_template(
        load_prompt_template("reporter", "global-log"),
        {
            "work_item_id": work_item_id,
        },
    )
    reporter_global_raw = codex_exec(
        reporter_global_prompt,
        cwd=reporter_path,
        profile="Reporter",
        runner_metadata=runner_metadata,
        root=str(runner_root),
    ).strip()
    reporter_global = parse_json_object_payload(reporter_global_raw)
    if reporter_global is None:
        reporter_global_repair_prompt = build_reporter_global_log_repair_prompt(
            work_item_id, reporter_global_raw
        )
        reporter_global_repaired_raw = codex_exec(
            reporter_global_repair_prompt,
            cwd=reporter_path,
            profile="Reporter",
            runner_metadata=runner_metadata,
            root=str(runner_root),
        ).strip()
        reporter_global = parse_json_object_payload(reporter_global_repaired_raw)

    global_log_payload = merge_reporter_global_log_payload(
        reporter_global,
        deterministic_global_log_payload(work_item_id, requires_global_logs),
    )
    implementation_line = str(global_log_payload.get("implementation_log", "")).strip()
    validation_line = str(global_log_payload.get("validation_log", "")).strip()
    decision_line = str(global_log_payload.get("decision_log", "")).strip()
    if implementation_line:
        append_log_line(
            os.path.join("docs", "03-logs", "implementation-log.md"),
            implementation_line,
        )
    if validation_line:
        append_log_line(
            os.path.join("docs", "03-logs", "validation-log.md"),
            validation_line,
        )
    if decision_line and decision_line.lower() != "none":
        append_log_line(
            os.path.join("docs", "03-logs", "decision-log.md"),
            decision_line,
        )

    base_ref = "HEAD"
    role_branches = [patcher_branch]
    collected_any = False
    emit_workflow_event("collect", "START")
    for branch in role_branches:
        if branch_ahead_count(root, base_ref, branch) == 0:
            continue
        merge_paths = collect_branch_merge_paths(
            root,
            base_ref,
            branch,
            dev_tasks_path=dev_tasks_repo_path,
            feature_dir=feature_dir,
        )
        collection_summary = collect_branch_into_main(
            root,
            base_ref,
            branch,
            merge_paths,
        )
        if merge_paths:
            collected_any = True
        skipped_paths = collection_summary["skipped_paths"]
        if skipped_paths:
            skipped_text = ", ".join(skipped_paths)
            print(
                "pc-feature: warning: collecting patcher branch into main "
                "auto-skipped conflicting paths: " + skipped_text
            )
            if collection_summary["applied_paths"]:
                print(
                    "pc-feature: collecting patcher branch into main "
                    f"applied {len(collection_summary['applied_paths'])} path(s) "
                    "after auto-skip."
                )
            else:
                print(
                    "pc-feature: warning: collecting patcher branch into main "
                    "could not apply patcher diff paths; continuing run with "
                    "orchestrator-owned updates only."
                )
            content = read_file(dev_tasks_path)
            content = append_iteration_log_note(
                content,
                work_item_id,
                "Collection stage: collecting patcher branch into main "
                f"auto-skipped conflicting paths: {skipped_text}.",
            )
            write_file(dev_tasks_path, content)
            review_items.append(
                "collect patcher branch into main: auto-skip conflicts ("
                + skipped_text
                + ")"
            )
        elif merge_paths:
            review_items.append(
                format_review_item("collect patcher branch into main", 0)
            )
    emit_workflow_event(
        "collect",
        "DONE",
        outcome="CHANGED" if collected_any else "NO_CHANGES",
    )

    allowed_stage_paths = collect_allowed_final_stage_paths(
        root, "refs/heads/main", patcher_branch, dev_tasks_repo_path, feature_dir
    )

    content = read_file(dev_tasks_path)
    commit_already_done = entry_section_complete(content, work_item_id, "Commit")
    if commit_already_done:
        emit_workflow_event(
            "commit",
            "SKIP",
            reason="commit section already completed",
        )
    else:
        emit_workflow_event("commit", "START")
    commit_message = ""
    if commit_already_done:
        commit_message = parse_commit_message(
            get_entry_section(content, work_item_id, "Commit")
        )
    if not commit_message:
        commit_prompt = render_prompt_template(
            load_prompt_template("commit-message"),
            {
                "work_item_id": work_item_id,
            },
        )
        commit_message = codex_exec(
            commit_prompt,
            runner_metadata=runner_metadata,
            root=str(runner_root),
        ).strip()
        if not commit_message:
            die("pc-feature: empty commit message from agent")
        content = replace_entry_section(
            content,
            work_item_id,
            "Commit",
            f"- Commit message: {commit_message}",
        )

    final_report = (
        "What changed (files): (see git diff)\n"
        "Tests written (names) + results: (see feature validation-log.md)\n"
        "Docs/logs updated checklist: (see Docs Updated)\n"
        f"make ci results: {gate_status}\n"
        f"Commands run (use pp for noisy output): {'; '.join(review_items)}\n"
        f"Commit message: {commit_message}"
    )
    content = replace_entry_section(content, work_item_id, "Final Report", final_report)
    commit_gate_issues = commit_evidence_gate_issues(content, work_item_id)
    if commit_gate_issues:
        issue_summary = "; ".join(commit_gate_issues)
        die(f"pc-feature: commit evidence gate failed: {issue_summary}")
    content = update_entry_field(content, work_item_id, "Outcome", "pass")
    write_file(dev_tasks_path, content)

    if not commit_already_done:
        unstage_ephemeral_paths(root)
        staged_paths = stage_scoped_final_paths(root, allowed_stage_paths)
        commit_cmd = ["tools/pc-commit", "--yes", "--message", commit_message]
        for path in staged_paths:
            commit_cmd.extend(["--allow", path])
        for path in final_commit_allow_paths():
            commit_cmd.extend(["--allow", path])
        commit_exit_code, commit_output = run_command_with_step_log_capture(
            commit_cmd,
            runner_metadata,
            step="commit",
            root=runner_root,
            label="tools/pc-commit",
            cwd=root,
        )
        if commit_exit_code != 0:
            failure_reason = "failed to commit collected changes via tools/pc-commit"
            first_output_line = next(
                (line.strip() for line in commit_output.splitlines() if line.strip()),
                "",
            )
            if first_output_line:
                failure_reason = (
                    f"{failure_reason}; detail={summarize_feedback(first_output_line)}"
                )
            emit_workflow_event(
                "commit",
                "FAIL",
                outcome="FAIL",
                reason=failure_reason,
                state="FAILED",
            )
            emit_workflow_event(
                "feature",
                "FAIL",
                outcome="FAIL",
                reason=failure_reason,
                state="FAILED",
            )
            die(f"pc-feature: {failure_reason}")
        emit_workflow_event("commit", "DONE", outcome="CREATED")
    remove_worktree(root, patcher_path, patcher_branch)

    emit_workflow_event("feature", "DONE", outcome="PASS", state="COMPLETED")
    pc_runner.log_message(runner_metadata, "feature", "complete", root=runner_root)
    print("pc-feature: complete")


if __name__ == "__main__":
    main()
