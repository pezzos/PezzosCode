def restore_dirty_paths(worktree_path: str, paths: List[str]) -> None:
    for path in sorted(set(paths)):
        if not path:
            continue
        result = subprocess.run(
            ["git", "ls-files", "--error-unmatch", path],
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            cwd=worktree_path,
        )
        if result.returncode == 0:
            subprocess.run(
                ["git", "checkout", "--", path],
                check=False,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                cwd=worktree_path,
            )
            continue
        full_path = os.path.join(worktree_path, path)
        if os.path.isdir(full_path):
            shutil.rmtree(full_path, ignore_errors=True)
        elif os.path.exists(full_path):
            os.remove(full_path)


def recreate_worktree(root: str, path: str, branch: str) -> None:
    result = subprocess.run(
        ["git", "worktree", "remove", "--force", path],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        cwd=root,
    )
    if result.returncode != 0:
        die(f"pc-feature: failed to remove worktree at {path}\n{result.stderr}")
    if not git_branch_exists(root, branch):
        die(f"pc-feature: expected branch {branch} to exist for worktree recreate")
    result = subprocess.run(
        ["git", "worktree", "add", path, branch],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        cwd=root,
    )
    if result.returncode != 0:
        die(f"pc-feature: failed to recreate worktree for {branch}\n{result.stderr}")


def ensure_clean_worktree(
    root: str, worktree_path: str, branch: str, label: str
) -> None:
    paths = filter_ignored_paths(get_status_paths(worktree_path))
    if not paths:
        return
    recreate_worktree(root, worktree_path, branch)
    paths = filter_ignored_paths(get_status_paths(worktree_path))
    if paths:
        die(
            f"pc-feature: {label} worktree still dirty after recreate: "
            + ", ".join(sorted(paths))
        )


def remove_worktree(root: str, path: str, branch: str) -> None:
    result = subprocess.run(
        ["git", "worktree", "list", "--porcelain"],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        cwd=root,
    )
    if result.returncode != 0:
        die(f"pc-feature: failed to list worktrees\n{result.stderr}")
    worktrees = set()
    current_path = None
    for line in result.stdout.splitlines():
        if line.startswith("worktree "):
            current_path = line.split(" ", 1)[1].strip()
            worktrees.add(current_path)
    if os.path.exists(path) and path not in worktrees:
        die(f"pc-feature: existing path is not a git worktree: {path}")
    if path in worktrees:
        subprocess.run(
            ["git", "worktree", "remove", "--force", path],
            check=False,
            cwd=root,
        )
    if branch != "main":
        subprocess.run(["git", "branch", "-D", branch], check=False, cwd=root)


def format_role_changes(role: str, worktree_path: str, feature_dir: str) -> None:
    paths = get_status_paths(worktree_path)
    if not paths:
        return
    role_paths = worktree_role_paths(feature_dir)
    dev_tasks_path = os.path.join(feature_dir, "dev-tasks.md")
    if role == "patcher":
        blocked = set(role_paths.values())
        blocked.add(dev_tasks_path)
        paths = [path for path in paths if path not in blocked]
    else:
        allowed = role_paths.get(role)
        allowed_set = {allowed} if allowed else set()
        if role == "planner":
            allowed_set.add(dev_tasks_path)
        paths = [path for path in paths if path in allowed_set]
    if not paths:
        return
    if shutil.which("pre-commit") is None:
        print("pc-feature: pre-commit not found; skipping role formatting")
        return
    cmd = ["tools/offload-proxy/pp", "pre-commit", "run", "--files"] + paths
    env = os.environ.copy()
    env["SKIP"] = PRECOMMIT_FORMAT_SKIP
    subprocess.run(cmd, check=False, cwd=worktree_path, env=env)


def enforce_role_scope(
    worktree_path: str,
    role: str,
    feature_dir: str,
) -> None:
    paths = get_status_paths(worktree_path)
    paths = filter_ignored_paths(paths)
    if not paths:
        return
    role_paths = worktree_role_paths(feature_dir)
    orchestrator_owned = set(orchestrator_owned_paths())
    dev_tasks_path = os.path.join(feature_dir, "dev-tasks.md")
    allowed = set()
    forbidden = set(role_paths.values())
    forbidden.add(dev_tasks_path)
    if role in role_paths:
        allowed.add(role_paths[role])
    if role == "planner":
        allowed.add(dev_tasks_path)
    if role == "patcher":
        illegal_globals = [path for path in paths if path in orchestrator_owned]
        if illegal_globals:
            die(
                "pc-feature: orchestrator-owned docs/logs are read-only until gates pass: "
                + ", ".join(sorted(illegal_globals))
            )
        illegal = [
            path for path in paths if role_scoped_path_forbidden_for_patcher(path)
        ]
        if illegal:
            die(
                "pc-feature: patcher edited role-scoped files: "
                + ", ".join(sorted(illegal))
            )
        return
    illegal_globals = [path for path in paths if path in orchestrator_owned]
    if illegal_globals:
        die(
            "pc-feature: orchestrator-owned docs/logs are read-only until gates pass: "
            + ", ".join(sorted(illegal_globals))
        )
    illegal = [path for path in paths if path not in allowed]
    if illegal:
        die(
            f"pc-feature: {role} edited out-of-scope files: "
            + ", ".join(sorted(illegal))
        )


def commit_worktree_changes(
    worktree_path: str, role: str, work_item_id: str, feature_dir: str
) -> None:
    paths = get_status_paths(worktree_path)
    paths = filter_ignored_paths(paths)
    if not paths:
        return
    if role == "patcher":
        illegal = [
            path for path in paths if role_scoped_path_forbidden_for_patcher(path)
        ]
        if illegal:
            die(
                "pc-feature: patcher edited role-scoped files: "
                + ", ".join(sorted(illegal))
            )
    add_cmd = ["git", "add", "--"] + paths
    result = subprocess.run(add_cmd, check=False, cwd=worktree_path)
    if result.returncode != 0:
        die(f"pc-feature: failed to stage changes for {role}")
    message = f"{role}: updates for {work_item_id}"
    commit_cmd = ["git", "commit", "--no-verify", "-m", message]
    result = subprocess.run(
        commit_cmd,
        check=False,
        cwd=worktree_path,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if result.returncode != 0:
        detail = ""
        if result.stdout:
            detail += result.stdout
        if result.stderr:
            detail += result.stderr
        die(f"pc-feature: failed to commit changes for {role}\n{detail}")


def commit_role_step(
    root: str,
    worktree_path: str,
    branch: str,
    role: str,
    work_item_id: str,
    feature_dir: str,
    *,
    allow_empty: bool = False,
) -> bool:
    paths = filter_ignored_paths(get_status_paths(worktree_path))
    if not paths:
        return False
    format_role_changes(role, worktree_path, feature_dir)
    reset_possible_improvements_to_head(worktree_path)
    dev_tasks_path = os.path.join(feature_dir, "dev-tasks.md")
    if role == "patcher":
        reset_role_logs_to_head(worktree_path, feature_dir)
        reset_global_logs_to_head(worktree_path)
    elif role in {"tester", "reporter", "plan-reviewer"}:
        reset_global_logs_to_head(worktree_path)
        reset_performed = reset_dev_tasks_if_dirty(worktree_path, dev_tasks_path)
        if reset_performed:
            print(
                "pc-feature: "
                f"{role} auto-reset planner-owned dev-tasks.md before scope check: "
                f"{dev_tasks_path}"
            )
    enforce_role_scope(worktree_path, role, feature_dir)
    paths = filter_ignored_paths(get_status_paths(worktree_path))
    if not paths and not allow_empty:
        return False
    commit_worktree_changes(worktree_path, role, work_item_id, feature_dir)
    ensure_clean_worktree(root, worktree_path, branch, role)
    return True


def branch_ahead_count(root: str, base_ref: str, branch: str) -> int:
    result = subprocess.run(
        ["git", "rev-list", "--count", f"{base_ref}..{branch}"],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        cwd=root,
    )
    if result.returncode != 0:
        die(f"pc-feature: failed to compare {branch} to {base_ref}\n{result.stderr}")
    return int(result.stdout.strip() or "0")


def branch_behind_count(root: str, branch: str, base_ref: str) -> int:
    result = subprocess.run(
        ["git", "rev-list", "--count", f"{branch}..{base_ref}"],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        cwd=root,
    )
    if result.returncode != 0:
        die(
            f"pc-feature: failed to compare {branch} behind {base_ref}\n{result.stderr}"
        )
    return int(result.stdout.strip() or "0")


def merge_main_into_worktree(worktree_path: str, main_ref: str) -> Tuple[bool, str]:
    merge_result = subprocess.run(
        ["git", "merge", "--no-edit", main_ref],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        cwd=worktree_path,
    )
    detail = ((merge_result.stdout or "") + (merge_result.stderr or "")).strip()
    if merge_result.returncode == 0:
        return True, detail
    abort_result = subprocess.run(
        ["git", "merge", "--abort"],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        cwd=worktree_path,
    )
    if abort_result.returncode != 0:
        abort_detail = (
            (abort_result.stdout or "") + (abort_result.stderr or "")
        ).strip()
        if abort_detail:
            detail = f"{detail}\nmerge --abort failed: {abort_detail}".strip()
    return False, detail or "git merge failed"


def apply_branch_diff(
    root: str,
    base_ref: str,
    branch: str,
    include_paths: Optional[List[str]] = None,
    *,
    diagnostics: Optional[Dict[str, Any]] = None,
    precheck: bool = False,
) -> bool:
    if diagnostics is not None:
        diagnostics.clear()
        diagnostics["attempts"] = []
        diagnostics["conflicts"] = []
        diagnostics["precheck_conflicts"] = []

    if include_paths is not None and not include_paths:
        return True
    cmd: List[str] = ["git", "diff", "--binary", f"{base_ref}..{branch}"]
    if include_paths:
        cmd.extend(["--", *include_paths])
    result = subprocess.run(
        cmd,
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=False,
        cwd=root,
    )
    if result.returncode != 0:
        die(
            f"pc-feature: failed to generate diff for {branch}\n{result.stderr.decode('utf-8', errors='replace')}"
        )
    patch = result.stdout
    if not patch:
        return True

    def decode_apply_output(data: bytes) -> str:
        return data.decode("utf-8", errors="replace") if data else ""

    def parse_conflict_paths(*texts: str) -> List[str]:
        patterns = (
            r"Applied patch to '([^']+)' with conflicts\.",
            r"CONFLICT \([^)]*\):.* in ([^\n]+)",
            r"error:\s+([^:\n]+):\s+does not match index",
            r"error:\s+([^:\n]+):\s+patch does not apply",
        )
        paths = set()
        for text in texts:
            if not text:
                continue
            for pattern in patterns:
                for match in re.findall(pattern, text):
                    candidate = normalize_repo_rel(match.strip())
                    if candidate:
                        paths.add(candidate)
        return sorted(paths)

    def restore_apply_delta(before_snapshot: Dict[str, str]) -> List[str]:
        after_snapshot = collect_dirty_snapshot(root)
        delta = dirty_delta_paths(before_snapshot, after_snapshot)
        if not delta:
            return []
        subprocess.run(
            ["git", "reset", "--"] + delta,
            check=False,
            cwd=root,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
        )
        restore_dirty_paths(root, delta)
        return delta

    all_conflicts: List[str] = []
    if precheck:
        check_result = subprocess.run(
            ["git", "apply", "--check", "--3way", "--whitespace=nowarn"],
            check=False,
            input=patch,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            cwd=root,
        )
        precheck_stdout = decode_apply_output(check_result.stdout)
        precheck_stderr = decode_apply_output(check_result.stderr)
        precheck_conflicts = parse_conflict_paths(precheck_stdout, precheck_stderr)
        if diagnostics is not None:
            diagnostics["precheck_conflicts"] = precheck_conflicts
        for path in precheck_conflicts:
            if path not in all_conflicts:
                all_conflicts.append(path)

    initial_snapshot = collect_dirty_snapshot(root)
    attempts_to_run = 2
    for attempt in range(1, attempts_to_run + 1):
        apply_result = subprocess.run(
            ["git", "apply", "--3way", "--whitespace=nowarn"],
            check=False,
            input=patch,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            cwd=root,
        )
        apply_stdout = decode_apply_output(apply_result.stdout)
        apply_stderr = decode_apply_output(apply_result.stderr)
        attempt_conflicts = parse_conflict_paths(apply_stdout, apply_stderr)
        for path in attempt_conflicts:
            if path not in all_conflicts:
                all_conflicts.append(path)
        if diagnostics is not None:
            diagnostics["attempts"].append(
                {
                    "attempt": attempt,
                    "returncode": apply_result.returncode,
                    "conflicts": attempt_conflicts,
                }
            )
        if apply_result.returncode == 0:
            if diagnostics is not None:
                diagnostics["conflicts"] = sorted(all_conflicts)
            return True
        restored = restore_apply_delta(initial_snapshot)
        if diagnostics is not None:
            diagnostics["attempts"][-1]["restored_paths"] = restored

    if diagnostics is not None:
        diagnostics["conflicts"] = sorted(all_conflicts)
    return False


def branch_diff_paths(root: str, base_ref: str, branch: str) -> List[str]:
    result = subprocess.run(
        ["git", "diff", "--name-only", f"{base_ref}..{branch}"],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        cwd=root,
    )
    if result.returncode != 0:
        die(f"pc-feature: failed to list changed paths for {branch}\n{result.stderr}")
    return [line.strip() for line in result.stdout.splitlines() if line.strip()]


def collect_branch_merge_paths(
    root: str,
    base_ref: str,
    branch: str,
    dev_tasks_path: str,
    feature_dir: str,
) -> List[str]:
    changed = branch_diff_paths(root, base_ref, branch)
    orchestrator_owned = set(orchestrator_owned_paths())
    merged: List[str] = []
    for path in changed:
        if path in orchestrator_owned:
            continue
        if path.startswith("logs/"):
            continue
        if path in IGNORED_PATH_FILES:
            continue
        if any(path.startswith(prefix) for prefix in IGNORED_PATH_PREFIXES):
            continue
        merged.append(path)
    return sorted(set(merged))


def collect_patcher_autofix_paths(
    root: str,
    base_ref: str,
    branch: str,
    dev_tasks_path: str,
    feature_dir: str,
) -> Tuple[List[str], List[str]]:
    candidates = collect_branch_merge_paths(
        root,
        base_ref,
        branch,
        dev_tasks_path=dev_tasks_path,
        feature_dir=feature_dir,
    )
    allowed: List[str] = []
    skipped_forbidden: List[str] = []
    for path in candidates:
        if role_scoped_path_forbidden_for_patcher(path):
            skipped_forbidden.append(path)
            continue
        allowed.append(path)
    return sorted(set(allowed)), sorted(set(skipped_forbidden))


def merge_collection_conflict_paths(diagnostics: Optional[Dict[str, Any]]) -> List[str]:
    if not diagnostics:
        return []
    conflicts: Set[str] = set()
    for key in ("precheck_conflicts", "conflicts"):
        for path in diagnostics.get(key, []) or []:
            normalized = normalize_repo_rel(str(path))
            if normalized:
                conflicts.add(normalized)
    return sorted(conflicts)


def collect_branch_into_main(
    root: str,
    base_ref: str,
    branch: str,
    include_paths: List[str],
) -> Dict[str, List[str]]:
    merged_paths = sorted(set(include_paths))
    summary: Dict[str, List[str]] = {
        "applied_paths": [],
        "skipped_paths": [],
        "conflict_paths": [],
    }
    if not merged_paths:
        return summary

    first_diagnostics: Dict[str, Any] = {}
    if apply_branch_diff(
        root,
        base_ref,
        branch,
        include_paths=merged_paths,
        diagnostics=first_diagnostics,
        precheck=True,
    ):
        summary["applied_paths"] = merged_paths
        return summary

    conflict_paths = set(merge_collection_conflict_paths(first_diagnostics))
    remaining_paths = [path for path in merged_paths if path not in conflict_paths]
    applied_paths: Set[str] = set()

    if remaining_paths:
        retry_diagnostics: Dict[str, Any] = {}
        if apply_branch_diff(
            root,
            base_ref,
            branch,
            include_paths=remaining_paths,
            diagnostics=retry_diagnostics,
            precheck=False,
        ):
            applied_paths.update(remaining_paths)
        else:
            conflict_paths.update(merge_collection_conflict_paths(retry_diagnostics))
            for path in remaining_paths:
                if path in conflict_paths:
                    continue
                path_diagnostics: Dict[str, Any] = {}
                if apply_branch_diff(
                    root,
                    base_ref,
                    branch,
                    include_paths=[path],
                    diagnostics=path_diagnostics,
                    precheck=False,
                ):
                    applied_paths.add(path)
                    continue
                path_conflicts = merge_collection_conflict_paths(path_diagnostics)
                if path_conflicts:
                    conflict_paths.update(path_conflicts)
                else:
                    conflict_paths.add(path)

    skipped_paths = sorted(path for path in merged_paths if path not in applied_paths)
    conflict_paths.update(skipped_paths)
    summary["applied_paths"] = sorted(applied_paths)
    summary["skipped_paths"] = skipped_paths
    summary["conflict_paths"] = sorted(conflict_paths)
    return summary


def cleanup_worktrees(
    root: str, path: Optional[str] = None, branch: Optional[str] = None
) -> None:
    if not path or not branch:
        return
    remove_worktree(root, path, branch)


def parse_outcome(text: str) -> str:
    match = re.search(r"Outcome:\s*(PASS|FAIL|NEEDS REPLAN)", text, re.IGNORECASE)
    if not match:
        return "FAIL"
    return match.group(1).upper()


def parse_section_outcome(text: str) -> Optional[str]:
    match = re.search(
        r"Outcome:\s*(PASS|FAIL|NEEDS REPLAN|SKIPPED)", text, re.IGNORECASE
    )
    if not match:
        return None
    return match.group(1).upper()


def missing_failure_context_fields(text: str) -> List[str]:
    if parse_outcome(text) != "FAIL":
        return []
    required = ("File/Path", "Check", "Evidence", "Expected fix")
    missing: List[str] = []
    for field in required:
        pattern = rf"\b{re.escape(field)}\s*:"
        if not re.search(pattern, text, re.IGNORECASE):
            missing.append(field)
    return missing


def with_failure_context_guard(text: str, *, role: str) -> str:
    missing = missing_failure_context_fields(text)
    if not missing:
        return text
    guard = (
        f"Failure context guard ({role}): missing required fields: "
        + ", ".join(missing)
        + ".\n"
        "Expected fix: include File/Path, Check, Evidence, and Expected fix entries."
    )
    return text.rstrip() + "\n" + guard + "\n"


def summarize_feedback(feedback: str, *, max_chars: int = 420) -> str:
    compact = " ".join((feedback or "").split())
    if len(compact) <= max_chars:
        return compact
    return compact[: max_chars - 3].rstrip() + "..."


def parse_feedback_field(feedback: str, field: str) -> str:
    pattern = rf"^\s*{re.escape(field)}\s*:\s*(.+)$"
    match = re.search(pattern, feedback or "", flags=re.IGNORECASE | re.MULTILINE)
    if not match:
        return ""
    return match.group(1).strip()


def pick_first_non_empty(*values: str) -> str:
    for value in values:
        if value and value.strip():
            return value.strip()
    return ""


def join_unique_values(values: List[str], *, separator: str = ", ") -> str:
    seen = set()
    ordered: List[str] = []
    for value in values:
        cleaned = value.strip()
        if not cleaned or cleaned in seen:
            continue
        seen.add(cleaned)
        ordered.append(cleaned)
    return separator.join(ordered)


def extract_failure_feedback_signals(feedback: str) -> Dict[str, str]:
    return {
        "file_path": parse_feedback_field(feedback, "File/Path"),
        "check": parse_feedback_field(feedback, "Check"),
        "evidence": parse_feedback_field(feedback, "Evidence"),
        "expected_fix": parse_feedback_field(feedback, "Expected fix"),
        "notes": parse_feedback_field(feedback, "Notes"),
        "proposed_improvement": parse_feedback_field(feedback, "Proposed Improvement"),
        "proposed_patch_location": parse_feedback_field(
            feedback, "Proposed Patch Location"
        ),
        "risks": pick_first_non_empty(
            parse_feedback_field(feedback, "Risks / Trade-offs"),
            parse_feedback_field(feedback, "Risks/Trade-offs"),
            parse_feedback_field(feedback, "Risks"),
        ),
    }


def proposal_field_is_placeholder(value: str) -> bool:
    lowered = (value or "").strip().lower()
    if not lowered:
        return True
    if lowered.startswith("tbd") or lowered.startswith("unknown"):
        return True
    return lowered in {
        "none noted",
        "none noted.",
        "n/a",
        "dec-tbd",
        "no failure summary provided.",
        "none",
        "(none)",
    }


def merge_agents(existing: str, incoming: str) -> str:
    return join_unique_values(
        [part.strip() for part in f"{existing}, {incoming}".split(",")],
        separator=", ",
    )


def merge_preferred_text(existing: str, incoming: str) -> str:
    if proposal_field_is_placeholder(existing) and not proposal_field_is_placeholder(
        incoming
    ):
        return incoming
    return existing


def merge_collected_proposal_entries(
    existing: "pc_runner.ProposalEntry", incoming: "pc_runner.ProposalEntry"
) -> "pc_runner.ProposalEntry":
    return pc_runner.ProposalEntry(
        date=merge_preferred_text(existing.date, incoming.date),
        work_item_id=existing.work_item_id,
        agent=merge_agents(existing.agent, incoming.agent),
        step=merge_preferred_text(existing.step, incoming.step),
        failure_summary=merge_preferred_text(
            existing.failure_summary, incoming.failure_summary
        ),
        proposed_improvement=merge_preferred_text(
            existing.proposed_improvement, incoming.proposed_improvement
        ),
        proposed_patch_location=merge_preferred_text(
            existing.proposed_patch_location, incoming.proposed_patch_location
        ),
        risks=merge_preferred_text(existing.risks, incoming.risks),
        status=merge_preferred_text(existing.status, incoming.status),
        decision_log_ref=merge_preferred_text(
            existing.decision_log_ref, incoming.decision_log_ref
        ),
    )


def dedupe_collected_proposals(
    proposals: List["pc_runner.ProposalEntry"],
) -> List["pc_runner.ProposalEntry"]:
    if not proposals:
        return []
    by_signature: Dict[Tuple[str, str, str], "pc_runner.ProposalEntry"] = {}
    order: List[Tuple[str, str, str]] = []
    for proposal in proposals:
        signature = pc_runner.proposal_signature(
            proposal.work_item_id,
            proposal.step,
            proposal.failure_summary,
        )
        if signature not in by_signature:
            by_signature[signature] = proposal
            order.append(signature)
            continue
        by_signature[signature] = merge_collected_proposal_entries(
            by_signature[signature], proposal
        )
    return [by_signature[signature] for signature in order]


def queue_failure_proposal(
    outcome_payload: Dict[str, Any],
    pending: List["pc_runner.ProposalEntry"],
    *,
    runner_metadata: Optional["pc_runner.RunMetadata"] = None,
    root: Optional[Path] = None,
) -> None:
    proposal = pc_runner.build_proposal_from_outcome(outcome_payload)
    if not proposal:
        return
    pending.append(proposal)
    if runner_metadata and root:
        pc_runner.log_message(
            runner_metadata,
            "feature",
            (
                "proposal queued "
                f"signature={pc_runner.proposal_signature(proposal.work_item_id, proposal.step, proposal.failure_summary)} "
                f"pending={len(pending)}"
            ),
            root=root,
        )


def flush_collected_proposals(
    pending: List["pc_runner.ProposalEntry"],
    *,
    root: Path,
    reason: str,
    runner_metadata: Optional["pc_runner.RunMetadata"] = None,
    log_root: Optional[Path] = None,
) -> None:
    if not pending:
        return
    log_root_path = log_root or root
    path = root / POSSIBLE_IMPROVEMENTS_PATH
    if not path.exists():
        if runner_metadata:
            pc_runner.log_message(
                runner_metadata,
                "feature",
                f"proposal flush skip missing {path} reason={reason}",
                root=log_root_path,
            )
        pending.clear()
        return
    queued_count = len(pending)
    deduped = dedupe_collected_proposals(pending)
    actions: List[str] = []
    for proposal in deduped:
        _, action = pc_runner.update_possible_improvements(path, proposal)
        actions.append(action)
        if runner_metadata:
            pc_runner.log_message(
                runner_metadata,
                "feature",
                (
                    f"proposal {action} "
                    f"signature={pc_runner.proposal_signature(proposal.work_item_id, proposal.step, proposal.failure_summary)} "
                    f"reason={reason}"
                ),
                root=log_root_path,
            )
    if runner_metadata:
        pc_runner.log_message(
            runner_metadata,
            "feature",
            (
                f"proposal flush complete reason={reason} "
                f"queued={queued_count} deduped={len(deduped)} "
                f"actions={','.join(actions) if actions else 'none'}"
            ),
            root=log_root_path,
        )
    pending.clear()


def build_failure_outcome_payload(
    *,
    work_item_id: str,
    tester_outcome: str,
    reporter_outcome: str,
    tester_feedback: str,
    reporter_feedback: str,
) -> Dict[str, Any]:
    agents: List[str] = []
    step = "Test"
    if tester_outcome != "PASS":
        agents.append("Tester")
    if reporter_outcome not in {"PASS", "SKIPPED"}:
        agents.append("Reporter")
        if tester_outcome == "PASS":
            step = "Report"
    tester_signals = extract_failure_feedback_signals(tester_feedback)
    reporter_signals = extract_failure_feedback_signals(reporter_feedback)
    proposed_improvement = pick_first_non_empty(
        reporter_signals.get("proposed_improvement", ""),
        tester_signals.get("proposed_improvement", ""),
        reporter_signals.get("expected_fix", ""),
        tester_signals.get("expected_fix", ""),
    )
    proposed_patch_location = join_unique_values(
        [
            reporter_signals.get("proposed_patch_location", ""),
            tester_signals.get("proposed_patch_location", ""),
            reporter_signals.get("file_path", ""),
            tester_signals.get("file_path", ""),
        ]
    )
    risks = pick_first_non_empty(
        reporter_signals.get("risks", ""),
        tester_signals.get("risks", ""),
    )
    if not risks:
        risk_fragments = []
        if reporter_signals.get("check") or reporter_signals.get("evidence"):
            risk_fragments.append(
                "Reporter: "
                + summarize_feedback(
                    "; ".join(
                        value
                        for value in (
                            reporter_signals.get("check", ""),
                            reporter_signals.get("evidence", ""),
                        )
                        if value
                    ),
                    max_chars=180,
                )
            )
        if tester_signals.get("check") or tester_signals.get("evidence"):
            risk_fragments.append(
                "Tester: "
                + summarize_feedback(
                    "; ".join(
                        value
                        for value in (
                            tester_signals.get("check", ""),
                            tester_signals.get("evidence", ""),
                        )
                        if value
                    ),
                    max_chars=180,
                )
            )
        risks = " | ".join(fragment for fragment in risk_fragments if fragment)
    failure_summary = (
        f"tester={tester_outcome}; reporter={reporter_outcome}; "
        f"tester_feedback={summarize_feedback(tester_feedback)}; "
        f"reporter_feedback={summarize_feedback(reporter_feedback)}"
    )
    payload: Dict[str, Any] = {
        "outcome": "FAIL",
        "work_item_id": work_item_id,
        "agent_names": agents,
        "step": step,
        "failure_summary": failure_summary,
    }
    if proposed_improvement:
        payload["proposed_improvement"] = proposed_improvement
    if proposed_patch_location:
        payload["proposed_patch_location"] = proposed_patch_location
    if risks:
        payload["risks"] = risks
    return payload


