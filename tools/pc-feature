def codex_exec_once(
    prompt: str,
    capture_output: bool = True,
    cwd: Optional[str] = None,
    profile: Optional[str] = None,
) -> str:
    if shutil.which("codex") is None:
        die("pc-feature: codex CLI not found in PATH")
    project_root = git_repo_root(cwd)
    codex_home = os.path.join(project_root, ".codex_subagent")
    os.makedirs(codex_home, exist_ok=True)
    config_path = os.path.join(codex_home, "config.toml")
    if not os.path.exists(config_path):
        with open(config_path, "w", encoding="utf-8") as handle:
            handle.write(
                'approval_policy = "never"\n'
                'sandbox_mode = "workspace-write"\n'
                "network_access = false\n"
            )
    auth_src = os.path.join(os.path.expanduser("~"), ".codex", "auth.json")
    auth_dst = os.path.join(codex_home, "auth.json")
    if os.path.exists(auth_src) and not os.path.exists(auth_dst):
        try:
            shutil.copy2(auth_src, auth_dst)
        except Exception as exc:
            print(
                f"pc-feature: failed to copy auth.json: {exc}",
                file=sys.stderr,
            )
    if not os.path.exists(auth_dst):
        print(
            "pc-feature: warning: auth.json missing; codex exec may fail.",
            file=sys.stderr,
        )
    env = os.environ.copy()
    env.pop("OPENAI_API_KEY", None)
    env["CODEX_HOME"] = codex_home
    codex_profile = profile or os.environ.get("CODEX_PROFILE", "Default")
    cmd = [
        "codex",
        "-C",
        project_root,
        "--profile",
        codex_profile,
        *codex_overrides(),
        "exec",
        prompt,
    ]
    result = subprocess.run(
        cmd,
        check=False,
        cwd=cwd,
        text=True,
        env=env,
        stdout=subprocess.PIPE if capture_output else None,
        stderr=subprocess.PIPE if capture_output else None,
    )
    if result.returncode != 0:
        combined = ""
        if result.stdout:
            combined += result.stdout
        if result.stderr:
            combined += result.stderr
        die(f"pc-feature: codex exec failed\n{combined}")
    return result.stdout or ""


def codex_exec(
    prompt: str,
    capture_output: bool = True,
    cwd: Optional[str] = None,
    profile: Optional[str] = None,
    runner_metadata: Optional["pc_runner.RunMetadata"] = None,
    root: Optional[str] = None,
) -> str:
    response = codex_exec_once(
        prompt,
        capture_output=capture_output,
        cwd=cwd,
        profile=profile,
    )
    if not capture_output:
        return response
    root_dir = root or git_repo_root(cwd)
    current_prompt = prompt
    for _ in range(MAX_ESCALATION_ROUNDS):
        request = parse_escalation_request(response)
        if not request:
            return response
        broker_result = process_escalation_request(
            request,
            root=root_dir,
            default_cwd=cwd,
            runner_metadata=runner_metadata,
        )
        if runner_metadata:
            pc_runner.log_message(
                runner_metadata,
                "escalation",
                f"decision={broker_result.get('decision')} command={broker_result.get('command')}",
                root=Path(root_dir),
            )
        current_prompt = (
            current_prompt
            + "\n\n"
            + format_escalation_result(broker_result)
            + "\nUse this result and continue the task. "
            "Return the requested final output format only."
        )
        response = codex_exec_once(
            current_prompt,
            capture_output=capture_output,
            cwd=cwd,
            profile=profile,
        )
    die("pc-feature: escalation loop exceeded max rounds")
    return ""


def build_worktree_path(root: str, feature_name: str, agent: str) -> str:
    repo_name = os.path.basename(root)
    safe_feature = re.sub(r"[^a-zA-Z0-9]+", "-", feature_name).strip("-")
    safe_agent = re.sub(r"[^a-zA-Z0-9]+", "-", agent).strip("-")
    parent = os.path.dirname(root)
    return os.path.join(parent, f"{repo_name}-{safe_feature}-{safe_agent}")


def build_worktree_branch(feature_name: str, agent: str) -> str:
    safe_feature = re.sub(r"[^a-zA-Z0-9]+", "-", feature_name).strip("-")
    safe_agent = re.sub(r"[^a-zA-Z0-9]+", "-", agent).strip("-")
    return f"feature-{safe_feature}-{safe_agent}"


def normalize_feature_token(value: str) -> str:
    return re.sub(r"[^a-zA-Z0-9]+", "-", value).strip("-").lower()


def patcher_branch_feature_token(branch: str) -> Optional[str]:
    match = re.match(r"^feature-(?P<feature>.+)-patcher$", branch.strip())
    if not match:
        return None
    return normalize_feature_token(match.group("feature"))


def git_current_branch(path: str) -> str:
    result = subprocess.run(
        ["git", "rev-parse", "--abbrev-ref", "HEAD"],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        cwd=path,
    )
    if result.returncode != 0:
        die(f"pc-feature: failed to resolve current branch\n{result.stderr}")
    branch = result.stdout.strip()
    if branch.startswith("heads/"):
        branch = branch[len("heads/") :]
    if branch.startswith("refs/heads/"):
        branch = branch[len("refs/heads/") :]
    return branch


def git_ref_sha(root: str, ref: str) -> str:
    result = subprocess.run(
        ["git", "rev-parse", ref],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        cwd=root,
    )
    if result.returncode != 0:
        die(f"pc-feature: failed to resolve git ref {ref}\n{result.stderr}")
    return result.stdout.strip().lower()


def git_branch_exists(root: str, branch: str) -> bool:
    result = subprocess.run(
        ["git", "show-ref", "--verify", f"refs/heads/{branch}"],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        cwd=root,
    )
    return result.returncode == 0


def resolve_base_ref(root: str, base_branch: str) -> str:
    if git_branch_exists(root, base_branch):
        return f"refs/heads/{base_branch}"
    return base_branch


def prepare_worktree(
    root: str, feature_name: str, agent: str, base_branch: str
) -> Tuple[str, str]:
    path = build_worktree_path(root, feature_name, agent)
    branch = build_worktree_branch(feature_name, agent)
    if os.path.exists(path):
        actual_branch = git_current_branch(path)
        if actual_branch == "main":
            die(f"pc-feature: worktree for {agent} is on main")
        return path, actual_branch
    if git_branch_exists(root, branch):
        cmd = ["git", "worktree", "add", path, branch]
    else:
        resolved_base = resolve_base_ref(root, base_branch)
        cmd = ["git", "worktree", "add", "-b", branch, path, resolved_base]
    result = subprocess.run(
        cmd,
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        cwd=root,
    )
    if result.returncode != 0:
        die(f"pc-feature: failed to create worktree for {agent}\n{result.stderr}")
    return path, branch


def list_worktree_entries(root: str) -> List[Tuple[str, Optional[str]]]:
    result = subprocess.run(
        ["git", "worktree", "list", "--porcelain"],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        cwd=root,
    )
    if result.returncode != 0:
        die(f"pc-feature: failed to list worktrees\n{result.stderr}")

    entries: List[Tuple[str, Optional[str]]] = []
    current_path: Optional[str] = None
    current_branch: Optional[str] = None
    for raw_line in result.stdout.splitlines() + [""]:
        line = raw_line.strip()
        if not line:
            if current_path:
                entries.append((current_path, current_branch))
            current_path = None
            current_branch = None
            continue
        if line.startswith("worktree "):
            if current_path:
                entries.append((current_path, current_branch))
            current_path = line.split(" ", 1)[1].strip()
            current_branch = None
            continue
        if line.startswith("branch "):
            current_branch = line.split(" ", 1)[1].strip()
            if current_branch.startswith("refs/heads/"):
                current_branch = current_branch[len("refs/heads/") :]
            continue
    return entries


def worktree_role_paths(feature_dir: str) -> Dict[str, str]:
    return {
        role: os.path.join(feature_dir, filename)
        for role, filename in ROLE_LOG_FILES.items()
    }


def ensure_role_log(path: str, role: str) -> None:
    if os.path.exists(path):
        return
    title = f"{role.title()} Log"
    content = f"# {title}\n\n## Entries\n"
    write_file(path, content)


def upsert_role_log_entry(content: str, work_item_id: str, entry: str) -> str:
    header_prefix = f"### {work_item_id} -"
    lines = content.splitlines()
    cleaned: List[str] = []
    idx = 0
    while idx < len(lines):
        line = lines[idx]
        if line.startswith(header_prefix):
            idx += 1
            while idx < len(lines) and not lines[idx].startswith("### "):
                idx += 1
            continue
        cleaned.append(line)
        idx += 1
    base = "\n".join(cleaned).rstrip()
    if not base:
        base = "# Log\n\n## Entries"
    return base + "\n\n" + entry.strip() + "\n"


def append_role_log(
    path: str, work_item_id: str, body: str, role: Optional[str] = None
) -> None:
    timestamp = datetime.now().strftime("%Y-%m-%d")
    entry = f"### {work_item_id} - {timestamp}\n\n{body.strip()}\n"
    if not os.path.exists(path):
        write_file(path, "# Log\n\n## Entries\n")
    content = read_file(path).rstrip()
    if role in {"reporter", "tester"}:
        updated = upsert_role_log_entry(content, work_item_id, entry)
        write_file(path, updated)
        return
    content = content + "\n\n" + entry + "\n"
    write_file(path, content)


def parse_status_paths(status_lines: List[str]) -> List[str]:
    paths: List[str] = []
    for line in status_lines:
        if not line.strip():
            continue
        entry = line[3:] if len(line) > 3 else ""
        if "->" in entry:
            parts = entry.split("->")
            paths.extend(part.strip() for part in parts if part.strip())
        else:
            paths.append(entry.strip())
    return paths


def get_status_paths(path: str) -> List[str]:
    result = subprocess.run(
        ["git", "status", "--porcelain"],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        cwd=path,
    )
    if result.returncode != 0:
        die(f"pc-feature: failed to read git status for {path}\n{result.stderr}")
    lines = result.stdout.splitlines()
    return parse_status_paths(lines)


def worktree_is_dirty(path: str) -> bool:
    return bool(get_status_paths(path))


def filter_ignored_paths(paths: List[str]) -> List[str]:
    filtered: List[str] = []
    for entry in paths:
        if entry in IGNORED_PATH_FILES:
            continue
        if any(entry.startswith(prefix) for prefix in IGNORED_PATH_PREFIXES):
            continue
        filtered.append(entry)
    return filtered


def final_commit_allow_paths() -> List[str]:
    # Runtime artifacts should not block pc-commit guard rails.
    prefixes = [prefix.rstrip("/") for prefix in IGNORED_PATH_PREFIXES if prefix]
    return sorted(set(prefixes + list(IGNORED_PATH_FILES)))


def unstage_ephemeral_paths(root: str) -> None:
    allow_paths = final_commit_allow_paths()
    if not allow_paths:
        return
    subprocess.run(
        ["git", "reset", "--"] + allow_paths,
        check=False,
        cwd=root,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )


def role_log_paths(feature_dir: str) -> List[str]:
    return list(worktree_role_paths(feature_dir).values())


def global_log_paths() -> List[str]:
    return [os.path.join("docs", "03-logs", name) for name in GLOBAL_LOG_FILES]


def reset_role_logs_to_head(worktree_path: str, feature_dir: str) -> None:
    paths = role_log_paths(feature_dir)
    if not paths:
        return
    cmd = ["git", "checkout", "--"] + paths
    subprocess.run(cmd, check=False, cwd=worktree_path)


def reset_global_logs_to_head(worktree_path: str) -> None:
    paths = global_log_paths()
    if not paths:
        return
    cmd = ["git", "checkout", "--"] + paths
    subprocess.run(cmd, check=False, cwd=worktree_path)


def reset_dev_tasks_if_dirty(worktree_path: str, dev_tasks_path: str) -> None:
    paths = get_status_paths(worktree_path)
    if dev_tasks_path not in paths:
        return
    subprocess.run(
        ["git", "checkout", "--", dev_tasks_path], check=False, cwd=worktree_path
    )


def check_allowed_tests_exist(
    allowed_tests: List[str], worktree_path: str
) -> List[str]:
    if not allowed_tests:
        return []
    cmd = ["tools/pc-allowed-tests-check"]
    for entry in allowed_tests:
        cmd.extend(["--cmd", entry])
    result = subprocess.run(
        cmd,
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        cwd=worktree_path,
    )
    missing = []
    if result.stdout:
        missing.extend(
            line.strip() for line in result.stdout.splitlines() if line.strip()
        )
    if result.stderr:
        missing.extend(
            line.strip() for line in result.stderr.splitlines() if line.strip()
        )
    return missing if result.returncode != 0 else []


def commit_paths(worktree_path: str, ref: str = "HEAD") -> List[str]:
    result = subprocess.run(
        ["git", "show", "--name-only", "--pretty=format:", ref],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        cwd=worktree_path,
    )
    if result.returncode != 0:
        die(f"pc-feature: failed to read commit paths\n{result.stderr}")
    return [line.strip() for line in result.stdout.splitlines() if line.strip()]


def process_docs_changed(paths: List[str]) -> bool:
    for path in paths:
        if path in PROCESS_DOC_FILES:
            return True
        if any(path.startswith(prefix) for prefix in PROCESS_DOC_PREFIXES):
            return True
    return False


def cleanup_dirty_role_logs(worktree_path: str, feature_dir: str) -> None:
    role_paths = role_log_paths(feature_dir)
    if not role_paths:
        return
    dirty = [path for path in get_status_paths(worktree_path) if path in role_paths]
    if not dirty:
        return
    for path in dirty:
        result = subprocess.run(
            ["git", "ls-files", "--error-unmatch", path],
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            cwd=worktree_path,
        )
        if result.returncode == 0:
            subprocess.run(
                ["git", "checkout", "--", path], check=False, cwd=worktree_path
            )
        else:
            full_path = os.path.join(worktree_path, path)
            if os.path.exists(full_path):
                os.remove(full_path)


def cleanup_dirty_global_logs(worktree_path: str) -> None:
    log_paths = global_log_paths()
    if not log_paths:
        return
    dirty = [path for path in get_status_paths(worktree_path) if path in log_paths]
    if not dirty:
        return
    for path in dirty:
        result = subprocess.run(
            ["git", "ls-files", "--error-unmatch", path],
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            cwd=worktree_path,
        )
        if result.returncode == 0:
            subprocess.run(
                ["git", "checkout", "--", path], check=False, cwd=worktree_path
            )
        else:
            full_path = os.path.join(worktree_path, path)
            if os.path.exists(full_path):
                os.remove(full_path)


def restore_dirty_paths(worktree_path: str, paths: List[str]) -> None:
    for path in sorted(set(paths)):
        if not path:
            continue
        result = subprocess.run(
            ["git", "ls-files", "--error-unmatch", path],
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            cwd=worktree_path,
        )
        if result.returncode == 0:
            subprocess.run(
                ["git", "checkout", "--", path],
                check=False,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                cwd=worktree_path,
            )
            continue
        full_path = os.path.join(worktree_path, path)
        if os.path.isdir(full_path):
            shutil.rmtree(full_path, ignore_errors=True)
        elif os.path.exists(full_path):
            os.remove(full_path)


def recreate_worktree(root: str, path: str, branch: str) -> None:
    result = subprocess.run(
        ["git", "worktree", "remove", "--force", path],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        cwd=root,
    )
    if result.returncode != 0:
        die(f"pc-feature: failed to remove worktree at {path}\n{result.stderr}")
    if not git_branch_exists(root, branch):
        die(f"pc-feature: expected branch {branch} to exist for worktree recreate")
    result = subprocess.run(
        ["git", "worktree", "add", path, branch],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        cwd=root,
    )
    if result.returncode != 0:
        die(f"pc-feature: failed to recreate worktree for {branch}\n{result.stderr}")


def ensure_clean_worktree(
    root: str, worktree_path: str, branch: str, label: str
) -> None:
    paths = filter_ignored_paths(get_status_paths(worktree_path))
    if not paths:
        return
    recreate_worktree(root, worktree_path, branch)
    paths = filter_ignored_paths(get_status_paths(worktree_path))
    if paths:
        die(
            f"pc-feature: {label} worktree still dirty after recreate: "
            + ", ".join(sorted(paths))
        )


def remove_worktree(root: str, path: str, branch: str) -> None:
    result = subprocess.run(
        ["git", "worktree", "list", "--porcelain"],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        cwd=root,
    )
    if result.returncode != 0:
        die(f"pc-feature: failed to list worktrees\n{result.stderr}")
    worktrees = set()
    current_path = None
    for line in result.stdout.splitlines():
        if line.startswith("worktree "):
            current_path = line.split(" ", 1)[1].strip()
            worktrees.add(current_path)
    if os.path.exists(path) and path not in worktrees:
        die(f"pc-feature: existing path is not a git worktree: {path}")
    if path in worktrees:
        subprocess.run(
            ["git", "worktree", "remove", "--force", path],
            check=False,
            cwd=root,
        )
    if branch != "main":
        subprocess.run(["git", "branch", "-D", branch], check=False, cwd=root)


def format_role_changes(role: str, worktree_path: str, feature_dir: str) -> None:
    paths = get_status_paths(worktree_path)
    if not paths:
        return
    role_paths = worktree_role_paths(feature_dir)
    dev_tasks_path = os.path.join(feature_dir, "dev-tasks.md")
    if role == "patcher":
        blocked = set(role_paths.values())
        blocked.add(dev_tasks_path)
        paths = [path for path in paths if path not in blocked]
    else:
        allowed = role_paths.get(role)
        allowed_set = {allowed} if allowed else set()
        if role == "planner":
            allowed_set.add(dev_tasks_path)
        paths = [path for path in paths if path in allowed_set]
    if not paths:
        return
    if shutil.which("pre-commit") is None:
        print("pc-feature: pre-commit not found; skipping role formatting")
        return
    cmd = ["tools/offload-proxy/pp", "pre-commit", "run", "--files"] + paths
    env = os.environ.copy()
    env["SKIP"] = PRECOMMIT_FORMAT_SKIP
    subprocess.run(cmd, check=False, cwd=worktree_path, env=env)


def enforce_role_scope(
    worktree_path: str,
    role: str,
    feature_dir: str,
) -> None:
    paths = get_status_paths(worktree_path)
    paths = filter_ignored_paths(paths)
    if not paths:
        return
    role_paths = worktree_role_paths(feature_dir)
    global_logs = set(global_log_paths())
    dev_tasks_path = os.path.join(feature_dir, "dev-tasks.md")
    allowed = set()
    forbidden = set(role_paths.values())
    forbidden.add(dev_tasks_path)
    if role in role_paths:
        allowed.add(role_paths[role])
    if role == "planner":
        allowed.add(dev_tasks_path)
    if role == "patcher":
        illegal_globals = [path for path in paths if path in global_logs]
        if illegal_globals:
            die(
                "pc-feature: global logs are read-only until gates pass: "
                + ", ".join(sorted(illegal_globals))
            )
        illegal = [
            path for path in paths if role_scoped_path_forbidden_for_patcher(path)
        ]
        if illegal:
            die(
                "pc-feature: patcher edited role-scoped files: "
                + ", ".join(sorted(illegal))
            )
        return
    illegal_globals = [path for path in paths if path in global_logs]
    if illegal_globals:
        die(
            "pc-feature: global logs are read-only until gates pass: "
            + ", ".join(sorted(illegal_globals))
        )
    illegal = [path for path in paths if path not in allowed]
    if illegal:
        die(
            f"pc-feature: {role} edited out-of-scope files: "
            + ", ".join(sorted(illegal))
        )


def commit_worktree_changes(
    worktree_path: str, role: str, work_item_id: str, feature_dir: str
) -> None:
    paths = get_status_paths(worktree_path)
    paths = filter_ignored_paths(paths)
    if not paths:
        return
    if role == "patcher":
        illegal = [
            path for path in paths if role_scoped_path_forbidden_for_patcher(path)
        ]
        if illegal:
            die(
                "pc-feature: patcher edited role-scoped files: "
                + ", ".join(sorted(illegal))
            )
    add_cmd = ["git", "add", "--"] + paths
    result = subprocess.run(add_cmd, check=False, cwd=worktree_path)
    if result.returncode != 0:
        die(f"pc-feature: failed to stage changes for {role}")
    message = f"{role}: updates for {work_item_id}"
    commit_cmd = ["git", "commit", "--no-verify", "-m", message]
    result = subprocess.run(
        commit_cmd,
        check=False,
        cwd=worktree_path,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if result.returncode != 0:
        detail = ""
        if result.stdout:
            detail += result.stdout
        if result.stderr:
            detail += result.stderr
        die(f"pc-feature: failed to commit changes for {role}\n{detail}")


def commit_role_step(
    root: str,
    worktree_path: str,
    branch: str,
    role: str,
    work_item_id: str,
    feature_dir: str,
    *,
    allow_empty: bool = False,
) -> bool:
    paths = filter_ignored_paths(get_status_paths(worktree_path))
    if not paths:
        return False
    format_role_changes(role, worktree_path, feature_dir)
    if role == "patcher":
        reset_role_logs_to_head(worktree_path, feature_dir)
        reset_global_logs_to_head(worktree_path)
    elif role in {"tester", "reporter", "plan-reviewer"}:
        reset_global_logs_to_head(worktree_path)
    enforce_role_scope(worktree_path, role, feature_dir)
    paths = filter_ignored_paths(get_status_paths(worktree_path))
    if not paths and not allow_empty:
        return False
    commit_worktree_changes(worktree_path, role, work_item_id, feature_dir)
    ensure_clean_worktree(root, worktree_path, branch, role)
    return True


def branch_ahead_count(root: str, base_ref: str, branch: str) -> int:
    result = subprocess.run(
        ["git", "rev-list", "--count", f"{base_ref}..{branch}"],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        cwd=root,
    )
    if result.returncode != 0:
        die(f"pc-feature: failed to compare {branch} to {base_ref}\n{result.stderr}")
    return int(result.stdout.strip() or "0")


def branch_behind_count(root: str, branch: str, base_ref: str) -> int:
    result = subprocess.run(
        ["git", "rev-list", "--count", f"{branch}..{base_ref}"],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        cwd=root,
    )
    if result.returncode != 0:
        die(
            f"pc-feature: failed to compare {branch} behind {base_ref}\n{result.stderr}"
        )
    return int(result.stdout.strip() or "0")


def apply_branch_diff(
    root: str, base_ref: str, branch: str, include_paths: Optional[List[str]] = None
) -> bool:
    if include_paths is not None and not include_paths:
        return True
    cmd: List[str] = ["git", "diff", "--binary", f"{base_ref}..{branch}"]
    if include_paths:
        cmd.extend(["--", *include_paths])
    result = subprocess.run(
        cmd,
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=False,
        cwd=root,
    )
    if result.returncode != 0:
        die(
            f"pc-feature: failed to generate diff for {branch}\n{result.stderr.decode('utf-8', errors='replace')}"
        )
    patch = result.stdout
    if not patch:
        return True
    apply_result = subprocess.run(
        ["git", "apply", "--3way", "--whitespace=nowarn"],
        check=False,
        input=patch,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        cwd=root,
    )
    if apply_result.returncode != 0:
        return False
    return True


def branch_diff_paths(root: str, base_ref: str, branch: str) -> List[str]:
    result = subprocess.run(
        ["git", "diff", "--name-only", f"{base_ref}..{branch}"],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        cwd=root,
    )
    if result.returncode != 0:
        die(f"pc-feature: failed to list changed paths for {branch}\n{result.stderr}")
    return [line.strip() for line in result.stdout.splitlines() if line.strip()]


def collect_branch_merge_paths(
    root: str,
    base_ref: str,
    branch: str,
    dev_tasks_path: str,
    feature_dir: str,
) -> List[str]:
    changed = branch_diff_paths(root, base_ref, branch)
    global_logs = set(global_log_paths())
    merged: List[str] = []
    for path in changed:
        if path in global_logs:
            continue
        if path.startswith("logs/"):
            continue
        if path in IGNORED_PATH_FILES:
            continue
        if any(path.startswith(prefix) for prefix in IGNORED_PATH_PREFIXES):
            continue
        merged.append(path)
    return sorted(set(merged))


def cleanup_worktrees(
    root: str, path: Optional[str] = None, branch: Optional[str] = None
) -> None:
    if not path or not branch:
        return
    remove_worktree(root, path, branch)


def parse_outcome(text: str) -> str:
    match = re.search(r"Outcome:\s*(PASS|FAIL|NEEDS REPLAN)", text, re.IGNORECASE)
    if not match:
        return "FAIL"
    return match.group(1).upper()


def missing_failure_context_fields(text: str) -> List[str]:
    if parse_outcome(text) != "FAIL":
        return []
    required = ("File/Path", "Check", "Evidence", "Expected fix")
    missing: List[str] = []
    for field in required:
        pattern = rf"\b{re.escape(field)}\s*:"
        if not re.search(pattern, text, re.IGNORECASE):
            missing.append(field)
    return missing


def with_failure_context_guard(text: str, *, role: str) -> str:
    missing = missing_failure_context_fields(text)
    if not missing:
        return text
    guard = (
        f"Failure context guard ({role}): missing required fields: "
        + ", ".join(missing)
        + ".\n"
        "Expected fix: include File/Path, Check, Evidence, and Expected fix entries."
    )
    return text.rstrip() + "\n" + guard + "\n"


def summarize_feedback(feedback: str, *, max_chars: int = 420) -> str:
    compact = " ".join((feedback or "").split())
    if len(compact) <= max_chars:
        return compact
    return compact[: max_chars - 3].rstrip() + "..."


def role_scoped_path_forbidden_for_patcher(path: str) -> bool:
    normalized = normalize_repo_rel(path)
    if normalized.startswith("docs/03-logs/"):
        return True
    if not normalized.startswith("docs/02-features/"):
        return False
    name = os.path.basename(normalized)
    return name in ROLE_SCOPED_FILENAMES


def match_plan_contract_section(line: str) -> Optional[str]:
    for section, pattern in PLAN_CONTRACT_SECTION_PATTERNS.items():
        if pattern.match(line):
            return section
    return None


def extract_plan_contract_sections(plan_text: str) -> Dict[str, str]:
    buckets: Dict[str, List[str]] = {section: [] for section in PLAN_CONTRACT_SECTIONS}
    active_section: Optional[str] = None
    for line in plan_text.splitlines():
        matched_section = match_plan_contract_section(line.strip())
        if matched_section:
            active_section = matched_section
            continue
        if active_section:
            buckets[active_section].append(line)
    return {section: "\n".join(lines).strip() for section, lines in buckets.items()}


def plan_uses_contract_sections(plan_text: str) -> bool:
    return any(
        match_plan_contract_section(line.strip()) for line in plan_text.splitlines()
    )


def missing_plan_contract_sections(plan_text: str) -> List[str]:
    sections = extract_plan_contract_sections(plan_text)
    return [section for section in PLAN_CONTRACT_SECTIONS if not sections.get(section)]


def plan_policy_violations(plan_text: str) -> List[str]:
    violations: List[str] = []
    lowered = plan_text.lower()
    sections = extract_plan_contract_sections(plan_text)
    files_scope_text = sections.get(PLAN_CONTRACT_FILES_SECTION, "").strip()
    path_scan_targets: List[str] = [plan_text]
    if files_scope_text:
        path_scan_targets.insert(0, files_scope_text)
    path_patterns = (
        r"docs/02-features/[^\s`]+/dev-tasks\.md",
        r"docs/02-features/[^\s`]+/planner-log\.md",
        r"docs/02-features/[^\s`]+/plan-reviewer-log\.md",
        r"docs/02-features/[^\s`]+/reporter-log\.md",
        r"docs/02-features/[^\s`]+/validation-log\.md",
        r"docs/03-logs/[^\s`]+",
    )
    for path_scan_text in path_scan_targets:
        for pattern in path_patterns:
            for match in re.findall(pattern, path_scan_text, flags=re.IGNORECASE):
                entry = f"forbidden path in plan: {match}"
                if entry not in violations:
                    violations.append(entry)
    command_patterns = (
        (r"\bmake\s+feature\b", "forbidden command in plan: make feature"),
        (r"\btools/pc-feature\b", "forbidden command in plan: tools/pc-feature"),
        (r"\bpc-feature\b", "forbidden command in plan: pc-feature"),
    )
    for pattern, message in command_patterns:
        if re.search(pattern, lowered, re.IGNORECASE):
            violations.append(message)
    return violations


def plan_policy_block_feedback(issues: List[str]) -> str:
    lines = [
        "Decision: Block",
        "Reasons:",
        "- Plan violates orchestrator scope policy.",
        "Required changes:",
    ]
    for issue in issues:
        lines.append(f"- {issue}")
    lines.extend(
        [
            "Optional suggestions:",
            "- Keep plan files limited to implementation targets; role/global logs are automation-owned.",
        ]
    )
    return "\n".join(lines)


def parse_plan_reviewer_decision(text: str) -> str:
    match = re.search(r"Decision:\s*(Approve|Block)\b", text, re.IGNORECASE)
    if not match:
        return "BLOCK"
    return match.group(1).upper()


def parse_feedback_plan_decision(text: str) -> str:
    match = re.search(
        r"Decision:\s*(PLAN_STILL_VALID|REVISE_PLAN|REVISED PLAN REQUIRED|PLAN STILL VALID)\b",
        text,
        re.IGNORECASE,
    )
    if not match:
        return "REVISE_PLAN"
    decision = match.group(1).upper().replace(" ", "_")
    if decision in {"REVISED_PLAN_REQUIRED", "REVISE_PLAN"}:
        return "REVISE_PLAN"
    return "PLAN_STILL_VALID"


def parse_feedback_revised_plan(text: str) -> str:
    match = re.search(r"Revised Plan:\s*\n(.+)$", text, re.IGNORECASE | re.DOTALL)
    if not match:
        return ""
    return match.group(1).strip()


def parse_feedback_rationale(text: str) -> str:
    match = re.search(r"Rationale:\s*(.+)$", text, re.IGNORECASE | re.MULTILINE)
    if not match:
        return ""
    return match.group(1).strip()


def revised_plan_quality_issues(
    revised_plan: str,
    *,
    previous_plan: str = "",
) -> List[str]:
    issues: List[str] = []
    lowered = revised_plan.lower()
    cross_ref_patterns = (
        r"\boriginal plan\b",
        r"\bcurrent plan\b",
        r"\bfrom the current plan\b",
        r"\bfrom the original plan\b",
        r"\bproceed with original\b",
    )
    if any(re.search(pattern, lowered) for pattern in cross_ref_patterns):
        issues.append(
            "revised plan must be self-contained and must not reference the original/current plan"
        )
    previous_uses_contract = plan_uses_contract_sections(previous_plan)
    revised_uses_contract = plan_uses_contract_sections(revised_plan)
    if previous_uses_contract or revised_uses_contract:
        missing_sections = missing_plan_contract_sections(revised_plan)
        if missing_sections:
            issues.append(
                "revised plan missing required sections: " + ", ".join(missing_sections)
            )
    if len([line for line in revised_plan.splitlines() if line.strip()]) < 1:
        issues.append("revised plan is empty")
    return issues


def merge_revised_plan(current_plan: str, revised_plan: str) -> str:
    revised_stripped = revised_plan.strip()
    if not revised_stripped:
        return current_plan
    # Revised plans always replace previous content to prevent stale policy
    # violations from remaining in the active plan after feedback loops.
    return revised_stripped


def anti_hardcode_coverage_issues(plan: str, tdd_plan: str) -> List[str]:
    text = f"{plan}\n{tdd_plan}".lower()
    issues: List[str] = []
    fixture_ok = "fixture" in text and (
        ">=2" in text
        or "at least 2" in text
        or "at least two" in text
        or "two fixtures" in text
        or "2 fixtures" in text
    )
    if not fixture_ok:
        issues.append("fixture coverage is missing (>=2 fixtures per critical path)")
    if "seed" not in text:
        issues.append("deterministic seed strategy is missing")
    if "invariant" not in text:
        issues.append("invariant checks are missing")
    if "contract" not in text:
        issues.append("contract boundary coverage is missing")
    return issues


def anti_hardcode_block_feedback(issues: List[str]) -> str:
    lines = [
        "Decision: Block",
        "Reasons:",
        "- Anti-hardcode requirements are incomplete.",
    ]
    lines.append("Required changes:")
    for issue in issues:
        lines.append(f"- {issue}")
    lines.append("Optional suggestions:")
    lines.append("- Keep the plan concise and scoped.")
    return "\n".join(lines)


