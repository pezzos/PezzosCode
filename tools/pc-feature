#!/usr/bin/env python3
import os
import re
import subprocess
import sys
from dataclasses import dataclass, field
from typing import List, Optional, Tuple


@dataclass
class Task:
    task_id: str
    title: str
    acceptance: Optional[str] = None
    estimate: Optional[str] = None
    bullets: List[str] = field(default_factory=list)


def die(message: str) -> None:
    print(message, file=sys.stderr)
    sys.exit(1)


def read_file(path: str) -> str:
    with open(path, "r", encoding="utf-8") as handle:
        return handle.read()


def write_file(path: str, content: str) -> None:
    with open(path, "w", encoding="utf-8") as handle:
        handle.write(content)


def parse_args(argv: List[str]) -> Tuple[str, bool]:
    feature_id = ""
    manual = False
    for arg in argv:
        if arg.startswith("F="):
            feature_id = arg[len("F=") :].strip()
        elif arg.startswith("MANUAL="):
            manual = arg.split("=", 1)[1].strip() == "1"
        else:
            die(f"pc-feature: unknown argument '{arg}'")
    if not feature_id:
        die("pc-feature: missing required F=<feature-id>")
    return feature_id, manual


def list_feature_dirs(root: str) -> List[Tuple[int, str, str]]:
    features = []
    for entry in os.listdir(root):
        path = os.path.join(root, entry)
        if not os.path.isdir(path):
            continue
        if entry == "feature-template":
            continue
        match = re.match(r"^(\d+)-", entry)
        if not match:
            continue
        features.append((int(match.group(1)), entry, path))
    return sorted(features, key=lambda item: item[0])


def resolve_feature_dir(root: str, feature_id: str) -> str:
    feature_id = feature_id.strip()
    for _, name, path in list_feature_dirs(root):
        if name.startswith(f"{feature_id}-"):
            return path
    die(f"pc-feature: feature folder not found for id {feature_id}")


def parse_feature_name(dev_tasks_path: str) -> str:
    content = read_file(dev_tasks_path)
    for line in content.splitlines():
        match = re.search(r"\*\*Feature:\*\*\s*(.+)$", line)
        if match:
            return match.group(1).strip()
    return "Unknown feature"


def parse_tasks(dev_tasks_path: str) -> List[Task]:
    task_re = re.compile(r"^\s*-\s*\[ \]\s*\*\*TASK-(\d+):\s*(.+?)\*\*\s*$")
    tasks: List[Task] = []
    current: Optional[Task] = None
    for line in read_file(dev_tasks_path).splitlines():
        task_match = task_re.match(line)
        if task_match:
            if current:
                tasks.append(current)
            current = Task(
                task_id=task_match.group(1), title=task_match.group(2).strip()
            )
            continue
        if current is None:
            continue
        bullet_match = re.match(r"^\s{2,}-\s+(.*)$", line)
        if not bullet_match:
            continue
        bullet = bullet_match.group(1).strip()
        lowered = bullet.lower()
        if lowered.startswith("**acceptance:**") or lowered.startswith("acceptance:"):
            current.acceptance = bullet.split(":", 1)[1].strip().strip("*")
            continue
        if lowered.startswith("**estimate:**") or lowered.startswith("estimate:"):
            current.estimate = bullet.split(":", 1)[1].strip().strip("*")
            continue
        if lowered.startswith("**dependencies:**") or lowered.startswith(
            "dependencies:"
        ):
            continue
        current.bullets.append(bullet)
    if current:
        tasks.append(current)
    return tasks


def parse_prd_feature(prd_path: str, feature_name: str) -> Tuple[Optional[str], str]:
    feature_lower = feature_name.lower()
    for line in read_file(prd_path).splitlines():
        match = re.match(r"^- \[ \] (.+?) \((P\d)\):", line)
        if match and match.group(1).strip().lower() == feature_lower:
            return match.group(2), "Process Features"
    for line in read_file(prd_path).splitlines():
        match = re.match(r"^\|\s*(P\d)\s*\|\s*(.+?)\s*\|", line)
        if match and match.group(2).strip().lower() == feature_lower:
            return match.group(1), "Prioritized Feature List"
    return None, "PRD"


def classify_task(title: str) -> str:
    lowered = title.lower()
    if "test" in lowered:
        return "Testing"
    if "doc" in lowered or "define" in lowered or "spec" in lowered:
        return "Docs"
    return "Feature"


def plan_scope(task_type: str) -> str:
    if task_type == "Docs":
        return "1 feature folder"
    return "1 mini change"


def change_budget(task_type: str) -> Tuple[int, int, int]:
    if task_type == "Docs":
        return 4, 0, 180
    if task_type == "Testing":
        return 4, 1, 220
    return 6, 1, 300


def build_ticket(
    task: Task,
    feature_id: str,
    feature_name: str,
    feature_dir: str,
    prd_priority: Optional[str],
    prd_section: str,
) -> str:
    task_type = classify_task(task.title)
    scope_choice = plan_scope(task_type)
    max_files, max_new_modules, max_lines = change_budget(task_type)
    prd_ref = f"{prd_priority} - {feature_name}" if prd_priority else feature_name
    acceptance_text = task.acceptance or "TODO: define acceptance criteria"
    estimate_text = task.estimate or "TODO"
    bullets = task.bullets or ["(none)"]
    bullets_block = "\n".join(f"- {item}" for item in bullets)
    tests_line = (
        "None (docs-only)."
        if task_type == "Docs"
        else "Targeted tests from the feature test plan."
    )
    evidence_hints = []
    if task_type == "Docs":
        evidence_hints = [
            f"`{feature_dir}/feature-spec.md` (Summary, Requirements)",
            f"`{feature_dir}/tech-design.md` (Architecture, Constraints)",
        ]
    elif task_type == "Testing":
        evidence_hints = [
            f"`{feature_dir}/test-plan.md` (Test Strategy, Cases)",
        ]
    else:
        evidence_hints = [
            f"`{feature_dir}/tech-design.md` (Architecture, Constraints)",
            f"`{feature_dir}/test-plan.md` (Test Strategy, Cases)",
        ]
    evidence_block = "\n".join(f"- {item}" for item in evidence_hints)
    feature_spec = f"{feature_dir}/feature-spec.md"
    tech_design = f"{feature_dir}/tech-design.md"
    test_plan = f"{feature_dir}/test-plan.md"

    return f"""---
id: {task.task_id}
title: "{task.title}"
prd_ref: "{prd_ref}"
status: "To Do"
status_timestamp: ""
complexity: "simple"
approval: ""
