def collect_dirty_snapshot(worktree_path: str) -> Dict[str, str]:
    snapshot: Dict[str, str] = {}
    paths = sorted(filter_ignored_paths(get_status_paths(worktree_path)))
    for rel_path in paths:
        absolute = os.path.join(worktree_path, rel_path)
        if not os.path.exists(absolute):
            snapshot[rel_path] = "<missing>"
            continue
        if os.path.isdir(absolute):
            snapshot[rel_path] = "<dir>"
            continue
        try:
            with open(absolute, "rb") as handle:
                digest = hashlib.sha256(handle.read()).hexdigest()
        except OSError:
            snapshot[rel_path] = "<unreadable>"
            continue
        snapshot[rel_path] = digest
    return snapshot


def dirty_delta_paths(before: Dict[str, str], after: Dict[str, str]) -> List[str]:
    delta: List[str] = []
    for path, digest in after.items():
        if path not in before:
            delta.append(path)
            continue
        if before[path] != digest:
            delta.append(path)
    return sorted(set(delta))


def ensure_plan_reviewer_read_only(
    worktree_path: str,
    *,
    baseline_snapshot: Optional[Dict[str, str]] = None,
) -> Tuple[List[str], List[str]]:
    before = baseline_snapshot or {}
    after = collect_dirty_snapshot(worktree_path)
    delta = (
        dirty_delta_paths(before, after)
        if baseline_snapshot is not None
        else sorted(after.keys())
    )
    preexisting = sorted(before.keys())
    return preexisting, delta


def parse_commit_message(section: str) -> str:
    for line in section.splitlines():
        stripped = line.strip()
        if stripped.startswith(("-", "*")):
            stripped = stripped[1:].strip()
        if stripped.lower().startswith("commit message:"):
            return stripped.split(":", 1)[1].strip()
    return ""


def extract_field(text: str, label: str) -> str:
    match = re.search(rf"^{label}:\s*(.+)$", text, re.MULTILINE | re.IGNORECASE)
    return match.group(1).strip() if match else ""


def run_command(cmd: List[str], cwd: Optional[str] = None) -> int:
    result = subprocess.run(cmd, check=False, cwd=cwd)
    return result.returncode


def run_command_with_step_log(
    cmd: List[str],
    metadata: "pc_runner.RunMetadata",
    *,
    step: str,
    root: Path,
    label: str,
    cwd: Optional[str] = None,
) -> int:
    command_text = " ".join(shlex.quote(part) for part in cmd)
    pc_runner.log_message(metadata, step, f"start {label}: {command_text}", root=root)
    exit_code = run_command(cmd, cwd=cwd)
    pc_runner.log_message(
        metadata, step, f"complete {label}: exit={exit_code}", root=root
    )
    return exit_code


def run_command_with_step_log_capture(
    cmd: List[str],
    metadata: "pc_runner.RunMetadata",
    *,
    step: str,
    root: Path,
    label: str,
    cwd: Optional[str] = None,
) -> Tuple[int, str]:
    if cmd:
        executable = cmd[0]
        if os.path.sep in executable:
            executable_path = Path(executable)
            if not executable_path.is_absolute():
                base_dir = Path(cwd) if cwd else Path.cwd()
                executable_path = base_dir / executable
            if not executable_path.exists():
                exit_code = run_command_with_step_log(
                    cmd,
                    metadata,
                    step=step,
                    root=root,
                    label=label,
                    cwd=cwd,
                )
                return exit_code, ""
        elif shutil.which(executable) is None:
            exit_code = run_command_with_step_log(
                cmd,
                metadata,
                step=step,
                root=root,
                label=label,
                cwd=cwd,
            )
            return exit_code, ""

    command_text = " ".join(shlex.quote(part) for part in cmd)
    pc_runner.log_message(metadata, step, f"start {label}: {command_text}", root=root)
    result = subprocess.run(
        cmd,
        check=False,
        cwd=cwd,
        capture_output=True,
        text=True,
    )
    if result.stdout:
        print(result.stdout, end="")
    if result.stderr:
        print(result.stderr, end="", file=sys.stderr)
    pc_runner.log_message(
        metadata, step, f"complete {label}: exit={result.returncode}", root=root
    )
    return result.returncode, f"{result.stdout}{result.stderr}"


def extract_test_discovery_summary(output: str) -> Optional[str]:
    for pattern in (
        r"Ran\s+\d+\s+tests?",
        r"collected\s+\d+\s+items?",
    ):
        match = re.search(pattern, output, re.IGNORECASE)
        if match:
            return match.group(0)
    return None


def prompt_yes_no(message: str) -> bool:
    reply = input(f"{message} ").strip().lower()
    return reply in {"y", "yes"}


def parse_bool_env(name: str) -> Optional[bool]:
    raw = os.environ.get(name)
    if raw is None:
        return None
    value = raw.strip().lower()
    if value in {"1", "true", "yes", "y", "on"}:
        return True
    if value in {"0", "false", "no", "n", "off"}:
        return False
    return None


def parse_resume_mode() -> str:
    raw = os.environ.get(RESUME_MODE_ENV, RESUME_MODE_AUTO)
    value = raw.strip().lower()
    if not value:
        return RESUME_MODE_AUTO
    if value not in RESUME_MODE_VALUES:
        die(
            f"pc-feature: invalid {RESUME_MODE_ENV} value '{raw}'; "
            f"expected one of: {', '.join(sorted(RESUME_MODE_VALUES))}"
        )
    return value


def classify_resume_dirty_paths(
    dirty_paths: List[str], feature_dir: str, dev_tasks_path: str
) -> Tuple[List[str], List[str]]:
    filtered = sorted(filter_ignored_paths(dirty_paths))
    allowed = {dev_tasks_path}
    allowed.update(role_log_paths(feature_dir))
    allowed.update(global_log_paths())
    runtime_dirty = sorted(path for path in filtered if path in allowed)
    unexpected_dirty = sorted(path for path in filtered if path not in allowed)
    return runtime_dirty, unexpected_dirty


def checkpoint_resume_state(
    worktree_path: str,
    work_item_id: Optional[str],
    *,
    feature_slug: str,
) -> List[str]:
    dirty = sorted(filter_ignored_paths(get_status_paths(worktree_path)))
    if not dirty:
        return []
    add_result = subprocess.run(
        ["git", "add", "--"] + dirty,
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        cwd=worktree_path,
    )
    if add_result.returncode != 0:
        die(
            "pc-feature: failed to stage startup checkpoint changes\n"
            + (add_result.stderr or add_result.stdout)
        )
    if work_item_id:
        commit_message = f"orchestrator: startup checkpoint for {work_item_id}"
    else:
        commit_message = f"orchestrator: startup checkpoint for feature {feature_slug}"
    commit_result = subprocess.run(
        ["git", "commit", "--no-verify", "-m", commit_message],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        cwd=worktree_path,
    )
    if commit_result.returncode == 0:
        return dirty
    detail = (commit_result.stdout or "") + (commit_result.stderr or "")
    if "nothing to commit" in detail.lower():
        return []
    die(
        "pc-feature: failed to checkpoint startup resume state\n"
        + (detail or "(no git output)")
    )
    return []


def checkpoint_resume_dev_tasks(
    worktree_path: str, work_item_id: str, dev_tasks_path: str
) -> bool:
    dirty = sorted(filter_ignored_paths(get_status_paths(worktree_path)))
    if dev_tasks_path not in dirty:
        return False
    checkpointed = checkpoint_resume_state(
        worktree_path,
        work_item_id,
        feature_slug="resume",
    )
    return dev_tasks_path in checkpointed


def active_other_feature_worktrees(
    root: str, feature_slug: str, patcher_path: str
) -> List[str]:
    current_token = normalize_feature_token(feature_slug)
    current_path_abs = os.path.abspath(patcher_path)
    blockers: List[str] = []
    for worktree_path, branch in list_worktree_entries(root):
        if not branch:
            continue
        feature_token = patcher_branch_feature_token(branch)
        if feature_token is None:
            continue
        if os.path.abspath(worktree_path) == current_path_abs:
            continue
        if feature_token == current_token:
            continue
        dirty = bool(filter_ignored_paths(get_status_paths(worktree_path)))
        ahead = branch_ahead_count(root, "refs/heads/main", branch) > 0
        if not dirty and not ahead:
            continue
        reasons: List[str] = []
        if dirty:
            reasons.append("dirty")
        if ahead:
            reasons.append("ahead-of-main")
        blockers.append(f"{worktree_path} ({branch}; reasons: {', '.join(reasons)})")
    return blockers


def enforce_single_active_feature(
    root: str, feature_slug: str, patcher_path: str
) -> None:
    blockers = active_other_feature_worktrees(root, feature_slug, patcher_path)
    if not blockers:
        return
    die(
        "pc-feature: another feature is already in progress; "
        "finish or clean it before starting this run: " + "; ".join(blockers)
    )


def approve_high_risk_interactive(risk_level: str, triggers: List[str]) -> bool:
    if risk_level != "HIGH":
        return True
    override = parse_bool_env("APPROVE_HIGH_RISK")
    if override is not None:
        return override
    trigger_text = ", ".join(triggers) if triggers else "(none)"
    print(f"pc-feature: high-risk triggers: {trigger_text}")
    if not sys.stdin.isatty():
        print(
            "pc-feature: non-interactive session; set APPROVE_HIGH_RISK=1 to continue.",
            file=sys.stderr,
