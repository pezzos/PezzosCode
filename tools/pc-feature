def entry_section_complete(content: str, work_item_id: str, section: str) -> bool:
    body = get_entry_section(content, work_item_id, section)
    if not body or "(pending)" in body:
        return False
    if section == "Preflight Report":
        lines = body.splitlines()
        risk_level = parse_field_value(lines, "Risk level")
        return bool(risk_level)
    if section == "Gates":
        return "make ci" in body and "PASS" in body
    if section == "Commit":
        return (
            "Commit message:" in body
            and len(body.split("Commit message:", 1)[1].strip()) > 0
        )
    return True


def parse_allowed_tests(section: str) -> List[str]:
    commands: List[str] = []
    for line in section.splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        if stripped.startswith(("-", "*")):
            stripped = stripped[1:].strip()
        if re.match(r"^\d+\.\s+", stripped):
            stripped = re.sub(r"^\d+\.\s+", "", stripped).strip()
        if "list exact commands" in stripped:
            continue
        if "(pending)" in stripped:
            continue
        normalized = normalize_allowed_test(stripped)
        if normalized:
            commands.append(normalized)
    return commands


def format_allowed_tests_body(commands: List[str]) -> str:
    unique: List[str] = []
    seen = set()
    for cmd in commands:
        if cmd in seen:
            continue
        seen.add(cmd)
        unique.append(cmd)
    return "\n".join(f"- `{cmd}`" for cmd in unique)


def sanitize_allowed_tests_response(response: str) -> str:
    parsed = parse_allowed_tests(response)
    return format_allowed_tests_body(parsed)


def normalize_allowed_test(raw: str) -> Optional[str]:
    text = raw.strip()
    if not text:
        return None
    if text.startswith("`") and text.endswith("`"):
        text = text[1:-1].strip()
    if "`" in text:
        return None
    try:
        parts = shlex.split(text)
    except ValueError:
        return None
    if not parts:
        return None
    if parts[0] == "tools/offload-proxy/pp":
        parts = parts[1:]
        if not parts:
            return None
    if parts[0] in {"pytest", "py.test"}:
        return shlex.join(parts)
    if len(parts) >= 3 and parts[0] in {"python", "python3"} and parts[1] == "-m":
        if parts[2] in {"unittest", "pytest"}:
            return shlex.join(parts)
    return None


def is_forbidden_test(cmd: str) -> bool:
    return bool(
        re.search(r"\bmake\s+feature\b", cmd, re.IGNORECASE)
        or re.search(r"\bpc-feature\b", cmd, re.IGNORECASE)
        or re.search(r"\btools/pc-feature\b", cmd, re.IGNORECASE)
        or re.search(r"\bmake\s+ci\b", cmd, re.IGNORECASE)
    )


def ensure_allowed_tests_section(content: str, work_item_id: str) -> str:
    lines = content.splitlines()
    start, end = find_entry_block(lines, work_item_id)
    entry_lines = lines[start:end]
    header = f"{SECTION_PREFIX}Allowed Tests"
    if any(line.strip() == header for line in entry_lines):
        return content
    insert_before = f"{SECTION_PREFIX}Files to Change + Change Budget"
    insert_idx = None
    for idx, line in enumerate(entry_lines):
        if line.strip() == insert_before:
            insert_idx = idx
            break
    block = [
        header,
        "",
        "- (list exact commands; do not include `make feature` or `pc-feature`)",
        "",
    ]
    if insert_idx is None:
        entry_lines.extend([""] + block)
    else:
        entry_lines = entry_lines[:insert_idx] + block + entry_lines[insert_idx:]
    return "\n".join(lines[:start] + entry_lines + lines[end:]) + "\n"


def extract_json_payload(raw: str) -> str:
    start = raw.find("{")
    end = raw.rfind("}")
    if start == -1 or end == -1 or end < start:
        return raw
    return raw[start : end + 1]


def parse_json_object_payload(raw: str) -> Optional[Dict[str, Any]]:
    payload = extract_json_payload(raw)
    try:
        parsed = json.loads(payload)
    except json.JSONDecodeError:
        return None
    if not isinstance(parsed, dict):
        return None
    return parsed


