    def emit_workflow_event(
        step: str,
        event: str,
        *,
        attempt: Optional[int] = None,
        outcome: str = "",
        reason: str = "",
        state: Optional[str] = None,
    ) -> None:
        clean_reason = " ".join(reason.strip().split())
        if len(clean_reason) > 220:
            clean_reason = clean_reason[:217] + "..."
        timestamp = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
        duration = None
        if workflow_tracking_enabled:
            payload = pc_runner.record_workflow_event(
                runner_metadata,
                step=step,
                event=event,
                attempt=attempt,
                outcome=outcome,
                reason=clean_reason,
                state=state,
                root=runner_root,
            )
            timestamp = str(payload.get("timestamp", timestamp))
            duration = payload.get("duration_ms")
        banner = f"{timestamp} [{work_item_id}]"
        if attempt is not None:
            banner += f"[attempt {attempt}]"
        banner += f" {step.upper()} {str(event).upper()}"
        if outcome:
            banner += f" outcome={outcome}"
        if clean_reason:
            banner += f" reason={clean_reason}"
        if isinstance(duration, int):
            banner += f" duration={duration / 1000:.2f}s"
        print(f"pc-feature: {banner}")

    pc_runner.log_message(
        runner_metadata, "feature", "start pc-feature", root=runner_root
    )
    pc_runner.log_message(
        runner_metadata,
