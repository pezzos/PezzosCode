def compacted_logs_dir() -> str:
    return COMPACTED_LOGS_DIR


def compacted_logs_dir_abs() -> str:
    base = compacted_logs_dir()
    if os.path.isabs(base):
        return os.path.abspath(base)
    return os.path.abspath(os.path.join(ROOT, base))


def compacted_log_output_paths() -> Dict[str, str]:
    return {
        key: os.path.join(compacted_logs_dir(), name)
        for key, name in COMPACTED_LOG_OUTPUT_NAMES.items()
    }


def is_compacted_logs_path(path: str) -> bool:
    normalized = normalize_repo_rel(path).lower().rstrip("/")
    compacted_root = normalize_repo_rel(compacted_logs_dir()).lower().rstrip("/")
    if normalized == compacted_root or normalized.startswith(compacted_root + "/"):
        return True
    abs_candidate = os.path.abspath(path).lower().rstrip(os.sep)
    compacted_abs = compacted_logs_dir_abs().lower().rstrip(os.sep)
    return abs_candidate == compacted_abs or abs_candidate.startswith(
        compacted_abs + os.sep
    )


def role_scoped_path_forbidden_for_patcher(path: str) -> bool:
    normalized = normalize_repo_rel(path)
    if is_compacted_logs_path(normalized):
        return False
    if normalized.startswith("docs/03-logs/"):
        return True
    if not normalized.startswith("docs/02-features/"):
        return False
    name = os.path.basename(normalized)
    return name in ROLE_SCOPED_FILENAMES


def match_plan_contract_section(line: str) -> Optional[str]:
    for section, pattern in PLAN_CONTRACT_SECTION_PATTERNS.items():
        if pattern.match(line):
            return section
    return None


def extract_plan_contract_sections(plan_text: str) -> Dict[str, str]:
    buckets: Dict[str, List[str]] = {section: [] for section in PLAN_CONTRACT_SECTIONS}
    active_section: Optional[str] = None
    for line in plan_text.splitlines():
        matched_section = match_plan_contract_section(line.strip())
        if matched_section:
            active_section = matched_section
            continue
        if active_section:
            buckets[active_section].append(line)
    return {section: "\n".join(lines).strip() for section, lines in buckets.items()}


def plan_uses_contract_sections(plan_text: str) -> bool:
    return any(
        match_plan_contract_section(line.strip()) for line in plan_text.splitlines()
    )


def missing_plan_contract_sections(plan_text: str) -> List[str]:
    sections = extract_plan_contract_sections(plan_text)
    return [section for section in PLAN_CONTRACT_SECTIONS if not sections.get(section)]


def compacted_policy_bootstrap_issues() -> List[str]:
    issues: List[str] = []
    probe_paths = [compacted_logs_dir()]
    probe_paths.extend(compacted_log_output_paths().values())
    seen = set()
    for path in probe_paths:
        normalized = normalize_repo_rel(path)
        if normalized in seen:
            continue
        seen.add(normalized)
        if role_scoped_path_forbidden_for_patcher(normalized):
            issues.append(f"patcher scope blocks compacted output path: {normalized}")
            continue
        plan_issues = plan_policy_violations(f"- write {normalized}")
        blocked = []
        for issue in plan_issues:
            if not issue.startswith("forbidden path in plan: "):
                continue
            candidate = issue.split(": ", 1)[1]
            if is_compacted_logs_path(candidate):
                blocked.append(issue)
        if blocked:
            issues.append(
                "plan policy blocks compacted output path: "
                + ", ".join(sorted(blocked))
            )
    return issues


def ensure_compacted_policy_bootstrap_ready() -> None:
    issues = compacted_policy_bootstrap_issues()
    if not issues:
        return
    die(
        "pc-feature: compacted outputs are blocked by current workflow policy; "
        "update workflow baseline before continuing.\n"
        + "\n".join(f"- {issue}" for issue in issues)
    )


def normalize_plan_line(line: str) -> str:
    stripped = line.strip()
    if not stripped:
        return ""
    if stripped.startswith(("-", "*")):
        stripped = stripped[1:].strip()
    if re.match(r"^\d+\.\s+", stripped):
        stripped = re.sub(r"^\d+\.\s+", "", stripped).strip()
    return stripped


def is_negated_command_reference(text: str) -> bool:
    return bool(
        re.search(
            r"\b(do not|don't|must not|never|without|forbid|forbidden)\b.{0,32}\b(make\s+feature|pc-feature|tools/pc-feature)\b",
            text,
            re.IGNORECASE,
        )
    )


def plan_command_violations(plan_text: str, sections: Dict[str, str]) -> List[str]:
    violations: List[str] = []
    has_contract = any(value.strip() for value in sections.values())
    scan_lines: List[str] = []
    if has_contract:
        for section_name, section_body in sections.items():
            if section_name == PLAN_CONTRACT_FILES_SECTION:
                continue
            scan_lines.extend(section_body.splitlines())
    else:
        scan_lines = plan_text.splitlines()

    for raw_line in scan_lines:
        normalized = normalize_plan_line(raw_line)
        if not normalized:
            continue
        lowered = normalized.lower()
        if is_negated_command_reference(lowered):
            continue
        explicit_context = bool(
            re.search(
                r"\b(run|execute|executed|invok(?:e|es|ed|ing)|command|shell|cli)\b",
                lowered,
            )
        )

        if re.search(r"^make\s+feature(?:\s|$)", lowered):
            if "forbidden command in plan: make feature" not in violations:
                violations.append("forbidden command in plan: make feature")
            continue

        if re.search(r"^(?:\./)?tools/pc-feature\b", lowered):
            has_args = bool(re.search(r"^(?:\./)?tools/pc-feature\b\s+\S+", lowered))
            if has_args or explicit_context:
                if "forbidden command in plan: tools/pc-feature" not in violations:
                    violations.append("forbidden command in plan: tools/pc-feature")
                if "forbidden command in plan: pc-feature" not in violations:
                    violations.append("forbidden command in plan: pc-feature")
            continue

        if re.search(r"^pc-feature\b", lowered):
            has_args = bool(re.search(r"^pc-feature\b\s+\S+", lowered))
            if has_args or explicit_context:
                if "forbidden command in plan: pc-feature" not in violations:
                    violations.append("forbidden command in plan: pc-feature")
            continue

        if explicit_context and re.search(r"\bmake\s+feature\b", lowered):
            if "forbidden command in plan: make feature" not in violations:
                violations.append("forbidden command in plan: make feature")
        if explicit_context and re.search(r"\b(?:\./)?tools/pc-feature\b", lowered):
            if "forbidden command in plan: tools/pc-feature" not in violations:
                violations.append("forbidden command in plan: tools/pc-feature")
            if "forbidden command in plan: pc-feature" not in violations:
                violations.append("forbidden command in plan: pc-feature")
        elif explicit_context and re.search(r"\bpc-feature\b", lowered):
            if "forbidden command in plan: pc-feature" not in violations:
                violations.append("forbidden command in plan: pc-feature")

    return violations


def extract_plan_test_commands(plan_text: str) -> List[str]:
    sections = extract_plan_contract_sections(plan_text)
    tests_section = sections.get("Tests (anti-hardcode coverage required)", "")
    commands: List[str] = []
    seen = set()
    for line in tests_section.splitlines():
        candidates = re.findall(r"`([^`]+)`", line)
        normalized_line = normalize_plan_line(line)
        if normalized_line:
            candidates.append(normalized_line)
        for candidate in candidates:
            normalized = normalize_allowed_test(candidate)
            if normalized and normalized not in seen:
                seen.add(normalized)
                commands.append(normalized)
    return commands


def missing_global_log_handoff_issue(plan_text: str) -> Optional[str]:
    if not plan_uses_contract_sections(plan_text):
        return None
    sections = extract_plan_contract_sections(plan_text)
    files_scope_text = sections.get(PLAN_CONTRACT_FILES_SECTION, "")
    lowered = plan_text.lower()
    files_scope_global_logs = [
        match
        for match in re.findall(
            r"docs/03-logs/[^\s`]+", files_scope_text, re.IGNORECASE
        )
        if not is_compacted_logs_path(match)
    ]
    full_text_global_logs = [
        match
        for match in re.findall(r"docs/03-logs/[^\s`]+", plan_text, re.IGNORECASE)
        if not is_compacted_logs_path(match)
    ]
    requires_handoff = bool(
        files_scope_global_logs
        or re.search(r"docs/04-process/", files_scope_text, re.IGNORECASE)
        or full_text_global_logs
    )
    if not requires_handoff:
        return None
    mentions_docs_logs = bool(full_text_global_logs)
    mentions_owner = "reporter" in lowered or "orchestrator" in lowered
    patcher_guard = any(
        marker in lowered
        for marker in (
            "patcher will not edit",
            "patcher does not edit",
            "patcher won't edit",
            "not by patcher",
            "not patcher",
        )
    )
    if mentions_docs_logs and mentions_owner and patcher_guard:
        return None
    return (
        "plan must explicitly assign docs/03-logs updates to reporter/orchestrator "
        "and state patcher will not edit those files"
    )


def plan_test_command_alignment_issues(
    plan_text: str, allowed_tests: Optional[List[str]] = None
) -> List[str]:
    if not allowed_tests:
        return []
    plan_commands = extract_plan_test_commands(plan_text)
    if not plan_commands:
        return []
    allowed = set(allowed_tests)
    disallowed = [cmd for cmd in plan_commands if cmd not in allowed]
    if not disallowed:
        return []
    return [
        "plan test commands must be listed in Allowed Tests: "
        + ", ".join(f"`{cmd}`" for cmd in disallowed)
    ]


def docs_logs_wildcard_reference(path_text: str) -> bool:
    normalized = path_text.lower().replace("\\", "")
    return normalized == "docs/03-logs/*"


def plan_policy_violations(
    plan_text: str, *, allowed_tests: Optional[List[str]] = None
) -> List[str]:
    violations: List[str] = []
    sections = extract_plan_contract_sections(plan_text)
    files_scope_text = sections.get(PLAN_CONTRACT_FILES_SECTION, "").strip()
    path_scan_targets: List[Tuple[str, str]] = [("full", plan_text)]
    if files_scope_text:
        path_scan_targets.insert(0, ("files", files_scope_text))
    path_patterns = (
        r"docs/02-features/[^\s`]+/dev-tasks\.md",
        r"docs/02-features/[^\s`]+/planner-log\.md",
        r"docs/02-features/[^\s`]+/plan-reviewer-log\.md",
        r"docs/02-features/[^\s`]+/reporter-log\.md",
        r"docs/02-features/[^\s`]+/validation-log\.md",
        r"docs/03-logs/[^\s`]+",
        r"docs/possible-improvements\.md",
    )
    for scan_scope, path_scan_text in path_scan_targets:
        for pattern in path_patterns:
            for match in re.findall(pattern, path_scan_text, flags=re.IGNORECASE):
                if (
                    scan_scope == "full"
                    and pattern == r"docs/03-logs/[^\s`]+"
                    and docs_logs_wildcard_reference(match)
                ):
                    continue
                if pattern == r"docs/03-logs/[^\s`]+" and is_compacted_logs_path(match):
                    continue
                entry = f"forbidden path in plan: {match}"
                if entry not in violations:
                    violations.append(entry)
    for issue in plan_command_violations(plan_text, sections):
        if issue not in violations:
            violations.append(issue)
    global_log_issue = missing_global_log_handoff_issue(plan_text)
    if global_log_issue and global_log_issue not in violations:
        violations.append(global_log_issue)
    for issue in plan_test_command_alignment_issues(plan_text, allowed_tests):
        if issue not in violations:
            violations.append(issue)
    return violations


