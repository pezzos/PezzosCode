def normalize_repo_path(path: str) -> str:
    normalized = path.replace("\\", "/").strip()
    if normalized.startswith("./"):
        normalized = normalized[2:]
    return normalized.lower()


def normalize_repo_rel(path: str) -> str:
    normalized = path.replace("\\", "/").strip()
    if normalized.startswith("./"):
        normalized = normalized[2:]
    return normalized


def repo_relative_path(root: str, path: str, *, label: str) -> str:
    root_abs = os.path.abspath(root)
    candidate = path if os.path.isabs(path) else os.path.join(root_abs, path)
    candidate_abs = os.path.abspath(candidate)
    try:
        rel = os.path.relpath(candidate_abs, root_abs)
    except ValueError:
        die(f"pc-feature: {label} is outside repository root: {candidate_abs}")
    rel = normalize_repo_rel(rel)
    if rel.startswith(".."):
        die(f"pc-feature: {label} is outside repository root: {candidate_abs}")
    return rel


def ensure_within_dir(base_dir: str, candidate: str, *, label: str) -> str:
    base_abs = os.path.abspath(base_dir)
    candidate_abs = os.path.abspath(candidate)
    try:
        common = os.path.commonpath([base_abs, candidate_abs])
    except ValueError:
        die(f"pc-feature: {label} path is invalid: {candidate_abs}")
    if common != base_abs:
        die(f"pc-feature: {label} must be inside worktree: {candidate_abs}")
    return candidate_abs


def worktree_runtime_path(
    worktree_path: str, repo_relative: str, *, label: str, must_exist: bool = False
) -> str:
    rel = normalize_repo_rel(repo_relative)
    path = ensure_within_dir(
        worktree_path, os.path.join(worktree_path, rel), label=label
    )
    if must_exist and not os.path.exists(path):
        die(f"pc-feature: missing {label} in worktree: {path}")
    return path


