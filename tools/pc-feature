def normalize_repo_path(path: str) -> str:
    normalized = path.replace("\\", "/").strip()
    if normalized.startswith("./"):
        normalized = normalized[2:]
    return normalized.lower()


def path_risk_triggers(paths: List[str]) -> List[str]:
    triggers: List[str] = []
    for path in paths:
        normalized = normalize_repo_path(path)
        for prefix, trigger in RISK_PATH_TRIGGERS:
            if normalized.startswith(prefix):
                triggers.append(trigger)
    return sorted(set(triggers))


def classify_risk(
    data: Dict, change_budget: Dict, actual_changed_paths: Optional[List[str]] = None
) -> Tuple[str, List[str]]:
    triggers = []
    if data.get("touches_secret_blocking"):
        triggers.append("touches secret blocking or fail-close behavior")
    if data.get("touches_restore"):
        triggers.append("affects restore apply semantics or permissions")
    if data.get("touches_secret_scanning"):
        triggers.append("modifies secret scanning dependencies/policies")
    modules = data.get("cross_cutting_refactor_modules", 0)
    if modules and modules >= 3:
        triggers.append("cross-cutting refactor impacting 3+ modules")
    files_to_change = data.get("files_to_change") or []
    if len(files_to_change) > change_budget["max_files"]:
        triggers.append("change budget exceeded (file count)")
    planned_new_modules = data.get("planned_new_modules", 0)
    if planned_new_modules > change_budget["max_new_modules"]:
        triggers.append("change budget exceeded (new modules)")
    planned_paths = data.get("files_to_change") or []
    triggers.extend(path_risk_triggers(planned_paths))
    if actual_changed_paths:
        triggers.extend(path_risk_triggers(actual_changed_paths))
    deduped = sorted(set(triggers))
    return ("HIGH" if deduped else "LOW", deduped)


def parse_escalation_request(raw: str) -> Optional[Dict[str, Any]]:
    payload = extract_json_payload(raw)
    try:
        data = json.loads(payload)
    except json.JSONDecodeError:
        return None
    if not isinstance(data, dict):
        return None
    if isinstance(data.get("escalation_request"), dict):
        request = data["escalation_request"]
    elif str(data.get("type", "")).lower() == "escalation_request":
        request = data
    else:
        return None
    command = request.get("command")
    if not command:
        return None
    return request


def normalize_escalation_command(command: Any) -> List[str]:
    if isinstance(command, list):
        if not all(isinstance(part, str) and part.strip() for part in command):
            return []
        return [part.strip() for part in command]
    if isinstance(command, str):
        try:
            parts = shlex.split(command)
        except ValueError:
            return []
        return [part.strip() for part in parts if part.strip()]
    return []


def unwrap_pp_command(command: List[str]) -> List[str]:
    if len(command) >= 2 and command[0] == "tools/offload-proxy/pp":
        return command[1:]
    return command


def escalation_command_allowed(command: List[str]) -> bool:
    if not command:
        return False
    effective = unwrap_pp_command(command)
    if not effective:
        return False
    forbidden_heads = {"rm", "dd", "mkfs", "shutdown", "reboot"}
    if effective[0] in forbidden_heads:
        return False
    if effective[:3] == ["git", "reset", "--hard"]:
        return False
    for prefix in ESCALATION_ALLOWLIST_PREFIXES:
        if len(effective) >= len(prefix) and tuple(effective[: len(prefix)]) == prefix:
            return True
    return False


def format_escalation_result(result: Dict[str, Any]) -> str:
    return "Escalation broker result (JSON):\n" + json.dumps(
        result, ensure_ascii=True, sort_keys=True, indent=2
    )


def process_escalation_request(
    request: Dict[str, Any],
    *,
    root: str,
    default_cwd: Optional[str],
    runner_metadata: Optional["pc_runner.RunMetadata"] = None,
) -> Dict[str, Any]:
    command = normalize_escalation_command(request.get("command"))
    reason = str(request.get("reason", "")).strip()
    target_cwd = str(request.get("cwd", "")).strip() or (default_cwd or root)
    if not os.path.isabs(target_cwd):
        target_cwd = os.path.join(root, target_cwd)
    target_cwd = os.path.abspath(target_cwd)
    root_abs = os.path.abspath(root)
    if not target_cwd.startswith(root_abs):
        target_cwd = root_abs
    result: Dict[str, Any] = {
        "decision": "DENY",
        "reason": reason or "no reason provided",
        "command": command,
        "cwd": target_cwd,
    }
    if not command:
        result["error"] = "invalid command format"
        return result
    if not escalation_command_allowed(command):
        result["error"] = "command not allowed by escalation policy"
        return result
    if not os.path.isdir(target_cwd):
        result["error"] = "cwd does not exist"
        return result
    if runner_metadata:
        pc_runner.log_message(
            runner_metadata,
            "escalation",
            f"request approved: {shlex.join(command)}",
            root=Path(root),
        )
    run_result = subprocess.run(
        command,
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        cwd=target_cwd,
    )
    result["decision"] = "APPROVE"
    result["exit_code"] = run_result.returncode
    result["stdout"] = run_result.stdout.strip()
    result["stderr"] = run_result.stderr.strip()
    if runner_metadata:
        pc_runner.log_message(
            runner_metadata,
            "escalation",
            f"request complete: exit={run_result.returncode} command={shlex.join(command)}",
            root=Path(root),
        )
    return result


def git_repo_root(path: Optional[str]) -> str:
    result = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        cwd=path,
    )
    if result.returncode != 0:
        die(f"pc-feature: git root not found\n{result.stderr}")
    return result.stdout.strip()


def codex_overrides() -> List[str]:
    uvx_path = shutil.which("uvx") or os.path.join(
        os.path.expanduser("~"), ".local", "bin", "uvx"
    )
    serena_payload = (
        f'{{command="{uvx_path}",args=["--refresh","--from","git+https://github.com/oraios/serena",'
        '"serena","start-mcp-server","--context","codex","--project-from-cwd"],'
        "optional=true,autostart=false,startup_timeout_ms=30000,request_timeout_ms=15000}"
    )
    return [
        "-c",
        'approval_policy="never"',
        "-c",
        'sandbox_mode="workspace-write"',
        "-c",
        "network_access=false",
        "-c",
        f"mcp_servers.serena={serena_payload}",
    ]


def codex_exec_once(
    prompt: str,
    capture_output: bool = True,
    cwd: Optional[str] = None,
    profile: Optional[str] = None,
) -> str:
    if shutil.which("codex") is None:
        die("pc-feature: codex CLI not found in PATH")
    project_root = git_repo_root(cwd)
    codex_home = os.path.join(project_root, ".codex_subagent")
    os.makedirs(codex_home, exist_ok=True)
    config_path = os.path.join(codex_home, "config.toml")
    if not os.path.exists(config_path):
        with open(config_path, "w", encoding="utf-8") as handle:
            handle.write(
                'approval_policy = "never"\n'
                'sandbox_mode = "workspace-write"\n'
                "network_access = false\n"
            )
    auth_src = os.path.join(os.path.expanduser("~"), ".codex", "auth.json")
    auth_dst = os.path.join(codex_home, "auth.json")
    if os.path.exists(auth_src) and not os.path.exists(auth_dst):
        try:
            shutil.copy2(auth_src, auth_dst)
        except Exception as exc:
            print(
                f"pc-feature: failed to copy auth.json: {exc}",
                file=sys.stderr,
            )
    if not os.path.exists(auth_dst):
        print(
            "pc-feature: warning: auth.json missing; codex exec may fail.",
            file=sys.stderr,
        )
    env = os.environ.copy()
    env.pop("OPENAI_API_KEY", None)
    env["CODEX_HOME"] = codex_home
    codex_profile = profile or os.environ.get("CODEX_PROFILE", "Default")
    cmd = [
        "codex",
        "-C",
        project_root,
        "--profile",
        codex_profile,
        *codex_overrides(),
        "exec",
        prompt,
    ]
    result = subprocess.run(
        cmd,
        check=False,
        cwd=cwd,
        text=True,
        env=env,
        stdout=subprocess.PIPE if capture_output else None,
        stderr=subprocess.PIPE if capture_output else None,
    )
    if result.returncode != 0:
        combined = ""
        if result.stdout:
            combined += result.stdout
        if result.stderr:
            combined += result.stderr
        die(f"pc-feature: codex exec failed\n{combined}")
    return result.stdout or ""


def codex_exec(
    prompt: str,
    capture_output: bool = True,
    cwd: Optional[str] = None,
    profile: Optional[str] = None,
    runner_metadata: Optional["pc_runner.RunMetadata"] = None,
    root: Optional[str] = None,
) -> str:
    response = codex_exec_once(
        prompt,
        capture_output=capture_output,
        cwd=cwd,
        profile=profile,
    )
    if not capture_output:
        return response
    root_dir = root or git_repo_root(cwd)
    current_prompt = prompt
    for _ in range(MAX_ESCALATION_ROUNDS):
        request = parse_escalation_request(response)
        if not request:
            return response
        broker_result = process_escalation_request(
            request,
            root=root_dir,
            default_cwd=cwd,
            runner_metadata=runner_metadata,
        )
        if runner_metadata:
            pc_runner.log_message(
                runner_metadata,
                "escalation",
                f"decision={broker_result.get('decision')} command={broker_result.get('command')}",
                root=Path(root_dir),
            )
        current_prompt = (
            current_prompt
            + "\n\n"
            + format_escalation_result(broker_result)
            + "\nUse this result and continue the task. "
            "Return the requested final output format only."
        )
        response = codex_exec_once(
            current_prompt,
            capture_output=capture_output,
            cwd=cwd,
            profile=profile,
        )
    die("pc-feature: escalation loop exceeded max rounds")
    return ""


def build_worktree_path(root: str, feature_name: str, agent: str) -> str:
    repo_name = os.path.basename(root)
    safe_feature = re.sub(r"[^a-zA-Z0-9]+", "-", feature_name).strip("-")
    safe_agent = re.sub(r"[^a-zA-Z0-9]+", "-", agent).strip("-")
    parent = os.path.dirname(root)
    return os.path.join(parent, f"{repo_name}-{safe_feature}-{safe_agent}")


def build_worktree_branch(feature_name: str, agent: str) -> str:
    safe_feature = re.sub(r"[^a-zA-Z0-9]+", "-", feature_name).strip("-")
    safe_agent = re.sub(r"[^a-zA-Z0-9]+", "-", agent).strip("-")
    return f"feature-{safe_feature}-{safe_agent}"


def git_current_branch(path: str) -> str:
    result = subprocess.run(
        ["git", "rev-parse", "--abbrev-ref", "HEAD"],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        cwd=path,
    )
    if result.returncode != 0:
        die(f"pc-feature: failed to resolve current branch\n{result.stderr}")
    branch = result.stdout.strip()
    if branch.startswith("heads/"):
        branch = branch[len("heads/") :]
    if branch.startswith("refs/heads/"):
        branch = branch[len("refs/heads/") :]
    return branch


def git_branch_exists(root: str, branch: str) -> bool:
    result = subprocess.run(
        ["git", "show-ref", "--verify", f"refs/heads/{branch}"],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        cwd=root,
    )
    return result.returncode == 0


def resolve_base_ref(root: str, base_branch: str) -> str:
    if git_branch_exists(root, base_branch):
        return f"refs/heads/{base_branch}"
    return base_branch


def prepare_worktree(
    root: str, feature_name: str, agent: str, base_branch: str
) -> Tuple[str, str]:
    path = build_worktree_path(root, feature_name, agent)
    branch = build_worktree_branch(feature_name, agent)
    if os.path.exists(path):
        actual_branch = git_current_branch(path)
        if actual_branch == "main":
            die(f"pc-feature: worktree for {agent} is on main")
        return path, actual_branch
    if git_branch_exists(root, branch):
        cmd = ["git", "worktree", "add", path, branch]
    else:
        resolved_base = resolve_base_ref(root, base_branch)
        cmd = ["git", "worktree", "add", "-b", branch, path, resolved_base]
    result = subprocess.run(
        cmd,
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        cwd=root,
    )
    if result.returncode != 0:
        die(f"pc-feature: failed to create worktree for {agent}\n{result.stderr}")
    return path, branch


def worktree_role_paths(feature_dir: str) -> Dict[str, str]:
    return {
        role: os.path.join(feature_dir, filename)
        for role, filename in ROLE_LOG_FILES.items()
    }


def ensure_role_log(path: str, role: str) -> None:
    if os.path.exists(path):
        return
    title = f"{role.title()} Log"
    content = f"# {title}\n\n## Entries\n"
    write_file(path, content)


def upsert_role_log_entry(content: str, work_item_id: str, entry: str) -> str:
    header_prefix = f"### {work_item_id} -"
    lines = content.splitlines()
    cleaned: List[str] = []
    idx = 0
    while idx < len(lines):
        line = lines[idx]
        if line.startswith(header_prefix):
            idx += 1
            while idx < len(lines) and not lines[idx].startswith("### "):
                idx += 1
            continue
        cleaned.append(line)
        idx += 1
    base = "\n".join(cleaned).rstrip()
    if not base:
        base = "# Log\n\n## Entries"
    return base + "\n\n" + entry.strip() + "\n"


def append_role_log(
    path: str, work_item_id: str, body: str, role: Optional[str] = None
) -> None:
    timestamp = datetime.now().strftime("%Y-%m-%d")
    entry = f"### {work_item_id} - {timestamp}\n\n{body.strip()}\n"
    if not os.path.exists(path):
        write_file(path, "# Log\n\n## Entries\n")
    content = read_file(path).rstrip()
    if role in {"reporter", "tester"}:
        updated = upsert_role_log_entry(content, work_item_id, entry)
        write_file(path, updated)
        return
    content = content + "\n\n" + entry + "\n"
    write_file(path, content)


def parse_status_paths(status_lines: List[str]) -> List[str]:
    paths: List[str] = []
    for line in status_lines:
        if not line.strip():
            continue
        entry = line[3:] if len(line) > 3 else ""
        if "->" in entry:
            parts = entry.split("->")
            paths.extend(part.strip() for part in parts if part.strip())
        else:
            paths.append(entry.strip())
    return paths


def get_status_paths(path: str) -> List[str]:
    result = subprocess.run(
        ["git", "status", "--porcelain"],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        cwd=path,
    )
    if result.returncode != 0:
        die(f"pc-feature: failed to read git status for {path}\n{result.stderr}")
    lines = result.stdout.splitlines()
    return parse_status_paths(lines)


def worktree_is_dirty(path: str) -> bool:
    return bool(get_status_paths(path))


def filter_ignored_paths(paths: List[str]) -> List[str]:
    filtered: List[str] = []
    for entry in paths:
        if entry in IGNORED_PATH_FILES:
            continue
        if any(entry.startswith(prefix) for prefix in IGNORED_PATH_PREFIXES):
            continue
        filtered.append(entry)
    return filtered


def final_commit_allow_paths() -> List[str]:
    # Runtime artifacts should not block pc-commit guard rails.
    prefixes = [prefix.rstrip("/") for prefix in IGNORED_PATH_PREFIXES if prefix]
    return sorted(set(prefixes + list(IGNORED_PATH_FILES)))


def unstage_ephemeral_paths(root: str) -> None:
    allow_paths = final_commit_allow_paths()
    if not allow_paths:
        return
    subprocess.run(
        ["git", "reset", "--"] + allow_paths,
        check=False,
        cwd=root,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )


