def entry_section_complete(content: str, work_item_id: str, section: str) -> bool:
    body = get_entry_section(content, work_item_id, section)
    if not body or "(pending)" in body:
        return False
    if section == "Preflight Report":
        lines = body.splitlines()
        risk_level = parse_field_value(lines, "Risk level")
        return bool(risk_level)
    if section == "Gates":
        return "make ci" in body and "PASS" in body
    if section == "Commit":
        return (
            "Commit message:" in body
            and len(body.split("Commit message:", 1)[1].strip()) > 0
        )
    return True


def parse_allowed_tests(section: str) -> List[str]:
    commands: List[str] = []
    for line in section.splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        if stripped.startswith(("-", "*")):
            stripped = stripped[1:].strip()
        if re.match(r"^\d+\.\s+", stripped):
            stripped = re.sub(r"^\d+\.\s+", "", stripped).strip()
        if "list exact commands" in stripped:
            continue
        if "(pending)" in stripped:
            continue
        normalized = normalize_allowed_test(stripped)
        if normalized:
            commands.append(normalized)
    return commands


def normalize_allowed_test(raw: str) -> Optional[str]:
    text = raw.strip()
    if not text:
        return None
    if text.startswith("`") and text.endswith("`"):
        text = text[1:-1].strip()
    if "`" in text:
        return None
    try:
        parts = shlex.split(text)
    except ValueError:
        return None
    if not parts:
        return None
    if parts[0] == "tools/offload-proxy/pp":
        parts = parts[1:]
        if not parts:
            return None
    if parts[0] in {"pytest", "py.test"}:
        return shlex.join(parts)
    if len(parts) >= 3 and parts[0] in {"python", "python3"} and parts[1] == "-m":
        if parts[2] in {"unittest", "pytest"}:
            return shlex.join(parts)
    return None


def is_forbidden_test(cmd: str) -> bool:
    return bool(
        re.search(r"\bmake\s+feature\b", cmd, re.IGNORECASE)
        or re.search(r"\bpc-feature\b", cmd, re.IGNORECASE)
        or re.search(r"\btools/pc-feature\b", cmd, re.IGNORECASE)
        or re.search(r"\bmake\s+ci\b", cmd, re.IGNORECASE)
    )


def ensure_allowed_tests_section(content: str, work_item_id: str) -> str:
    lines = content.splitlines()
    start, end = find_entry_block(lines, work_item_id)
    entry_lines = lines[start:end]
    header = f"{SECTION_PREFIX}Allowed Tests"
    if any(line.strip() == header for line in entry_lines):
        return content
    insert_before = f"{SECTION_PREFIX}Files to Change + Change Budget"
    insert_idx = None
    for idx, line in enumerate(entry_lines):
        if line.strip() == insert_before:
            insert_idx = idx
            break
    block = [
        header,
        "",
        "- (list exact commands; do not include `make feature` or `pc-feature`)",
        "",
    ]
    if insert_idx is None:
        entry_lines.extend([""] + block)
    else:
        entry_lines = entry_lines[:insert_idx] + block + entry_lines[insert_idx:]
    return "\n".join(lines[:start] + entry_lines + lines[end:]) + "\n"


def extract_json_payload(raw: str) -> str:
    start = raw.find("{")
    end = raw.rfind("}")
    if start == -1 or end == -1 or end < start:
        return raw
    return raw[start : end + 1]


def entry_outcome(content: str, work_item_id: str) -> str:
    entry_lines = content.splitlines()
    start, end = find_entry_block(entry_lines, work_item_id)
    field = parse_field_value(entry_lines[start:end], "Outcome")
    return field.lower()


def select_resume_work_item_id(content: str) -> Optional[str]:
    headers = list_entry_headers(content.splitlines())
    if not headers:
        return None
    newest_id = headers[0]
    normalize_work_item_id(newest_id)
    outcome = entry_outcome(content, newest_id)
    if outcome and outcome.startswith("pass"):
        return None
    return newest_id


def append_iteration_log_note(content: str, work_item_id: str, note: str) -> str:
    body = get_entry_section(content, work_item_id, "Iteration Log")
    entry = f"- {note.strip()}"
    if not body or body.strip() in {"-", "(pending)"}:
        new_body = entry
    elif entry in body:
        new_body = body
    else:
        new_body = body.rstrip() + "\n" + entry
    return replace_entry_section(content, work_item_id, "Iteration Log", new_body)


def append_noop_step_note(
    content: str, work_item_id: str, *, attempt: int, step: str, reason: str
) -> str:
    note = f"Attempt {attempt}: {step} no-op; reason={reason.strip()}."
    return append_iteration_log_note(content, work_item_id, note)


def collect_allowed_final_stage_paths(
    root: str, base_ref: str, branch: str, dev_tasks_path: str, feature_dir: str
) -> List[str]:
    allowed = set(
        collect_branch_merge_paths(
            root,
            base_ref,
            branch,
            dev_tasks_path=dev_tasks_path,
            feature_dir=feature_dir,
        )
    )
    allowed.add(dev_tasks_path)
    allowed.update(global_log_paths())
    return sorted(allowed)


def stage_scoped_final_paths(root: str, allowed_paths: List[str]) -> List[str]:
    current_paths = set(filter_ignored_paths(get_status_paths(root)))
    allowed = set(filter_ignored_paths(allowed_paths))
    unexpected = sorted(path for path in current_paths if path not in allowed)
    if unexpected:
        die(
            "pc-feature: unrelated dirty paths block final commit; "
            "clean/stash these first: " + ", ".join(unexpected)
        )
    stage_paths = sorted(path for path in current_paths if path in allowed)
    if not stage_paths:
        die("pc-feature: no scoped changes to commit at final stage")
    commit_result = subprocess.run(
        ["git", "add", "--"] + stage_paths,
        check=False,
        cwd=root,
    )
    if commit_result.returncode != 0:
        die("pc-feature: failed to stage scoped changes")
    return stage_paths


def ensure_root_start_scope(root: str, allowed_paths: List[str]) -> None:
    current_paths = set(filter_ignored_paths(get_status_paths(root)))
    allowed = set(filter_ignored_paths(allowed_paths))
    unexpected = sorted(path for path in current_paths if path not in allowed)
    if unexpected:
        die(
            "pc-feature: unrelated dirty paths detected before execution; "
            "clean/stash these first: " + ", ".join(unexpected)
        )


def get_staged_paths(root: str) -> List[str]:
    result = subprocess.run(
        ["git", "diff", "--cached", "--name-only"],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        cwd=root,
    )
    if result.returncode != 0:
        die(f"pc-feature: failed to read staged paths\n{result.stderr}")
    return [line.strip() for line in result.stdout.splitlines() if line.strip()]


def run_scoped_autofix(root: str, staged_paths: List[str]) -> int:
    scoped_paths = sorted(set(filter_ignored_paths(staged_paths)))
    if not scoped_paths:
        die("pc-feature: no staged files available for scoped autofix")
    autofix_cmd = [
        "tools/offload-proxy/pp",
        "pre-commit",
        "run",
        "--files",
    ] + scoped_paths
    autofix_exit = run_command(autofix_cmd, cwd=root)
    status_paths = set(filter_ignored_paths(get_status_paths(root)))
    scoped_set = set(scoped_paths)
    unexpected = sorted(path for path in status_paths if path not in scoped_set)
    if unexpected:
        die(
            "pc-feature: scoped autofix touched out-of-scope files: "
            + ", ".join(unexpected)
        )
    add_result = subprocess.run(
        ["git", "add", "--"] + scoped_paths,
        check=False,
        cwd=root,
    )
    if add_result.returncode != 0:
        die("pc-feature: failed to restage scoped autofix files")
    return autofix_exit


def append_log_line(path: str, line: str) -> None:
    content = read_file(path)
    if line in content:
        return
    content = content.rstrip() + f"\n\n- {line}\n"
    write_file(path, content)


def main() -> None:
    feature_id, manual = parse_args(sys.argv[1:])
    root = os.getcwd()
    current_branch = git_current_branch(root)
    if current_branch != "main":
        die("pc-feature: run from main branch only")
    feature_root = os.path.join("docs", "02-features")
    feature_dir = resolve_feature_dir(feature_root, feature_id)
    feature_slug = os.path.basename(feature_dir)
    patcher_path = build_worktree_path(root, feature_slug, "patcher")
    patcher_branch = build_worktree_branch(feature_slug, "patcher")
    if os.path.exists(patcher_path) and os.path.exists(
        os.path.join(patcher_path, ".git")
    ):
        existing_branch = git_current_branch(patcher_path)
        dirty = worktree_is_dirty(patcher_path)
        ahead = branch_ahead_count(root, "refs/heads/main", existing_branch) > 0
        behind = branch_behind_count(root, existing_branch, "refs/heads/main") > 0
        if behind:
            print(
                "pc-feature: existing patcher worktree is behind main "
                f"(stale): {patcher_path}"
            )
            if not prompt_yes_no(
                "pc-feature: recreate stale patcher worktree from main? [y/N]"
            ):
                die("pc-feature: aborted by user; stale patcher worktree preserved")
            remove_worktree(root, patcher_path, existing_branch)
            dirty = False
            ahead = False
        if dirty or ahead:
            reasons: List[str] = []
            if dirty:
                reasons.append("dirty")
            if ahead:
                reasons.append("ahead-of-main")
            print(
                "pc-feature: existing patcher worktree is not pristine "
                f"({', '.join(reasons)}): {patcher_path}"
            )
            if not prompt_yes_no(
                "pc-feature: continue with existing patcher worktree? [y/N]"
            ):
                die("pc-feature: aborted by user; existing patcher worktree preserved")
    dev_tasks_path = os.path.join(feature_dir, "dev-tasks.md")
    if not os.path.exists(dev_tasks_path):
        die(f"pc-feature: missing dev-tasks.md at {dev_tasks_path}")
    content = read_file(dev_tasks_path)
    ensure_execution_log(content)
    patcher_path, patcher_branch = prepare_worktree(
        root, feature_slug, "patcher", "main"
    )
    planner_path = patcher_path
    tester_path = patcher_path
    reporter_path = patcher_path
    role_paths = worktree_role_paths(feature_dir)
    cleanup_dirty_role_logs(patcher_path, feature_dir)
    cleanup_dirty_global_logs(patcher_path)
    ensure_clean_worktree(root, patcher_path, patcher_branch, "preflight")

    work_item_id = select_resume_work_item_id(content)
    if not work_item_id:
        work_item_id = next_work_item_id(content)
        entry = build_execution_entry(work_item_id)
        content = insert_execution_entry(content, entry)
        write_file(dev_tasks_path, content)
    content = read_file(dev_tasks_path)
    content = ensure_allowed_tests_section(content, work_item_id)
    write_file(dev_tasks_path, content)
    start_allowed_paths = collect_allowed_final_stage_paths(
        root, "refs/heads/main", patcher_branch, dev_tasks_path, feature_dir
    )
    ensure_root_start_scope(root, start_allowed_paths)

    runner_metadata = pc_runner.build_metadata(work_item_id, "pc-feature")
    pc_runner.log_message(
        runner_metadata, "feature", "start pc-feature", root=Path(root)
    )

    if manual:
        pc_runner.log_message(
            runner_metadata, "feature", "manual mode enabled; exit", root=Path(root)
        )
        print("pc-feature: manual mode enabled; execution log entry ready")
        return

    feature_spec = read_file(os.path.join(feature_dir, "feature-spec.md"))
    tech_design = read_file(os.path.join(feature_dir, "tech-design.md"))
    test_plan = read_file(os.path.join(feature_dir, "test-plan.md"))

    review_items: List[str] = []

    content = read_file(dev_tasks_path)
    preflight_complete = entry_section_complete(
        content, work_item_id, "Preflight Report"
    )
    if not preflight_complete:
        actual_changed_paths: List[str] = []
        if os.path.exists(patcher_path) and os.path.exists(
            os.path.join(patcher_path, ".git")
        ):
            actual_changed_paths = filter_ignored_paths(get_status_paths(patcher_path))
        preflight_prompt = (
            "You are preparing preflight data for a work item execution.\n"
            "Return ONLY valid JSON. No prose, no markdown, no extra text.\n"
            "Required keys: prd_ref, scope_in, scope_out, non_goals_reminder, "
            "files_to_change (array), planned_new_modules (int), touches_secret_blocking (bool), "
            "touches_restore (bool), touches_secret_scanning (bool), cross_cutting_refactor_modules (int), "
            "tdd_tests (array), doc_updates (array).\n"
            f"Work Item ID: {work_item_id}\n"
            f"Feature spec:\n{feature_spec}\n\n"
            f"Tech design:\n{tech_design}\n\n"
            f"Test plan:\n{test_plan}\n\n"
            f"Dev tasks:\n{content}\n"
        )
        preflight_raw = codex_exec(
            preflight_prompt,
            runner_metadata=runner_metadata,
            root=root,
        ).strip()
        preflight_json = extract_json_payload(preflight_raw)
        try:
            preflight_data = json.loads(preflight_json)
        except json.JSONDecodeError:
            die(f"pc-feature: failed to parse preflight JSON\n{preflight_raw}")

        risk_level, triggers = classify_risk(
            preflight_data, DEFAULT_CHANGE_BUDGET, actual_changed_paths
        )
        content = read_file(dev_tasks_path)
        content = replace_entry_section(
            content,
            work_item_id,
            "Preflight Report",
            build_preflight_block(
                preflight_data,
                work_item_id,
                DEFAULT_CHANGE_BUDGET,
                risk_level,
                triggers,
                "; ".join(review_items) if review_items else None,
            ),
        )
        content = replace_entry_section(
            content,
            work_item_id,
            "TDD Plan",
            build_tdd_plan_block(preflight_data.get("tdd_tests") or []),
        )
        content = replace_entry_section(
            content,
            work_item_id,
            "Files to Change + Change Budget",
            build_files_block(
                preflight_data.get("files_to_change") or [], DEFAULT_CHANGE_BUDGET
            ),
        )
        content = replace_entry_section(
            content,
            work_item_id,
            "Docs Updated",
            build_docs_block(preflight_data.get("doc_updates") or []),
        )
        write_file(dev_tasks_path, content)

        if risk_level == "HIGH":
            if not approve_high_risk_interactive(risk_level, triggers):
                content = update_entry_field(
                    content, work_item_id, "Outcome", "needs replan"
                )
                content = update_entry_field(
                    content, work_item_id, "Notes", "Awaiting PO Approval"
                )
                write_file(dev_tasks_path, content)
                die("pc-feature: high-risk work item requires PO approval")
            content = update_entry_field(
                content, work_item_id, "Notes", HIGH_RISK_APPROVAL_NOTE
            )
            write_file(dev_tasks_path, content)

    content = read_file(dev_tasks_path)
    risk_level = preflight_risk_level(content, work_item_id)
    if risk_level == "HIGH" and not high_risk_approval_recorded(content, work_item_id):
        triggers = preflight_triggers(content, work_item_id)
        if not approve_high_risk_interactive(risk_level, triggers):
            content = update_entry_field(
                content, work_item_id, "Outcome", "needs replan"
            )
            content = update_entry_field(
                content, work_item_id, "Notes", "Awaiting PO Approval"
            )
            write_file(dev_tasks_path, content)
            die("pc-feature: high-risk work item requires PO approval")
        content = update_entry_field(
            content, work_item_id, "Notes", HIGH_RISK_APPROVAL_NOTE
        )
        write_file(dev_tasks_path, content)

    requires_global_logs = False
    reviewer_blocks = 0
    execution_attempt = 0
    last_failure_context = "No failure context recorded."
    while execution_attempt < MAX_LOOPS:
        attempt = execution_attempt + 1
        content = read_file(dev_tasks_path)
        if not entry_section_complete(content, work_item_id, "Plan"):
            plan_prompt = render_prompt_template(
                load_prompt_template("planner", "create"),
                {
                    "work_item_id": work_item_id,
                    "feature_spec": feature_spec,
                    "tech_design": tech_design,
                    "dev_tasks": content,
                },
            )
            plan_text = codex_exec(
                plan_prompt,
                cwd=planner_path,
                profile="Planner",
                runner_metadata=runner_metadata,
                root=root,
            ).strip()
            content = read_file(dev_tasks_path)
            content = update_entry_field(content, work_item_id, "Planner", "Codex")
            content = replace_entry_section(content, work_item_id, "Plan", plan_text)
            write_file(dev_tasks_path, content)
            ensure_role_log(
                os.path.join(planner_path, role_paths["planner"]), "planner"
            )
            append_role_log(
                os.path.join(planner_path, role_paths["planner"]),
                work_item_id,
                plan_text,
                role="planner",
            )
            format_role_changes("planner", planner_path, feature_dir)
            enforce_role_scope(planner_path, "planner", feature_dir)
            commit_worktree_changes(planner_path, "planner", work_item_id, feature_dir)
            ensure_clean_worktree(root, planner_path, patcher_branch, "planner")
        else:
            content = append_noop_step_note(
                content,
                work_item_id,
                attempt=attempt,
                step="planner",
                reason="plan already present",
            )
            write_file(dev_tasks_path, content)

        content = read_file(dev_tasks_path)
        planner_updates = False
        planner_note = ""
        allowed_tests: List[str] = []
        forbidden: List[str] = []
        missing: List[str] = []
        for attempt_fix in range(2):
            allowed_section = get_entry_section(content, work_item_id, "Allowed Tests")
            allowed_tests = parse_allowed_tests(allowed_section)
            forbidden = [cmd for cmd in allowed_tests if is_forbidden_test(cmd)]
            missing = check_allowed_tests_exist(allowed_tests, planner_path)
            if not allowed_tests or forbidden or missing:
                issues: List[str] = []
                if not allowed_tests:
                    issues.append("No allowed tests are listed.")
                if forbidden:
                    issues.append("Forbidden commands detected (do not use `make ci`).")
                if missing:
                    issues.append("Missing tests: " + "; ".join(sorted(set(missing))))
                planner_prompt = render_prompt_template(
                    load_prompt_template("planner", "update-allowed-tests"),
                    {
                        "work_item_id": work_item_id,
                        "issues": " ".join(issues),
                    },
                )
                planner_response = codex_exec(
                    planner_prompt,
                    cwd=planner_path,
                    profile="Planner",
                    runner_metadata=runner_metadata,
                    root=root,
                ).strip()
                if planner_response:
                    content = replace_entry_section(
                        content, work_item_id, "Allowed Tests", planner_response
                    )
                    write_file(dev_tasks_path, content)
                    planner_updates = True
                    content = read_file(dev_tasks_path)
                    continue
            break
        if not allowed_tests or forbidden or missing:
            issues: List[str] = []
            if not allowed_tests:
                issues.append("no allowed tests listed")
            if forbidden:
                issues.append("forbidden commands: " + "; ".join(forbidden))
            if missing:
                issues.append("missing targets: " + "; ".join(sorted(set(missing))))
            remediation = (
                "Allowed Tests must contain only specific, existing unittest/pytest commands. "
                "Do not include `make ci`, `make feature`, `pc-feature`, or placeholders."
            )
            issue_summary = " | ".join(issues)
            tester_feedback = (
                "Outcome: FAIL\n"
                "Tests run: (none)\n"
                f"Notes: Invalid Allowed Tests after planner remediation attempts ({issue_summary}). "
                f"{remediation}\n"
                f"Work Item ID: {work_item_id}\n"
            )
            ensure_role_log(os.path.join(tester_path, role_paths["tester"]), "tester")
            append_role_log(
                os.path.join(tester_path, role_paths["tester"]),
                work_item_id,
                tester_feedback,
                role="tester",
            )
            format_role_changes("tester", tester_path, feature_dir)
            reset_global_logs_to_head(tester_path)
            enforce_role_scope(tester_path, "tester", feature_dir)
            commit_worktree_changes(tester_path, "tester", work_item_id, feature_dir)
            ensure_clean_worktree(root, tester_path, patcher_branch, "tester")
            execution_attempt += 1
            last_failure_context = (
                "allowed tests validation failed: "
                + issue_summary
                + "; remediation: "
                + remediation
            )
            content = read_file(dev_tasks_path)
            content = update_entry_field(
                content, work_item_id, "Outcome", "needs replan"
            )
            content = append_iteration_log_note(
                content,
                work_item_id,
                f"Attempt {attempt}: allowed-tests validation failed; routed back to planner. Issues: {issue_summary}.",
            )
            content = append_noop_step_note(
                content,
                work_item_id,
                attempt=attempt,
                step="plan-reviewer",
                reason="blocked by invalid allowed tests",
            )
            content = append_noop_step_note(
                content,
                work_item_id,
                attempt=attempt,
                step="patcher",
                reason="blocked by invalid allowed tests",
            )
            content = append_noop_step_note(
                content,
                work_item_id,
                attempt=attempt,
                step="reporter",
                reason="blocked by invalid allowed tests",
            )
            write_file(dev_tasks_path, content)
            continue
        if planner_updates:
            if not extract_field(content, "Planner"):
                content = update_entry_field(content, work_item_id, "Planner", "Codex")
                write_file(dev_tasks_path, content)
            ensure_role_log(
                os.path.join(planner_path, role_paths["planner"]), "planner"
            )
            note = (
                planner_note
                or "Updated Allowed Tests to satisfy existence and scope checks."
            )
            append_role_log(
                os.path.join(planner_path, role_paths["planner"]),
                work_item_id,
                note,
                role="planner",
            )
            format_role_changes("planner", planner_path, feature_dir)
            enforce_role_scope(planner_path, "planner", feature_dir)
            commit_worktree_changes(planner_path, "planner", work_item_id, feature_dir)
            ensure_clean_worktree(root, planner_path, patcher_branch, "planner")

        content = read_file(dev_tasks_path)
        current_plan = get_entry_section(content, work_item_id, "Plan")
        allowed_section = get_entry_section(content, work_item_id, "Allowed Tests")
        tdd_section = get_entry_section(content, work_item_id, "TDD Plan")
        anti_hardcode_issues = anti_hardcode_coverage_issues(current_plan, tdd_section)
        plan_reviewer_prompt = render_prompt_template(
            load_prompt_template("plan-reviewer", "gate"),
            {
                "work_item_id": work_item_id,
                "current_plan": current_plan,
                "allowed_tests": allowed_section,
            },
        )
        if anti_hardcode_issues:
            reviewer_feedback = anti_hardcode_block_feedback(anti_hardcode_issues)
        else:
            reviewer_feedback = codex_exec(
                plan_reviewer_prompt,
                cwd=planner_path,
                profile="Planner",
                runner_metadata=runner_metadata,
                root=root,
            ).strip()
            ensure_plan_reviewer_read_only(planner_path)
        reviewer_decision = parse_plan_reviewer_decision(reviewer_feedback)
        if reviewer_decision == "BLOCK":
            last_failure_context = (
                "plan reviewer blocked plan; planner revision required."
            )
            reviewer_blocks += 1
            if reviewer_blocks > MAX_REVIEWER_BLOCKS:
                die(
                    "pc-feature: max plan-reviewer block attempts reached; "
                    "check planner/reviewer feedback for unresolved policy constraints"
                )
            ensure_role_log(
                os.path.join(planner_path, role_paths["planner"]), "planner"
            )
            append_role_log(
                os.path.join(planner_path, role_paths["planner"]),
                work_item_id,
                f"Plan Reviewer feedback (BLOCK):\n{reviewer_feedback}",
                role="planner",
            )
            planner_update_prompt = render_prompt_template(
                load_prompt_template("planner", "update-from-feedback"),
                {
                    "work_item_id": work_item_id,
                    "current_plan": current_plan,
                    "reviewer_feedback": reviewer_feedback,
                },
            )
            revised_plan = codex_exec(
                planner_update_prompt,
                cwd=planner_path,
                profile="Planner",
                runner_metadata=runner_metadata,
                root=root,
            ).strip()
            if not revised_plan:
                die("pc-feature: planner returned empty plan after reviewer block")
            content = read_file(dev_tasks_path)
            content = replace_entry_section(content, work_item_id, "Plan", revised_plan)
            content = append_iteration_log_note(
                content,
                work_item_id,
                f"Attempt {attempt}: Plan Reviewer BLOCK; planner updated plan (block count: {reviewer_blocks}).",
            )
            write_file(dev_tasks_path, content)
            format_role_changes("planner", planner_path, feature_dir)
            enforce_role_scope(planner_path, "planner", feature_dir)
            commit_worktree_changes(planner_path, "planner", work_item_id, feature_dir)
            ensure_clean_worktree(root, planner_path, patcher_branch, "planner")
            continue
        content = read_file(dev_tasks_path)
        content = append_iteration_log_note(
            content,
            work_item_id,
            f"Attempt {attempt}: Plan Reviewer APPROVE; proceeding to patch.",
        )
        write_file(dev_tasks_path, content)

        execution_attempt += 1
        smoke_command = allowed_tests[0] if allowed_tests else ""
        if smoke_command:
            smoke_cmd = ["tools/offload-proxy/pp"] + shlex.split(smoke_command)
            smoke_exit = run_command(smoke_cmd, cwd=patcher_path)
            review_items.append(
                format_review_item(f"prepatch smoke {smoke_command}", smoke_exit)
            )

        content = read_file(dev_tasks_path)
        if not entry_section_complete(content, work_item_id, "Patch"):
            patch_prompt = render_prompt_template(
                load_prompt_template("patcher", "apply"),
                {
                    "work_item_id": work_item_id,
                    "plan": get_entry_section(content, work_item_id, "Plan"),
                },
            )
            codex_exec(
                patch_prompt,
                capture_output=True,
                cwd=patcher_path,
                profile="Patcher",
                runner_metadata=runner_metadata,
                root=root,
            ).strip()
            format_role_changes("patcher", patcher_path, feature_dir)
            reset_role_logs_to_head(patcher_path, feature_dir)
            reset_global_logs_to_head(patcher_path)
            enforce_role_scope(patcher_path, "patcher", feature_dir)
            commit_worktree_changes(patcher_path, "patcher", work_item_id, feature_dir)
            requires_global_logs = requires_global_logs or process_docs_changed(
                commit_paths(patcher_path)
            )
            ensure_clean_worktree(root, patcher_path, patcher_branch, "patcher")
        else:
            content = append_noop_step_note(
                content,
                work_item_id,
                attempt=attempt,
                step="patcher",
                reason="patch already present",
            )
            write_file(dev_tasks_path, content)

        reset_dev_tasks_if_dirty(tester_path, dev_tasks_path)
        content = read_file(dev_tasks_path)
        allowed_section = get_entry_section(content, work_item_id, "Allowed Tests")
        allowed_tests = parse_allowed_tests(allowed_section)
        forbidden = [cmd for cmd in allowed_tests if is_forbidden_test(cmd)]
        missing = check_allowed_tests_exist(allowed_tests, tester_path)
        if not allowed_tests or forbidden or missing:
            if not allowed_tests:
                note = "No allowed tests are listed."
            elif forbidden:
                note = "Forbidden tests detected: " + "; ".join(forbidden)
            else:
                note = "Missing tests: " + "; ".join(sorted(set(missing)))
            tester_feedback = (
                "Outcome: FAIL\n"
                "Tests run: (none)\n"
                f"Notes: {note} Add specific, scoped tests to Allowed Tests; "
                "`make ci`, `make feature`, and `pc-feature` are forbidden.\n"
                f"Work Item ID: {work_item_id}\n"
            )
            ensure_role_log(os.path.join(tester_path, role_paths["tester"]), "tester")
            append_role_log(
                os.path.join(tester_path, role_paths["tester"]),
                work_item_id,
                tester_feedback,
                role="tester",
            )
            format_role_changes("tester", tester_path, feature_dir)
            reset_global_logs_to_head(tester_path)
            enforce_role_scope(tester_path, "tester", feature_dir)
            commit_worktree_changes(tester_path, "tester", work_item_id, feature_dir)
            ensure_clean_worktree(root, tester_path, patcher_branch, "tester")
            die("pc-feature: missing or forbidden allowed tests; update Allowed Tests")

        test_results: List[str] = []
        failed = False
        for cmd in allowed_tests:
            cmd_list = ["tools/offload-proxy/pp"] + shlex.split(cmd)
            exit_code = run_command_with_step_log(
                cmd_list,
                runner_metadata,
                step="tests",
                root=Path(root),
                label=cmd,
                cwd=tester_path,
            )
            test_results.append(f"{cmd} -> {exit_code}")
            if exit_code != 0:
                failed = True
        tester_outcome = "FAIL" if failed else "PASS"
        tests_run = "; ".join(allowed_tests)
        tester_feedback = (
            f"Outcome: {tester_outcome}\n"
            f"Tests run: {tests_run}\n"
            f"Notes: Results: {'; '.join(test_results)}\n"
            f"Work Item ID: {work_item_id}\n"
        )
        ensure_role_log(os.path.join(tester_path, role_paths["tester"]), "tester")
        append_role_log(
            os.path.join(tester_path, role_paths["tester"]),
            work_item_id,
            tester_feedback,
            role="tester",
        )
        format_role_changes("tester", tester_path, feature_dir)
        reset_global_logs_to_head(tester_path)
        enforce_role_scope(tester_path, "tester", feature_dir)
        commit_worktree_changes(tester_path, "tester", work_item_id, feature_dir)
        ensure_clean_worktree(root, tester_path, patcher_branch, "tester")

        if tester_outcome != "PASS":
            reporter_feedback = (
                "Outcome: SKIPPED\n"
                "Docs/logs updated: reporter deferred\n"
                "Notes: Reporter skipped because tester failed; planner must replan before review.\n"
                f"Work Item ID: {work_item_id}\n"
            )
            ensure_role_log(
                os.path.join(reporter_path, role_paths["reporter"]), "reporter"
            )
            append_role_log(
                os.path.join(reporter_path, role_paths["reporter"]),
                work_item_id,
                reporter_feedback,
                role="reporter",
            )
            format_role_changes("reporter", reporter_path, feature_dir)
            enforce_role_scope(reporter_path, "reporter", feature_dir)
            commit_worktree_changes(
                reporter_path, "reporter", work_item_id, feature_dir
            )
            content = read_file(dev_tasks_path)
            content = append_noop_step_note(
                content,
                work_item_id,
                attempt=attempt,
                step="reporter",
                reason="tester failed",
            )
            write_file(dev_tasks_path, content)
            reporter_outcome = "SKIPPED"
        else:
            reporter_note = ""
            if requires_global_logs:
                reporter_note = (
                    "Global logs will be auto-appended after gates when process docs change. "
                    "Do not fail solely due to missing docs/03-logs updates; note any gaps."
                )
            reporter_prompt = render_prompt_template(
                load_prompt_template("reporter", "review"),
                {
                    "work_item_id": work_item_id,
                    "reporter_note": reporter_note,
                },
            )
            reporter_feedback = codex_exec(
                reporter_prompt,
                cwd=reporter_path,
                profile="Reporter",
                runner_metadata=runner_metadata,
                root=root,
            ).strip()
            reporter_outcome = parse_outcome(reporter_feedback)
            ensure_role_log(
                os.path.join(reporter_path, role_paths["reporter"]), "reporter"
            )
            append_role_log(
                os.path.join(reporter_path, role_paths["reporter"]),
                work_item_id,
                reporter_feedback,
                role="reporter",
            )
            format_role_changes("reporter", reporter_path, feature_dir)
            enforce_role_scope(reporter_path, "reporter", feature_dir)
            commit_worktree_changes(
                reporter_path, "reporter", work_item_id, feature_dir
            )

        if tester_outcome != "PASS" or reporter_outcome != "PASS":
            last_failure_context = (
                f"tester={tester_outcome}; reporter={reporter_outcome}; "
                "planner/patcher feedback loop required."
            )
            content = read_file(dev_tasks_path)
            current_plan = get_entry_section(content, work_item_id, "Plan")
            feedback_blob = (
                "Tester feedback:\n"
                f"{tester_feedback.strip()}\n\n"
                "Reporter feedback:\n"
                f"{reporter_feedback.strip()}\n"
            )
            planner_feedback_prompt = render_prompt_template(
                load_prompt_template("planner", "update_from_feedback"),
                {
                    "work_item_id": work_item_id,
                    "current_plan": current_plan,
                    "tester_feedback": tester_feedback.strip(),
                    "reporter_feedback": reporter_feedback.strip(),
                    "failure_feedback": feedback_blob.strip(),
                },
            )
            planner_feedback = codex_exec(
                planner_feedback_prompt,
                cwd=planner_path,
                profile="Planner",
                runner_metadata=runner_metadata,
                root=root,
            ).strip()
            planner_decision = parse_feedback_plan_decision(planner_feedback)
            planner_rationale = parse_feedback_rationale(planner_feedback)
            updated_plan = current_plan
            if planner_decision == "REVISE_PLAN":
                revised_plan = parse_feedback_revised_plan(planner_feedback)
                if not revised_plan:
                    die(
                        "pc-feature: planner marked REVISE_PLAN but returned no Revised Plan section"
                    )
                content = replace_entry_section(
                    content, work_item_id, "Plan", revised_plan
                )
                updated_plan = revised_plan
            ensure_role_log(
                os.path.join(planner_path, role_paths["planner"]), "planner"
            )
            append_role_log(
                os.path.join(planner_path, role_paths["planner"]),
                work_item_id,
                planner_feedback,
                role="planner",
            )
            format_role_changes("planner", planner_path, feature_dir)
            enforce_role_scope(planner_path, "planner", feature_dir)
            commit_worktree_changes(planner_path, "planner", work_item_id, feature_dir)
            ensure_clean_worktree(root, planner_path, patcher_branch, "planner")

            patcher_feedback_prompt = render_prompt_template(
                load_prompt_template("patcher", "update_from_feedback"),
                {
                    "work_item_id": work_item_id,
                    "plan": updated_plan,
                    "tester_feedback": tester_feedback.strip(),
                    "reporter_feedback": reporter_feedback.strip(),
                    "failure_feedback": feedback_blob.strip(),
                    "planner_decision": planner_decision,
                    "planner_rationale": planner_rationale,
                },
            )
            codex_exec(
                patcher_feedback_prompt,
                capture_output=True,
                cwd=patcher_path,
                profile="Patcher",
                runner_metadata=runner_metadata,
                root=root,
            ).strip()
            format_role_changes("patcher", patcher_path, feature_dir)
            reset_role_logs_to_head(patcher_path, feature_dir)
            reset_global_logs_to_head(patcher_path)
            enforce_role_scope(patcher_path, "patcher", feature_dir)
            commit_worktree_changes(patcher_path, "patcher", work_item_id, feature_dir)
            requires_global_logs = requires_global_logs or process_docs_changed(
                commit_paths(patcher_path)
            )
            ensure_clean_worktree(root, patcher_path, patcher_branch, "patcher")

            rationale = planner_rationale if planner_rationale else "(not provided)"
            content = update_entry_field(
                content, work_item_id, "Outcome", "needs replan"
            )
            content = append_iteration_log_note(
                content,
                work_item_id,
                f"Attempt {attempt}: tester={tester_outcome}, reporter={reporter_outcome}; "
                f"planner decision={planner_decision}; rationale={rationale}; "
                "patcher feedback task executed.",
            )
            write_file(dev_tasks_path, content)
            continue

        break
    else:
        content = read_file(dev_tasks_path)
        content = update_entry_field(content, work_item_id, "Outcome", "needs replan")
        content = append_iteration_log_note(
            content,
            work_item_id,
            "Loop exhausted at MAX_LOOPS; "
            f"last failure context: {last_failure_context}",
        )
        content = update_entry_field(
            content,
            work_item_id,
            "Notes",
            "Loop exhausted; review Iteration Log for actionable remediation.",
        )
        write_file(dev_tasks_path, content)
        die("pc-feature: max iteration attempts reached; check execution log")

    base_ref = "HEAD"
    role_branches = [patcher_branch]
    for branch in role_branches:
        if branch_ahead_count(root, base_ref, branch) == 0:
            continue
        merge_paths = collect_branch_merge_paths(
            root,
            base_ref,
            branch,
            dev_tasks_path=dev_tasks_path,
            feature_dir=feature_dir,
        )
        if not apply_branch_diff(root, base_ref, branch, include_paths=merge_paths):
            content = read_file(dev_tasks_path)
            content = update_entry_field(
                content, work_item_id, "Outcome", "needs replan"
            )
            content = update_entry_field(
                content,
                work_item_id,
                "Notes",
                "Collection conflict while replaying patcher branch",
            )
            write_file(dev_tasks_path, content)
            die("pc-feature: conflict detected while collecting worktrees")

    allowed_stage_paths = collect_allowed_final_stage_paths(
        root, "refs/heads/main", patcher_branch, dev_tasks_path, feature_dir
    )
    gate_status = "FAIL"
    autofix_notes: List[str] = []
    ci_cmd = ["tools/offload-proxy/pp", "make", "ci"]
    first_ci_exit = run_command_with_step_log(
        ci_cmd,
        runner_metadata,
        step="ci",
        root=Path(root),
        label="make ci attempt=1",
    )
    review_items.append(
        format_review_item("tools/offload-proxy/pp make ci", first_ci_exit)
    )
    if first_ci_exit == 0:
        gate_status = "PASS"
    else:
        scoped_autofix_paths = stage_scoped_final_paths(root, allowed_stage_paths)
        staged_before_autofix = get_staged_paths(root)
        if sorted(set(scoped_autofix_paths)) != sorted(set(staged_before_autofix)):
            die("pc-feature: staged scope changed before autofix; aborting")
        autofix_exit = run_scoped_autofix(root, staged_before_autofix)
        autofix_notes.append(
            format_review_item(
                "tools/offload-proxy/pp pre-commit run --files <scoped>", autofix_exit
            )
        )
        second_ci_exit = run_command_with_step_log(
            ci_cmd,
            runner_metadata,
            step="ci",
            root=Path(root),
            label="make ci attempt=2",
        )
        review_items.append(
            format_review_item("tools/offload-proxy/pp make ci", second_ci_exit)
        )
        if second_ci_exit == 0:
            gate_status = "PASS"
    content = read_file(dev_tasks_path)
    content = replace_entry_section(
        content, work_item_id, "Gates", build_gates_block("make ci", gate_status)
    )
    if autofix_notes:
        content = replace_entry_section(
            content, work_item_id, "Autofix Attempts", "\n".join(autofix_notes)
        )
    write_file(dev_tasks_path, content)

    if gate_status != "PASS":
        content = read_file(dev_tasks_path)
        content = update_entry_field(content, work_item_id, "Outcome", "needs replan")
        write_file(dev_tasks_path, content)
        die(
            "pc-feature: make ci failed after final gate retry "
            f"(max attempts: {MAX_CI_ATTEMPTS})"
        )

    reporter_global_prompt = render_prompt_template(
        load_prompt_template("reporter", "global-log"),
        {
            "work_item_id": work_item_id,
        },
    )
    reporter_global_raw = codex_exec(
        reporter_global_prompt,
        cwd=reporter_path,
        profile="Reporter",
        runner_metadata=runner_metadata,
        root=root,
    ).strip()
    reporter_global_json = extract_json_payload(reporter_global_raw)
    try:
        reporter_global = json.loads(reporter_global_json)
    except json.JSONDecodeError:
        die(
            f"pc-feature: failed to parse reporter global log JSON\n{reporter_global_raw}"
        )
    implementation_line = str(reporter_global.get("implementation_log", "")).strip()
    validation_line = str(reporter_global.get("validation_log", "")).strip()
    decision_line = str(reporter_global.get("decision_log", "")).strip()
    if requires_global_logs:
        if not implementation_line:
            implementation_line = f"{work_item_id}: Process docs updated; placeholder implementation log entry."
        if not validation_line:
            validation_line = f"{work_item_id}: Process docs updated; placeholder validation log entry."
    if implementation_line:
        append_log_line(
            os.path.join("docs", "03-logs", "implementation-log.md"),
            implementation_line,
        )
    if validation_line:
        append_log_line(
            os.path.join("docs", "03-logs", "validation-log.md"),
            validation_line,
        )
    if decision_line and decision_line.lower() != "none":
        append_log_line(
            os.path.join("docs", "03-logs", "decision-log.md"),
            decision_line,
        )

    content = read_file(dev_tasks_path)
    commit_already_done = entry_section_complete(content, work_item_id, "Commit")
    commit_message = ""
    if commit_already_done:
        commit_message = parse_commit_message(
            get_entry_section(content, work_item_id, "Commit")
        )
    if not commit_message:
        commit_prompt = render_prompt_template(
            load_prompt_template("commit-message"),
            {
                "work_item_id": work_item_id,
            },
        )
        commit_message = codex_exec(
            commit_prompt,
            runner_metadata=runner_metadata,
            root=root,
        ).strip()
        if not commit_message:
            die("pc-feature: empty commit message from agent")
        content = replace_entry_section(
            content,
            work_item_id,
            "Commit",
            f"- Commit message: {commit_message}",
        )

    final_report = (
        "What changed (files): (see git diff)\n"
        "Tests written (names) + results: (see feature validation-log.md)\n"
        "Docs/logs updated checklist: (see Docs Updated)\n"
        f"make ci results: {gate_status}\n"
        f"Commands run (use pp for noisy output): {'; '.join(review_items)}\n"
        f"Commit message: {commit_message}"
    )
    content = replace_entry_section(content, work_item_id, "Final Report", final_report)
    content = update_entry_field(content, work_item_id, "Outcome", "pass")
    write_file(dev_tasks_path, content)

    if not commit_already_done:
        unstage_ephemeral_paths(root)
        staged_paths = stage_scoped_final_paths(root, allowed_stage_paths)
        commit_cmd = ["tools/pc-commit", "--yes", "--message", commit_message]
        for path in staged_paths:
            commit_cmd.extend(["--allow", path])
        for path in final_commit_allow_paths():
            commit_cmd.extend(["--allow", path])
        commit_result = subprocess.run(
            commit_cmd,
            check=False,
            cwd=root,
        )
        if commit_result.returncode != 0:
            die("pc-feature: failed to commit collected changes via tools/pc-commit")
    remove_worktree(root, patcher_path, patcher_branch)

    pc_runner.log_message(runner_metadata, "feature", "complete", root=Path(root))
    print("pc-feature: complete")


if __name__ == "__main__":
    main()
