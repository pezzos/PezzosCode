def merge_reporter_global_log_payload(
    reporter_payload: Optional[Dict[str, Any]],
    fallback_payload: Dict[str, str],
) -> Dict[str, str]:
    merged = dict(fallback_payload)
    if not reporter_payload:
        return merged
    for key in ("implementation_log", "validation_log", "decision_log"):
        value = str(reporter_payload.get(key, "")).strip()
        if not value or value.lower() == "none":
            continue
        merged[key] = value
    return merged


