def collect_allowed_final_stage_paths(
    root: str, base_ref: str, branch: str, dev_tasks_path: str, feature_dir: str
) -> List[str]:
    allowed = set(
        collect_branch_merge_paths(
            root,
            base_ref,
            branch,
            dev_tasks_path=dev_tasks_path,
            feature_dir=feature_dir,
        )
    )
    allowed.add(dev_tasks_path)
    allowed.update(global_log_paths())
    return sorted(allowed)


def stage_scoped_final_paths(root: str, allowed_paths: List[str]) -> List[str]:
    current_paths = set(filter_ignored_paths(get_status_paths(root)))
    allowed = set(filter_ignored_paths(allowed_paths))
    unexpected = sorted(path for path in current_paths if path not in allowed)
    if unexpected:
        die(
            "pc-feature: unrelated dirty paths block final commit; "
            "clean/stash these first: " + ", ".join(unexpected)
        )
    stage_paths = sorted(path for path in current_paths if path in allowed)
    if not stage_paths:
        die("pc-feature: no scoped changes to commit at final stage")
    commit_result = subprocess.run(
        ["git", "add", "--"] + stage_paths,
        check=False,
        cwd=root,
    )
    if commit_result.returncode != 0:
        die("pc-feature: failed to stage scoped changes")
    return stage_paths


def ensure_root_start_scope(root: str, allowed_paths: List[str]) -> None:
    current_paths = set(filter_ignored_paths(get_status_paths(root)))
    allowed = set(filter_ignored_paths(allowed_paths))
    unexpected = sorted(path for path in current_paths if path not in allowed)
    if unexpected:
        print(
            "pc-feature: warning: unrelated dirty paths detected before execution "
            "(preserved): " + ", ".join(unexpected)
        )


def get_staged_paths(root: str) -> List[str]:
    result = subprocess.run(
        ["git", "diff", "--cached", "--name-only"],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        cwd=root,
    )
    if result.returncode != 0:
        die(f"pc-feature: failed to read staged paths\n{result.stderr}")
    return [line.strip() for line in result.stdout.splitlines() if line.strip()]


def run_scoped_autofix(root: str, staged_paths: List[str]) -> int:
    scoped_paths = sorted(set(filter_ignored_paths(staged_paths)))
    if not scoped_paths:
        die("pc-feature: no staged files available for scoped autofix")
    autofix_cmd = [
        "tools/offload-proxy/pp",
        "pre-commit",
        "run",
        "--files",
    ] + scoped_paths
    autofix_exit = run_command(autofix_cmd, cwd=root)
    status_paths = set(filter_ignored_paths(get_status_paths(root)))
    scoped_set = set(scoped_paths)
    unexpected = sorted(path for path in status_paths if path not in scoped_set)
    if unexpected:
        die(
            "pc-feature: scoped autofix touched out-of-scope files: "
            + ", ".join(unexpected)
        )
    add_result = subprocess.run(
        ["git", "add", "--"] + scoped_paths,
        check=False,
        cwd=root,
    )
    if add_result.returncode != 0:
        die("pc-feature: failed to restage scoped autofix files")
    return autofix_exit


def append_log_line(path: str, line: str) -> None:
    content = read_file(path)
    if line in content:
        return
    content = content.rstrip() + f"\n\n- {line}\n"
    write_file(path, content)


def main() -> None:
    feature_id, manual = parse_args(sys.argv[1:])
    root = os.getcwd()
    current_branch = git_current_branch(root)
    if current_branch != "main":
        die("pc-feature: run from main branch only")
    feature_root = os.path.join("docs", "02-features")
    feature_dir = repo_relative_path(
        root,
        resolve_feature_dir(feature_root, feature_id),
        label=f"feature directory for id {feature_id}",
    )
    feature_slug = os.path.basename(feature_dir)
    print(
        f"pc-feature: requested feature id={feature_id}; resolved feature={feature_slug}"
    )
    resume_mode = parse_resume_mode()
    patcher_path = build_worktree_path(root, feature_slug, "patcher")
    patcher_branch = build_worktree_branch(feature_slug, "patcher")
    enforce_single_active_feature(root, feature_slug, patcher_path)
    existing_patcher_worktree = os.path.exists(patcher_path) and os.path.exists(
        os.path.join(patcher_path, ".git")
    )
    if existing_patcher_worktree:
        existing_branch = git_current_branch(patcher_path)
        if existing_branch == "main":
            die("pc-feature: existing patcher worktree is on main")
        if existing_branch != patcher_branch:
            die(
                "pc-feature: existing patcher worktree branch mismatch; "
                f"expected={patcher_branch} actual={existing_branch}"
            )
        dirty = bool(filter_ignored_paths(get_status_paths(patcher_path)))
        ahead = branch_ahead_count(root, "refs/heads/main", existing_branch) > 0
        behind = branch_behind_count(root, existing_branch, "refs/heads/main") > 0
        if resume_mode == RESUME_MODE_FRESH:
            print(
                "pc-feature: RESUME_MODE=fresh; recreating existing patcher worktree: "
                f"{patcher_path}"
            )
            remove_worktree(root, patcher_path, existing_branch)
            existing_patcher_worktree = False
            dirty = False
            ahead = False
            behind = False
        elif behind:
            print(
                "pc-feature: existing patcher worktree is behind main "
                f"(stale): {patcher_path}"
            )
            if resume_mode == RESUME_MODE_PROMPT:
                if not prompt_yes_no(
                    "pc-feature: recreate stale patcher worktree from main? [y/N]"
                ):
                    die("pc-feature: aborted by user; stale patcher worktree preserved")
                remove_worktree(root, patcher_path, existing_branch)
                existing_patcher_worktree = False
                dirty = False
                ahead = False
            else:
                die(
                    "pc-feature: existing patcher worktree is stale (behind main); "
                    "main must remain unchanged while a feature is in progress. "
                    f"Path: {patcher_path}"
                )
        if existing_patcher_worktree and (dirty or ahead):
            reasons: List[str] = []
            if dirty:
                reasons.append("dirty")
            if ahead:
                reasons.append("ahead-of-main")
            print(
                "pc-feature: existing patcher worktree is not pristine "
                f"({', '.join(reasons)}): {patcher_path}"
            )
            if resume_mode == RESUME_MODE_PROMPT:
                if not prompt_yes_no(
                    "pc-feature: continue with existing patcher worktree? [y/N]"
                ):
                    die(
                        "pc-feature: aborted by user; existing patcher worktree preserved"
                    )
            else:
                print(
                    "pc-feature: auto-resume enabled; continuing existing patcher worktree."
                )
    dev_tasks_repo_path = normalize_repo_rel(os.path.join(feature_dir, "dev-tasks.md"))
    patcher_path, patcher_branch = prepare_worktree(
        root, feature_slug, "patcher", "main"
    )
    planner_path = patcher_path
    reviewer_path = patcher_path
    tester_path = patcher_path
    reporter_path = patcher_path
    dev_tasks_path = worktree_runtime_path(
        patcher_path,
        dev_tasks_repo_path,
        label="dev-tasks.md",
        must_exist=True,
    )
    content = read_file(dev_tasks_path)
    ensure_execution_log(content)
    role_paths = worktree_role_paths(feature_dir)
    role_paths_abs = {
        role: worktree_runtime_path(
            patcher_path, role_path, label=f"{role} role log", must_exist=False
        )
        for role, role_path in role_paths.items()
    }
    resume_work_item_id = select_resume_work_item_id(content)
    dirty_before_checkpoint = sorted(
        filter_ignored_paths(get_status_paths(patcher_path))
    )
    if dirty_before_checkpoint:
        print(
            "pc-feature: startup dirty paths detected in patcher worktree: "
            + ", ".join(dirty_before_checkpoint)
        )
        checkpointed_paths = checkpoint_resume_state(
            patcher_path,
            resume_work_item_id,
            feature_slug=feature_slug,
        )
        if checkpointed_paths:
            print(
                "pc-feature: startup checkpoint commit created for paths: "
                + ", ".join(checkpointed_paths)
            )
    dirty_after_checkpoint = sorted(
        filter_ignored_paths(get_status_paths(patcher_path))
    )
    if dirty_after_checkpoint:
        die(
            "pc-feature: startup checkpoint left dirty paths in patcher worktree: "
            + ", ".join(dirty_after_checkpoint)
        )
    content = read_file(dev_tasks_path)
    work_item_id = select_resume_work_item_id(content)
    if not work_item_id:
        work_item_id = next_work_item_id(content)
        entry = build_execution_entry(work_item_id)
        content = insert_execution_entry(content, entry)
        write_file(dev_tasks_path, content)
    print_runtime_scope(
        worktree_path=patcher_path,
        feature_dir=feature_dir,
        dev_tasks_path=dev_tasks_path,
        role_log_paths_abs=role_paths_abs,
        work_item_id=work_item_id,
    )
    content = read_file(dev_tasks_path)
    content = ensure_allowed_tests_section(content, work_item_id)
    current_main_head = git_ref_sha(root, "refs/heads/main")
    notes_value = get_entry_field(content, work_item_id, "Notes")
    locked_main_head = parse_locked_main_head(notes_value)
    if locked_main_head:
        if locked_main_head != current_main_head:
            die(
                "pc-feature: main branch moved during feature execution; "
                f"locked={locked_main_head} current={current_main_head}. "
                "Workflow policy requires main to stay unchanged while a feature is running."
            )
    else:
        notes_value = set_locked_main_head_note(notes_value, current_main_head)
        content = update_entry_field(content, work_item_id, "Notes", notes_value)
        locked_main_head = current_main_head
    write_file(dev_tasks_path, content)
    start_allowed_paths = collect_allowed_final_stage_paths(
        root,
        "refs/heads/main",
        patcher_branch,
        dev_tasks_repo_path,
        feature_dir,
    )
    ensure_root_start_scope(root, start_allowed_paths)

    runner_metadata = pc_runner.build_metadata(work_item_id, "pc-feature")
    runner_root = Path(patcher_path)
    pc_runner.log_message(
        runner_metadata, "feature", "start pc-feature", root=runner_root
    )
    pc_runner.log_message(
        runner_metadata,
        "feature",
        f"feature-id requested={feature_id} resolved={feature_slug}",
        root=runner_root,
    )

    if manual:
        pc_runner.log_message(
            runner_metadata, "feature", "manual mode enabled; exit", root=runner_root
        )
