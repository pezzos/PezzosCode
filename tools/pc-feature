    if not match:
        return ""
    return match.group(1).lower()


def set_locked_main_head_note(notes: str, head_sha: str) -> str:
    head = head_sha.strip().lower()
    marker = f"{MAIN_FREEZE_NOTE_PREFIX} {head}"
    base_notes = (notes or "").strip()
    if not base_notes:
        return marker
    pattern = re.escape(MAIN_FREEZE_NOTE_PREFIX) + r"\s*[0-9a-f]{40}"
    if re.search(pattern, base_notes, re.IGNORECASE):
        return re.sub(pattern, marker, base_notes, flags=re.IGNORECASE)
    return f"{base_notes}; {marker}"


