def parse_entry_sections(
    content: str, work_item_id: str
) -> Tuple[Dict[str, str], Set[str]]:
    lines = content.splitlines()
    start, end = find_entry_block(lines, work_item_id)
    entry_lines = lines[start:end]
    sections: Dict[str, str] = {}
    duplicates: Set[str] = set()
    cursor = 0
    while cursor < len(entry_lines):
        line = entry_lines[cursor]
        if not line.startswith(SECTION_PREFIX):
            cursor += 1
            continue
        title = line[len(SECTION_PREFIX) :].strip()
        body_start = cursor + 1
        body_end = len(entry_lines)
        for idx in range(body_start, len(entry_lines)):
            if entry_lines[idx].startswith(SECTION_PREFIX):
                body_end = idx
                break
        body = "\n".join(entry_lines[body_start:body_end]).strip()
        if title in sections:
            duplicates.add(title)
        else:
            sections[title] = body
        cursor = body_end
    return sections, duplicates


def commit_evidence_gate_issues(content: str, work_item_id: str) -> List[str]:
    issues: List[str] = []
    sections, duplicates = parse_entry_sections(content, work_item_id)
    tests_run_field = get_entry_field(content, work_item_id, "Tests run").strip()
    if not tests_run_field:
        issues.append("missing top execution field: Tests run")

    for section in REQUIRED_COMMIT_EVIDENCE_SECTIONS:
        if section in duplicates:
            issues.append(f"duplicate required section heading: {section}")
        body = sections.get(section, "").strip()
        if section not in sections:
            issues.append(f"missing required section: {section}")
            continue
        if not body:
            issues.append(f"required section is empty: {section}")
            continue
        if "(pending)" in body.lower():
            issues.append(f"required section still pending: {section}")

    test_results = sections.get("Test Results", "")
    if test_results:
        if not parse_section_outcome(test_results):
            issues.append("Test Results is missing Outcome")

    commit_body = sections.get("Commit", "")
    if commit_body and not parse_commit_message(commit_body):
        issues.append("Commit section is missing Commit message")

    final_report = sections.get("Final Report", "")
    if final_report:
        for label in REQUIRED_FINAL_REPORT_FIELDS:
            if not parse_labeled_line(final_report, label):
                issues.append(f"Final Report is missing required field: {label}")

    return issues


