    docs_updated = parse_labeled_line(reporter_feedback, "Docs/logs updated")
    if not docs_updated:
        return ["reporter feedback is missing Docs/logs updated summary"]
    lowered = docs_updated.lower()
    markers = (
        "compacted",
        "docs/03-logs",
        "implementation-log",
        "validation-log",
        "decision-log",
    )
    if any(marker in lowered for marker in markers):
        return []
    return ["reporter Docs/logs updated summary lacks compacted/traceability evidence"]


