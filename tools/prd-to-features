        "- **TC-F003:** Verify skip behavior for done/deferred/rejected items.\n\n"
        "### Edge Cases\n\n"
        "- Missing status lines in existing `dev-tasks.md`.\n"
        "- Existing folder index/slug drift.\n"
        "- Missing template files in partially-created folders.\n\n"
        "## Exit Criteria\n\n"
        f"- `{summary}`\n"
        "- Targeted automated tests pass.\n"
        "- Validation evidence is recorded in `docs/03-logs/validation-log.md`.\n"
    )


def build_core_documents(
    feature: FeatureRecord, surfaces: List[str], folder_name: str
) -> Dict[str, str]:
    updated_on = date.today().isoformat()
    return {
        "feature-spec.md": render_feature_spec(feature, surfaces, updated_on),
        "tech-design.md": render_tech_design(
            feature, surfaces, updated_on, folder_name
        ),
        "dev-tasks.md": render_dev_tasks(feature, surfaces, updated_on),
        "test-plan.md": render_test_plan(feature, surfaces, updated_on),
    }


def document_needs_hydration(content: str) -> bool:
    if any(marker in content for marker in TEMPLATE_PLACEHOLDER_MARKERS):
        return True
    non_empty_lines = [line for line in content.splitlines() if line.strip()]
    return len(non_empty_lines) <= 4


def write_if_changed(path: Path, content: str) -> bool:
    if path.exists():
        existing = path.read_text(encoding="utf-8")
        if existing == content:
            return False
    path.write_text(content, encoding="utf-8")
    return True


def hydrate_core_documents(
    target_dir: Path,
    feature: FeatureRecord,
    surfaces: List[str],
    force: bool = False,
) -> List[str]:
    rendered = build_core_documents(feature, surfaces, target_dir.name)
    changed: List[str] = []
    for filename in CORE_DOC_FILES:
        content = rendered[filename]
        path = target_dir / filename
        if not path.exists():
            if write_if_changed(path, content):
                changed.append(filename)
            continue
        existing = path.read_text(encoding="utf-8")
        if force or document_needs_hydration(existing):
            if write_if_changed(path, content):
                changed.append(filename)
    return changed


def update_missing_files(
    target_dir: Path, template_dir: Path
) -> Tuple[List[str], List[str]]:
    created: List[str] = []
    skipped: List[str] = []
    for entry in sorted(template_dir.iterdir(), key=lambda p: p.name):
        dest = target_dir / entry.name
        if dest.exists():
            skipped.append(entry.name)
            continue
        if entry.is_dir():
            shutil.copytree(entry, dest)
        else:
            shutil.copy2(entry, dest)
        created.append(entry.name)
    return created, skipped


def ensure_execution_log_section(dev_tasks_path: Path) -> bool:
    if not dev_tasks_path.exists():
        return False
    content = dev_tasks_path.read_text(encoding="utf-8")
    if re.search(r"^\s*##\s+Execution Log\s*$", content, re.IGNORECASE | re.MULTILINE):
        return False
    insert_block = f"{EXEC_LOG_HEADER}\n\n- No runs yet.\n\n"
    if "## Task Breakdown" in content:
        content = content.replace(
            "## Task Breakdown", insert_block + "## Task Breakdown", 1
        )
    else:
        content = content.rstrip() + "\n\n" + insert_block
    dev_tasks_path.write_text(content, encoding="utf-8")
    return True


def create_feature_folder(
    target_dir: Path, template_dir: Path
) -> Tuple[List[str], List[str]]:
    target_dir.mkdir(parents=True, exist_ok=False)
    return update_missing_files(target_dir, template_dir)


def apply_prd_to_features(
    root: Path,
    prd_path: Path = DEFAULT_PRD_PATH,
    features_dir: Path = DEFAULT_FEATURES_DIR,
    *,
    include_process_features: bool = False,
) -> Dict[str, List[ActionResult]]:
    prd_file = root / prd_path
    features_root = root / features_dir
    template_dir = features_root / TEMPLATE_DIRNAME
    if not prd_file.exists():
        raise FileNotFoundError(f"Missing PRD: {prd_file}")
    if not template_dir.exists():
        raise FileNotFoundError(f"Missing feature template: {template_dir}")
    prd_text = prd_file.read_text(encoding="utf-8")
    prd_features = parse_prd_features(
        prd_text, include_process_features=include_process_features
    )
    prd_features = apply_feature_order_plan(root, prd_features)
    surfaces = infer_product_surfaces(prd_text, prd_features)
    log_skip_reasons = extract_log_skip_reasons(root, prd_features)
    existing = discover_existing_features(features_root)
    by_index = existing["by_index"]
    by_slug = existing["by_slug"]
    summary: Dict[str, List[ActionResult]] = {
        "created": [],
        "updated": [],
        "skipped": [],
    }
    for feature in prd_features:
        desired_index = feature.index
        desired_slug = feature.slug
        desired_name = f"{desired_index:02d}-{desired_slug}"
        existing_feature = None
        drift_reason = None
        if desired_index in by_index:
            existing_feature = by_index[desired_index]
            if existing_feature.slug != desired_slug:
                drift_reason = (
                    f"index {desired_index:02d} already mapped to "
                    f"{existing_feature.path.name}; not renaming"
                )
        elif desired_slug in by_slug:
            existing_feature = by_slug[desired_slug]
            if (
                existing_feature.index is not None
                and existing_feature.index != desired_index
            ):
                drift_reason = (
                    f"slug exists at index {existing_feature.index:02d}; not reindexing"
                )
        if feature.slug in log_skip_reasons:
            reason_parts = [log_skip_reasons[feature.slug]]
            if drift_reason:
                reason_parts.append(drift_reason)
            summary["skipped"].append(
                ActionResult(
                    name=(
                        existing_feature.path.name if existing_feature else desired_name
                    ),
                    action="skipped",
                    reason="; ".join(reason_parts),
                )
            )
            continue
        if existing_feature:
            status, status_note = parse_dev_tasks_status(
                existing_feature.path / "dev-tasks.md"
            )
            if status_is_done(status):
                summary["skipped"].append(
                    ActionResult(
                        name=existing_feature.path.name,
                        action="skipped",
                        reason="Status: Done",
                        details=[note for note in [drift_reason] if note],
                    )
                )
                continue
            created, _ = update_missing_files(existing_feature.path, template_dir)
            hydrated = hydrate_core_documents(
                existing_feature.path, feature, surfaces, force=False
            )
            repaired_exec_log = ensure_execution_log_section(
                existing_feature.path / "dev-tasks.md"
            )
            details: List[str] = list(created) + list(hydrated)
            if repaired_exec_log:
                details.append("dev-tasks.md")
            details = ordered_unique(details)
            if details:
                reason_parts = []
                if created:
                    reason_parts.append("missing template files")
                if hydrated:
                    reason_parts.append("hydrated placeholder/incomplete core docs")
                if repaired_exec_log:
                    reason_parts.append(
                        "dev-tasks.md missing Execution Log (autofixed)"
                    )
                if status_note:
                    reason_parts.append(status_note)
                if drift_reason:
                    reason_parts.append(drift_reason)
                summary["updated"].append(
                    ActionResult(
                        name=existing_feature.path.name,
                        action="updated",
                        reason="; ".join(reason_parts),
                        details=details,
                    )
                )
            else:
                reason_parts = ["existing folder; no missing sections"]
                if status_note:
                    reason_parts.append(status_note)
                if drift_reason:
                    reason_parts.append(drift_reason)
                summary["skipped"].append(
                    ActionResult(
                        name=existing_feature.path.name,
                        action="skipped",
                        reason="; ".join(reason_parts),
                    )
                )
            continue
        target_dir = features_root / desired_name
        created, _ = create_feature_folder(target_dir, template_dir)
        hydrated = hydrate_core_documents(target_dir, feature, surfaces, force=True)
        repaired_exec_log = ensure_execution_log_section(target_dir / "dev-tasks.md")
        details = ordered_unique(
            created + hydrated + (["dev-tasks.md"] if repaired_exec_log else [])
        )
        reason_parts = [f"missing feature folder from PRD ({feature.priority})"]
        if hydrated:
            reason_parts.append("hydrated core docs")
        summary["created"].append(
            ActionResult(
                name=desired_name,
                action="created",
                reason="; ".join(reason_parts),
                details=details,
            )
        )
        new_feature = ExistingFeature(
            path=target_dir, index=desired_index, slug=desired_slug
        )
        by_index.setdefault(desired_index, new_feature)
        by_slug.setdefault(desired_slug, new_feature)
    return summary


def format_summary(summary: Dict[str, List[ActionResult]]) -> str:
    lines = ["prd-to-features summary"]
    for key in ("created", "updated", "skipped"):
        lines.append(f"{key}:")
        items = summary.get(key, [])
        if not items:
            lines.append("- (none)")
            continue
        for item in items:
            detail = ""
            if item.details:
                detail = f" [{', '.join(item.details)}]"
            lines.append(f"- {item.name}: {item.reason}{detail}")
    return "\n".join(lines)


def parse_args(argv: Optional[List[str]] = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Generate or update feature folders from the PRD incrementally."
    )
    parser.add_argument(
        "--root",
        default=str(ROOT),
        help="Repository root (defaults to detected root).",
    )
    parser.add_argument(
        "--include-process-features",
        action="store_true",
        help="Include PRD '## Process Features' entries in generated feature folders.",
    )
    return parser.parse_args(argv)


def main(argv: Optional[List[str]] = None) -> int:
    args = parse_args(argv)
    root = Path(args.root).resolve()
    summary = apply_prd_to_features(
        root,
        include_process_features=bool(args.include_process_features),
    )
    print(format_summary(summary))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
