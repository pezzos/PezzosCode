def slugify(title: str) -> str:
    slug = re.sub(r"[^a-z0-9]+", "-", title.strip().lower())
    return slug.strip("-")


def normalize_sentence(text: str, fallback: str) -> str:
    value = re.sub(r"\s+", " ", text.strip()) if text else ""
    if not value:
        value = fallback
    if not value.endswith("."):
        value += "."
    return value


def ordered_unique(values: Iterable[str]) -> List[str]:
    seen = set()
    ordered: List[str] = []
    for value in values:
        if value in seen:
            continue
        seen.add(value)
        ordered.append(value)
    return ordered


def parse_prd_features(
    prd_text: str, *, include_process_features: bool = False
) -> List[FeatureRecord]:
    features: List[Tuple[str, str, str, str, Tuple[str, ...], str]] = []
    lines = prd_text.splitlines()
    features.extend(_parse_feature_table(lines))
    if include_process_features:
        features.extend(_parse_process_features(lines))
    seen = set()
    ordered: List[Tuple[str, str, str, str, Tuple[str, ...], str]] = []
    for priority, title, outcome, notes, dependencies, source in features:
        key = slugify(title)
        if key in seen:
            continue
        seen.add(key)
        ordered.append((priority, title, outcome, notes, dependencies, source))
    prd_features: List[FeatureRecord] = []
    index = 1
    for priority, title, outcome, notes, dependencies, source in ordered:
        if priority not in {"P0", "P1"}:
            continue
        prd_features.append(
            FeatureRecord(
                index=index,
                title=title,
                priority=priority,
                slug=slugify(title),
                dependencies=tuple(ordered_unique(dependencies)),
                source=source,
                outcome=outcome,
                notes=notes,
            )
        )
        index += 1
    return prd_features


def parse_dependencies(value: str) -> Tuple[str, ...]:
    if not value:
        return ()
    separators = re.compile(r"[,\|;/]")
    raw_parts = separators.split(value)
    parsed: List[str] = []
    for raw in raw_parts:
        candidate = raw.strip()
        if not candidate:
            continue
        lowered = candidate.lower()
        if lowered in {"none", "n/a", "na", "-", "[]"}:
            continue
        parsed.append(candidate)
    return tuple(ordered_unique(parsed))


def _parse_feature_table(
    lines: Iterable[str],
) -> List[Tuple[str, str, str, str, Tuple[str, ...], str]]:
    in_section = False
    rows: List[Tuple[str, str, str, str, Tuple[str, ...], str]] = []
    column_map: Dict[str, int] = {}
    for line in lines:
        stripped = line.strip()
        if stripped.lower().startswith("## prioritized feature list"):
            in_section = True
            continue
        if in_section and stripped.startswith("## "):
            break
        if not in_section:
            continue
        if not stripped.startswith("|"):
            continue
        cells = [cell.strip() for cell in stripped.strip("|").split("|")]
        if len(cells) < 2:
            continue
        if cells[0].lower() == "priority":
            column_map = {cell.strip().lower(): idx for idx, cell in enumerate(cells)}
            continue
        if set(cells[0]) <= {"-"}:
            continue
        if column_map:

            def cell(col: str, fallback_idx: int) -> str:
                idx = column_map.get(col, fallback_idx)
                if idx < 0 or idx >= len(cells):
                    return ""
                return cells[idx]

            priority = cell("priority", 0)
            title = cell("feature", 1)
            outcome = cell("outcome", 2)
            notes = cell("notes", 3)
            dependencies_raw = ""
            if "dependencies" in column_map and column_map["dependencies"] < len(cells):
                dependencies_raw = cells[column_map["dependencies"]]
        else:
            priority = cells[0]
            title = cells[1]
            outcome = cells[2] if len(cells) >= 3 else ""
            notes = cells[3] if len(cells) >= 4 else ""
            dependencies_raw = cells[4] if len(cells) >= 5 else ""
        rows.append(
            (
                priority,
                title,
                outcome,
                notes,
                parse_dependencies(dependencies_raw),
                "table",
            )
        )
    return rows


def _parse_process_features(
    lines: Iterable[str],
) -> List[Tuple[str, str, str, str, Tuple[str, ...], str]]:
    in_section = False
    rows: List[Tuple[str, str, str, str, Tuple[str, ...], str]] = []
    pattern = re.compile(r"^- \[[ xX]\]\s*(.+?)\s*\((P\d)\)\s*:?\s*(.*)$")
    for line in lines:
        stripped = line.rstrip()
        if stripped.lower().startswith("## process features"):
            in_section = True
            continue
        if in_section and stripped.startswith("## "):
            break
        if not in_section:
            continue
        match = pattern.match(stripped)
        if not match:
            continue
        title = match.group(1)
        priority = match.group(2)
        details = match.group(3).strip()
        outcome = normalize_sentence(
            details, f"Deliver {title.lower()} according to the PRD."
        )
        rows.append((priority, title, outcome, details, (), "process"))
    return rows


def reindex_features(features: List[FeatureRecord]) -> List[FeatureRecord]:
    reindexed: List[FeatureRecord] = []
    for idx, feature in enumerate(features, start=1):
        reindexed.append(
            FeatureRecord(
                index=idx,
                title=feature.title,
                priority=feature.priority,
                slug=feature.slug,
                dependencies=feature.dependencies,
                source=feature.source,
                outcome=feature.outcome,
                notes=feature.notes,
            )
        )
    return reindexed


def apply_feature_order_plan(
    root: Path,
    features: List[FeatureRecord],
    order_plan_path: Path = FEATURE_ORDER_PLAN_PATH,
) -> List[FeatureRecord]:
    if not features:
        return features
    plan_file = root / order_plan_path
    if not plan_file.exists():
        return features
    try:
        payload = json.loads(plan_file.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError):
        return features
    if not isinstance(payload, dict):
        return features
    ordered_slugs = payload.get("ordered_feature_slugs", [])
    if not isinstance(ordered_slugs, list):
        return features
    slug_to_feature = {feature.slug: feature for feature in features}
    ordered: List[FeatureRecord] = []
    seen = set()
    for slug in ordered_slugs:
        if not isinstance(slug, str):
            continue
        key = slug.strip()
        if not key or key in seen:
            continue
        feature = slug_to_feature.get(key)
        if not feature:
            continue
        ordered.append(feature)
        seen.add(key)
    for feature in features:
        if feature.slug in seen:
            continue
        ordered.append(feature)
        seen.add(feature.slug)
    return reindex_features(ordered)


def discover_existing_features(
    features_dir: Path,
) -> Dict[str, Dict[str, ExistingFeature]]:
    by_index: Dict[int, ExistingFeature] = {}
    by_slug: Dict[str, ExistingFeature] = {}
    if not features_dir.exists():
        return {"by_index": {}, "by_slug": {}}
    for entry in sorted(features_dir.iterdir(), key=lambda p: p.name):
        if not entry.is_dir():
            continue
        if entry.name == TEMPLATE_DIRNAME:
            continue
        match = re.match(r"^(\d+)-(.+)$", entry.name)
        index = int(match.group(1)) if match else None
        slug = match.group(2) if match else entry.name
        feature = ExistingFeature(path=entry, index=index, slug=slug)
        if index is not None and index not in by_index:
            by_index[index] = feature
        if slug not in by_slug:
            by_slug[slug] = feature
    return {"by_index": by_index, "by_slug": by_slug}


def parse_dev_tasks_status(dev_tasks_path: Path) -> Tuple[Optional[str], Optional[str]]:
    if not dev_tasks_path.exists():
        return None, "dev-tasks.md missing"
    content = dev_tasks_path.read_text(encoding="utf-8")
    for line in content.splitlines():
        stripped = line.strip()
        if stripped.lower().startswith("status:"):
            value = stripped.split(":", 1)[1].strip()
            if not value:
                return None, "Status line missing value"
            return value, None
        bold_match = re.match(r"^\*\*status:\*\*\s*(.+)$", stripped, re.IGNORECASE)
        if bold_match:
            value = bold_match.group(1).strip()
            if not value:
                return None, "Status line missing value"
            return value, None
    return None, "Status line not found"


def status_is_done(status: Optional[str]) -> bool:
    if not status:
        return False
    return bool(re.match(r"^(done|completed|shipped)\b", status.strip(), re.IGNORECASE))


def feature_matches_line(feature: FeatureRecord, line: str) -> bool:
    normalized = line.lower()
    if feature.title.lower() in normalized:
        return True
    if feature.slug in normalized:
        return True
    if feature.slug.replace("-", " ") in normalized:
        return True
    return False


def extract_log_skip_reasons(
    root: Path, features: List[FeatureRecord]
) -> Dict[str, str]:
    reasons: Dict[str, str] = {}
    for rel_path in LOG_PATHS:
        path = root / rel_path
        if not path.exists():
            continue
        lines = path.read_text(encoding="utf-8").splitlines()
        for lineno, line in enumerate(lines, start=1):
            lowered = line.lower()
            for feature in features:
                if feature.slug in reasons:
                    continue
                if not feature_matches_line(feature, lowered):
                    continue
                for label, keywords in LOG_SKIP_KEYWORDS.items():
                    if any(keyword in lowered for keyword in keywords):
                        reasons[feature.slug] = (
                            f"{label} marker in {rel_path.as_posix()}:{lineno}"
                        )
                        break
    return reasons


def parse_checked_surfaces(prd_text: str) -> List[str]:
    selected: List[str] = []
    for line in prd_text.splitlines():
        match = re.match(
            r"^\s*-\s*\[(x|X)\]\s*(CLI|TUI|API|Web UI|Desktop UI|Mobile UI)\s*$",
            line.strip(),
        )
        if match:
            selected.append(match.group(2))
    return ordered_unique(selected)


def infer_product_surfaces(prd_text: str, features: List[FeatureRecord]) -> List[str]:
    checked = parse_checked_surfaces(prd_text)
    if checked:
        return checked
    feature_evidence = " ".join(
        " ".join(
            part
            for part in (feature.title, feature.outcome, feature.notes)
            if part.strip()
        )
        for feature in features
    )
    evidence = (
        feature_evidence + "\n" + "\n".join(prd_text.splitlines()[:180])
    ).lower()
    patterns = {
        "CLI": (r"\bcli\b", r"\bcommand line\b"),
        "TUI": (r"\btui\b", r"\bterminal ui\b"),
        "API": (r"\bapi\b", r"\bendpoint\b", r"\bendpoints\b"),
        "Web UI": (r"\bweb ui\b", r"\bweb app\b", r"\bbrowser\b"),
        "Desktop UI": (r"\bdesktop ui\b", r"\bdesktop app\b"),
        "Mobile UI": (r"\bmobile ui\b", r"\bmobile app\b"),
    }
    scores: Dict[str, int] = {}
    for surface, surface_patterns in patterns.items():
        scores[surface] = sum(
            len(re.findall(pattern, evidence)) for pattern in surface_patterns
        )
    selected: List[str] = []
    if scores["CLI"] > 0:
        selected.append("CLI")
    for surface in SURFACE_ORDER:
        if surface == "CLI":
            continue
        if scores[surface] >= 2:
            selected.append(surface)
    if not selected:
        selected = ["CLI"]
    return ordered_unique(selected)


def format_surface_checklist(surfaces: List[str]) -> str:
    selected = set(surfaces)
    lines = []
    for surface in SURFACE_ORDER:
        mark = "x" if surface in selected else " "
        lines.append(f"- [{mark}] {surface}")
    return "\n".join(lines)


