#!/usr/bin/env python3
"""Migrate legacy bootstrap work-item entries to current dev-tasks schema."""

from __future__ import annotations

import argparse
import re
import sys
from pathlib import Path
from typing import Dict, Iterable, List, Optional, Tuple

DEFAULT_ROOT = Path(__file__).resolve().parents[1]
FEATURES_DIR = Path("docs/02-features")
TEMPLATE_DIRNAME = "feature-template"
ENTRY_HEADER_PREFIX = "### "
SECTION_PREFIX = "#### "
WORK_ITEM_PATTERN = re.compile(r"^WI-\d{8}-\d{2}$")
SECTION_OUTCOME_PATTERN = re.compile(
    r"Outcome:\s*(PASS|FAIL|NEEDS REPLAN|SKIPPED)", re.IGNORECASE
)
ZERO_EXIT_PATTERN = re.compile(r"(?:->\s*0\b|exit\s*0\b)", re.IGNORECASE)
NON_ZERO_EXIT_PATTERN = re.compile(
    r"(?:->\s*[1-9]\d*\b|exit\s*[1-9]\d*\b)", re.IGNORECASE
)
SECTION_ALIASES = {
    "Files to Change": ("Files to Change + Change Budget",),
}
REQUIRED_SECTIONS = (
    "Preflight Report",
    "TDD Plan",
    "Allowed Tests",
    "Files to Change",
    "Docs Updated",
    "Plan",
    "Patch",
    "Test Results",
    "Reporter Review",
    "Gates",
    "Autofix Attempts",
    "Tester Feedback",
    "Reporter Feedback",
    "Iteration Log",
    "Commit",
    "Final Report",
)
LEGACY_OUTCOMES = {"pass", "done"}
LEGACY_SCOPE_MARKERS = (
    "bootstrap feature docs from prd",
    "bootstrap feature documentation from prd",
)
LEGACY_NOTES_MARKERS = ("initial hydration generated by `tools/prd-to-features`",)


def parse_args(argv: Optional[List[str]] = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Migrate legacy summary-only bootstrap work-item entries in dev-tasks.md."
        )
    )
    parser.add_argument(
        "--root",
        default=str(DEFAULT_ROOT),
        help="Repository root (defaults to detected root).",
    )
    parser.add_argument(
        "--feature",
        default="",
        help=(
            "Optional feature selector (e.g. '01' or full folder name "
            "'01-sample-feature')."
        ),
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Report planned updates without writing files.",
    )
    return parser.parse_args(argv)


def normalize_status(value: str) -> str:
    return " ".join(str(value or "").strip().split()).lower()


def section_variants(section: str) -> List[str]:
    variants = [section]
    variants.extend(SECTION_ALIASES.get(section, ()))
    return variants


def normalize_feature_selector(raw: str) -> str:
    return raw.strip()


def feature_dirs(features_root: Path, feature_selector: str) -> Iterable[Path]:
    selector = normalize_feature_selector(feature_selector)
    for entry in sorted(features_root.iterdir(), key=lambda item: item.name):
        if not entry.is_dir():
            continue
        if entry.name == TEMPLATE_DIRNAME:
            continue
        if not re.match(r"^\d+-", entry.name):
            continue
        if not selector:
            yield entry
            continue
        if entry.name == selector or entry.name.startswith(f"{selector}-"):
            yield entry


def parse_field_value(lines: List[str], field: str) -> str:
    prefix = f"- {field}:"
    for line in lines:
        stripped = line.strip()
        if stripped.startswith(prefix):
            return stripped.split(":", 1)[1].strip()
    return ""


def update_field(lines: List[str], field: str, value: str) -> bool:
    prefix = f"- {field}:"
    for idx, line in enumerate(lines):
        stripped = line.strip()
        if not stripped.startswith(prefix):
            continue
        lines[idx] = f"{prefix} {value}".rstrip()
        return True
    return False


def find_entry_blocks(lines: List[str]) -> List[Tuple[str, int, int]]:
    blocks: List[Tuple[str, int, int]] = []
    for idx, line in enumerate(lines):
        if not line.startswith(ENTRY_HEADER_PREFIX):
            continue
        header = line[len(ENTRY_HEADER_PREFIX) :].strip()
        if not header.startswith("WI-"):
            continue
        work_item_id = header.split(" ", 1)[0]
        if not WORK_ITEM_PATTERN.match(work_item_id):
            continue
        end = len(lines)
        for cursor in range(idx + 1, len(lines)):
            if lines[cursor].startswith(ENTRY_HEADER_PREFIX):
                end = cursor
                break
        blocks.append((work_item_id, idx, end))
    return blocks


def present_sections(entry_lines: List[str]) -> set[str]:
    sections: set[str] = set()
    for line in entry_lines:
        if not line.startswith(SECTION_PREFIX):
            continue
        title = line[len(SECTION_PREFIX) :].strip()
        if title:
            sections.add(title)
    return sections


def missing_sections(entry_lines: List[str]) -> List[str]:
    available = present_sections(entry_lines)
    missing: List[str] = []
    for section in REQUIRED_SECTIONS:
        variants = section_variants(section)
        if any(variant in available for variant in variants):
            continue
        missing.append(section)
    return missing


def find_section_span(
    entry_lines: List[str], section_name: str
) -> Optional[Tuple[int, int]]:
    headings: List[Tuple[str, int]] = []
    for idx, line in enumerate(entry_lines):
        if not line.startswith(SECTION_PREFIX):
            continue
        heading = line[len(SECTION_PREFIX) :].strip()
        if heading:
            headings.append((heading, idx))
    for idx, (heading, start) in enumerate(headings):
        if heading not in section_variants(section_name):
            continue
        end = headings[idx + 1][1] if idx + 1 < len(headings) else len(entry_lines)
        return start, end
    return None


def section_body_text(entry_lines: List[str], section_name: str) -> str:
    span = find_section_span(entry_lines, section_name)
    if not span:
        return ""
    start, end = span
    return "\n".join(entry_lines[start + 1 : end]).strip()


def parse_section_outcome(text: str) -> Optional[str]:
    match = SECTION_OUTCOME_PATTERN.search(text or "")
    if not match:
        return None
    return match.group(1).upper()


def section_is_complete(text: str) -> bool:
    if not text.strip():
        return False
    return "(pending)" not in text.lower()


def infer_tester_outcome_from_test_results(text: str) -> str:
    explicit = parse_section_outcome(text)
    if explicit:
        return explicit
    if NON_ZERO_EXIT_PATTERN.search(text):
        return "FAIL"
    if ZERO_EXIT_PATTERN.search(text):
        return "PASS"
    normalized = text.lower()
    if "fail" in normalized:
        return "FAIL"
    if "pass" in normalized:
        return "PASS"
    return "SKIPPED"


def upsert_section_outcome(
    entry_lines: List[str], section_name: str, outcome: str
) -> bool:
    span = find_section_span(entry_lines, section_name)
    if not span:
        return False
    start, end = span
    body_lines = entry_lines[start + 1 : end]
    outcome_line = f"- Outcome: {outcome}"
    for idx, line in enumerate(body_lines):
        stripped = line.strip()
        normalized = stripped[2:].strip() if stripped.startswith("- ") else stripped
        if normalized.lower().startswith("outcome:"):
            if body_lines[idx] == outcome_line:
                return False
            body_lines[idx] = outcome_line
            entry_lines[start + 1 : end] = body_lines
            return True
    insert_at = 0
    while insert_at < len(body_lines) and not body_lines[insert_at].strip():
        insert_at += 1
    body_lines.insert(insert_at, outcome_line)
    entry_lines[start + 1 : end] = body_lines
    return True


def repair_missing_tester_feedback_outcome(entry_lines: List[str]) -> bool:
    test_results = section_body_text(entry_lines, "Test Results")
    if not section_is_complete(test_results):
        return False
    tester_feedback = section_body_text(entry_lines, "Tester Feedback")
    if not tester_feedback.strip():
        return False
    if parse_section_outcome(tester_feedback):
        return False
    outcome = infer_tester_outcome_from_test_results(test_results)
    return upsert_section_outcome(entry_lines, "Tester Feedback", outcome)


def section_default_lines(work_item_id: str, section: str) -> List[str]:
    if section == "Preflight Report":
        return [
            f"- Work Item: {work_item_id}",
            "- PRD ref: ",
            "- Risk level: ",
            "- Triggers: ",
            "- Scope in: ",
            "- Scope out: ",
            "- Non-goals reminder: ",
            "- Files to change: ",
            "- TDD plan: ",
            "- Systematic review: ",
        ]
    if section == "TDD Plan":
        return ["- Tests to write first: "]
    if section == "Allowed Tests":
        return [
            "- (list exact commands; do not include `make feature` or `pc-feature`)"
        ]
    if section == "Files to Change":
        return ["- Files: "]
    if section == "Docs Updated":
        return [
            "- [ ] Implementation log",
            "- [ ] Decision log (if needed)",
            "- [ ] Bug log (if needed)",
            "- [ ] Validation log (if needed)",
            "- [ ] Feature docs",
            "- [ ] PRD (if needed)",
        ]
    if section in {"Plan", "Patch", "Test Results", "Reporter Review"}:
        return ["- (pending)"]
    if section == "Gates":
        return ["- make ci: "]
    if section == "Autofix Attempts":
        return ["- (none)"]
    if section in {"Tester Feedback", "Reporter Feedback"}:
        return ["- Notes: "]
    if section == "Iteration Log":
        return ["- "]
    if section == "Commit":
        return ["- Commit message: "]
    if section == "Final Report":
        return ["- "]
    return ["- (pending)"]


def is_legacy_bootstrap_entry(entry_lines: List[str], missing: List[str]) -> bool:
    if not missing:
        return False
    outcome = normalize_status(parse_field_value(entry_lines, "Outcome"))
    if outcome not in LEGACY_OUTCOMES:
        return False
    scope_value = parse_field_value(entry_lines, "Scope / tasks covered").lower()
    notes_value = parse_field_value(entry_lines, "Notes").lower()
    scope_marker_present = any(marker in scope_value for marker in LEGACY_SCOPE_MARKERS)
    notes_marker_present = any(marker in notes_value for marker in LEGACY_NOTES_MARKERS)
    return scope_marker_present or notes_marker_present


def repair_legacy_entry(
    work_item_id: str, entry_lines: List[str]
) -> Tuple[List[str], bool]:
    changed = False
    missing = missing_sections(entry_lines)
    if is_legacy_bootstrap_entry(entry_lines, missing):
        changed = update_field(entry_lines, "Outcome", "completed")
        while entry_lines and entry_lines[-1].strip() == "":
            entry_lines.pop()
        for section in missing:
            entry_lines.extend(
                [
                    "",
                    f"{SECTION_PREFIX}{section}",
                    "",
                    *section_default_lines(work_item_id, section),
                    "",
                ]
            )
            changed = True
    if repair_missing_tester_feedback_outcome(entry_lines):
        changed = True
    return entry_lines, changed


def migrate_file(path: Path) -> Tuple[bool, List[str], str]:
    content = path.read_text(encoding="utf-8")
    lines = content.splitlines()
    blocks = find_entry_blocks(lines)
    if not blocks:
        return False, [], content
    changed = False
    migrated_work_items: List[str] = []
    for work_item_id, start, end in reversed(blocks):
        entry = lines[start:end]
        repaired, entry_changed = repair_legacy_entry(work_item_id, entry[:])
        if not entry_changed:
            continue
        lines[start:end] = repaired
        changed = True
        migrated_work_items.append(work_item_id)
    migrated_work_items.reverse()
    migrated_content = "\n".join(lines).rstrip() + "\n"
    return changed, migrated_work_items, migrated_content


def migrate_repo(root: Path, feature_selector: str, dry_run: bool) -> int:
    features_root = root / FEATURES_DIR
    if not features_root.exists():
        print(
            f"pc-devtasks-migrate-legacy: missing features directory: {features_root}",
            file=sys.stderr,
        )
        return 1
    updates: Dict[Path, List[str]] = {}
    for feature_dir in feature_dirs(features_root, feature_selector):
        dev_tasks_path = feature_dir / "dev-tasks.md"
        if not dev_tasks_path.exists():
            continue
        changed, work_items, migrated_content = migrate_file(dev_tasks_path)
        if not changed:
            continue
        updates[dev_tasks_path] = work_items
        if not dry_run:
            dev_tasks_path.write_text(migrated_content, encoding="utf-8")
    if not updates:
        print("pc-devtasks-migrate-legacy: no legacy entries found")
        return 0
    action = "would update" if dry_run else "updated"
    print(f"pc-devtasks-migrate-legacy: {action} {len(updates)} file(s)")
    for path in sorted(updates.keys()):
        rel_path = path.relative_to(root)
        work_items = ", ".join(updates[path])
        print(f"- {rel_path.as_posix()}: {work_items}")
    return 0


def main(argv: Optional[List[str]] = None) -> int:
    args = parse_args(argv)
    root = Path(args.root).resolve()
    return migrate_repo(root, args.feature, args.dry_run)


if __name__ == "__main__":
    raise SystemExit(main())
