#!/usr/bin/env bash
set -euo pipefail

work_item_id="${PC_WORK_ITEM_ID:-}"
agent_name="${PC_AGENT_NAME:-pc-precommit}"
run_id="${PC_RUN_ID:-}"
logging_enabled=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --work-item-id)
      work_item_id="$2"
      shift 2
      ;;
    --agent-name)
      agent_name="$2"
      shift 2
      ;;
    --run-id)
      run_id="$2"
      shift 2
      ;;
    *)
      echo "pc-precommit: unknown argument $1" >&2
      exit 1
      ;;
  esac
done

if ! command -v pre-commit >/dev/null 2>&1; then
  echo "pre-commit not installed. Install with: pipx install pre-commit" >&2
  exit 1
fi

if ! command -v git >/dev/null 2>&1; then
  echo "git not installed." >&2
  exit 1
fi

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if [[ -n "$work_item_id" ]]; then
  if [[ -z "$agent_name" ]]; then
    echo "pc-precommit: agent name required when work item id is set" >&2
    exit 1
  fi
  if [[ -z "$run_id" ]]; then
    run_id="$(python3 -c 'from lib.pc_runner import generate_run_id; print(generate_run_id())')"
  fi
  export PC_WORK_ITEM_ID="$work_item_id"
  export PC_AGENT_NAME="$agent_name"
  export PC_RUN_ID="$run_id"
  logging_enabled=true
else
  echo "pc-precommit: warning: PC_WORK_ITEM_ID not set; structured logging disabled." >&2
fi

log_event() {
  if [[ "$logging_enabled" != true ]]; then
    return 0
  fi
  PC_LOG_MESSAGE="$1" python3 - <<'PY'
import os
from lib.pc_runner import build_metadata, log_message

metadata = build_metadata(
    os.environ["PC_WORK_ITEM_ID"],
    os.environ["PC_AGENT_NAME"],
    os.environ["PC_RUN_ID"],
)
log_message(metadata, "precommit", os.environ["PC_LOG_MESSAGE"], root=os.getcwd())
PY
}

log_event "start"

staged_paths=()
while IFS= read -r -d '' path; do
  staged_paths+=("$path")
done < <(git diff --cached --name-only -z)
if [[ ${#staged_paths[@]} -eq 0 ]]; then
  echo "No staged changes detected." >&2
  exit 1
fi

initial_added_paths=()
while IFS= read -r -d '' path; do
  initial_added_paths+=("$path")
done < <(git diff --cached --name-only --diff-filter=A -z)

contains_path() {
  local needle="$1"
  shift
  local item
  for item in "$@"; do
    if [[ "$item" == "$needle" ]]; then
      return 0
    fi
  done
  return 1
}

needs_stash=false
stash_ref_before=""
stash_ref_after=""
if [[ -n "$(git diff --name-only)" || -n "$(git ls-files --others --exclude-standard)" ]]; then
  stash_ref_before="$(git rev-parse -q --verify refs/stash || true)"
  git stash push -u --keep-index -m "pc-precommit"
  stash_ref_after="$(git rev-parse -q --verify refs/stash || true)"
  if [[ -n "$stash_ref_after" && "$stash_ref_after" != "$stash_ref_before" ]]; then
    needs_stash=true
  fi
fi

output_file="$(mktemp)"
cleanup() {
  rm -f "$output_file"
}
trap cleanup EXIT

run_precommit() {
  : >"$output_file"
  set +e
  pre-commit run --hook-stage pre-commit --files "${staged_paths[@]}" >"$output_file" 2>&1
  local status=$?
  set -e
  cat "$output_file"
  return "$status"
}

restage_staged() {
  modified_paths=()
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    modified_paths+=("$line")
  done < <(git diff --name-only -- "${staged_paths[@]}")

  if [[ ${#modified_paths[@]} -eq 0 ]]; then
    return 0
  fi

  git add -u -- "${modified_paths[@]}"

  added_modified=()
  for path in "${modified_paths[@]}"; do
    if contains_path "$path" "${initial_added_paths[@]}"; then
      added_modified+=("$path")
    fi
  done
  if [[ ${#added_modified[@]} -gt 0 ]]; then
    git add -- "${added_modified[@]}"
  fi

  echo "pre-commit: re-staged modified files:" >&2
  printf ' - %s\n' "${modified_paths[@]}" >&2
}

lint_attempts=0
max_lint_attempts=2
status=1

while [[ "$lint_attempts" -lt "$max_lint_attempts" ]]; do
  if run_precommit; then
    status=0
    break
  fi
  restage_staged
  lint_attempts=$((lint_attempts + 1))
done

if [[ "$status" -ne 0 ]]; then
  echo "pre-commit: running AI autofix after $max_lint_attempts failed attempt(s)." >&2
  autofix_cmd=(
    tools/pc-autofix
    --mode pre-commit
    --issues-file "$output_file"
  )
  for path in "${staged_paths[@]}"; do
    autofix_cmd+=(
      --allowed-path "$path"
    )
  done
  if [[ -n "$work_item_id" ]]; then
    autofix_cmd+=(
      --work-item-id "$work_item_id"
      --agent-name "$agent_name"
      --run-id "$run_id"
    )
  fi
  "${autofix_cmd[@]}"
  restage_staged
  if ! run_precommit; then
    status=1
  else
    status=0
  fi
fi

if [[ "$needs_stash" == true ]]; then
  if ! git stash pop; then
    echo "pre-commit: stash pop failed; attempting AI conflict recovery." >&2
    conflict_file="$(mktemp)"
    {
      echo "git stash pop failed."
      echo ""
      git status --porcelain
    } >"$conflict_file"
    autofix_cmd=(
      tools/pc-autofix
      --mode stash-conflict
      --issues-file "$conflict_file"
    )
    if [[ -n "$work_item_id" ]]; then
      autofix_cmd+=(
        --work-item-id "$work_item_id"
        --agent-name "$agent_name"
        --run-id "$run_id"
      )
    fi
    "${autofix_cmd[@]}" || true
    rm -f "$conflict_file"
    exit 1
  fi
fi

log_event "complete status=$status"
exit "$status"
