#!/usr/bin/env python3
from __future__ import annotations

import argparse
import os
import subprocess
from datetime import datetime, timezone
from pathlib import Path


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Run deterministic pre-commit checks then Codex fallback")
    parser.add_argument("--dry-run", action="store_true", help="Validate tool chain without executing hooks")
    return parser.parse_args()


def staged_files() -> list[str]:
    completed = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "-z"],
        text=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=True,
    )
    return [entry.decode("utf-8") for entry in completed.stdout.split(b"\0") if entry]


def run_precommit(files: list[str], log_path: Path) -> int:
    command = [
        "pre-commit",
        "run",
        "--hook-stage",
        "pre-commit",
        "--files",
        *files,
    ]
    env = dict(**{"SKIP": "codex-autofix-fallback"})
    completed = subprocess.run(
        command,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        env={**os.environ, **env},
    )
    log_path.parent.mkdir(parents=True, exist_ok=True)
    log_path.write_text(completed.stdout or "", encoding="utf-8")
    return completed.returncode


def run_codex_autofix(files: list[str], issues_path: Path, artifact_root: Path) -> int:
    command = [
        "tools/codex-autofix",
        "--issues-file",
        str(issues_path),
        "--retry-max",
        "1",
        "--stage",
        "pre-commit",
        "--output-json",
        str(artifact_root / "codex-autofix.json"),
    ]
    for path in files:
        command.extend(["--allowed-path", path])
    completed = subprocess.run(command, text=True)
    return completed.returncode


def main() -> int:
    args = parse_args()

    if args.dry_run:
        checks = [
            ["git", "rev-parse", "--show-toplevel"],
            ["bash", "-lc", "command -v pre-commit >/dev/null 2>&1"],
            ["bash", "-lc", "command -v codex >/dev/null 2>&1"],
            ["bash", "-lc", "test -x tools/codex-autofix"],
            ["bash", "-lc", "test -x tools/scope-guard"],
        ]
        for command in checks:
            completed = subprocess.run(command)
            if completed.returncode != 0:
                print(f"git_precommit: dry-run check failed: {' '.join(command)}")
                return 1
        print("git_precommit: dry-run ok")
        return 0

    files = staged_files()
    if not files:
        print("git_precommit: no staged files")
        return 1

    timestamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    artifact_root = Path(".orchestrator") / "autofix" / f"precommit-{timestamp}"
    artifact_root.mkdir(parents=True, exist_ok=True)

    deterministic_1 = artifact_root / "deterministic-round1.log"
    if run_precommit(files, deterministic_1) == 0:
        print("git_precommit: deterministic checks passed")
        return 0

    print("git_precommit: deterministic checks failed, running Codex fallback round 1")
    if run_codex_autofix(files, deterministic_1, artifact_root) == 0:
        deterministic_2 = artifact_root / "deterministic-round2.log"
        if run_precommit(files, deterministic_2) == 0:
            print("git_precommit: checks passed after Codex fallback round 1")
            return 0

    print("git_precommit: running Codex fallback round 2")
    deterministic_3 = artifact_root / "deterministic-round3.log"
    if run_codex_autofix(files, deterministic_3, artifact_root) == 0:
        deterministic_4 = artifact_root / "deterministic-round4.log"
        if run_precommit(files, deterministic_4) == 0:
            print("git_precommit: checks passed after Codex fallback round 2")
            return 0

    print("git_precommit: failed after deterministic + fallback retries")
    print(f"git_precommit: see artifacts in {artifact_root}")
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
